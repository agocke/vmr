# VMR root BUILD file

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

# Mirror runtime's config flags so .bazelrc --//:clr_config works from VMR root.
string_flag(
    name = "clr_config",
    build_setting_default = "debug",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "libs_config",
    build_setting_default = "debug",
    visibility = ["//visibility:public"],
)

# Alias used by .bazelrc to point rules_dotnet's targeting pack override at
# the runtime's hybrid pack. We can't put @dotnet_runtime//... in the override
# flag value directly because the label is parsed in rules_dotnet's repo
# context, where dotnet_runtime isn't visible. By using a root-module alias
# (referenced as @@// in the flag value), we avoid that visibility problem.
alias(
    name = "vmr_targeting_pack_net10",
    actual = "@dotnet_runtime//src/libraries:vmr_targeting_pack_net10",
    visibility = ["//visibility:public"],
)
