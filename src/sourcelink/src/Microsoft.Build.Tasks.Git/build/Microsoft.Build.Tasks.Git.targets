<Project>
  <PropertyGroup>
    <!-- Keep replay outside Common's automatic project-extension imports so Restore can skip stale snapshots. -->
    <SourceControlFetchManifestPath Condition="'$(SourceControlFetchManifestPath)' == ''">$(MSBuildProjectExtensionsPath)sourcelink/$(_GraphInputsConfiguration)$(MSBuildProjectFile).g.targets</SourceControlFetchManifestPath>
    <SourceControlFetchManifestPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(SourceControlFetchManifestPath)'))</SourceControlFetchManifestPath>
  </PropertyGroup>

  <Import Project="$(SourceControlFetchManifestPath)"
          Condition="'$(EnableSourceControlFetchManifest)' == 'true' and
                     ('$(MSBuildHardenedGraph)' != 'true' or '$(IsCrossTargetingBuild)' != 'true') and
                     '$(EnableSourceControlManagerQueries)' == 'true' and
                     '$(_SourceLinkFetchManifestImported)' != 'true' and
                     ('$(MSBuildHardenedGraph)' == 'true' or '$(MSBuildRestoreGraphInputs)' != 'true') and
                     ('$(MSBuildHardenedGraph)' == 'true' or Exists('$(SourceControlFetchManifestPath)'))" />

  <UsingTask TaskName="Microsoft.Build.Tasks.Git.LocateRepository" AssemblyFile="$(MicrosoftBuildTasksGitAssemblyFile)"/>
  <UsingTask TaskName="Microsoft.Build.Tasks.Git.GetUntrackedFiles" AssemblyFile="$(MicrosoftBuildTasksGitAssemblyFile)"/>
  <UsingTask TaskName="Microsoft.Build.Tasks.Git.WriteSourceControlFetchManifest" AssemblyFile="$(MicrosoftBuildTasksGitAssemblyFile)"/>

  <PropertyGroup>
    <!--
      Sets the scope of git repository configuration. By default (no scope specified) configuration is read from environment variables
      and system and global user git/ssh configuration files. 
      
      If "local" is specified the configuration is only read from the configuration files local to the repository (or work tree).
      In addition, any use of home relative paths in these configuration files (paths that start with '~/') is disallowed.
      
      By default, the scope is restricted to "local" when building in CI (ContinuousIntegrationBuild is true) to avoid introducing 
      dependencies on CI machine state into the build.
    -->
    <GitRepositoryConfigurationScope Condition="'$(GitRepositoryConfigurationScope)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">local</GitRepositoryConfigurationScope>
  </PropertyGroup>

  <Target Name="_CollectSourceControlFetchManifest"
          Condition="'$(MSBuildHardenedGraph)' != 'true' and
                     ('$(MSBuildRestoreGraphInputs)' == 'true' or '$(EnableSourceControlFetchManifest)' == 'true') and
                     '$(EnableSourceControlManagerQueries)' == 'true'">
    <Microsoft.Build.Tasks.Git.LocateRepository
      Path="$(MSBuildProjectDirectory)"
      RemoteName="$(GitRepositoryRemoteName)"
      ConfigurationScope="$(GitRepositoryConfigurationScope)"
      NoWarnOnMissingInfo="$(PkgMicrosoft_Build_Tasks_Git.Equals(''))">

      <Output TaskParameter="RepositoryId" PropertyName="_SourceLinkFetchRepositoryId" />
      <Output TaskParameter="WorkingDirectory" PropertyName="_SourceLinkFetchRepositoryRoot" />
      <Output TaskParameter="Url" PropertyName="_SourceLinkFetchRepositoryUrl" />
      <Output TaskParameter="Roots" ItemName="_SourceLinkFetchSourceRoot" />
      <Output TaskParameter="RevisionId" PropertyName="_SourceLinkFetchRevisionId" />
      <Output TaskParameter="BranchName" PropertyName="_SourceLinkFetchBranchName" />
    </Microsoft.Build.Tasks.Git.LocateRepository>

    <Microsoft.Build.Tasks.Git.GetUntrackedFiles
      RepositoryId="$(_SourceLinkFetchRepositoryId)"
      ConfigurationScope="$(GitRepositoryConfigurationScope)"
      NoWarnOnMissingInfo="true"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      Files="@(Compile)">

      <Output TaskParameter="UntrackedFiles" ItemName="_SourceLinkFetchUntrackedFile" />
    </Microsoft.Build.Tasks.Git.GetUntrackedFiles>
  </Target>

  <Target Name="_PrepareSourceControlFetchManifestTranslation"
          DependsOnTargets="_CollectSourceControlFetchManifest">
    <PropertyGroup>
      <_SourceLinkFetchOriginalScmRepositoryUrl>$(ScmRepositoryUrl)</_SourceLinkFetchOriginalScmRepositoryUrl>
      <ScmRepositoryUrl>$(_SourceLinkFetchRepositoryUrl)</ScmRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <_SourceLinkFetchOriginalSourceRoot Include="@(SourceRoot)" />
      <SourceRoot Remove="@(SourceRoot)" />
      <SourceRoot Include="@(_SourceLinkFetchSourceRoot)" />
    </ItemGroup>
  </Target>

  <Target Name="_TranslateSourceControlFetchManifestUrls"
          DependsOnTargets="_PrepareSourceControlFetchManifestTranslation;_SourceLinkHasSingleProvider;$(SourceControlManagerUrlTranslationTargets)"
          Condition="'$(SourceControlManagerUrlTranslationTargets)' != ''">
    <PropertyGroup>
      <_SourceLinkFetchManifestUrlsTranslated>true</_SourceLinkFetchManifestUrlsTranslated>
    </PropertyGroup>
  </Target>

  <Target Name="_GenerateSourceControlFetchManifest"
          DependsOnTargets="_CollectSourceControlFetchManifest;_TranslateSourceControlFetchManifestUrls"
          AfterTargets="Restore"
          BeforeTargets="_GenerateProjectRestoreGraphPerFramework;_CaptureHardenedGraphInputs;_CaptureHardenedGraphInputsForFrameworkDiscovery"
          Condition="'$(MSBuildHardenedGraph)' != 'true' and
                     ('$(MSBuildRestoreGraphInputs)' == 'true' or '$(EnableSourceControlFetchManifest)' == 'true') and
                     '$(EnableSourceControlManagerQueries)' == 'true'">
    <PropertyGroup>
      <_SourceLinkFetchManifestRepositoryUrl Condition="'$(_SourceLinkFetchManifestUrlsTranslated)' == 'true'">$(ScmRepositoryUrl)</_SourceLinkFetchManifestRepositoryUrl>
      <_SourceLinkFetchManifestRepositoryUrl Condition="'$(_SourceLinkFetchManifestUrlsTranslated)' != 'true'">$(_SourceLinkFetchRepositoryUrl)</_SourceLinkFetchManifestRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <_SourceLinkFetchManifestSourceRoot Include="@(SourceRoot)" Condition="'$(_SourceLinkFetchManifestUrlsTranslated)' == 'true'" />
      <_SourceLinkFetchManifestSourceRoot Include="@(_SourceLinkFetchSourceRoot)" Condition="'$(_SourceLinkFetchManifestUrlsTranslated)' != 'true'" />
    </ItemGroup>

    <Microsoft.Build.Tasks.Git.WriteSourceControlFetchManifest
      OutputFile="$(SourceControlFetchManifestPath)"
      RepositoryRoot="$(_SourceLinkFetchRepositoryRoot)"
      RepositoryUrl="$(_SourceLinkFetchManifestRepositoryUrl)"
      RevisionId="$(_SourceLinkFetchRevisionId)"
      BranchName="$(_SourceLinkFetchBranchName)"
      SourceRoots="@(_SourceLinkFetchManifestSourceRoot)"
      UntrackedFiles="@(_SourceLinkFetchUntrackedFile)"
      RepositoryUrlsTranslated="$(_SourceLinkFetchManifestUrlsTranslated)" />

    <PropertyGroup Condition="'$(_SourceLinkFetchManifestUrlsTranslated)' == 'true'">
      <ScmRepositoryUrl>$(_SourceLinkFetchOriginalScmRepositoryUrl)</ScmRepositoryUrl>
    </PropertyGroup>

    <ItemGroup Condition="'$(_SourceLinkFetchManifestUrlsTranslated)' == 'true'">
      <SourceRoot Remove="@(SourceRoot)" />
      <SourceRoot Include="@(_SourceLinkFetchOriginalSourceRoot)" />
    </ItemGroup>
  </Target>

  <Target Name="InitializeSourceControlInformationFromSourceControlManager"
          Condition="'$(_SourceLinkFetchManifestImported)' != 'true'">
    <!--
      Reports a warning if the given project doesn't belong to a repository under source control,
      unless the targets were implicily imported from an SDK without a package reference.
    -->
    <Microsoft.Build.Tasks.Git.LocateRepository
      Path="$(MSBuildProjectDirectory)"
      RemoteName="$(GitRepositoryRemoteName)"
      ConfigurationScope="$(GitRepositoryConfigurationScope)"
      NoWarnOnMissingInfo="$(PkgMicrosoft_Build_Tasks_Git.Equals(''))">

      <Output TaskParameter="RepositoryId" PropertyName="_GitRepositoryId" />
      <Output TaskParameter="Url" PropertyName="ScmRepositoryUrl" />
      <Output TaskParameter="Roots" ItemName="SourceRoot" />
      <Output TaskParameter="RevisionId" PropertyName="SourceRevisionId" Condition="'$(SourceRevisionId)' == ''" />
      <Output TaskParameter="BranchName" PropertyName="SourceBranchName" />
    </Microsoft.Build.Tasks.Git.LocateRepository>

    <PropertyGroup>
      <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    </PropertyGroup>
  </Target>

  <!--
    Embed files to the PDB that either do not belong to any of the SourceRoot directories
    or belong to the source repository, but are explicitly ignored (excluded) from source control.
  -->
  <Target Name="SetEmbeddedFilesFromSourceControlManagerUntrackedFiles"
          DependsOnTargets="InitializeSourceControlInformationFromSourceControlManager">

    <ItemGroup Condition="'$(_SourceLinkFetchManifestImported)' == 'true'">
      <EmbeddedFiles Include="@(_SourceLinkFetchedUntrackedFile)" />
    </ItemGroup>

    <Microsoft.Build.Tasks.Git.GetUntrackedFiles
      RepositoryId="$(_GitRepositoryId)"
      ConfigurationScope="$(GitRepositoryConfigurationScope)"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      Files="@(Compile)"
      Condition="'$(_SourceLinkFetchManifestImported)' != 'true' and '$(_GitRepositoryId)' != ''">

      <Output TaskParameter="UntrackedFiles" ItemName="EmbeddedFiles" />
    </Microsoft.Build.Tasks.Git.GetUntrackedFiles>
  </Target>

</Project>
