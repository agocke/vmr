load("@rules_dotnet//dotnet:defs.bzl", "csharp_library")
load("@dotnet_runtime//:defs.bzl", "gen_resx_source", "resgen")
load("//src/roslyn:defs.bzl", "ROSLYN_KEYFILE", "ROSLYN_PUBLIC_KEY", "roslyn_assembly_info")

roslyn_assembly_info(name = "assembly_info")

gen_resx_source(
    name = "resx_test",
    out = "TestResource.Generated.cs",
    assembly_name = "Microsoft.CodeAnalysis.Test.Utilities",
    resource_name = "Microsoft.CodeAnalysis.Test.Utilities.TestResource",
    resource_class_name = "Microsoft.CodeAnalysis.Test.Utilities.TestResource",
    resx_file = "TestResource.resx",
)

resgen(
    name = "resgen_test",
    out = "TestResource.resources",
    resx_file = "TestResource.resx",
)

# Shared source files from Workspaces (linked in csproj via Compile Include with Link)
filegroup(
    name = "flow_analysis_srcs",
    srcs = [
        "//src/roslyn/src/Workspaces/SharedUtilitiesAndExtensions/Compiler/Core/Extensions:ControlFlowRegionExtensions.cs",
        "//src/roslyn/src/Workspaces/SharedUtilitiesAndExtensions/Compiler/Core/FlowAnalysis:CustomDataFlowAnalysis.cs",
        "//src/roslyn/src/Workspaces/SharedUtilitiesAndExtensions/Compiler/Core/FlowAnalysis:DataFlowAnalyzer.cs",
    ],
)

csharp_library(
    name = "Microsoft.CodeAnalysis.Test.Utilities",
    srcs = glob(["**/*.cs"]) + [
        ":resx_test",
        ":assembly_info",
        ":flow_analysis_srcs",
    ],
    out = "Microsoft.CodeAnalysis.Test.Utilities",
    deps = [
        "//src/roslyn/src/Compilers/Core/Portable:Microsoft.CodeAnalysis",
        "//src/roslyn/src/Compilers/CSharp/Portable:Microsoft.CodeAnalysis.CSharp",
        "//src/roslyn/src/Compilers/Test/Resources/Core:Microsoft.CodeAnalysis.Compiler.Test.Resources",
        "@paket.main//microsoft.codeanalysis.visualbasic",
        "@paket.main//diffplex",
        "@paket.main//microsoft.build.locator",
        "@paket.main//microsoft.diasymreader",
        "@paket.main//microsoft.diasymreader.converter.xml",
        "@paket.main//microsoft.diasymreader.converter",
        "@paket.main//microsoft.diasymreader.portablepdb",
        "@paket.main//microsoft.metadata.visualizer",
        "@paket.main//moq",
        "@paket.main//castle.core",
        "@paket.main//xunit.assert",
        "@paket.main//xunit.extensibility.core",
        "@paket.main//xunit.combinatorial",
        "@paket.main//xunit.abstractions",
        "@paket.main//icsharpcode.decompiler",
        "@paket.main//newtonsoft.json",
        "@paket.main//basic.reference.assemblies.netstandard20",
        "@paket.main//basic.reference.assemblies.net20",
        "@paket.main//basic.reference.assemblies.net40",
        "@paket.main//basic.reference.assemblies.net461",
        "@paket.main//basic.reference.assemblies.net50",
        "@paket.main//basic.reference.assemblies.net60",
        "@paket.main//basic.reference.assemblies.net70",
        "@paket.main//basic.reference.assemblies.net80",
        "@paket.main//basic.reference.assemblies.net90",
        "@paket.main//basic.reference.assemblies.net100",
        "@paket.main//microsoft.ilverification",
    ] ,
    resources = [":resgen_test"],
    resource_logical_names = {
        "TestResource.resources": "Microsoft.CodeAnalysis.Test.Utilities.TestResource.resources",
    },
    allow_unsafe_blocks = True,
    nullable = "enable",
    langversion = "preview",
    keyfile = ROSLYN_KEYFILE,
    compiler_options = ["/publicsign"],
    target_frameworks = ["net10.0"],
    internals_visible_to = [
        "Microsoft.CodeAnalysis.CSharp.Test.Utilities, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.Syntax.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.Semantic.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.Symbol.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.Emit.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.Emit2.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.Emit3.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.CommandLine.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.EndToEnd.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.WinRT.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.CSharp.IOperation.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Microsoft.CodeAnalysis.UnitTests, PublicKey=" + ROSLYN_PUBLIC_KEY,
        "Roslyn.Test.PdbUtilities, PublicKey=" + ROSLYN_PUBLIC_KEY,
    ],
    visibility = ["//src/roslyn:__subpackages__"],
)
