<?xml version="1.0" encoding="utf-8"?>
<!-- Licensed to the .NET Foundation under one or more agreements. The .NET Foundation licenses this file to you under the MIT license. See the LICENSE file in the project root for more information. -->
<Project>
  <PropertyGroup>
    <GenBuildMSBuildUtilitiesAssembly Condition="'$(GenBuildMSBuildUtilitiesAssembly)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../../../../../msbuild/artifacts/bin/Microsoft.Build.Utilities/$(Configuration)/netstandard2.0/Microsoft.Build.Utilities.Core.dll'))</GenBuildMSBuildUtilitiesAssembly>
    <GenBuildMSBuildFrameworkAssembly Condition="'$(GenBuildMSBuildFrameworkAssembly)' == ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(GenBuildMSBuildUtilitiesAssembly)')), 'Microsoft.Build.Framework.dll'))</GenBuildMSBuildFrameworkAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="Runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" ExcludeAssets="Runtime" />
    <PackageReference Include="System.Memory" Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'" />
    <CompilerVersionTargetsFile Include="$(IntermediateOutputPath)Microsoft.Managed.Core.CurrentVersions.targets" />
  </ItemGroup>
  <Target Name="UseGenBuildMSBuildUtilities" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="ResolvePackageAssets">
    <Error Condition="!Exists('$(GenBuildMSBuildUtilitiesAssembly)')" Text="Build the source MSBuild Utilities netstandard2.0 component first, or set GenBuildMSBuildUtilitiesAssembly to a reference containing SandboxedToolTask." />
    <Error Condition="!Exists('$(GenBuildMSBuildFrameworkAssembly)')" Text="Build the source MSBuild Framework component first, or set GenBuildMSBuildFrameworkAssembly to a reference containing the staged file-access APIs." />
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Build.Framework'" />
      <Reference Include="Microsoft.Build.Framework" HintPath="$(GenBuildMSBuildFrameworkAssembly)" Private="false" />
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Build.Utilities.Core'" />
      <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(GenBuildMSBuildUtilitiesAssembly)" Private="false" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateCompilerVersionTargets" BeforeTargets="AssignTargetPaths" DependsOnTargets="GenerateCompilerVersionTargetsFile">
    <ItemGroup>
      <Content Include="@(CompilerVersionTargetsFile)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Pack>true</Pack>
        <BuildAction>None</BuildAction>
        <PackageCopyToOutput>true</PackageCopyToOutput>
        <PackagePath>contentFiles\any\any</PackagePath>
      </Content>
    </ItemGroup>
  </Target>
  <Target Name="GenerateCompilerVersionTargetsFile" Outputs="@(CompilerVersionTargetsFile)">
    <PropertyGroup>
      <_CompilerApiVersion>$([System.Version]::Parse($(VersionPrefix)).Major).$([System.Version]::Parse($(VersionPrefix)).Minor)</_CompilerApiVersion>
      <_CompilerVersionTargetsFileContent><![CDATA[<Project>
  <PropertyGroup>
    <CompilerApiVersion>roslyn$(_CompilerApiVersion)</CompilerApiVersion>
  </PropertyGroup>
</Project>]]></_CompilerVersionTargetsFileContent>
    </PropertyGroup>
    <WriteLinesToFile File="@(CompilerVersionTargetsFile)" Lines="$(_CompilerVersionTargetsFileContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
</Project>