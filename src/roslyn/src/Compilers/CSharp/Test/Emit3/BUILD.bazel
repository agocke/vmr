load("//src/roslyn:defs.bzl", "ROSLYN_KEYFILE", "roslyn_assembly_info")
load("//src/roslyn:xunit_test.bzl", "roslyn_xunit_test")

roslyn_assembly_info(name = "assembly_info")

roslyn_xunit_test(
    name = "Microsoft.CodeAnalysis.CSharp.Emit3.UnitTests",
    srcs = glob(
        ["**/*.cs"],
        exclude = [
            # Needs PdbUtilities (extern alias not yet supported)
            "Semantics/ExtensionTests2.cs",
            # Partial class of ExtensionTests2 (excluded above)
            "Semantics/ExtensionTests.cs",
            # References ExtensionTests class (excluded above)
            "Semantics/ExtensionOperatorsTests.cs",
            "Semantics/PatternMatchingTests.cs",
            # Uses VisualBasicCompilation (VB NuGet incompatible with live-built CodeAnalysis)
            "OverloadResolutionPriorityTests.cs",
            "RefReadonlyParameterTests.cs",
            "Symbols/UserDefinedCompoundAssignmentOperatorsTests.cs",
            "Attributes/AttributeTests.cs",
            "Attributes/AttributeTests_CallerInfoAttributes.cs",
            "Attributes/AttributeTests_NullableContext.cs",
            "Attributes/InternalsVisibleToAndStrongNameTests.cs",
            # Partial class of InternalsVisibleToAndStrongNameTests (excluded above)
            "Attributes/EmitTestStrongNameProvider.cs",
            "Semantics/InlineArrayTests.cs",
            "Semantics/ParamsCollectionTests.cs",
            "Semantics/PatternMatchingTests4.cs",
            "Semantics/PatternMatchingTests_ListPatterns.cs",
            "Semantics/RecordTests.cs",
        ],
    ) + [
        ":assembly_info",
    ],
    out = "Microsoft.CodeAnalysis.CSharp.Emit3.UnitTests",
    deps = [
        "//src/roslyn/src/Compilers/Core/Portable:Microsoft.CodeAnalysis",
        "//src/roslyn/src/Compilers/CSharp/Portable:Microsoft.CodeAnalysis.CSharp",
        "//src/roslyn/src/Compilers/Test/Core:Microsoft.CodeAnalysis.Test.Utilities",
        "//src/roslyn/src/Compilers/Test/Utilities/CSharp:Microsoft.CodeAnalysis.CSharp.Test.Utilities",
        "//src/roslyn/src/Compilers/Test/Resources/Core:Microsoft.CodeAnalysis.Compiler.Test.Resources",
        "@paket.main//microsoft.codeanalysis.visualbasic",
        "@paket.main//xunit.assert",
        "@paket.main//xunit.extensibility.core",
        "@paket.main//xunit.abstractions",
        "@paket.main//xunit.combinatorial",
        "@paket.main//xunit.extensibility.execution",
        "@paket.main//basic.reference.assemblies.net40",
        "@paket.main//basic.reference.assemblies.net50",
        "@paket.main//basic.reference.assemblies.net60",
        "@paket.main//basic.reference.assemblies.net70",
        "@paket.main//basic.reference.assemblies.net80",
        "@paket.main//basic.reference.assemblies.net90",
        "@paket.main//basic.reference.assemblies.net100",
    ],
    allow_unsafe_blocks = True,
    nullable = "enable",
    langversion = "preview",
    nowarn = ["CS1570", "CS1587"],
    keyfile = ROSLYN_KEYFILE,
    compiler_options = ["/publicsign", "/nostdlib"],
    native_tools = ["@dotnet_runtime//src/coreclr/ilasm"],
    size = "enormous",
    visibility = ["//src/roslyn:__subpackages__"],
)