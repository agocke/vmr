# Bazel configuration for dotnet/runtime native builds.
#
# Supported platforms: linux-x64, osx-arm64, win-x64.
# Platform-specific flags are applied automatically via
# --enable_platform_specific_config (build:linux, build:macos, build:windows).
#
# Per-component configuration (matching MSBuild's -rc / -lc flags):
#
#   CoreCLR (clr_config):   debug, checked (default), release
#   Libraries (libs_config): debug (default), release
#
# Use --config flags to select:
#   --config=clr_debug       Debug CLR
#   --config=clr_checked     Checked CLR (debug asserts + release optimization)
#   --config=clr_release     Release CLR
#   --config=libs_release    Release libraries
#   --config=release         Release everything (= clr_release + libs_release)
#
# Use --compilation_mode (-c) for optimization:
#   -c dbg       Debug (matches CMake Debug: -O0, debug symbols)
#   -c opt       Release (matches CMake Release: -O2, -DNDEBUG)
#   -c fastbuild Default (fast incremental builds)
#
# Examples:
#   bazel build //...                                          # debug everything
#   bazel build --config=release //...                         # release everything
#   bazel build --config=clr_checked --config=libs_release //... # checked CLR + release libs
#   bazel build -c opt --config=clr_checked //...              # checked CLR + debug libs + -O2

# =====================================================================
# Unix compiler flags (GCC/Clang)
# =====================================================================
# Applied automatically on Linux and macOS via --enable_platform_specific_config
# (see build:linux --config=unix and build:macos --config=unix below).
# Windows uses MSVC flags instead (see build:windows section).
#
# Flags within build:unix are applied in file order, so -Wall appears
# before -Wno-* suppressions — the ordering is correct.

# Default to Clang on Unix (matching CMake).
build:unix --config=clang

# Match CMake configurecompiler.cmake settings (config-independent)
build:unix --conlyopt=-std=gnu11
build:unix --cxxopt=-std=gnu++11
build:unix --copt=-fPIC
build:unix --copt=-fno-omit-frame-pointer
build:unix --copt=-fno-strict-overflow
build:unix --copt=-fno-strict-aliasing
build:unix --copt=-fstack-protector-strong
build:unix --copt=-ffp-contract=off
build:unix --copt=-fsigned-char
build:unix --copt=-fvisibility=hidden
build:unix --copt=-ffunction-sections
build:unix --cxxopt=-fno-rtti

# Platform defines (Unix only)
# Platform-specific arch/OS defines are in PLATFORM_DEFINES (cc_defs.bzl)
# and used via select() in BUILD files. Only universal defines go here.
build:unix --copt=-D_FILE_OFFSET_BITS=64
build:unix --copt=-D_TIME_BITS=64

# Exec/tool platform defines (for tools like ilasm built with cfg = "exec")
build:unix --host_conlyopt=-std=gnu11
build:unix --host_cxxopt=-std=gnu++11
build:unix --host_copt=-D_FILE_OFFSET_BITS=64
build:unix --host_copt=-D_TIME_BITS=64

# Warning flags shared between GCC and Clang (configurecompiler.cmake)
build:unix --copt=-Wall
build:unix --copt=-Wno-unused-variable
build:unix --copt=-Wno-unused-value
build:unix --copt=-Wno-unused-function
build:unix --copt=-Wno-tautological-compare
build:unix --copt=-Wno-unknown-pragmas
build:unix --copt=-Wimplicit-fallthrough
build:unix --copt=-Wno-unused-but-set-variable
# Bazel's default C++ toolchain enables -Wunused-but-set-parameter; CMake does not.
build:unix --copt=-Wno-unused-but-set-parameter

# --- GCC-specific warning flags (default compiler) ---
# These are in an else() branch in configurecompiler.cmake (not Clang).
# Silently ignored by Clang when -Wno-unknown-warning-option is set.
build:unix --copt=-Wno-uninitialized
build:unix --copt=-Wno-strict-aliasing
build:unix --copt=-Wno-array-bounds
build:unix --cxxopt=-Wno-misleading-indentation
build:unix --cxxopt=-Wno-stringop-overflow
build:unix --cxxopt=-Wno-restrict
build:unix --copt=-Wno-stringop-truncation
build:unix --cxxopt=-Wno-class-memaccess

# --- Clang-specific warning flags (configurecompiler.cmake) ---
# Unknown -Wno-* flags are silently ignored by GCC, so this is safe.
build:unix --copt=-Wno-unknown-warning-option
build:unix --copt=-ferror-limit=4096
build:unix --copt=-Wno-null-conversion
build:unix --copt=-Wno-unused-private-field
build:unix --copt=-Wno-constant-logical-operand
build:unix --copt=-Wno-pragma-pack
build:unix --copt=-Wno-incompatible-ms-struct
build:unix --copt=-Wno-reserved-identifier
build:unix --copt=-Wno-unsafe-buffer-usage
build:unix --copt=-Wno-single-bit-bitfield-constant-conversion
build:unix --copt=-Wno-cast-function-type-strict
build:unix --copt=-Wno-switch-default
build:unix --cxxopt=-Wno-nontrivial-memaccess

# Exec/tool warning flags (for tools like ilasm built with cfg = "exec")
build:unix --host_copt=-Wall
build:unix --host_copt=-Wno-unused-variable
build:unix --host_copt=-Wno-unused-value
build:unix --host_copt=-Wno-unused-function
build:unix --host_copt=-Wno-tautological-compare
build:unix --host_copt=-Wno-unknown-pragmas
build:unix --host_copt=-Wimplicit-fallthrough
build:unix --host_copt=-Wno-unused-but-set-variable
build:unix --host_copt=-Wno-unused-but-set-parameter
build:unix --host_copt=-Wno-uninitialized
build:unix --host_copt=-Wno-strict-aliasing
build:unix --host_copt=-Wno-array-bounds
build:unix --host_cxxopt=-Wno-misleading-indentation
build:unix --host_cxxopt=-Wno-stringop-overflow
build:unix --host_cxxopt=-Wno-restrict
build:unix --host_copt=-Wno-stringop-truncation
build:unix --host_cxxopt=-Wno-class-memaccess
build:unix --host_copt=-Wno-unknown-warning-option
build:unix --host_copt=-ferror-limit=4096
build:unix --host_copt=-Wno-null-conversion
build:unix --host_copt=-Wno-unused-private-field
build:unix --host_copt=-Wno-constant-logical-operand
build:unix --host_copt=-Wno-pragma-pack
build:unix --host_copt=-Wno-incompatible-ms-struct
build:unix --host_copt=-Wno-reserved-identifier
build:unix --host_copt=-Wno-unsafe-buffer-usage
build:unix --host_copt=-Wno-single-bit-bitfield-constant-conversion
build:unix --host_copt=-Wno-cast-function-type-strict
build:unix --host_copt=-Wno-switch-default
build:unix --host_cxxopt=-Wno-nontrivial-memaccess

# Disable warnings for vendored code
build:unix --per_file_copt=src/native/external/.*@-w
build:unix --host_per_file_copt=src/native/external/.*@-w

# safecrt_input_s.cpp is the non-unicode scanf variant — _UNICODE must not be defined
build:unix --per_file_copt=.*safecrt_input_s.*@-U_UNICODE,-UUNICODE
build:unix --host_per_file_copt=.*safecrt_input_s.*@-U_UNICODE,-UUNICODE

# --- Clang compiler (config:clang) ---
# Matches CMake default: uses clang/clang++ with lld linker on Linux.
# On macOS, Apple Clang + default ld are used (no lld).
build:clang --repo_env=CC=clang
build:clang --repo_env=CXX=clang++
build:clang --define compiler=clang

# =====================================================================
# Linux-specific settings
# =====================================================================
build:linux --config=unix
# Linker hardening and lld (no-ops or harmful on macOS).
build:linux --linkopt=-Wl,--build-id=sha1
build:linux --linkopt=-fuse-ld=lld

# =====================================================================
# macOS-specific settings
# =====================================================================
build:macos --config=unix
# Deployment target — match CMake's eng/native/configureplatform.cmake
build:macos --macos_minimum_os=12.0

# =====================================================================
# Windows-specific settings (MSVC)
# =====================================================================
# Applied automatically via --enable_platform_specific_config.
# Compiler and linker flags live in cc_defs.bzl (PLATFORM_COPTS,
# PLATFORM_LINKOPTS) so targets opt in explicitly, matching the
# PLATFORM_DEFINES pattern.  Only per_file_copt overrides (which have
# no BUILD-file equivalent) belong here.

# Disable Bazel's default dynamic CRT selection (/MD, /MDd).  The
# project controls CRT flags explicitly via NATIVE_CONFIG_COPTS in
# native_defs.bzl, selecting /MT or /MTd based on clr_config to match
# CMake's configurecompiler.cmake.
build:windows --features=-dynamic_link_msvcrt

# Force /DEBUG:FULL for all link actions.  Bazel's MSVC toolchain
# defaults to /DEBUG:FASTLINK in fastbuild mode, which is no longer
# supported by current MSVC linkers.  The /ignore:4315 suppresses the
# warning that the linker falls back to /DEBUG:FULL anyway.
build:windows --linkopt=/DEBUG:FULL
build:windows --linkopt=/ignore:4315

# Disable warnings for vendored code
build:windows --per_file_copt=src/native/external/.*@/w
build:windows --host_per_file_copt=src/native/external/.*@/w

# safecrt_input_s.cpp is the non-unicode scanf variant — _UNICODE must not be defined
build:windows --per_file_copt=.*safecrt_input_s.*@/U_UNICODE,/UUNICODE
build:windows --host_per_file_copt=.*safecrt_input_s.*@/U_UNICODE,/UUNICODE

# Enable automatic platform config selection (applies build:linux on Linux,
# build:macos on macOS, build:windows on Windows).
build --enable_platform_specific_config

# =====================================================================
# Per-component configuration
# =====================================================================
#
# CoreCLR and libraries have independent debug/release configurations,
# matching MSBuild's -rc (runtime config) and -lc (libraries config).
#
# Debug/checked/release defines are set per-target in BUILD files via
# select() on //:clr_config and //:libs_config.  See CLR_CONFIG_DEFINES
# in src/coreclr/coreclr_defs.bzl and NATIVE_CONFIG_DEFINES in
# src/native/native_defs.bzl.  The --config flags below set the
# string_flag values that drive those select() expressions.

# --- CoreCLR default: checked ---
build --//:clr_config=checked

# --- Libraries default: debug ---
build --//:libs_config=debug

# =====================================================================
# --config=clr_debug: Debug CoreCLR
# =====================================================================
build:clr_debug --//:clr_config=debug

# =====================================================================
# --config=clr_checked: Checked CoreCLR (same as default)
# =====================================================================
build:clr_checked --//:clr_config=checked

# =====================================================================
# --config=clr_release: Release CoreCLR
# =====================================================================
build:clr_release --//:clr_config=release
build:clr_release -c opt

# =====================================================================
# --config=libs_release: Release libraries
# =====================================================================
build:libs_release --//:libs_config=release

# =====================================================================
# --config=release: Release everything (convenience)
# =====================================================================
build:release --config=clr_release
build:release --config=libs_release
# Note: -c opt is on clr_release, so it applies here too.

# =====================================================================
# --config=ci: CI mode — deterministic source paths
# Enables /pathmap to normalize source and PDB paths, matching MSBuild's
# ContinuousIntegrationBuild=true / DeterministicSourcePaths=true.
# Use with --config=release for comparison against CI-built MSBuild output.
# =====================================================================
build:ci --//:ci=true

# =====================================================================
# Default test tag filters: exclude pri1 tests (expensive / not default)
# To include pri1 tests: bazel test --test_tag_filters= //...
# To run ONLY pri1 tests: bazel test --test_tag_filters=pri1 //...
# =====================================================================
test --test_tag_filters=-pri1
