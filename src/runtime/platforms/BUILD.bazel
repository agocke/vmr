# Platform definitions for cross-compilation.
# Use with --platforms=//platforms:<platform> to cross-compile.
# These are NOT auto-registered as execution platforms.

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "macos_x64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)
