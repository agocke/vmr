    name = "reflection_EmbeddedTextFile1",
    srcs = ["System.Reflection.Tests/Resources/EmbeddedTextFile.txt"],
    outs = ["System.Reflection.Tests/Resources/EmbeddedTextFile1.txt"],
    cmd = "cp $< $@",
)

