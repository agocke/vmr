    name = "reflection_EmbeddedImage1",
    srcs = ["System.Reflection.Tests/Resources/EmbeddedImage.png"],
    outs = ["System.Reflection.Tests/Resources/EmbeddedImage1.png"],
    cmd = "cp $< $@",
)

