# NOTE: System.Resources.ResourceManager.Tests requires System.Drawing.Common (NuGet),
# System.Resources.Extensions, System.Runtime.Serialization.Formatters, resx-generated
# code, and satellite assemblies. Ported with available deps; satellite assemblies and
# .resources content files may need additional work.
#
# MSBuild compiles .resx files to .resources before embedding. The neutral
# .resx files (AToZResx, CustomReader, TestResx) are compiled via resgen;
# satellite .resx files are passed as /additionalfile only (for analyzers).
resgen(
    name = "resgen_AToZResx",
    out = "AToZResx.resources",
    resx_file = "System.Resources.ResourceManager.Tests/Resources/AToZResx.resx",
)

