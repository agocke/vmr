library_test(
    name = "System.Text.Json.Tests",
    size = "large",
    allow_unsafe_blocks = True,
    features_nullable_public_only = False,
    nowarn = [
        "CA1510",
        "CA1511",
        "CA1512",
        "CA1513",
        "CA1845",
        "CA1846",
        "CA1847",
        "SYSLIB0020",  # JsonSerializerOptions.IgnoreNullValues is obsolete
        "SYSLIB0049",  # JsonSerializerOptions.AddContext is obsolete
        "JSON001",     # JSON misformatted in string literals
    ],
    srcs = glob(
        ["**/*.cs"],
        exclude = [
            # TrimmingTests are not applicable under Bazel
            "TrimmingTests/**",
        ],
    ) + _COMMON_TEST_FILES + [
        ":gen_resx",
        # SR.cs provides the partial class that gen_resx_source completes
        "//src/libraries/Common:src/System/SR.cs",
        # BitStack.cs from impl source (compiled into the test assembly)
        "//src/libraries/System.Text.Json:src/System/Text/Json/BitStack.cs",
        # Common test utilities
        "//src/libraries/Common/tests:System/IO/WrappedMemoryStream.cs",
        "//src/libraries/Common/tests:System/DateTimeTestHelpers.cs",
    ],
    resources = [":strings_resx"],
    resource_logical_names = {"FxResources.System.Text.Json.Tests.SR.resources": "FxResources.System.Text.Json.Tests.SR.resources"},
    additionalfiles = ["Resources/Strings.resx"],
    deps = [
        "//src/libraries/System.Text.Json:ref_System.Text.Json",
        "//src/libraries/System.Collections.Immutable:ref_System.Collections.Immutable",
        "//src/libraries/System.IO.Pipelines:ref_System.IO.Pipelines",
