load("//src/libraries:defs.bzl", "DOWNLEVEL_GENERATOR_ANALYZERS", "MULTITARGET_NOWARN", "live_csharp_library")
load("//src/tests:live_test.bzl", "library_test")
load("//:defs.bzl", "OPEN_SNK", "csharp_library")

# In MSBuild these target netstandard2.0, but they use ProjectReference to the
# source System.Composition projects.  In Bazel we must reference the same impl
# assemblies the test uses so that type identities match at runtime (otherwise
# List<ExportDescriptorProvider>.Add throws ArrayTypeMismatchException).

live_csharp_library(
    name = "TestLibrary",
    keyfile = OPEN_SNK,
    srcs = ["TestLibrary/TestClass.cs"],
    nullable = "annotations",
    deps = [
        "//src/libraries/System.Composition.AttributedModel:impl_System.Composition.AttributedModel",
    ],
)

live_csharp_library(
    name = "Microsoft.Composition.Demos.ExtendedCollectionImports",
    keyfile = OPEN_SNK,
    srcs = glob(["Microsoft.Composition.Demos.ExtendedCollectionImports/**/*.cs"]),
    nullable = "annotations",
    deps = [
        "//src/libraries/System.Composition.AttributedModel:impl_System.Composition.AttributedModel",
        "//src/libraries/System.Composition.Hosting:impl_System.Composition.Hosting",
        "//src/libraries/System.Composition.Runtime:impl_System.Composition.Runtime",
        "//src/libraries/System.Composition.TypedParts:impl_System.Composition.TypedParts",
    ],
)

# netstandard2.0 equivalents for compare-bazel equivalence checking only.
# These match MSBuild's netstandard2.0 compilation but are NOT used by the
# test runner (the live_csharp_library versions above are used instead).

csharp_library(
    name = "TestLibrary_netstandard2.0",
    out = "TestLibrary",
    analyzers = DOWNLEVEL_GENERATOR_ANALYZERS,
    keyfile = OPEN_SNK,
    srcs = ["TestLibrary/TestClass.cs"],
    target_frameworks = ["netstandard2.0"],
    include_default_ruleset = False,
    include_syslib_warnaserror = False,
    skip_analyzers = True,
    nullable = "annotations",
    msbuild_analyzer_config = "style",
    nowarn = ["IL2121", "SYSLIB0011", "SYSLIB0050", "SYSLIB0051", "nullable", "CA1510", "CA1511", "CA1512", "CA1513", "CA1845", "CA1846", "CA1847"],
    deps = [
        "//src/libraries/System.Composition.AttributedModel:System.Composition.AttributedModel_netstandard2.0",
    ],
)

csharp_library(
    name = "Microsoft.Composition.Demos.ExtendedCollectionImports_netstandard2.0",
    out = "Microsoft.Composition.Demos.ExtendedCollectionImports",
    analyzers = DOWNLEVEL_GENERATOR_ANALYZERS,
    keyfile = OPEN_SNK,
    srcs = glob(["Microsoft.Composition.Demos.ExtendedCollectionImports/**/*.cs"]),
    target_frameworks = ["netstandard2.0"],
    include_default_ruleset = False,
    include_syslib_warnaserror = False,
    skip_analyzers = True,
    nullable = "annotations",
    msbuild_analyzer_config = "style",
    nowarn = ["IL2121", "SYSLIB0011", "SYSLIB0050", "SYSLIB0051", "nullable", "CA1510", "CA1511", "CA1512", "CA1513", "CA1845", "CA1846", "CA1847"],
    deps = [
        "//src/libraries/System.Composition.AttributedModel:System.Composition.AttributedModel_netstandard2.0",
        "//src/libraries/System.Composition.Hosting:System.Composition.Hosting_netstandard2.0",
        "//src/libraries/System.Composition.Runtime:System.Composition.Runtime_netstandard2.0",
        "//src/libraries/System.Composition.TypedParts:System.Composition.TypedParts_netstandard2.0",
    ],
)

library_test(
    name = "System.Composition.Tests",
    nowarn = MULTITARGET_NOWARN,
    srcs = glob(["*.cs", "Util/**/*.cs"]),
    deps = [
        ":Microsoft.Composition.Demos.ExtendedCollectionImports",
        ":TestLibrary",
        "//src/libraries/System.Composition.AttributedModel:impl_System.Composition.AttributedModel",
        "//src/libraries/System.Composition.Convention:impl_System.Composition.Convention",
        "//src/libraries/System.Composition.TypedParts:impl_System.Composition.TypedParts",
        "//src/libraries/System.Composition.Hosting:impl_System.Composition.Hosting",
        "//src/libraries/System.Composition.Runtime:impl_System.Composition.Runtime",
        "//src/libraries/System.Collections.Concurrent:ref_System.Collections.Concurrent",
        "//src/libraries/System.Collections.Immutable:ref_System.Collections.Immutable",
        "//src/libraries/System.Linq.Expressions:ref_System.Linq.Expressions",
        "//src/libraries/Common/tests:TestUtilities",
        "//src/libraries/shims/netstandard:impl_netstandard",
        "@paket.main//microsoft.dotnet.xunitassert",
        "@paket.main//microsoft.dotnet.xunitextensions",
        "@paket.main//xunit.abstractions",
        "@paket.main//xunit.extensibility.core",
    ],
    data = [
        ":Microsoft.Composition.Demos.ExtendedCollectionImports",
        ":TestLibrary",
    ],
    keyfile = OPEN_SNK,
    size = "large",
)
