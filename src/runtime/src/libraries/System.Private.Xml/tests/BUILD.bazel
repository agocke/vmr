# MSBuild uses Link attributes to remap test data directory paths:
#   XmlReader/TestFiles/** → TestFiles/**   (strip "XmlReader/" prefix)
#   Xslt/TestFiles/**      → TestFiles/**   (strip "Xslt/" prefix)
# These remap_data targets produce symlinks at the correct output paths so that
# library_test's data handling places them next to the test DLL as expected.
remap_data(
    name = "xslt_testfiles",
    srcs = glob(["Xslt/TestFiles/**"]),
    strip_prefix = "Xslt/",
)

remap_data(
    name = "xmlreader_testfiles",
    srcs = glob(["XmlReader/TestFiles/**"]),
    strip_prefix = "XmlReader/",
)

# DTD files from System.Private.Xml src need to appear at Utils/DTDs/... next to the DLL.
# MSBuild copies these with Link="Utils\DTDs\..." preserving the DTDs subdirectory structure.
remap_data(
    name = "dtd_files",
    srcs = [
        "//src/libraries/System.Private.Xml:src/Utils/DTDs/XHTML10/no_comments/xhtml1-frameset.dtd",
        "//src/libraries/System.Private.Xml:src/Utils/DTDs/XHTML10/no_comments/xhtml1-strict.dtd",
        "//src/libraries/System.Private.Xml:src/Utils/DTDs/XHTML10/no_comments/xhtml1-transitional.dtd",
        "//src/libraries/System.Private.Xml:src/Utils/DTDs/XHTML10/no_comments/xhtml-lat1.ent",
        "//src/libraries/System.Private.Xml:src/Utils/DTDs/XHTML10/no_comments/xhtml-special.ent",
        "//src/libraries/System.Private.Xml:src/Utils/DTDs/XHTML10/no_comments/xhtml-symbol.ent",
        "//src/libraries/System.Private.Xml:src/Utils/DTDs/RSS091/no_comments/rss-0.91.dtd",
    ],
    full_strip_prefix = "src/libraries/System.Private.Xml/src/",
)

# XmlReaderLib sub-library (referenced by csproj as ProjectReference)
csharp_library(
    name = "XmlReaderLib",
    srcs = glob(["XmlReaderLib/*.cs"]),
    keyfile = OPEN_SNK,
    nowarn = ["CS1701", "CS1702", "CS1705", "CS8500", "CS8969", "IDE0060", "IDE0100", "NU5105", "SYSLIB0011", "SYSLIB0050", "SYSLIB0051", "IL2121"],
    target_frameworks = [NETCOREAPP_CURRENT],
    deps = [
        "//src/libraries/Common/tests:XmlModuleCore",
        "//src/libraries/Common/tests:XmlCoreTest",
        "//src/libraries/Common/tests:XmlDiff",
        "//src/libraries/Common/tests:TestUtilities",
        "//src/libraries/System.Xml.ReaderWriter:ref_System.Xml.ReaderWriter",
        "//src/libraries/System.Xml.XPath:ref_System.Xml.XPath",
        "@paket.main//microsoft.dotnet.xunitassert",
        "@paket.main//xunit.abstractions",
        "@paket.main//xunit.extensibility.core",
    ],
    visibility = ["//visibility:public"],
)

# BaseLibManaged sub-library (referenced by csproj as ProjectReference)
