load("//src/tests:live_test.bzl", "library_test")
load("//src/libraries:defs.bzl", "MULTITARGET_NOWARN")
load("//:defs.bzl", "OPEN_SNK")

library_test(
    name = "System.Numerics.Tensors.Tests",
    nowarn = MULTITARGET_NOWARN,
    srcs = glob(["*.cs"]),
    deps = [
        "//src/libraries/System.Numerics.Tensors:impl_System.Numerics.Tensors",
        "//src/libraries:ref_System.Linq.Expressions",
        "//src/libraries/System.Runtime.Numerics:ref_System.Runtime.Numerics",
        "//src/libraries/System.Collections.Concurrent:ref_System.Collections.Concurrent",
        "//src/libraries/System.Collections.Immutable:ref_System.Collections.Immutable",
        "//src/libraries:ref_System.Threading.Tasks",
        "//src/libraries/Common/tests:TestUtilities",
        "@paket.main//microsoft.dotnet.xunitassert",
        "@paket.main//microsoft.dotnet.xunitextensions",
        "@paket.main//xunit.abstractions",
        "@paket.main//xunit.extensibility.core",
    ],
    allow_unsafe_blocks = True,
    keyfile = OPEN_SNK,
    size = "large",
)

# Net8 test variant: tests the net8.0 API surface using SNT_NET8_TESTS define.
# In Bazel we use the current build of System.Numerics.Tensors (not net8.0),
# but the define restricts tests to the net8.0 API subset.
library_test(
    name = "System.Numerics.Tensors.Net8.Tests",
    srcs = [
        "Helpers.cs",
        "TensorPrimitives.NonGeneric.Single.cs",
        "TensorPrimitivesTests.cs",
        "TensorPrimitivesTests.Reference.cs",
        "TensorPrimitives.ConvertTo.cs",
        "TensorPrimitives.Generic.cs",
    ],
    deps = [
        "//src/libraries/System.Numerics.Tensors:impl_System.Numerics.Tensors",
        "//src/libraries:ref_System.Linq.Expressions",
        "//src/libraries/System.Runtime.Numerics:ref_System.Runtime.Numerics",
        "//src/libraries/System.Collections.Concurrent:ref_System.Collections.Concurrent",
        "//src/libraries/System.Collections.Immutable:ref_System.Collections.Immutable",
        "//src/libraries:ref_System.Threading.Tasks",
        "//src/libraries/Common/tests:TestUtilities",
        "@paket.main//microsoft.dotnet.xunitassert",
        "@paket.main//microsoft.dotnet.xunitextensions",
        "@paket.main//xunit.abstractions",
        "@paket.main//xunit.extensibility.core",
    ],
    defines = ["SNT_NET8_TESTS"],
    allow_unsafe_blocks = True,
    keyfile = OPEN_SNK,
    size = "large",
)
