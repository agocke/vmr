load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//:cc_defs.bzl", "PLATFORM_DEFINES")
load("//src/native:native_defs.bzl", "NATIVE_CONFIG_DEFINES")

cc_library(
    name = "System.Native_lib",
    srcs = [
        "entrypoints.c",
        "pal_autoreleasepool.c",
        "pal_console.c",
        "pal_datetime.c",
        "pal_dynamicload.c",
        "pal_environment.c",
        "pal_errno.c",
        "pal_interfaceaddresses.c",
        "pal_io.c",
        "pal_iossupportversion.c",
        "pal_log.c",
        "pal_maphardwaretype.c",
        "pal_memory.c",
        "pal_mount.c",
        "pal_networkchange.c",
        "pal_networking.c",
        "pal_networkstatistics.c",
        "pal_process.c",
        "pal_random.c",
        "pal_runtimeinformation.c",
        "pal_searchpath.c",
        "pal_signal.c",
        "pal_string.c",
        "pal_sysctl.c",
        "pal_tcpstate.c",
        "pal_threading.c",
        "pal_time.c",
        "pal_uid.c",
    ] + glob(["*.h"]),
    copts = [
        "-Wno-declaration-after-statement",
        "-Isrc/native",
        "-Isrc/native/libs/Common",
        "-Isrc/native/libs/bazel",
    ],
    defines = [
        "HAS_CONSOLE_SIGNALS",
    ],
    local_defines = NATIVE_CONFIG_DEFINES + PLATFORM_DEFINES,
    linkopts = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["-lrt"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//src/native/libs:common",
        "//src/native/minipal",
    ] + select({
        "@platforms//os:macos": [":System.Native_objc"],
        "//conditions:default": [],
    }),
)

# On macOS, compile Objective-C sources as a separate cc_library.
# Rename .m -> .c and use -x objective-c to compile them as ObjC.
[genrule(
    name = "rename_%s" % src.replace(".m", "").replace("pal_", ""),
    srcs = [src],
    outs = [src.replace(".m", "_objc.c")],
    cmd = "cp $< $@",
) for src in [
    "pal_autoreleasepool.m",
    "pal_datetime.m",
    "pal_environment.m",
    "pal_log.m",
    "pal_searchpath.m",
]]

cc_library(
    name = "System.Native_objc",
    srcs = [
        "pal_autoreleasepool_objc.c",
        "pal_datetime_objc.c",
        "pal_environment_objc.c",
        "pal_log_objc.c",
        "pal_searchpath_objc.c",
    ] + glob(["*.h"]),
    copts = [
        "-x", "objective-c",
        "-fno-objc-arc",
        "-Wno-declaration-after-statement",
        "-Isrc/native",
        "-Isrc/native/libs/Common",
        "-Isrc/native/libs/bazel",
        "-Isrc/native/libs/System.Native",
    ],
    defines = [
        "HAS_CONSOLE_SIGNALS",
    ],
    local_defines = NATIVE_CONFIG_DEFINES + PLATFORM_DEFINES,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//src/native/libs:common",
        "//src/native/minipal",
    ],
)

cc_shared_library(
    name = "System.Native",
    shared_lib_name = select({
        "@platforms//os:macos": "libSystem.Native.dylib",
        "//conditions:default": "libSystem.Native.so",
    }),
    user_link_flags = select({
        "@platforms//os:macos": [
            "-Wl,-install_name,@rpath/libSystem.Native.dylib",
            "-framework", "Foundation",
        ],
        "//conditions:default": ["-Wl,-soname,libSystem.Native.so"],
    }),
    visibility = ["//visibility:public"],
    deps = [":System.Native_lib"],
)
