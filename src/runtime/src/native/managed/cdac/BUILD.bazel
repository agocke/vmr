# cDAC reader API headers.
# Matches CMake: src/native/managed/cdac/cmake/CMakeLists.txt (INTERFACE library).

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//src/coreclr:__subpackages__"])

cc_library(
    name = "cdac_api",
    hdrs = ["inc/cdac_reader.h"],
    strip_include_prefix = "inc",
)

# Target for relative includes (../../native/managed/cdac/inc/cdac_reader.h)
cc_library(
    name = "cdac_inc",
    hdrs = ["inc/cdac_reader.h"],
)

exports_files(["inc/cdac_reader.h"])
