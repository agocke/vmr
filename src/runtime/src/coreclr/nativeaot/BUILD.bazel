# NativeAOT runtime — Bazel build.
# Matches CMake: src/coreclr/nativeaot/Runtime/CMakeLists.txt
#                src/coreclr/nativeaot/Runtime/Full/CMakeLists.txt

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//src/coreclr:coreclr_defs.bzl", "CLR_BASE_CONFIG_DEFINES", "CLR_CONFIG_COPTS")
load("//src/coreclr/nativeaot:nativeaot_defs.bzl", "NATIVEAOT_COMMON_DEFINES", "NATIVEAOT_COPTS", "NATIVEAOT_DEFINES")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "nativeaot_inc",
    # Header-only target exposing shared NativeAOT include paths.
    # Replaces the -Isrc/... copts that were in NATIVEAOT_COPTS.
    includes = [
        "Runtime",
        "Runtime/inc",
        "Runtime/unix",
        "../gc",
        "../gc/env",
        "../runtime",
        "../pal/inc/rt",
    ] + select({
        "@platforms//os:macos": ["Runtime/arm64"],
        "@platforms//os:linux": ["Runtime/amd64"],
    }),
)

# ---------------------------------------------------------------------------
# Generated AsmOffsets.inc (preprocessed from unix/AsmOffsets.cpp)
# ---------------------------------------------------------------------------

genrule(
    name = "gen_asm_offsets",
    srcs = [
        "Runtime/unix/AsmOffsets.cpp",
        "Runtime/AsmOffsets.h",
    ] + select({
        "@platforms//cpu:arm64": ["Runtime/arm64/AsmOffsetsCpu.h"],
        "//conditions:default": ["Runtime/amd64/AsmOffsetsCpu.h"],
    }),
    outs = ["AsmOffsets.inc"],
    cmd = select({
        "@platforms//cpu:arm64": " ".join([
            "$(CC)",
            "-x c++",
            "-E -P",
            "-DHOST_64BIT",
            "-DHOST_ARM64",
        ] + ["-D" + d for d in NATIVEAOT_COMMON_DEFINES] + [
            "-I$$(dirname $(location Runtime/AsmOffsets.h))",
            "-I$$(dirname $(location Runtime/arm64/AsmOffsetsCpu.h))",
            "$(location Runtime/unix/AsmOffsets.cpp)",
            "> $@",
        ]),
        "//conditions:default": " ".join([
            "$(CC)",
            "-x c++",
            "-E -P",
            "-DHOST_64BIT",
            "-DHOST_AMD64",
        ] + ["-D" + d for d in NATIVEAOT_COMMON_DEFINES] + [
            "-I$$(dirname $(location Runtime/AsmOffsets.h))",
            "-I$$(dirname $(location Runtime/amd64/AsmOffsetsCpu.h))",
            "$(location Runtime/unix/AsmOffsets.cpp)",
            "> $@",
        ]),
    }),
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)

# Copy the pre-generated config.h into the gendir so it is found via
# -I$(GENDIR)/src/coreclr/nativeaot without polluting the source-tree
# include paths (which would cause infinite include loops).
genrule(
    name = "gen_config_h",
    srcs = select({
        "@platforms//os:macos": ["Runtime/unix/bazel/darwin-arm64/config.h"],
        "//conditions:default": ["Runtime/unix/bazel/config.h"],
    }),
    outs = ["config.h"],
    cmd = select({
        "@platforms//os:macos": "cp $(location Runtime/unix/bazel/darwin-arm64/config.h) $@",
        "//conditions:default": "cp $(location Runtime/unix/bazel/config.h) $@",
    }),
)

