        ],
    }),
    copts = CORECLR_COPTS + CLR_CONFIG_COPTS,
    includes = [
        ".",
        "..",
    ] + select({
        "@platforms//cpu:arm64": ["arm64"],
        "//conditions:default": ["amd64"],
    }),
    local_defines = CLR_CONFIG_DEFINES + select({
