# CoreCLR VM — headers and compiled execution engine.
# Matches CMake: src/coreclr/vm/CMakeLists.txt + vm/wks/CMakeLists.txt

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//src/coreclr:coreclr_defs.bzl", "CLR_CONFIG_DEFINES", "CORECLR_COPTS", "CLR_CONFIG_COPTS", "CORECLR_DEFINES", "CORECLR_DAC_DEFINES")

package(default_visibility = ["//src/coreclr:__subpackages__"])

exports_files([
    "ClrEtwAll.man",
    "gcinfodecoder.cpp",
    "yieldprocessornormalizedshared.cpp",
])

cc_library(
    name = "vm_headers",
    hdrs = glob(
        [
            "*.h",
            "*.hpp",
            "*.inl",
            "amd64/*.h",
            "amd64/*.hpp",
            "amd64/*.inl",
            "arm64/*.h",
            "arm64/*.hpp",
            "arm64/*.inl",
            "i386/*.h",
        ],
        allow_empty = True,
    ),
)

# Common copts for VM targets (vm/ is the CMAKE_INCLUDE_CURRENT_DIR).
_VM_INCLUDES = [
    ".",
    "..",
    "../gc",
    "../runtime",
    "eventing/eventpipe",
] + select({
    "@platforms//cpu:arm64": ["arm64"],
    "//conditions:default": ["amd64"],
})

_VM_COPTS = CORECLR_COPTS + CLR_CONFIG_COPTS + [
    "-include", "src/coreclr/vm/common.h",
    "-Wno-error",
]

_VM_DEFINES = CORECLR_DEFINES + [
    "FEATURE_VIRTUAL_STUB_DISPATCH",
    "FEATURE_SIMD",
    "FEATURE_HW_INTRINSICS",
    "FEATURE_MASKED_HW_INTRINSICS",
]

# Assembly files compiled separately (no C++ PCH).
cc_library(
    name = "cee_wks_asm",
    srcs = select({
        "@platforms//cpu:arm64": [
            "arm64/AllocSlow.S",
            "arm64/CachedInterfaceDispatchCoreCLR.S",
            "arm64/StubPrecodeDynamicHelpers.S",
