            "amd64/patchedcode.S",
            "amd64/pinvokestubs.S",
            "amd64/redirectedhandledjitcase.S",
            "amd64/theprestubamd64.S",
            "amd64/thunktemplates.S",
            "amd64/umthunkstub.S",
            "amd64/unixasmhelpers.S",
            "amd64/virtualcallstubamd64.S",
