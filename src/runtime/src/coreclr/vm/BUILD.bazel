            "arm64/pinvokestubs.S",
            "arm64/thunktemplates.S",
            "//src/coreclr/runtime:arm64/AllocFast.S",
            "//src/coreclr/runtime:arm64/StubDispatch.S",
            "//src/coreclr/runtime:arm64/WriteBarriers.S",
        ],
        "//conditions:default": [
            "amd64/AllocSlow.S",
            "amd64/CachedInterfaceDispatchCoreCLR.S",
            "amd64/Context.S",
            "amd64/StubPrecodeDynamicHelpers.S",
