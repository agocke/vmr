# CoreCLR ceefgen — CEE file generation (metadata writer support).
# Matches CMake: src/coreclr/md/ceefilegen/CMakeLists.txt

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//src/coreclr:coreclr_defs.bzl", "CLR_CONFIG_DEFINES", "CORECLR_COPTS", "CLR_CONFIG_COPTS", "CORECLR_DEFINES")

package(default_visibility = ["//src/coreclr:__subpackages__"])

cc_library(
    name = "ceefgen",
    srcs = [
        "blobfetcher.cpp",
        "cceegen.cpp",
        "ceegentokenmapper.cpp",
        "ceesectionstring.cpp",
        "pesectionman.cpp",
        "stdafx.h",
    ],
    copts = CORECLR_COPTS + CLR_CONFIG_COPTS + [
        "-Isrc/coreclr/md/ceefilegen",
        "-Isrc/coreclr/md/inc",
        "-include", "src/coreclr/md/ceefilegen/stdafx.h",
    ],
    local_defines = CLR_CONFIG_DEFINES,
    defines = CORECLR_DEFINES,
    alwayslink = True,
    deps = ["//src/coreclr/inc:coreclr_inc"],
)
