        "compiler/import.cpp",
        "compiler/importhelper.cpp",
        "compiler/mdutil.cpp",
        "compiler/regmeta.cpp",
        "compiler/regmeta_compilersupport.cpp",
        "compiler/regmeta_emit.cpp",
        "compiler/regmeta_import.cpp",
        "compiler/regmeta_imetadatatables.cpp",
        "compiler/regmeta_vm.cpp",
        "compiler/stdafx.h",
    ],
    copts = _MD_COPTS + [
        "-Isrc/coreclr/md/compiler",
        "-include", "src/coreclr/md/compiler/stdafx.h",
    ],
    local_defines = CLR_CONFIG_DEFINES,
    defines = _MD_DEFINES + [
        "FEATURE_METADATA_EMIT_PORTABLE_PDB",
    ],
    alwayslink = True,
    deps = ["//src/coreclr/inc:coreclr_inc"],
)

