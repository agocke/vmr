# CoreLib's AssemblyInfo is generated by .NET SDK's GenerateAssemblyInfo in
# MSBuild.  Unlike regular libraries it does NOT include Serviceable,
# PreferInbox, DefaultAlias, NeutralResourcesLanguage, or IsAotCompatible.
# CLSCompliant is set in source (Internal/AssemblyAttributes.cs).
gen_assembly_info(
    name = "corelib_assembly_info",
    out = "System.Private.CoreLib.AssemblyInfo.cs",
    assembly_name = "System.Private.CoreLib",
    assembly_version = "10.0.0.0",
    assembly_configuration = "Release",
    is_trimmable = True,
    cls_compliant = False,
    include_serviceable = False,
    include_neutral_resources_language = False,
    is_aot_compatible = False,
)

genrule(
    name = "corelib_generated_msbuild_editorconfig",
    outs = ["System.Private.CoreLib.GeneratedMSBuildEditorConfig.editorconfig"],
    cmd = """cat >"$@" <<'EOF'
is_global = true
build_property.InformationalVersion = {version}
dotnet_diagnostic.CA1516.severity = none
EOF""".format(version = PRODUCT_VERSION),
)

genrule(
    name = "corelib_disabled_analyzers_config",
    outs = ["disabledAnalyzers.config"],
    cmd = ": > \"$@\"",
)

genrule(
    name = "corelib_illink_descriptors",
    srcs = [
        "src/ILLink/ILLink.Descriptors.Shared.xml",
    ] + select({
        "@platforms//os:windows": ["src/ILLink/ILLink.Descriptors.Windows.xml"],
        "//conditions:default": [],
    }) + select({
        "//:clr_release": [],
        "//conditions:default": ["src/ILLink/ILLink.Descriptors.Debug.xml"],
    }),
    outs = ["ILLink.Descriptors.xml"],
    cmd = """echo '<linker>' > "$@" && \
for f in $(SRCS); do \
  sed -e '1{/^<\\?xml/d;}' \
      -e '/^[[:space:]]*<linker>[[:space:]]*$$/d' \
      -e '/^[[:space:]]*<\\/linker>[[:space:]]*$$/d' "$$f" >> "$@"; \
done && \
echo '</linker>' >> "$@"
""",
)

genrule(
    name = "corelib_illink_link_attributes",
    srcs = ["src/ILLink/ILLink.Suppressions.LibraryBuild.xml"],
    outs = ["ILLink.LinkAttributes.xml"],
    cmd = "cp \"$<\" \"$@\"",
)

