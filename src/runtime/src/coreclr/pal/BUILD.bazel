_PAL_ASM_SOURCES = select({
    "@platforms//os:macos": [
        "src/arch/arm64/context.S",
        "src/arch/arm64/context2.S",
        "src/arch/arm64/debugbreak.S",
        "src/arch/arm64/dispatchexceptionwrapper.S",
        "src/arch/arm64/exceptionhelper.S",
    ],
    "//conditions:default": [
        "src/arch/amd64/context2.S",
        "src/arch/amd64/debugbreak.S",
        "src/arch/amd64/exceptionhelper.S",
        "src/arch/amd64/callsignalhandlerwrapper.S",
    ],
})

_PAL_PLATFORM_SOURCES = select({
    "@platforms//os:macos": [
        "src/exception/machexception.cpp",
        "src/exception/machmessage.cpp",
    ],
    "//conditions:default": [
        "src/arch/amd64/signalhandlerhelper.cpp",
    ],
})

cc_library(
    name = "coreclrpal",
    srcs = _PAL_SOURCES + _PAL_ASM_SOURCES + _PAL_PLATFORM_SOURCES + select({
        "@platforms//os:macos": ["src/bazel/darwin-arm64/config.h"],
        "//conditions:default": ["src/bazel/linux-glibc-x64/config.h"],
    }) + glob(
        [
            "src/include/**/*.h",
            "src/include/**/*.hpp",
            "src/include/**/*.inl",
            "src/exception/*.h",
            "src/map/*.h",
            "src/misc/*.h",
            "src/safecrt/*.inl",
            "src/synchmgr/*.hpp",
            "src/thread/*.hpp",
            "src/objmgr/*.hpp",
        ],
        allow_empty = True,
    ) + select({
        "@platforms//os:macos": glob(["src/arch/arm64/*.h"], allow_empty = True),
        "//conditions:default": glob(["src/arch/amd64/*.h"], allow_empty = True),
    }),
    textual_hdrs = [
        "src/exception/seh-unwind.cpp",
    ],
    hdrs = glob([
        "inc/*.h",
        "inc/*.inc",
        "inc/rt/*.h",
    ]),
    copts = CLR_CONFIG_COPTS + [
        # Warning suppression (matching configurecompiler.cmake for GCC C++)
        "-Wno-invalid-offsetof",
        "-Wno-class-memaccess",
        "-Wno-conversion-null",
        "-Wno-pointer-arith",
        "-Wno-misleading-indentation",
        "-Wno-stringop-overflow",
        "-Wno-restrict",
        # PAL needs a few headers from coreclr/inc (volatile.h, etc.)
        "-Isrc/coreclr/inc",
        # PAL-specific include paths
        "-Isrc/coreclr/pal/src/include",
        "-Isrc/coreclr/pal/inc",
        "-Isrc/coreclr/pal/inc/rt",
        "-Isrc/coreclr/pal/src/safecrt",
        "-Isrc/native",
        "-Isrc/native/inc",
    ] + select({
        "@platforms//os:macos": [
            "-Isrc/coreclr/pal/src/arch/arm64",
        ],
        "//conditions:default": [
            "-Isrc/coreclr/pal/src/arch/amd64",
        ],
    }) + select({
        "//:compiler_clang": [],
        "//conditions:default": ["-Wa,--divide"],
    }),
    defines = PLATFORM_DEFINES + [
        # PAL-specific
        "LP64COMPATIBLE",
        "CORECLR",
        "PIC",
        "UNICODE",
        "_UNICODE",
        "FEATURE_PAL_ANSI",
    ] + select({
        "@platforms//os:macos": [
            # configurecompiler.cmake — macOS platform defines
            "_XOPEN_SOURCE",
            "_DARWIN_C_SOURCE",
            "__DARWIN_NON_CANCELABLE=1",
        ],
        "//conditions:default": ["XSTATE_SUPPORTED"],
    }),
    linkopts = select({
        "@platforms//os:macos": [
            "-lpthread",
            "-framework", "CoreFoundation",
            "-framework", "Security",
        ],
        "//conditions:default": [
            "-lgcc_s",
            "-lpthread",
            "-lrt",
            "-ldl",
        ],
    }),
    deps = [
        ":pal_config",
        ":pal_headers",
        "//src/coreclr/inc:coreclr_inc_headers_only",
        "//src/native:native_inc",
        "//src/native/external/libunwind",
        "//src/native/minipal",
    ],
    alwayslink = True,
)

# tracepointprovider — Linux-specific (single source)
cc_library(
    name = "tracepointprovider",
    srcs = ["src/misc/tracepointprovider.cpp"] + glob(
        [
            "src/include/**/*.h",
            "src/include/**/*.hpp",
            "src/include/**/*.inl",
        ],
        allow_empty = True,
    ) + select({
        "@platforms//os:macos": ["src/bazel/darwin-arm64/config.h"],
        "//conditions:default": ["src/bazel/linux-glibc-x64/config.h"],
    }),
    copts = CLR_CONFIG_COPTS + [
        "-Wno-invalid-offsetof",
        "-Isrc/coreclr/pal/src/include",
        "-Isrc/coreclr/pal/inc",
        "-Isrc/coreclr/pal/inc/rt",
        "-Isrc/coreclr/pal/src/safecrt",
        "-Isrc/coreclr/inc",
        "-Isrc/native",
        "-Isrc/native/inc",
    ] + select({
        "@platforms//os:macos": ["-Isrc/coreclr/pal/src/bazel/darwin-arm64"],
        "//conditions:default": ["-Isrc/coreclr/pal/src/bazel/linux-glibc-x64"],
    }),
    defines = PLATFORM_DEFINES + [
        "CORECLR",
    ],
    deps = [
        ":pal_headers",
        "//src/coreclr/inc:coreclr_inc_headers_only",
        "//src/native/minipal",
    ],
    alwayslink = True,
)

# --- eventprovider (dummy LTTng stubs) ---
# Pre-generated by genDummyProvider.py from ClrEtwAll.man.
# On linux without LTTng, this provides no-op event stubs.
cc_library(
    name = "eventprovider",
    srcs = glob(["src/eventprovider/bazel/dummy/*.cpp"]) + glob([
        "src/include/**/*.h",
        "src/include/**/*.hpp",
        "src/include/**/*.inl",
    ]),
    copts = CORECLR_COPTS + CLR_CONFIG_COPTS + [
        "-Isrc/coreclr/pal/src/include",
    ],
    local_defines = CLR_CONFIG_DEFINES,
    defines = CORECLR_DEFINES,
    alwayslink = True,
    linkstatic = True,
    deps = [
        ":pal_headers",
        "//src/coreclr/inc:coreclr_inc",
    ],
)
