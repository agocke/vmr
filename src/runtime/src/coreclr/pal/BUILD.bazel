# CoreCLR Platform Abstraction Layer (PAL) — headers and compiled library.
# Matches CMake: src/coreclr/pal/src/CMakeLists.txt (for the library)
# and global include_directories in src/coreclr/CMakeLists.txt (for headers).

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:cc_defs.bzl", "PLATFORM_DEFINES")
load("//src/coreclr:coreclr_defs.bzl", "CLR_CONFIG_DEFINES", "CORECLR_COPTS", "CLR_CONFIG_COPTS", "CORECLR_DEFINES")

package(default_visibility = ["//src/coreclr:__subpackages__"])

exports_files(glob(["prebuilt/idl/*.cpp"]))

# --- PAL headers (Windows API shims for Unix) ---
# On Unix, coreclr uses the PAL to provide <windows.h>, <objbase.h>, etc.
# These are header-only targets needed by nearly all coreclr components.

cc_library(
    name = "pal_inc",
    hdrs = glob([
        "inc/*.h",
        "inc/*.inc",
        "inc/rt/*.h",
    ]),
    includes = [
        "inc",
        "inc/rt",
    ],
    deps = [
        "//src/native/minipal",
    ],
)

cc_library(
    name = "pal_prebuilt_inc",
    hdrs = glob(["prebuilt/inc/*.h"]),
    includes = ["prebuilt/inc"],
)

# Just the inc/rt/ headers (sal.h etc.) without inc/ (which has
# unixasmmacros.inc that conflicts with NativeAOT's versions).
cc_library(
    name = "pal_rt_inc",
    hdrs = glob(["inc/rt/*.h"]),
    includes = ["inc/rt"],
)

cc_library(
    name = "pal_safecrt",
    hdrs = glob(["src/safecrt/*.h"]),
    includes = ["src/safecrt"],
)

# Combined PAL headers target
cc_library(
    name = "pal_headers",
    deps = [
        ":pal_inc",
        ":pal_prebuilt_inc",
        ":pal_safecrt",
    ],
)

# Generated PAL config header (from configure.cmake → config.h.in)
cc_library(
    name = "pal_config",
    hdrs = select({
        "@platforms//os:macos": ["src/bazel/darwin-arm64/config.h"],
        "//conditions:default": ["src/bazel/linux-glibc-x64/config.h"],
    }),
    strip_include_prefix = select({
        "@platforms//os:macos": "src/bazel/darwin-arm64",
        "//conditions:default": "src/bazel/linux-glibc-x64",
    }),
)

