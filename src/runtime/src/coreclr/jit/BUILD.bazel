# -------------------------------------------------------------------------
# Common copts and defines
# -------------------------------------------------------------------------

_JIT_COPTS = CORECLR_COPTS + CLR_CONFIG_COPTS + [
    "-include", "src/coreclr/jit/jitpch.h",
    "-Wno-error",
    "-Wno-endif-labels",
    "-Wno-changes-meaning",
    "-Wno-sizeof-pointer-div",
    # emitarm64.h uses static_assert without message (C++17) in a C++11 build.
    "-Wno-c++17-extensions",
]

_JIT_INCLUDES = [
    ".",
    "jitstd",
]

_JIT_DEFINES_BASE = [
    "JIT_BUILD",
]

_JIT_SIMD_DEFINES = [
    "FEATURE_SIMD",
    "FEATURE_HW_INTRINSICS",
    "FEATURE_MASKED_HW_INTRINSICS",
]

# -------------------------------------------------------------------------
# clrjit_static — OBJECT library for linking into libcoreclr.so
# -------------------------------------------------------------------------

cc_library(
    name = "clrjit_static",
    srcs = _JIT_COMMON_SOURCES + select({
        "@platforms//cpu:arm64": _JIT_ARM64_SOURCES,
        "//conditions:default": _JIT_AMD64_SOURCES,
    }),
    textual_hdrs = ["smcommon.cpp"],
    copts = _JIT_COPTS,
    includes = _JIT_INCLUDES,
    local_defines = CLR_CONFIG_DEFINES,
    defines = CORECLR_DEFINES + _JIT_DEFINES_BASE + _JIT_SIMD_DEFINES,
    deps = [
        "//src/coreclr/inc:coreclr_inc",
    ],
    alwayslink = True,
    linkstatic = True,
)

# -------------------------------------------------------------------------
# libclrjit.so — standalone JIT shared library (native linux-x64 target)
# Matches CMake: create_standalone_jit(TARGET clrjit OS unix ARCH x64)
# -------------------------------------------------------------------------

# Textual header included by sm.cpp via #include "smcommon.cpp".
# cc_binary does not support textual_hdrs, so we expose it via a header-only lib.
cc_library(
    name = "jit_textual_hdrs",
    textual_hdrs = ["smcommon.cpp"],
)

cc_binary(
    name = "libclrjit.so",
    srcs = _JIT_COMMON_SOURCES + select({
        "@platforms//cpu:arm64": _JIT_ARM64_SOURCES,
        "//conditions:default": _JIT_AMD64_SOURCES,
    }),
    linkshared = True,
    linkstatic = True,
    copts = _JIT_COPTS + CLR_CONFIG_COPTS,
    includes = _JIT_INCLUDES,
    local_defines = CLR_CONFIG_DEFINES,
    defines = CORECLR_DEFINES + _JIT_DEFINES_BASE + _JIT_SIMD_DEFINES + [
        "FEATURE_NO_HOST",
        "SELF_NO_HOST",
        "JIT_STANDALONE_BUILD",
    ],
    linkopts = select({
        "@platforms//os:macos": [
            "-Wl,-install_name,@rpath/libclrjit.dylib",
            "-Wl,-exported_symbols_list,$(location bazel/clrjit.exports.mac)",
        ],
        "//conditions:default": [
            "-Wl,-Bsymbolic",
            "-Wl,--version-script=$(location bazel/clrjit.exports)",
        ],
    }),
    additional_linker_inputs = select({
        "@platforms//os:macos": ["bazel/clrjit.exports.mac"],
        "//conditions:default": ["bazel/clrjit.exports"],
    }),
    deps = [
        ":jit_textual_hdrs",
        "//src/coreclr/gcinfo",
        "//src/coreclr/inc:coreclr_inc",
        "//src/coreclr/utilcode:utilcodestaticnohost",
        "//src/coreclr/dlls/mscorrc",
        "//src/coreclr/pal:coreclrpal",
        "//src/coreclr/minipal:coreclrminipal",
        "//src/native/minipal",
    ],
    visibility = ["//visibility:public"],
)

# -------------------------------------------------------------------------
# Cross-target standalone JIT shared libraries.
# Built on linux-x64 host but targeting different architectures/OSes.
# Matches CMake: create_standalone_jit() calls in src/coreclr/jit/CMakeLists.txt
# -------------------------------------------------------------------------

# Undefine global TARGET_* from .bazelrc and ABI defines propagated by deps
# (CORECLR_DEFINES in utilcodestaticnohost). Each variant re-defines via copts.
_CROSS_JIT_UNDEF_COPTS = [
    "-UTARGET_64BIT",
    "-UTARGET_AMD64",
    "-UTARGET_UNIX",
    "-UTARGET_LINUX",
    "-UUNIX_AMD64_ABI",
    "-UUNIX_AMD64_ABI_ITF",
    "-UFEATURE_USE_ASM_GC_WRITE_BARRIERS",
]

_CROSS_JIT_DEFINES = _JIT_DEFINES_BASE + [
    "FEATURE_NO_HOST",
    "SELF_NO_HOST",
    "JIT_STANDALONE_BUILD",
]

_CROSS_JIT_LINKOPTS = select({
    "@platforms//os:macos": [],
    "//conditions:default": [
        "-Wl,-Bsymbolic",
        "-Wl,--version-script=$(location bazel/clrjit.exports)",
    ],
})

_CROSS_JIT_LINKER_INPUTS = select({
    "@platforms//os:macos": [],
    "//conditions:default": ["bazel/clrjit.exports"],
})

_CROSS_JIT_DEPS = [
    ":jit_textual_hdrs",
    "//src/coreclr/inc:coreclr_inc_headers_only",
    "//src/coreclr/utilcode:utilcodestaticnohost",
    "//src/coreclr/dlls/mscorrc",
    "//src/coreclr/pal:coreclrpal",
    "//src/coreclr/minipal:coreclrminipal",
    "//src/native/minipal",
]

# --- clrjit_universal_arm64_x64 ---
cc_binary(
    name = "libclrjit_universal_arm64_x64.so",
    includes = _JIT_INCLUDES,
    srcs = _JIT_COMMON_SOURCES + _JIT_ARM64_SOURCES,
    linkshared = True,
    linkstatic = True,
    copts = _JIT_COPTS + _CROSS_JIT_UNDEF_COPTS + [
        "-DTARGET_64BIT",
        "-DTARGET_ARM64",
    ],
    defines = _CROSS_JIT_DEFINES + _JIT_SIMD_DEFINES,
    linkopts = _CROSS_JIT_LINKOPTS,
    additional_linker_inputs = _CROSS_JIT_LINKER_INPUTS,
    deps = _CROSS_JIT_DEPS + ["//src/coreclr/gcinfo:gcinfo_universal_arm64"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

# --- clrjit_unix_x64_x64 ---
cc_binary(
    name = "libclrjit_unix_x64_x64.so",
    includes = _JIT_INCLUDES,
    srcs = _JIT_COMMON_SOURCES + _JIT_AMD64_SOURCES,
    linkshared = True,
    linkstatic = True,
    copts = _JIT_COPTS + _CROSS_JIT_UNDEF_COPTS + [
        "-DTARGET_64BIT",
        "-DTARGET_AMD64",
        "-DTARGET_UNIX",
        "-DTARGET_UNIX_ANYOS",
        "-DUNIX_AMD64_ABI",
    ],
    defines = _CROSS_JIT_DEFINES + _JIT_SIMD_DEFINES,
    linkopts = _CROSS_JIT_LINKOPTS,
    additional_linker_inputs = _CROSS_JIT_LINKER_INPUTS,
    deps = _CROSS_JIT_DEPS + ["//src/coreclr/gcinfo:gcinfo_unix_x64"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

