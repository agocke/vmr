***********************************************************************************************
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Restore captures with MSBuildRestoreGraphInputs; hardened evaluation only enables replay. -->
  <PropertyGroup>
    <EnableFrameworkReferenceFetchManifest Condition="'$(EnableFrameworkReferenceFetchManifest)' == '' and '$(MSBuildHardenedGraph)' == 'true'">true</EnableFrameworkReferenceFetchManifest>
    <EnableFrameworkPathOverride Condition="'$(EnableFrameworkPathOverride)' == '' and '$(MSBuildHardenedGraph)' == 'true'">false</EnableFrameworkPathOverride>
    <_GraphInputsConfiguration Condition="'$(MSBuildRestoreGraphInputs)' == 'true' or '$(MSBuildHardenedGraph)' == 'true'">$(Configuration)/$(Platform)/$(TargetFramework)/</_GraphInputsConfiguration>
    <_DisableNuGetRestoreTargetFrameworksOverride Condition="'$(MSBuildRestoreGraphInputs)' == 'true'">true</_DisableNuGetRestoreTargetFrameworksOverride>
    <FrameworkReferenceFetchManifestPath Condition="('$(MSBuildRestoreGraphInputs)' == 'true' or '$(EnableFrameworkReferenceFetchManifest)' == 'true') and '$(FrameworkReferenceFetchManifestPath)' == ''">$(MSBuildProjectExtensionsPath)frameworkreferences/$(_GraphInputsConfiguration)$(MSBuildProjectFile).g.props</FrameworkReferenceFetchManifestPath>
    <FrameworkReferenceFetchManifestPath Condition="'$(MSBuildRestoreGraphInputs)' == 'true' or '$(EnableFrameworkReferenceFetchManifest)' == 'true'">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(FrameworkReferenceFetchManifestPath)'))</FrameworkReferenceFetchManifestPath>
  </PropertyGroup>

  <Import Project="$(FrameworkReferenceFetchManifestPath)"
          Condition="'$(EnableFrameworkReferenceFetchManifest)' == 'true' and
                     ('$(MSBuildHardenedGraph)' != 'true' or '$(TargetFramework)' != '') and
                     '$(MSBuildIsRestoring)' != 'true' and
                     ('$(MSBuildHardenedGraph)' == 'true' or '$(MSBuildRestoreGraphInputs)' != 'true')" />

  <Import Project="$(BeforeMicrosoftNETSdkTargets)" Condition="'$(BeforeMicrosoftNETSdkTargets)' != ''"/>

  <!-- Using the same property as Microsoft.CSharp.targets and presumably Microsoft.VisualBasic.targets here -->
  <PropertyGroup Condition="'$(TargetFrameworks)' != '' and '$(TargetFramework)' == ''">
    <IsCrossTargetingBuild>true</IsCrossTargetingBuild>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\targets\Microsoft.NET.Sdk.BeforeCommonCrossTargeting.targets"
          Condition="'$(IsCrossTargetingBuild)' == 'true'"/>
  <Import Project="$(MSBuildThisFileDirectory)..\targets\Microsoft.NET.Sdk.BeforeCommon.targets"
          Condition="'$(IsCrossTargetingBuild)' != 'true'"/>

  <PropertyGroup Condition="'$(LanguageTargets)' == ''">
    <LanguageTargets Condition="'$(MSBuildProjectExtension)' == '.csproj'">$(MSBuildToolsPath)\Microsoft.CSharp.targets</LanguageTargets>
    <LanguageTargets Condition="'$(MSBuildProjectExtension)' == '.vbproj'">$(MSBuildToolsPath)\Microsoft.VisualBasic.targets</LanguageTargets>
    <LanguageTargets Condition="'$(MSBuildProjectExtension)' == '.fsproj'">$(MSBuildThisFileDirectory)..\targets\Microsoft.NET.Sdk.FSharpTargetsShim.targets</LanguageTargets>

    <!-- If LanguageTargets isn't otherwise set, then just import the common targets.  This should allow the restore target to run,
         which could bring in NuGet packages that set the LanguageTargets to something else.  This means support for different
         languages could either be supplied via an SDK or via a NuGet package. -->
    <LanguageTargets Condition="'$(LanguageTargets)' == ''">$(MSBuildToolsPath)\Microsoft.Common.targets</LanguageTargets>
  </PropertyGroup>

  <!-- REMARK: Dont remove/rename, the LanguageTargets property is used by F# to hook inside the project's sdk
               using Sdk attribute (from .NET Core Sdk 1.0.0-preview4) -->
  <Import Project="$(LanguageTargets)"/>

  <Import Project="$(MSBuildThisFileDirectory)..\targets\Microsoft.NET.Sdk.CrossTargeting.targets"
          Condition="'$(IsCrossTargetingBuild)' == 'true'"/>
  <Import Project="$(MSBuildThisFileDirectory)..\targets\Microsoft.NET.Sdk.targets"
          Condition="'$(IsCrossTargetingBuild)' != 'true'"/>

  <Import Project="$(MSBuildThisFileDirectory)..\targets\Microsoft.NET.ApiCompat.targets" />

  <Import Project="$(MSBuildThisFileDirectory)..\targets\Microsoft.NET.NuGetInputs.targets"
          Condition="'$(MSBuildHardenedGraph)' == 'true' and '$(IsCrossTargetingBuild)' != 'true'" />

  <!-- Import targets from NuGet.Build.Tasks.Pack package/Sdk -->
  <PropertyGroup Condition="'$(NuGetBuildTasksPackTargets)' == '' AND '$(ImportNuGetBuildTasksPackTargetsFromSdk)' != 'false'">
    <NuGetBuildTasksPackTargets>$(MSBuildThisFileDirectory)..\..\..\NuGet.Build.Tasks.Pack.targets</NuGetBuildTasksPackTargets>
    <ImportNuGetBuildTasksPackTargetsFromSdk>true</ImportNuGetBuildTasksPackTargetsFromSdk>
  </PropertyGroup>

  <Import Project="$(NuGetBuildTasksPackTargets)"
          Condition="Exists('$(NuGetBuildTasksPackTargets)') AND '$(ImportNuGetBuildTasksPackTargetsFromSdk)' == 'true'"/>

  <!-- Import targets from Microsoft.NET.Build.Container.targets -->
  <PropertyGroup>
    <_IsNotSetContainersTargetsDir>false</_IsNotSetContainersTargetsDir>
    <_IsNotSetContainersTargetsDir Condition=" '$(_ContainersTargetsDir)'=='' ">true</_IsNotSetContainersTargetsDir>
    <_ContainersTargetsDir Condition="$(_IsNotSetContainersTargetsDir)">$(MSBuildThisFileDirectory)..\..\..\Containers\build\</_ContainersTargetsDir>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\..\Containers\build\Microsoft.NET.Build.Containers.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Containers\build\Microsoft.NET.Build.Containers.props')" />

  <Import Project="$(_ContainersTargetsDir)Microsoft.NET.Build.Containers.targets"
    Condition="$(_IsNotSetContainersTargetsDir) AND Exists('$(_ContainersTargetsDir)Microsoft.NET.Build.Containers.targets')" />

  <PropertyGroup>
    <MSBuildPrepareGraphInputsDependsOn>$(MSBuildPrepareGraphInputsDependsOn);_CaptureNuGetInputs;_GenerateFrameworkReferenceFetchManifest</MSBuildPrepareGraphInputsDependsOn>
    <MSBuildPrepareGraphInputsDependsOn Condition="'$(Language)' == 'C#'">$(MSBuildPrepareGraphInputsDependsOn);_CaptureCscToolInputs</MSBuildPrepareGraphInputsDependsOn>
    <_CaptureNuGetInputsDependsOn Condition="'$(MSBuildRestoreGraphInputs)' == 'true'">_ResolveCompilerVersion</_CaptureNuGetInputsDependsOn>
  </PropertyGroup>

  <UsingTask TaskName="WriteNuGetInputs" AssemblyFile="$(MicrosoftNETBuildTasksAssembly)" />

  <Target Name="_CaptureNuGetInputs"
          DependsOnTargets="$(_CaptureNuGetInputsDependsOn)"
          Condition="'$(MSBuildHardenedGraph)' != 'true'">
    <PropertyGroup>
      <_NuGetInputFile Condition="'$(ProjectAssetsFile)' == ''">$(MSBuildProjectExtensionsPath)project.assets.json</_NuGetInputFile>
      <_NuGetInputFile Condition="'$(ProjectAssetsFile)' != ''">$(ProjectAssetsFile)</_NuGetInputFile>
      <_NuGetInputFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_NuGetInputFile)'))</_NuGetInputFile>
      <NuGetInputsPath Condition="'$(NuGetInputsPath)' == ''">$(MSBuildProjectExtensionsPath)nugetinputs/$(_GraphInputsConfiguration)$(MSBuildProjectFile).g.props</NuGetInputsPath>
      <NuGetInputsPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(NuGetInputsPath)'))</NuGetInputsPath>
    </PropertyGroup>
    <WriteNuGetInputs InputFile="$(_NuGetInputFile)" OutputFile="$(NuGetInputsPath)"
                      CapturePackageContext="$(MSBuildRestoreGraphInputs)" CompilerApiVersion="$(CompilerApiVersion)"
                      ProjectLanguage="$(Language)" />
  </Target>

  <Target Name="_PrepareNuGetAnalyzersForGraph"
          BeforeTargets="_CaptureCscToolInputs"
          DependsOnTargets="ResolveLockFileAnalyzers"
          Condition="'$(MSBuildRestoreGraphInputs)' == 'true' and '$(MSBuildHardenedGraph)' != 'true'" />

  <Target Name="_ComputeFrameworkReferenceFetchManifestProfile"
          Condition="'$(MSBuildRestoreGraphInputs)' == 'true' or '$(EnableFrameworkReferenceFetchManifest)' == 'true'">
    <PropertyGroup>
      <_FrameworkReferenceFetchManifestReferences>@(Reference, ', ')</_FrameworkReferenceFetchManifestReferences>
      <_FrameworkReferenceFetchManifestProfileSupported
        Condition="'$(IsCrossTargetingBuild)' != 'true' and
                   '$(TargetFramework)' != '' and
                   ('@(Reference->Count())' == '0' or
                    '$(MSBuildRestoreGraphInputs)' == 'true' or '$(MSBuildHardenedGraph)' == 'true') and
                   '$(RuntimeIdentifier)' == '' and
                   '$(RuntimeIdentifiers)' == ''">true</_FrameworkReferenceFetchManifestProfileSupported>
    </PropertyGroup>
  </Target>

  <Target Name="_InvalidateUnsupportedFrameworkReferenceFetchManifest"
          DependsOnTargets="_ComputeFrameworkReferenceFetchManifestProfile"
          BeforeTargets="Restore"
          Condition="'$(MSBuildHardenedGraph)' != 'true' and
                     ('$(MSBuildRestoreGraphInputs)' == 'true' or
                      ('$(EnableFrameworkReferenceFetchManifest)' == 'true' and '$(MSBuildIsRestoring)' == 'true'))">
    <Delete Files="$(FrameworkReferenceFetchManifestPath)"
            Condition="'$(_FrameworkReferenceFetchManifestProfileSupported)' != 'true'" />
  </Target>

  <Target Name="_ReportUnsupportedFrameworkReferenceFetchManifestProfile"
          DependsOnTargets="_ComputeFrameworkReferenceFetchManifestProfile"
          Condition="'$(_FrameworkReferenceFetchManifestProfileSupported)' != 'true'">
    <NETSdkError
      Condition="'$(IsCrossTargetingBuild)' == 'true' or '$(TargetFramework)' == ''"
      ResourceName="FrameworkReferenceFetchManifestUnsupportedInput"
      FormatArguments="TargetFrameworks;$([MSBuild]::Escape('$(TargetFrameworks)'))"
      ContinueOnError="ErrorAndContinue" />
    <NETSdkError
      Condition="'@(Reference)' != '' and
                 '$(MSBuildRestoreGraphInputs)' != 'true' and '$(MSBuildHardenedGraph)' != 'true'"
      ResourceName="FrameworkReferenceFetchManifestUnsupportedInput"
      FormatArguments="Reference;$([MSBuild]::Escape('$(_FrameworkReferenceFetchManifestReferences)'))"
      ContinueOnError="ErrorAndContinue" />
    <NETSdkError
      Condition="'$(RuntimeIdentifier)' != ''"
      ResourceName="FrameworkReferenceFetchManifestUnsupportedInput"
      FormatArguments="RuntimeIdentifier;$([MSBuild]::Escape('$(RuntimeIdentifier)'))"
      ContinueOnError="ErrorAndContinue" />
    <NETSdkError
      Condition="'$(RuntimeIdentifiers)' != ''"
      ResourceName="FrameworkReferenceFetchManifestUnsupportedInput"
      FormatArguments="RuntimeIdentifiers;$([MSBuild]::Escape('$(RuntimeIdentifiers)'))"
      ContinueOnError="ErrorAndContinue" />
    <NETSdkError
      Condition="'$(_FrameworkReferenceFetchManifestProfileSupported)' != 'true'"
      ResourceName="FrameworkReferenceFetchManifestUnsupportedProfile" />
  </Target>

  <Target Name="_ValidateFrameworkReferenceFetchManifestProfileForRestore"
          DependsOnTargets="_InvalidateUnsupportedFrameworkReferenceFetchManifest;_ReportUnsupportedFrameworkReferenceFetchManifestProfile"
          BeforeTargets="ProcessFrameworkReferences;Restore"
          Condition="'$(MSBuildHardenedGraph)' != 'true' and
                     (('$(MSBuildRestoreGraphInputs)' == 'true' and '$(IsCrossTargetingBuild)' == 'true') or
                      ('$(MSBuildRestoreGraphInputs)' != 'true' and '$(EnableFrameworkReferenceFetchManifest)' == 'true' and '$(MSBuildIsRestoring)' == 'true'))" />

  <Target Name="_ValidateImportedFrameworkReferenceFetchManifestProfile"
          DependsOnTargets="_ReportUnsupportedFrameworkReferenceFetchManifestProfile"
          BeforeTargets="_CheckForInvalidConfigurationAndPlatform;Build"
          Condition="'$(_UsingFrameworkReferenceManifest)' == 'true'" />
</Project>
