<Project>
  <!-- SDK hardened builds use the same facts as explicitly imported asset views. -->
  <PropertyGroup>
    <NuGetInputsPath Condition="'$(NuGetInputsPath)' == ''">$(MSBuildProjectExtensionsPath)nugetinputs/$(MSBuildProjectFile).g.props</NuGetInputsPath>
    <NuGetInputsPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(NuGetInputsPath)'))</NuGetInputsPath>
  </PropertyGroup>
  <Import Project="$(NuGetInputsPath)" />
  <PropertyGroup Condition="'$(MSBuildHardenedGraph)' == 'true' and '$(CompilerApiVersion)' == ''">
    <CompilerApiVersion>$(_NuGetCompilerApiVersion)</CompilerApiVersion>
  </PropertyGroup>
  <UsingTask TaskName="ReadNuGetAssets" AssemblyFile="$(MicrosoftNETBuildTasksAssembly)" />
  <Target Name="_ReadNuGetAssets">
    <ReadNuGetAssets FormatVersion="$(_NuGetInputsFormatVersion)"
                    Facts="@(_NuGetInput)"
                    TargetName="$(NuGetAssetsTarget)"
                    DeclaredInputs="" DeclaredOutputs="">
      <Output TaskParameter="Libraries" ItemName="_NuGetTargetLibrary" />
      <Output TaskParameter="Assets" ItemName="_NuGetTargetAsset" />
      <Output TaskParameter="Dependencies" ItemName="_NuGetTargetDependency" />
      <Output TaskParameter="Files" ItemName="_NuGetLibraryFile" />
    </ReadNuGetAssets>
  </Target>
</Project>
