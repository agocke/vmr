<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <PackageVersion Condition="'$(GenBuildTaskPackageVersion)' != ''">$(GenBuildTaskPackageVersion)</PackageVersion>
    <GenBuildMSBuildArtifactsDirectory Condition="'$(GenBuildMSBuildArtifactsDirectory)' == ''">$(MSBuildThisFileDirectory)../src/msbuild/artifacts/</GenBuildMSBuildArtifactsDirectory>
    <GenBuildRoslynArtifactsDirectory Condition="'$(GenBuildRoslynArtifactsDirectory)' == ''">$(MSBuildThisFileDirectory)../src/roslyn/artifacts/</GenBuildRoslynArtifactsDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GenBuildAppArtifactsDirectory)' != ''">
    <BaseIntermediateOutputPath>$(GenBuildAppArtifactsDirectory)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(GenBuildAppArtifactsDirectory)bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
