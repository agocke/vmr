<Project DefaultTargets="Build">
  <PropertyGroup>
    <TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>
    <_TargetFrameworkVersionWithoutV>11.0</_TargetFrameworkVersionWithoutV>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>exe</OutputType>
    <Deterministic Condition="'$(Deterministic)' == ''">true</Deterministic>
    <DeterministicSourcePaths Condition="'$(DeterministicSourcePaths)' == ''">true</DeterministicSourcePaths>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <UseSharedCompilation>false</UseSharedCompilation>
    <DebugType Condition="'$(DebugType)' == ''">portable</DebugType>
    <IntermediateOutputPath>obj/</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/</MSBuildProjectExtensionsPath>
    <DefineConstants Condition="'$(TestCase)' == 'compiler-error'">BROKEN</DefineConstants>
    <CompilerResponseFile Condition="'$(TestCase)' == 'response'">override.rsp</CompilerResponseFile>
    <CompilerGeneratedFilesOutputPath Condition="'$(TestCase)' == 'generated-directory'">generated/</CompilerGeneratedFilesOutputPath>
    <EmitCompilerGeneratedFiles Condition="'$(TestCase)' == 'generated-directory'">true</EmitCompilerGeneratedFiles>
    <SourceLink>obj/source-link.json</SourceLink>
    <_CompilerDirectory>$(MSBuildSDKsPath)/../Roslyn/</_CompilerDirectory>
    <_SourceLinkText>{"documents":{"/_/*":"https://example.invalid/repository/*"}}</_SourceLinkText>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestCase)' == 'signed'">
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>obj/public.snk</AssemblyOriginatorKeyFile>
    <_SigningTarget>ResolveKeySource</_SigningTarget>
  </PropertyGroup>
  <PropertyGroup Condition="$(TestCase.StartsWith('resource-'))">
    <DefineConstants>$(DefineConstants);RESOURCE_TEST</DefineConstants>
    <_ResourceTargets>CoreResGen;_GenerateCompileInputs</_ResourceTargets>
    <GenerateResourceMSBuildRuntime>CurrentRuntime</GenerateResourceMSBuildRuntime>
    <GenerateResourceMSBuildArchitecture>CurrentArchitecture</GenerateResourceMSBuildArchitecture>
    <UseSourcePath>true</UseSourcePath>
    <ResGenExecuteAsTool>false</ResGenExecuteAsTool>
    <ResGenExecuteAsTool Condition="'$(TestCase)' == 'resource-tool'">true</ResGenExecuteAsTool>
    <GenerateResourceMSBuildRuntime Condition="'$(TestCase)' == 'resource-runtime'">CLR2</GenerateResourceMSBuildRuntime>
    <GenerateResourceMSBuildArchitecture Condition="'$(TestCase)' == 'resource-architecture'">x86</GenerateResourceMSBuildArchitecture>
    <GenerateResourceUsePreserializedResources Condition="'$(TestCase)' == 'resource-preserialized'">true</GenerateResourceUsePreserializedResources>
    <_ResourceData>&lt;root&gt;&lt;data name="Greeting" xml:space="preserve"&gt;&lt;value&gt; inline &amp;amp%3B generated &lt;/value&gt;&lt;/data&gt;&lt;/root&gt;</_ResourceData>
    <_ResourceData Condition="'$(TestCase)' == 'resource-linked'">&lt;root&gt;&lt;data name="Greeting" type="System.Resources.ResXFileRef, System.Windows.Forms"&gt;&lt;value&gt;undeclared.txt%3BSystem.String, mscorlib, Version=4.0.0.0&lt;/value&gt;&lt;/data&gt;&lt;/root&gt;</_ResourceData>
    <_ResourceData Condition="'$(TestCase)' == 'resource-typed'">&lt;root&gt;&lt;data name="Greeting" type="System.Int32, mscorlib"&gt;&lt;value&gt;42&lt;/value&gt;&lt;/data&gt;&lt;/root&gt;</_ResourceData>
  </PropertyGroup>
  <UsingTask TaskName="Microsoft.CodeAnalysis.BuildTasks.Csc" AssemblyFile="$(_CompilerDirectory)Microsoft.Build.Tasks.CodeAnalysis.dll" />
  <Import Project="$(_CompilerDirectory)Microsoft.CSharp.Core.targets" />
  <Import Project="FrameworkInputs.props" />
  <Import Project="Signing.targets" Condition="'$(TestCase)' == 'signed'" />
  <Import Project="Resources.targets" Condition="$(TestCase.StartsWith('resource-'))" />
  <ItemGroup>
    <SourceRoot Include="$(MSBuildProjectDirectory)/../" SourceControl="git" />
    <Compile Include="Program.cs;obj/Generated.cs" />
    <IntermediateAssembly Include="obj/Hello.dll" />
    <IntermediateRefAssembly Include="obj/ref/Hello.dll" />
    <ReferencePathWithRefAssemblies Include="@(_FrameworkReferenceManifestCompileReference)" />
    <Analyzer Include="@(_FrameworkReferenceManifestFrameworkReference->'%(TargetingPackPath)/analyzers/dotnet/cs/System.Text.RegularExpressions.Generator.dll')" />
    <Analyzer Include="$(MSBuildSDKsPath)/Microsoft.NET.Sdk/analyzers/Microsoft.CodeAnalysis.NetAnalyzers.dll;$(MSBuildSDKsPath)/Microsoft.NET.Sdk/analyzers/Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll" />
  </ItemGroup>
  <ItemGroup Condition="$(TestCase.StartsWith('resource-'))">
    <EmbeddedResource Include="obj/Strings.resx" Type="Resx" WithCulture="false" ManifestResourceName="ResourceRoot.Strings">
      <StronglyTypedLanguage Condition="'$(TestCase)' == 'resource-source'">C#</StronglyTypedLanguage>
    </EmbeddedResource>
    <EmbeddedResource Include="obj/Strings.fr.resx" Type="Resx" WithCulture="true" Culture="fr" ManifestResourceName="ResourceRoot.Strings.fr" />
  </ItemGroup>
  <Target Name="_BeforeVBCSCoreCompile" DependsOnTargets="$(_SigningTarget);$(_ResourceTargets)" />
  <Target Name="PrepareForBuild" />
  <Target Name="ResolvePackageAssets" />
  <Target Name="ResolveTargetingPackAssets" />
  <Target Name="Produce">
    <WriteLinesToFile File="%(EmbeddedResource.Identity)" Lines="$(_ResourceData)"
                      Overwrite="true" Encoding="UTF-8" DeclaredInputs="" DeclaredOutputs="%(EmbeddedResource.Identity)"
                      Condition="$(TestCase.StartsWith('resource-'))" />
    <CopyFiles SourceFiles="public.snk" DestinationFiles="obj/public.snk"
               DeclaredInputs="public.snk" DeclaredOutputs="obj/public.snk"
               Condition="'$(TestCase)' == 'signed'" />
    <WriteLinesToFile File="obj/Generated.cs"
                      Lines="public static class Producer { public const string Text = &quot;generated before compilation&quot;%3B }"
                      Overwrite="true" Encoding="UTF-8" DeclaredInputs="" DeclaredOutputs="obj/Generated.cs" />
    <WriteLinesToFile File="$(SourceLink)" Lines="$(_SourceLinkText)"
                      Overwrite="true" Encoding="UTF-8" DeclaredInputs="" DeclaredOutputs="$(SourceLink)" />
  </Target>
  <Target Name="Build" DependsOnTargets="_SetPathMapFromSourceRoots;Produce;CoreCompile" />
  <Target Name="Restore">
    <MakeDir Directories="obj/ref" />
  </Target>
</Project>
