<Project DefaultTargets="Build">
  <PropertyGroup>
    <TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>
    <_TargetFrameworkVersionWithoutV>11.0</_TargetFrameworkVersionWithoutV>
    <IntermediateOutputPath>obj/$(TestCase)/</IntermediateOutputPath>
    <GenerateResourceMSBuildRuntime>CurrentRuntime</GenerateResourceMSBuildRuntime>
    <GenerateResourceMSBuildArchitecture>CurrentArchitecture</GenerateResourceMSBuildArchitecture>
    <UseSourcePath>true</UseSourcePath>
    <ResGenExecuteAsTool>false</ResGenExecuteAsTool>
    <ResourcePolicyFile Condition="'$(ResourcePolicyFile)' == ''">ResourcePolicy.props</ResourcePolicyFile>
  </PropertyGroup>
  <Import Project="ResourceDefaults.props" />
  <Import Project="$(ResourcePolicyFile)" Condition="'$(UseRuntimePolicy)' != 'false'" />
  <Import Project="ResourceCompilation.targets" />
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)Strings.resx" Type="Resx"
                      WithCulture="false" ManifestResourceName="Mono.Linker.Resources.Strings" />
    <EmbeddedResource Include="$(IntermediateOutputPath)SharedStrings.resx" Type="Resx"
                      WithCulture="false" ManifestResourceName="ILLink.Shared.SharedStrings" />
    <EmbeddedResource Include="$(IntermediateOutputPath)ImmutableStrings.resx" Type="Resx"
                      WithCulture="false" ManifestResourceName="System.Collections.Immutable.Strings" />
  </ItemGroup>
  <Target Name="Produce">
    <CopyFiles SourceFiles="inputs/Strings.resx;inputs/SharedStrings.resx;inputs/ImmutableStrings.resx"
               DestinationFiles="$(IntermediateOutputPath)Strings.resx;$(IntermediateOutputPath)SharedStrings.resx;$(IntermediateOutputPath)ImmutableStrings.resx"
               DeclaredInputs="inputs/Strings.resx;inputs/SharedStrings.resx;inputs/ImmutableStrings.resx"
               DeclaredOutputs="$(IntermediateOutputPath)Strings.resx;$(IntermediateOutputPath)SharedStrings.resx;$(IntermediateOutputPath)ImmutableStrings.resx" />
  </Target>
  <Target Name="Build" DependsOnTargets="Produce;CoreResGen" />
  <Target Name="Restore">
    <MakeDir Directories="$(IntermediateOutputPath)" />
  </Target>
</Project>
