<Project DefaultTargets="Test">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <GenBuildApp Condition="'$(GenBuildApp)' == ''">$(MSBuildThisFileDirectory)../../artifacts/bin/genbuild/$(Configuration)/genbuild.dll</GenBuildApp>
    <GenBuildTestHost Condition="'$(GenBuildTestHost)' == ''">$(DOTNET_HOST_PATH)</GenBuildTestHost>
    <_TestDirectory>$(MSBuildThisFileDirectory)../../artifacts/obj/genbuild-smoke/$([System.Guid]::NewGuid())/with spaces/</_TestDirectory>
    <_App>&quot;$(GenBuildTestHost)&quot; &quot;$(GenBuildApp)&quot;</_App>
    <_AppDirectory>$([System.IO.Path]::GetDirectoryName('$(GenBuildApp)'))</_AppDirectory>
  </PropertyGroup>
  <Target Name="Test">
    <Error Condition="!Exists('$(GenBuildApp)') or !Exists('$(GenBuildTestHost)')" Text="Build genbuild.proj first and set GenBuildTestHost to an external dotnet runtime." />
    <Error Condition="Exists('$(_AppDirectory)/shared') or Exists('$(_AppDirectory)/host') or Exists('$(_AppDirectory)/sdk')" Text="The app must not bundle a runtime or an SDK installation." />
    <MakeDir Directories="$(_TestDirectory)" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Action.proj;$(MSBuildThisFileDirectory)ProjectStyle.proj;$(MSBuildThisFileDirectory)ExecutableReferences.proj;$(MSBuildThisFileDirectory)WinMDReferences.proj;$(MSBuildThisFileDirectory)HelloWorld.csproj;$(MSBuildThisFileDirectory)HelloWorld.cs" DestinationFolder="$(_TestDirectory)" />
    <Exec Command="$(_App) --help" />
    <Exec Command="$(_App) invalid" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_InvalidExitCode" />
    </Exec>
    <Error Condition="'$(_InvalidExitCode)' == '0'" Text="Invalid commands must fail." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)missing.csproj&quot; -bl:&quot;$(_TestDirectory)missing-{}.binlog&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_MissingExitCode" />
    </Exec>
    <Error Condition="'$(_MissingExitCode)' == '0'" Text="The app must propagate MSBuild failure." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)Action.proj&quot; -bl:&quot;$(_TestDirectory)graph-{}.binlog&quot;" />
    <Error Condition="Exists('$(_TestDirectory)action.txt')" Text="Graph construction must not execute actions." />
    <Error Condition="!Exists('$(_TestDirectory)obj/genbuild/build.ninja')" Text="Graph construction did not emit the default Ninja file." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f obj/genbuild/build.ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)action.txt">
      <Output TaskParameter="Lines" ItemName="_ActionContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_ActionContents)' != 'executed outside MSBuild'" Text="The independent action host did not produce the expected contents." />
    <CallTarget Targets="TestProjectStyles" />
    <CallTarget Targets="TestExecutableReferences" />
    <CallTarget Targets="TestWinMDReferences" />
    <CallTarget Targets="TestEditorConfig" />
    <CallTarget Targets="TestFrameworkAttribute" />
    <CallTarget Targets="TestAssemblyVersion" />
    <CallTarget Targets="TestIncrementalCaches" />
    <CallTarget Targets="TestSourceLink" />
    <CallTarget Targets="TestCsc" />
    <CallTarget Targets="TestCopyOutputs" />
    <CallTarget Targets="TestCleanup" />
    <CallTarget Targets="TestDeps" />
    <CallTarget Targets="TestRuntimeConfig" />
    <PropertyGroup>
      <_SdkGraph>$([System.IO.Path]::GetFullPath('$(_TestDirectory)sdk-build.ninja'))</_SdkGraph>
      <_SdkHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_SdkHostOS>
      <_SdkHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_SdkHostOS>
      <_SdkHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_SdkHostOS>
      <_SdkHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_SdkHostOS>
      <_SdkArguments>-p:DirectoryBuildPropsPath=&quot;$(_TestDirectory)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_TestDirectory)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_TestDirectory)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_SdkHostOS)</_SdkArguments>
      <_LegacyCleanFile>$(_TestDirectory)obj/Debug/net11.0/HelloWorld.csproj.FileListAbsolute.txt</_LegacyCleanFile>
    </PropertyGroup>
    <MakeDir Directories="$(_LegacyCleanFile)" />
    <WriteLinesToFile File="$(_LegacyCleanFile).hardened.props" Lines="not an MSBuild project" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)HelloWorld.csproj&quot; $(_SdkArguments) -bl:&quot;$(_TestDirectory)restore-{}.binlog&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)obj/project.assets.json') or !Exists('$(_TestDirectory)obj/frameworkreferences/HelloWorld.csproj.g.props')" Text="SDK restore must produce assets and capture framework-reference inputs using the app's targets." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)HelloWorld.csproj&quot; $(_SdkArguments) -p:MSBuildEmitActionGraph=&quot;$(_SdkGraph)&quot; -bl:&quot;$(_TestDirectory)sdk-build-{}.binlog&quot;" />
    <Error Condition="!Exists('$(_SdkGraph)') or !Exists('$(_SdkGraph).actions') or Exists('$(_TestDirectory)obj/Debug/net11.0/HelloWorld.dll') or Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.dll') or Exists('$(_TestDirectory)obj/Debug/net11.0/.NETCoreApp,Version=v11.0.AssemblyAttributes.cs')"
           Text="SDK Build must emit its graph without executing product actions." />
    <ReadLinesFromFile File="$(_LegacyCleanFile).hardened.props">
      <Output TaskParameter="Lines" PropertyName="_LegacyCleanSnapshot" />
    </ReadLinesFromFile>
    <Error Condition="'$(_LegacyCleanSnapshot)' != 'not an MSBuild project' or $([System.IO.File]::ReadAllText('$(_SdkGraph)').Contains('FileListAbsolute.txt'))"
           Text="Restore and graph construction must ignore obsolete clean snapshots and ledger state." />
    <XmlPeek XmlInputPath="$(_TestDirectory)obj/frameworkreferences/HelloWorld.csproj.g.props" Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_CompileReference" />
    </XmlPeek>
    <Error Condition="'@(_CompileReference)' == ''" Text="Restore did not capture compiler reference inputs." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;$(_SdkGraph)&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.dll') or !Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.pdb') or !Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.deps.json') or !Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.runtimeconfig.json')"
           Text="Independent SDK graph execution must publish its assembly, symbols and runtime manifests." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)bin/Debug/net11.0/HelloWorld.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SdkProgramOutput" />
    </Exec>
    <Error Condition="'@(_SdkProgramOutput)' != 'Hello from genbuild.'" Text="The program built by the SDK action graph did not run correctly on the external runtime." />
    <CallTarget Targets="TestProjectReferences" />
    <WriteLinesToFile File="$(_TestDirectory)compile.rsp" Lines="@(_CompileReference->'-r:&quot;%(Identity)&quot;');&quot;$(_TestDirectory)HelloWorld.cs&quot;" Overwrite="true" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; --roll-forward Major &quot;$(_AppDirectory)/toolset/Roslyn/bincore/csc.dll&quot; -noconfig -nostdlib+ -target:exe -out:&quot;$(_TestDirectory)HelloWorld.dll&quot; @&quot;$(_TestDirectory)compile.rsp&quot;" />
    <Copy SourceFiles="$(_AppDirectory)/genbuild.runtimeconfig.json" DestinationFiles="$(_TestDirectory)HelloWorld.runtimeconfig.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)HelloWorld.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_ProgramOutput" />
    </Exec>
    <Error Condition="'@(_ProgramOutput)' != 'Hello from genbuild.'" Text="The program compiled with the packaged compiler did not run correctly on the external runtime." />
    <Message Importance="high" Text="genbuild smoke checks passed: CLI failures, graph-only construction, independent execution, project-style classification, duplicate-item, executable-reference and WinMD validation, editorconfig and framework attribute generation, assembly version derivation, cache-free assembly generation, source-root mapping and SourceLink publication, SDK restore, cleanup-free Build graph execution and program startup, packaged compiler execution, assembly/reference/PDB copying, dependency-manifest and runtime-config publication, cross-project action graphs, SDK project-closure preparation, child framework metadata, source-built NuGet framework selection and native-manifest metadata queries. $(_TestDirectory)" />
  </Target>
  <Target Name="TestProjectReferences">
    <PropertyGroup>
      <_ProjectReferenceRoot>$(_TestDirectory)project-references/</_ProjectReferenceRoot>
      <_ProjectReferenceGraph>$([System.IO.Path]::GetFullPath('$(_ProjectReferenceRoot)build.ninja'))</_ProjectReferenceGraph>
      <_ProjectReferenceHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_ProjectReferenceHostOS>
      <_ProjectReferenceHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_ProjectReferenceHostOS>
      <_ProjectReferenceHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_ProjectReferenceHostOS>
      <_ProjectReferenceHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_ProjectReferenceHostOS>
      <_ProjectReferenceArguments>-p:DirectoryBuildPropsPath=&quot;$(_TestDirectory)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_TestDirectory)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_TestDirectory)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_ProjectReferenceHostOS)</_ProjectReferenceArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_ProjectReferenceRoot)App;$(_ProjectReferenceRoot)Library" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/Actions.proj;$(MSBuildThisFileDirectory)ProjectReference/Metadata.proj;$(MSBuildThisFileDirectory)ProjectReference/FrameworkSelection.proj" DestinationFolder="$(_ProjectReferenceRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/Library/Actions.proj;$(MSBuildThisFileDirectory)ProjectReference/Library/Library.csproj;$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs" DestinationFolder="$(_ProjectReferenceRoot)Library" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/App/App.csproj;$(MSBuildThisFileDirectory)ProjectReference/App/Program.cs" DestinationFolder="$(_ProjectReferenceRoot)App" />
    <Exec Command="$(_App) restore &quot;$(_ProjectReferenceRoot)App/App.csproj&quot; $(_ProjectReferenceArguments) -bl:&quot;$(_ProjectReferenceRoot)restore.binlog&quot;" />
    <Error Condition="!Exists('$(_ProjectReferenceRoot)App/obj/project.assets.json') or !Exists('$(_ProjectReferenceRoot)Library/obj/project.assets.json') or !Exists('$(_ProjectReferenceRoot)App/obj/frameworkreferences/App.csproj.g.props') or !Exists('$(_ProjectReferenceRoot)Library/obj/frameworkreferences/Library.csproj.g.props') or !Exists('$(_ProjectReferenceRoot)App/obj/cscinputs/App.csproj.g.props') or !Exists('$(_ProjectReferenceRoot)Library/obj/cscinputs/Library.csproj.g.props')"
           Text="SDK Restore must prepare framework/compiler inputs throughout the project-reference closure." />
    <Error Condition="Exists('$(_ProjectReferenceRoot)App/bin') or Exists('$(_ProjectReferenceRoot)Library/bin') or Exists('$(_ProjectReferenceRoot)App/obj/Debug/net11.0/App.dll') or Exists('$(_ProjectReferenceRoot)Library/obj/Debug/net11.0/Library.dll')"
           Text="Project-reference preparation must not prebuild referenced assemblies." />
    <Exec Command="$(_App) restore &quot;$(_ProjectReferenceRoot)Metadata.proj&quot; -t:Build $(_ProjectReferenceArguments) -p:MetadataFile=ordinary-metadata.txt -bl:&quot;$(_ProjectReferenceRoot)ordinary-metadata.binlog&quot;" />
    <Exec Command="$(_App) build &quot;$(_ProjectReferenceRoot)Metadata.proj&quot; $(_ProjectReferenceArguments) -p:MetadataFile=metadata.txt -p:MSBuildEmitActionGraph=&quot;$(_ProjectReferenceRoot)metadata.ninja&quot; -bl:&quot;$(_ProjectReferenceRoot)metadata.binlog&quot;" />
    <Error Condition="Exists('$(_ProjectReferenceRoot)metadata.txt') or Exists('$(_ProjectReferenceRoot)Library/bin') or $([System.IO.Directory]::GetFiles('$(_ProjectReferenceRoot)metadata.ninja.actions', '*.json').Length) != '1'"
           Text="SDK target-framework metadata must be computed during construction without child file actions." />
    <Exec WorkingDirectory="$(_ProjectReferenceRoot)" Command="ninja -f metadata.ninja" />
    <PropertyGroup>
      <_ProjectReferenceMetadataBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_ProjectReferenceRoot)metadata.txt'))))</_ProjectReferenceMetadataBytes>
      <_ProjectReferenceOrdinaryMetadataBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_ProjectReferenceRoot)ordinary-metadata.txt'))))</_ProjectReferenceOrdinaryMetadataBytes>
    </PropertyGroup>
    <Error Condition="'$(_ProjectReferenceMetadataBytes)' != '$(_ProjectReferenceOrdinaryMetadataBytes)'"
           Text="SDK target-framework metadata returned to parent construction must match ordinary execution." />
    <CallTarget Targets="TestFrameworkSelection" />
    <CallTarget Targets="TestNativeManifest" />
    <Exec Command="$(_App) build &quot;$(_ProjectReferenceRoot)Actions.proj&quot; -p:MSBuildEmitActionGraph=&quot;$(_ProjectReferenceGraph)&quot; -bl:&quot;$(_ProjectReferenceRoot)build.binlog&quot;" />
    <Error Condition="Exists('$(_ProjectReferenceRoot)out/application.txt') or Exists('$(_ProjectReferenceRoot)Library/out/library.txt') or Exists('$(_ProjectReferenceRoot)Library/obj/genbuild/build.ninja')"
           Text="Child requests must contribute actions to the root graph without executing or publishing their own graph." />
    <Error Condition="$([System.IO.Directory]::GetFiles('$(_ProjectReferenceGraph).actions', '*.json').Length) != '2'"
           Text="Repeated child targets must contribute their producer exactly once." />
    <Exec WorkingDirectory="$(_ProjectReferenceRoot)" Command="ninja -f &quot;$(_ProjectReferenceGraph)&quot;" />
    <ReadLinesFromFile File="$(_ProjectReferenceRoot)out/application.txt">
      <Output TaskParameter="Lines" PropertyName="_ProjectReferenceContents" />
    </ReadLinesFromFile>
    <Error Condition="'$(_ProjectReferenceContents)' != 'Hello from a child project.'"
           Text="The root action must consume the independently generated child artifact." />
    <PropertyGroup>
      <_ProjectReferenceBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_ProjectReferenceRoot)out/application.txt'))))</_ProjectReferenceBytes>
    </PropertyGroup>
    <Exec Command="$(_App) restore &quot;$(_ProjectReferenceRoot)Actions.proj&quot; -t:Build -bl:&quot;$(_ProjectReferenceRoot)ordinary.binlog&quot;" />
    <PropertyGroup>
      <_ProjectReferenceOrdinaryBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_ProjectReferenceRoot)out/application.txt'))))</_ProjectReferenceOrdinaryBytes>
    </PropertyGroup>
    <Error Condition="'$(_ProjectReferenceBytes)' != '$(_ProjectReferenceOrdinaryBytes)'"
           Text="Independent project-reference outputs must match ordinary execution." />
  </Target>
  <Target Name="TestFrameworkSelection">
    <PropertyGroup>
      <_FrameworkSelectionRoot>$(_TestDirectory)project-references/</_FrameworkSelectionRoot>
    </PropertyGroup>
    <ItemGroup>
      <_FrameworkSelectionCase Include="exact" Expected="net8.0" />
      <_FrameworkSelectionCase Include="nearest" Expected="net7.0" />
      <_FrameworkSelectionCase Include="alias" Expected="second" />
      <_FrameworkSelectionCase Include="platform" Expected="desktop" />
      <_FrameworkSelectionCase Include="fallback" Expected="net461" />
      <_FrameworkSelectionCase Include="unspecified" Expected="" />
      <_FrameworkSelectionFailure Include="incompatible;invalid" />
    </ItemGroup>
    <Exec Command="$(_App) restore &quot;$(_FrameworkSelectionRoot)FrameworkSelection.proj&quot; -t:Build -p:Case=%(_FrameworkSelectionCase.Identity) -p:ResultFile=%(_FrameworkSelectionCase.Identity)-ordinary.txt -bl:&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity)-ordinary.binlog&quot;" />
    <Exec Command="$(_App) build &quot;$(_FrameworkSelectionRoot)FrameworkSelection.proj&quot; -p:Case=%(_FrameworkSelectionCase.Identity) -p:ResultFile=%(_FrameworkSelectionCase.Identity).txt -p:MSBuildEmitActionGraph=&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).ninja&quot; -bl:&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).binlog&quot;" />
    <Error Condition="Exists('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).txt') or Exists('$(_FrameworkSelectionRoot)missing') or $([System.IO.Directory]::GetFiles('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).ninja.actions', '*.json').Length) != '1'"
           Text="Framework selection must use supplied metadata without inspecting referenced project files or publishing content." />
    <Exec WorkingDirectory="$(_FrameworkSelectionRoot)" Command="ninja -f %(_FrameworkSelectionCase.Identity).ninja" />
    <ItemGroup>
      <_FrameworkSelectionCase>
        <ActualBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).txt'))))</ActualBytes>
        <OrdinaryBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity)-ordinary.txt'))))</OrdinaryBytes>
        <ContainsExpected>$([System.IO.File]::ReadAllText('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).txt').Contains('|%(_FrameworkSelectionCase.Expected)|literal;value'))</ContainsExpected>
      </_FrameworkSelectionCase>
    </ItemGroup>
    <Error Condition="'%(_FrameworkSelectionCase.ActualBytes)' != '%(_FrameworkSelectionCase.OrdinaryBytes)'"
           Text="Independent framework selection must preserve ordinary assigned metadata." />
    <Error Condition="'%(_FrameworkSelectionCase.ContainsExpected)' != 'true'"
           Text="Framework selection did not return the expected nearest target alias and original metadata." />
    <Exec Command="$(_App) build &quot;$(_FrameworkSelectionRoot)FrameworkSelection.proj&quot; -p:Case=%(_FrameworkSelectionFailure.Identity) -p:ResultFile=%(_FrameworkSelectionFailure.Identity).txt -p:MSBuildEmitActionGraph=&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).ninja&quot; -bl:&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_FrameworkSelectionFailureExitCode" />
    </Exec>
    <Error Condition="'%(_FrameworkSelectionFailureExitCode.Identity)' == '0'"
           Text="Invalid or incompatible frameworks must fail." />
    <Error Condition="Exists('$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).ninja') or Exists('$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).ninja.actions') or Exists('$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).txt')"
           Text="Invalid or incompatible frameworks must fail without publishing partial action graphs or content." />
  </Target>
  <Target Name="TestNativeManifest">
    <PropertyGroup>
      <_NativeManifestRoot>$(_TestDirectory)native-manifest/</_NativeManifestRoot>
    </PropertyGroup>
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='GetNativeManifest']">
      <Output TaskParameter="Result" PropertyName="_NativeManifestXml" />
    </XmlPeek>
    <Error Condition="'$(_NativeManifestXml)' == ''" Text="The packaged native-manifest query target is missing." />
    <MakeDir Directories="$(_NativeManifestRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/NativeManifest.proj" DestinationFolder="$(_NativeManifestRoot)" />
    <WriteLinesToFile File="$(_NativeManifestRoot)NativeManifest.targets" Lines="&lt;Project&gt;;$(_NativeManifestXml);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -t:Build -p:ResultFile=ordinary-empty.txt" />
    <Exec Command="$(_App) build &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -p:ResultFile=absent.txt -p:MSBuildEmitActionGraph=&quot;$(_NativeManifestRoot)absent.ninja&quot;" />
    <Error Condition="Exists('$(_NativeManifestRoot)absent.txt') or Exists('$(_NativeManifestRoot)native.manifest')"
           Text="A native-manifest metadata query must not publish content during construction." />
    <Exec WorkingDirectory="$(_NativeManifestRoot)" Command="ninja -f absent.ninja" />
    <WriteLinesToFile File="$(_NativeManifestRoot)native.manifest" Lines="stale native manifest" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -t:Build -p:ResultFile=ordinary-stale.txt" />
    <Exec Command="$(_App) build &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -p:ResultFile=stale.txt -p:MSBuildEmitActionGraph=&quot;$(_NativeManifestRoot)stale.ninja&quot;" />
    <Error Condition="Exists('$(_NativeManifestRoot)stale.txt')" Text="A stale native manifest must not cause construction-time publication." />
    <Exec WorkingDirectory="$(_NativeManifestRoot)" Command="ninja -f stale.ninja" />
    <GetFileHash Files="$(_NativeManifestRoot)ordinary-empty.txt;$(_NativeManifestRoot)absent.txt;$(_NativeManifestRoot)stale.txt">
      <Output TaskParameter="Items" ItemName="_NativeManifestHash" />
    </GetFileHash>
    <Error Condition="'@(_NativeManifestHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Hardened queries without manifest generation must match the ordinary empty result, regardless of stale output." />
    <ReadLinesFromFile File="$(_NativeManifestRoot)ordinary-stale.txt">
      <Output TaskParameter="Lines" PropertyName="_OrdinaryNativeManifest" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_ExpectedOrdinaryNativeManifest>Native;Native.Library|$([System.IO.Path]::GetFullPath('$(_NativeManifestRoot)native.manifest'))</_ExpectedOrdinaryNativeManifest>
    </PropertyGroup>
    <Error Condition="'$(_OrdinaryNativeManifest)' != '$(_ExpectedOrdinaryNativeManifest)'"
           Text="Ordinary native-manifest queries must retain their existing output discovery." />
    <ReadLinesFromFile File="$(_NativeManifestRoot)native.manifest">
      <Output TaskParameter="Lines" PropertyName="_StaleNativeManifest" />
    </ReadLinesFromFile>
    <Error Condition="'$(_StaleNativeManifest)' != 'stale native manifest'" Text="Native-manifest metadata queries must leave old output untouched." />
    <ItemGroup>
      <_NativeManifestFailure Include="clickonce;appx;native;com" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -p:Case=%(_NativeManifestFailure.Identity) -p:ResultFile=%(_NativeManifestFailure.Identity).txt -p:MSBuildEmitActionGraph=&quot;$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).ninja&quot; -flp:&quot;LogFile=$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).log;Verbosity=quiet&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_NativeManifestFailureExitCode" />
    </Exec>
    <Error Condition="'%(_NativeManifestFailureExitCode.Identity)' == '0'" Text="Requested native-manifest discovery remains unsupported and must fail explicitly." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).log').Contains('MSB4287')) or Exists('$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).ninja') or Exists('$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).ninja.actions') or Exists('$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).txt')"
           Text="Requested native-manifest discovery must fail without partial graphs or content." />
  </Target>
  <Target Name="TestCleanup">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='IncrementalClean' or @Name='_CleanGetCurrentAndPriorFileWrites' or @Name='_CleanRecordFileWrites']">
      <Output TaskParameter="Result" ItemName="_CleanupTarget" />
    </XmlPeek>
    <Error Condition="'@(_CleanupTarget->Count())' != '3'" Text="The packaged Common targets must contain the ordinary cleanup closure." />
    <ItemGroup>
      <_CleanupCase Include="fresh;stale;obstructed;ordinary" />
      <_CleanupExecution Include="fresh;stale;obstructed" />
      <_CleanupPrior Include="stale;ordinary" />
      <_CleanupRoot Include="@(_CleanupCase->'$(_TestDirectory)cleanup/%(Identity)/')" />
    </ItemGroup>
    <MakeDir Directories="@(_CleanupRoot->'%(Identity)out');@(_CleanupRoot->'%(Identity)obj')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Cleanup.proj" DestinationFolder="%(_CleanupRoot.Identity)" />
    <WriteLinesToFile File="%(_CleanupRoot.Identity)Cleanup.targets" Lines="&lt;Project&gt;;@(_CleanupTarget);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/obj/ledger.txt"
                      Lines="$([System.IO.Path]::GetFullPath('$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/out/obsolete.txt'));$([System.IO.Path]::GetFullPath('$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/obj/obsolete.txt'))"
                      Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/out/obsolete.txt" Lines="prior output" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/obj/obsolete.txt" Lines="prior intermediate" Overwrite="true" />
    <WriteLinesToFile File="%(_CleanupRoot.Identity)out/user.txt" Lines="not an owned output" Overwrite="true" />
    <MakeDir Directories="$(_TestDirectory)cleanup/obstructed/obj/ledger.txt;$(_TestDirectory)cleanup/obstructed/obj/ledger.txt.hardened.props" />
    <ReadLinesFromFile File="$(_TestDirectory)cleanup/stale/obj/ledger.txt">
      <Output TaskParameter="Lines" PropertyName="_CleanupPriorLedger" />
    </ReadLinesFromFile>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/Cleanup.proj&quot;" />
    <Error Condition="Exists('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/out/current.txt') or Exists('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/obj/intermediate.txt')"
           Text="Cleanup-free graph construction must not execute product actions." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/obj/genbuild/build.ninja').Contains('ledger.txt'))"
           Text="Legacy cleanup state must not be a graph input or output." />
    <Exec WorkingDirectory="$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)" Command="ninja -f obj/genbuild/build.ninja" />
    <Error Condition="!Exists('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/out/current.txt') or !Exists('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/obj/intermediate.txt')"
           Text="Omitting cleanup must preserve product actions." />
    <ReadLinesFromFile File="$(_TestDirectory)cleanup/stale/obj/ledger.txt">
      <Output TaskParameter="Lines" PropertyName="_CleanupAfterLedger" />
    </ReadLinesFromFile>
    <Error Condition="'$(_CleanupAfterLedger)' != '$(_CleanupPriorLedger)' or !Exists('$(_TestDirectory)cleanup/stale/out/obsolete.txt') or !Exists('$(_TestDirectory)cleanup/stale/obj/obsolete.txt') or Exists('$(_TestDirectory)cleanup/fresh/obj/ledger.txt') or !Exists('$(_TestDirectory)cleanup/obstructed/obj/ledger.txt')"
           Text="Hardened execution must not read, reconcile, create or delete legacy cleanup state or obsolete outputs." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)cleanup/ordinary/Cleanup.proj&quot; -t:Produce,IncrementalClean" />
    <Error Condition="Exists('$(_TestDirectory)cleanup/ordinary/out/obsolete.txt') or Exists('$(_TestDirectory)cleanup/ordinary/obj/obsolete.txt')"
           Text="Ordinary builds must retain incremental cleanup." />
    <ReadLinesFromFile File="$(_TestDirectory)cleanup/ordinary/obj/ledger.txt">
      <Output TaskParameter="Lines" ItemName="_CleanupOrdinaryLedger" />
    </ReadLinesFromFile>
    <Error Condition="'@(_CleanupOrdinaryLedger->Count())' != '2' or !@(_CleanupOrdinaryLedger->AnyHaveMetadataValue('Identity', '$([System.IO.Path]::GetFullPath('$(_TestDirectory)cleanup/ordinary/out/current.txt'))')) or !@(_CleanupOrdinaryLedger->AnyHaveMetadataValue('Identity', '$([System.IO.Path]::GetFullPath('$(_TestDirectory)cleanup/ordinary/obj/intermediate.txt'))'))"
           Text="Ordinary builds must reconcile and retain the current output ledger." />
    <Error Condition="!Exists('%(_CleanupRoot.Identity)out/user.txt')"
           Text="Neither build profile may delete unowned files." />
  </Target>
  <Target Name="TestCopyOutputs">
    <MakeDir Directories="$(_TestDirectory)copies" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj" DestinationFolder="$(_TestDirectory)copies" />
    <WriteLinesToFile File="$(_TestDirectory)copies/Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)copies/Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)copies/Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)copies/HelloWorld.csproj&quot;" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets" Query="/Project/Target[@Name='CopyFilesToOutputDirectory']">
      <Output TaskParameter="Result" ItemName="_CopyOutputTarget" />
    </XmlPeek>
    <Error Condition="'@(_CopyOutputTarget->Count())' != '1'" Text="The packaged Common targets must contain build-output publication." />
    <ItemGroup>
      <_CopyCase Include="short;another longer checkout;stale;ordinary;write-failure" Mode="normal" />
      <_CopyCase Include="disabled" Mode="disabled" />
      <_CopyCase Include="skip-product" Mode="skip-product" />
      <_CopyCase Include="no-symbols" Mode="no-symbols" />
      <_CopyNegative Include="hardlink" Mode="hardlink" />
      <_CopyNegative Include="symlink" Mode="symlink" />
      <_CopyNegative Include="read-only" Mode="read-only" />
      <_CopyNegative Include="link-error" Mode="link-error" />
      <_CopyNegative Include="self-copy" Mode="self-copy" />
      <_CopyCase Include="@(_CopyNegative)" />
      <_CopyRoot Include="@(_CopyCase->'$(_TestDirectory)copies/%(Identity)/project/')" />
      <_CopyExecution Include="short;another longer checkout;stale;disabled;skip-product;no-symbols" />
    </ItemGroup>
    <MakeDir Directories="@(_CopyRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)CopyOutputs.proj;$(MSBuildThisFileDirectory)Csc.proj" DestinationFolder="%(_CopyRoot.Identity)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Csc.cs" DestinationFiles="%(_CopyRoot.Identity)Program.cs" />
    <Copy SourceFiles="$(_TestDirectory)copies/obj/frameworkreferences/HelloWorld.csproj.g.props" DestinationFiles="%(_CopyRoot.Identity)FrameworkInputs.props" />
    <WriteLinesToFile File="%(_CopyRoot.Identity)CopyOutputs.targets" Lines="&lt;Project&gt;;@(_CopyOutputTarget);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)copies/%(_CopyCase.Identity)/project/CopyOutputs.proj&quot; -p:TestCase=%(_CopyCase.Mode)" />
    <MakeDir Directories="$(_TestDirectory)copies/stale/project/out/ref;$(_TestDirectory)copies/stale/project/obj/copy.marker" />
    <WriteLinesToFile File="$(_TestDirectory)copies/stale/project/out/Hello.dll" Lines="stale main" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)copies/stale/project/out/ref/renamed.dll" Lines="stale ref" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)copies/stale/project/out/Hello.pdb" Lines="stale PDB" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)copies/%(_CopyCase.Identity)/project/CopyOutputs.proj&quot; -p:TestCase=%(_CopyCase.Mode)"
          Condition="'%(_CopyCase.Identity)' != 'ordinary' and '%(_CopyCase.Identity)' != 'hardlink' and '%(_CopyCase.Identity)' != 'symlink' and '%(_CopyCase.Identity)' != 'read-only' and '%(_CopyCase.Identity)' != 'link-error' and '%(_CopyCase.Identity)' != 'self-copy'" />
    <Error Condition="Exists('$(_TestDirectory)copies/short/project/obj/Hello.dll') or Exists('$(_TestDirectory)copies/short/project/out/Hello.dll') or Exists('$(_TestDirectory)copies/short/project/out/ref/renamed.dll') or Exists('$(_TestDirectory)copies/short/project/out/Hello.pdb')"
           Text="Build-output construction must not compile or copy any files." />
    <ReadLinesFromFile File="$(_TestDirectory)copies/stale/project/out/Hello.dll">
      <Output TaskParameter="Lines" PropertyName="_CopyStaleMain" />
    </ReadLinesFromFile>
    <Error Condition="'$(_CopyStaleMain)' != 'stale main'" Text="Copy construction must leave stale destination content untouched." />
    <Exec WorkingDirectory="$(_TestDirectory)copies/%(_CopyExecution.Identity)/project" Command="ninja -f obj/genbuild/build.ninja" />
    <MakeDir Directories="$(_TestDirectory)copies/ordinary/project/out/ref" />
    <Copy SourceFiles="$(_TestDirectory)copies/short/project/obj/Hello.dll;$(_TestDirectory)copies/short/project/obj/ref/Hello.dll;$(_TestDirectory)copies/short/project/obj/Hello.pdb"
          DestinationFiles="$(_TestDirectory)copies/ordinary/project/obj/Hello.dll;$(_TestDirectory)copies/ordinary/project/obj/ref/Hello.dll;$(_TestDirectory)copies/ordinary/project/obj/Hello.pdb" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)copies/ordinary/project/CopyOutputs.proj&quot; -t:CopyFilesToOutputDirectory -p:TestCase=normal" />
    <ItemGroup>
      <_CopyResult Include="short;another longer checkout;stale;ordinary" />
      <_CopyMainResult Include="@(_CopyResult->'$(_TestDirectory)copies/%(Identity)/project/out/Hello.dll')" />
      <_CopyRefResult Include="@(_CopyResult->'$(_TestDirectory)copies/%(Identity)/project/out/ref/renamed.dll')" />
      <_CopyPdbResult Include="@(_CopyResult->'$(_TestDirectory)copies/%(Identity)/project/out/Hello.pdb')" />
    </ItemGroup>
    <GetFileHash Files="@(_CopyMainResult)">
      <Output TaskParameter="Items" ItemName="_CopyMainHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CopyRefResult)">
      <Output TaskParameter="Items" ItemName="_CopyRefHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CopyPdbResult)">
      <Output TaskParameter="Items" ItemName="_CopyPdbHash" />
    </GetFileHash>
    <Error Condition="'@(_CopyMainHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_CopyRefHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_CopyPdbHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Relocated main/reference/PDB copies must match ordinary bytes and replace stale outputs." />
    <Error Condition="Exists('$(_TestDirectory)copies/disabled/project/out/Hello.dll') or Exists('$(_TestDirectory)copies/disabled/project/out/ref/renamed.dll') or Exists('$(_TestDirectory)copies/disabled/project/out/Hello.pdb') or Exists('$(_TestDirectory)copies/no-symbols/project/out/Hello.pdb')"
           Text="Disabled copies must not publish artifacts." />
    <Error Condition="Exists('$(_TestDirectory)copies/skip-product/project/out/Hello.dll') or Exists('$(_TestDirectory)copies/skip-product/project/out/ref/renamed.dll') or !Exists('$(_TestDirectory)copies/skip-product/project/out/Hello.pdb')"
           Text="Skipping the product must preserve independent symbol-copy selection." />
    <Error Condition="!Exists('$(_TestDirectory)copies/ordinary/project/obj/copy.marker') or !Exists('$(_TestDirectory)copies/stale/project/obj/copy.marker')"
           Text="Ordinary marker behavior and the hardened obstructing marker directory must be retained." />
    <Error Condition="'%(_CopyExecution.Identity)' != 'stale' and Exists('$(_TestDirectory)copies/%(_CopyExecution.Identity)/project/obj/copy.marker')"
           Text="Hardened copy publication must not write timestamp/cache markers." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)copies/%(_CopyNegative.Identity)/project/CopyOutputs.proj&quot; -p:TestCase=%(_CopyNegative.Mode)"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_CopyRejectedExitCode" />
    </Exec>
    <Error Condition="@(_CopyRejectedExitCode->AnyHaveMetadataValue('Identity', '0')) or Exists('$(_TestDirectory)copies/%(_CopyNegative.Identity)/project/obj/genbuild/build.ninja') or Exists('$(_TestDirectory)copies/%(_CopyNegative.Identity)/project/obj/genbuild/build.ninja.actions') or Exists('$(_TestDirectory)copies/%(_CopyNegative.Identity)/project/obj/Hello.dll')"
           Text="Unsupported copy modes must fail without a graph, action invocations or compiled output." />
    <Exec WorkingDirectory="$(_TestDirectory)copies/write-failure/project" Command="ninja -f obj/genbuild/build.ninja &quot;$([System.IO.Path]::GetFullPath('$(_TestDirectory)copies/write-failure/project/obj/Hello.dll'))&quot;" />
    <MakeDir Directories="$(_TestDirectory)copies/write-failure/project/out/Hello.dll" />
    <ItemGroup>
      <_CopyInvocationCandidate Include="$(_TestDirectory)copies/write-failure/project/obj/genbuild/build.ninja.actions/*.json" />
      <_CopyFailureInvocation Include="@(_CopyInvocationCandidate)"
                              Condition="$([System.IO.File]::ReadAllText('%(_CopyInvocationCandidate.Identity)').Contains('Microsoft.Build.Tasks.CopyFiles')) and $([System.IO.File]::ReadAllText('%(_CopyInvocationCandidate.Identity)').Contains('Hello.dll')) and !$([System.IO.File]::ReadAllText('%(_CopyInvocationCandidate.Identity)').Contains('renamed.dll'))" />
    </ItemGroup>
    <Error Condition="'@(_CopyFailureInvocation->Count())' != '1'" Text="The main-assembly copy must be an independent action." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_CopyFailureInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_CopyFailureExitCode" />
    </Exec>
    <Error Condition="'$(_CopyFailureExitCode)' == '0'" Text="Independent copy publication errors must be fatal." />
  </Target>
  <Target Name="TestRuntimeConfig">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:PropertyGroup[msb:UserRuntimeConfig or msb:GenerateProbingPathsToRuntimeConfigDevFile or msb:ProjectRuntimeConfigFilePath] | /msb:Project/msb:ItemGroup[msb:GenerateRuntimeConfigurationFilesInputs] | /msb:Project/msb:Target[@Name='GenerateBuildRuntimeConfigurationFiles' or @Name='_GenerateRuntimeConfigurationFilesInputCache']">
      <Output TaskParameter="Result" ItemName="_RuntimeConfigFragment" />
    </XmlPeek>
    <Error Condition="'@(_RuntimeConfigFragment->Count())' != '7'" Text="The packaged SDK must contain runtime-config defaults, input selection and publication." />
    <PropertyGroup>
      <_RuntimeConfigXml>@(_RuntimeConfigFragment, '')</_RuntimeConfigXml>
      <_RuntimeConfigXml>$(_RuntimeConfigXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_RuntimeConfigXml>
    </PropertyGroup>
    <ItemGroup>
      <_RuntimeConfigCase Include="short;another longer checkout;stale" Mode="generated" />
      <_RuntimeConfigCase Include="existing-template" Mode="existing-template" />
      <_RuntimeConfigCase Include="late-parameter" Mode="late-parameter" />
      <_RuntimeConfigCase Include="self-contained" Mode="self-contained" />
      <_RuntimeConfigCase Include="no-template" Mode="no-template" />
      <_RuntimeConfigCase Include="default-roll-forward" Mode="default-roll-forward" />
      <_RuntimeConfigCase Include="late-default" Mode="late-default" />
      <_RuntimeConfigCase Include="release" Mode="release" />
      <_RuntimeConfigCase Include="missing-template" Mode="missing-template" />
      <_RuntimeConfigNegative Include="deleted-template" Mode="deleted-template" />
      <_RuntimeConfigNegative Include="package-probe" Mode="package-probe" />
      <_RuntimeConfigNegative Include="absolute-template" Mode="absolute-template" />
      <_RuntimeConfigNegative Include="malformed-template" Mode="malformed-template" />
      <_RuntimeConfigNegative Include="write-failure" Mode="write-failure" />
      <_RuntimeConfigCase Include="@(_RuntimeConfigNegative)" />
      <_RuntimeConfigRoot Include="@(_RuntimeConfigCase->'$(_TestDirectory)runtime-config/%(Identity)/project/')" />
      <_RuntimeConfigOrdinary Include="generated;self-contained;no-template;default-roll-forward;release" />
      <_RuntimeConfigRoot Include="@(_RuntimeConfigOrdinary->'$(_TestDirectory)runtime-config/ordinary-%(Identity)/project/')" />
    </ItemGroup>
    <MakeDir Directories="@(_RuntimeConfigRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RuntimeConfig.proj" DestinationFiles="%(_RuntimeConfigRoot.Identity)RuntimeConfig.proj" />
    <WriteLinesToFile File="%(_RuntimeConfigRoot.Identity)RuntimeConfig.targets" Lines="&lt;Project&gt;;$(_RuntimeConfigXml);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/absolute-template/project/runtimeconfig.template.json"
                      Lines="{&quot;additionalProbingPaths&quot;:[&quot;/machine-specific/packages&quot;]}" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/malformed-template/project/runtimeconfig.template.json" Lines="not JSON" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/deleted-template/project/missing.template.json" Lines="{}" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/existing-template/project/runtimeconfig.template.json"
                      Lines="{&quot;configProperties&quot;:{&quot;setting&quot;:&quot;generated after construction&quot;,&quot;count&quot;:4,&quot;enabled&quot;:false,&quot;text&quot;:&quot;a+b&quot;}}" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)runtime-config/%(_RuntimeConfigCase.Identity)/project/RuntimeConfig.proj&quot; &quot;-p:TestCase=%(_RuntimeConfigCase.Mode)&quot;" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/late-default/project/runtimeconfig.template.json"
                      Lines="{&quot;selectedDuringEvaluation&quot;:true}" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/stale/project/out/RuntimeApp.runtimeconfig.json" Lines="old main" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/stale/project/out/RuntimeApp.runtimeconfig.dev.json" Lines="old dev" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)runtime-config/%(_RuntimeConfigCase.Identity)/project/RuntimeConfig.proj&quot; &quot;-p:TestCase=%(_RuntimeConfigCase.Mode)&quot;"
          Condition="'%(_RuntimeConfigCase.Identity)' != 'missing-template'" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)runtime-config/missing-template/project/RuntimeConfig.proj&quot; -p:TestCase=missing-template"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_MissingRuntimeConfigTemplateExitCode" />
    </Exec>
    <Error Condition="'$(_MissingRuntimeConfigTemplateExitCode)' == '0' or Exists('$(_TestDirectory)runtime-config/missing-template/project/obj/genbuild/build.ninja') or Exists('$(_TestDirectory)runtime-config/missing-template/project/obj/genbuild/build.ninja.actions')"
           Text="An explicit missing template without a producer must fail without publishing a graph." />
    <Error Condition="Exists('$(_TestDirectory)runtime-config/short/project/obj/generated.template.json') or Exists('$(_TestDirectory)runtime-config/short/project/out/RuntimeApp.runtimeconfig.json') or Exists('$(_TestDirectory)runtime-config/short/project/out/RuntimeApp.runtimeconfig.dev.json')"
           Text="Runtime-config construction must not execute template producers or JSON writers." />
    <ReadLinesFromFile File="$(_TestDirectory)runtime-config/stale/project/out/RuntimeApp.runtimeconfig.json">
      <Output TaskParameter="Lines" PropertyName="_StaleRuntimeConfigMain" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_TestDirectory)runtime-config/stale/project/out/RuntimeApp.runtimeconfig.dev.json">
      <Output TaskParameter="Lines" PropertyName="_StaleRuntimeConfigDev" />
    </ReadLinesFromFile>
    <Error Condition="'$(_StaleRuntimeConfigMain)' != 'old main' or '$(_StaleRuntimeConfigDev)' != 'old dev'" Text="Runtime-config construction must leave stale outputs untouched." />
    <ItemGroup>
      <_RuntimeConfigExecution Include="@(_RuntimeConfigCase)" Exclude="@(_RuntimeConfigNegative);missing-template" />
    </ItemGroup>
    <Exec WorkingDirectory="$(_TestDirectory)runtime-config/%(_RuntimeConfigExecution.Identity)/project" Command="ninja -f obj/genbuild/build.ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)runtime-config/ordinary-%(_RuntimeConfigOrdinary.Identity)/project/RuntimeConfig.proj&quot; -p:TestCase=%(_RuntimeConfigOrdinary.Identity)" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)runtime-config/ordinary-%(_RuntimeConfigOrdinary.Identity)/project/RuntimeConfig.proj&quot; -t:Build -p:TestCase=%(_RuntimeConfigOrdinary.Identity)" />
    <ItemGroup>
      <_RuntimeConfigRelocated Include="short;another longer checkout;stale;existing-template;late-parameter;ordinary-generated" />
      <_RuntimeConfigComparable Include="self-contained;no-template;default-roll-forward;release" />
    </ItemGroup>
    <GetFileHash Files="@(_RuntimeConfigRelocated->'$(_TestDirectory)runtime-config/%(Identity)/project/out/RuntimeApp.runtimeconfig.json')">
      <Output TaskParameter="Items" ItemName="_RuntimeConfigMainHash" />
    </GetFileHash>
    <GetFileHash Files="@(_RuntimeConfigRelocated->'$(_TestDirectory)runtime-config/%(Identity)/project/out/RuntimeApp.runtimeconfig.dev.json')">
      <Output TaskParameter="Items" ItemName="_RuntimeConfigDevHash" />
    </GetFileHash>
    <Error Condition="'@(_RuntimeConfigMainHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_RuntimeConfigDevHash->'%(FileHash)'->Distinct()->Count())' != '1'" Text="Relocated runtime-config actions must match ordinary main/dev JSON bytes." />
    <ItemGroup>
      <_RuntimeConfigPair Include="$(_TestDirectory)runtime-config/%(_RuntimeConfigComparable.Identity)/project/out/RuntimeApp.runtimeconfig.json">
        <Baseline>$(_TestDirectory)runtime-config/ordinary-%(_RuntimeConfigComparable.Identity)/project/out/RuntimeApp.runtimeconfig.json</Baseline>
      </_RuntimeConfigPair>
      <_RuntimeConfigPair Include="$(_TestDirectory)runtime-config/%(_RuntimeConfigComparable.Identity)/project/out/RuntimeApp.runtimeconfig.dev.json" Condition="'%(_RuntimeConfigComparable.Identity)' != 'release'">
        <Baseline>$(_TestDirectory)runtime-config/ordinary-%(_RuntimeConfigComparable.Identity)/project/out/RuntimeApp.runtimeconfig.dev.json</Baseline>
      </_RuntimeConfigPair>
    </ItemGroup>
    <GetFileHash Files="@(_RuntimeConfigPair)">
      <Output TaskParameter="Items" ItemName="_RuntimeConfigPairHash" />
    </GetFileHash>
    <ItemGroup>
      <_RuntimeConfigBaseline Include="%(_RuntimeConfigPairHash.Baseline)" ExpectedHash="%(_RuntimeConfigPairHash.FileHash)" />
    </ItemGroup>
    <GetFileHash Files="@(_RuntimeConfigBaseline)">
      <Output TaskParameter="Items" ItemName="_RuntimeConfigBaselineHash" />
    </GetFileHash>
    <Error Condition="'%(_RuntimeConfigBaselineHash.ExpectedHash)' != '%(_RuntimeConfigBaselineHash.FileHash)'"
           Text="Runtime-config framework/self-contained semantics must match ordinary generation." />
    <Error Condition="Exists('$(_TestDirectory)runtime-config/release/project/out/RuntimeApp.runtimeconfig.dev.json')"
           Text="Release must not publish an inactive dev config." />
    <PropertyGroup>
      <_LateRuntimeConfig>$([System.IO.File]::ReadAllText('$(_TestDirectory)runtime-config/late-default/project/out/RuntimeApp.runtimeconfig.json'))</_LateRuntimeConfig>
      <_GeneratedRuntimeConfig>$([System.IO.File]::ReadAllText('$(_TestDirectory)runtime-config/short/project/out/RuntimeApp.runtimeconfig.json'))</_GeneratedRuntimeConfig>
      <_DefaultRuntimeConfig>$([System.IO.File]::ReadAllText('$(_TestDirectory)runtime-config/default-roll-forward/project/out/RuntimeApp.runtimeconfig.json'))</_DefaultRuntimeConfig>
    </PropertyGroup>
    <Error Condition="$(_DefaultRuntimeConfig.Contains('&quot;rollForward&quot;'))"
           Text="An unset RollForward must retain the ordinary task default and remain absent from runtime configuration." />
    <Error Condition="!$(_LateRuntimeConfig.Contains('&quot;selectedDuringEvaluation&quot;: true'))"
           Text="The engine must select a default template present during fresh Build evaluation." />
    <Error Condition="!$(_GeneratedRuntimeConfig.Contains('generated after construction')) or !$(_GeneratedRuntimeConfig.Contains('&quot;count&quot;: 12')) or $(_GeneratedRuntimeConfig.Contains('$(_TestDirectory)'))"
           Text="Runtime-config execution must merge generated templates and host overrides without physical paths." />
    <MakeDir Directories="$(_TestDirectory)runtime-config/write-failure/project/out/RuntimeApp.runtimeconfig.json" />
    <Delete Files="$(_TestDirectory)runtime-config/deleted-template/project/missing.template.json" />
    <ItemGroup>
      <_RuntimeConfigInvocationCandidate Include="$(_TestDirectory)runtime-config/%(_RuntimeConfigNegative.Identity)/project/obj/genbuild/build.ninja.actions/*.json">
        <Case>%(_RuntimeConfigNegative.Identity)</Case>
      </_RuntimeConfigInvocationCandidate>
      <_RuntimeConfigFailureInvocation Include="@(_RuntimeConfigInvocationCandidate)" Condition="$([System.IO.File]::ReadAllText('%(_RuntimeConfigInvocationCandidate.Identity)').Contains('Microsoft.NET.Build.Tasks.WriteRuntimeConfig'))" />
    </ItemGroup>
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;%(_RuntimeConfigFailureInvocation.Identity)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_RuntimeConfigFailureExitCode" />
    </Exec>
    <Error Condition="'@(_RuntimeConfigFailureInvocation->Count())' != '5' or @(_RuntimeConfigFailureExitCode->AnyHaveMetadataValue('Identity', '0'))"
           Text="Invalid/missing runtime-config inputs and write failures must fail independent execution." />
    <Error Condition="Exists('$(_TestDirectory)runtime-config/%(_RuntimeConfigNegative.Identity)/project/out/RuntimeApp.runtimeconfig.dev.json')"
           Text="Invalid runtime-config actions must not publish a dev file." />
  </Target>
  <Target Name="TestDeps">
    <MakeDir Directories="$(_TestDirectory)deps" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj" DestinationFolder="$(_TestDirectory)deps" />
    <WriteLinesToFile File="$(_TestDirectory)deps/Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)deps/Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)deps/Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)deps/HelloWorld.csproj&quot;" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='GenerateBuildDependencyFile']">
      <Output TaskParameter="Result" ItemName="_DepsTarget" />
    </XmlPeek>
    <Error Condition="'@(_DepsTarget->Count())' != '1'" Text="The packaged SDK must contain GenerateBuildDependencyFile." />
    <PropertyGroup>
      <_DepsTargetXml>@(_DepsTarget)</_DepsTargetXml>
      <_DepsTargetXml>$(_DepsTargetXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_DepsTargetXml>
    </PropertyGroup>
    <ItemGroup>
      <_DepsCase Include="short;another longer checkout;stale;ordinary;missing" />
      <_DepsExecution Include="short;another longer checkout;stale" />
      <_DepsRoot Include="@(_DepsCase->'$(_TestDirectory)deps/%(Identity)/project/')" />
    </ItemGroup>
    <MakeDir Directories="@(_DepsRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Deps.proj;$(MSBuildThisFileDirectory)Csc.proj" DestinationFolder="%(_DepsRoot.Identity)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Csc.cs" DestinationFiles="%(_DepsRoot.Identity)Program.cs" />
    <Copy SourceFiles="$(_TestDirectory)deps/obj/frameworkreferences/HelloWorld.csproj.g.props" DestinationFiles="%(_DepsRoot.Identity)FrameworkInputs.props" />
    <WriteLinesToFile File="%(_DepsRoot.Identity)Deps.targets" Lines="&lt;Project&gt;;$(_DepsTargetXml);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="%(_DepsRoot.Identity)Version.cs"
                      Lines="[assembly: System.Reflection.AssemblyVersion(&quot;3.4.5.6&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;7.8.9.10&quot;)]" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)deps/%(_DepsCase.Identity)/project/Deps.proj&quot;" />
    <WriteLinesToFile File="$(_TestDirectory)deps/stale/project/out/DepsApp.deps.json" Lines="stale JSON must not survive" Overwrite="true" />
    <GetFileHash Files="$(_TestDirectory)deps/stale/project/out/DepsApp.deps.json">
      <Output TaskParameter="Hash" PropertyName="_DepsStaleBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)deps/%(_DepsCase.Identity)/project/Deps.proj&quot;" Condition="'%(_DepsCase.Identity)' != 'ordinary'" />
    <Error Condition="Exists('$(_TestDirectory)deps/%(_DepsExecution.Identity)/project/obj/Hello.dll')" Text="Deps graph construction must not execute its compiler producer." />
    <Error Condition="Exists('$(_TestDirectory)deps/short/project/out/DepsApp.deps.json') or Exists('$(_TestDirectory)deps/another longer checkout/project/out/DepsApp.deps.json')"
           Text="Deps graph construction must not write JSON." />
    <GetFileHash Files="$(_TestDirectory)deps/stale/project/out/DepsApp.deps.json">
      <Output TaskParameter="Hash" PropertyName="_DepsStaleAfter" />
    </GetFileHash>
    <Error Condition="'$(_DepsStaleBefore)' != '$(_DepsStaleAfter)'" Text="Deps graph construction must not inspect or change old output contents." />
    <Exec WorkingDirectory="$(_TestDirectory)deps/%(_DepsExecution.Identity)/project" Command="ninja -f obj/genbuild/build.ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)deps/ordinary/project/Deps.proj&quot; -t:Build" />
    <ItemGroup>
      <_DepsResult Include="@(_DepsExecution);ordinary" />
    </ItemGroup>
    <GetFileHash Files="@(_DepsResult->'$(_TestDirectory)deps/%(Identity)/project/out/DepsApp.deps.json')">
      <Output TaskParameter="Items" ItemName="_DepsHash" />
    </GetFileHash>
    <Error Condition="'@(_DepsHash->'%(FileHash)'->Distinct()->Count())' != '1'" Text="Relocated deps actions must match ordinary JSON bytes, including referenced binary versions." />
    <PropertyGroup>
      <_DepsJson>$([System.IO.File]::ReadAllText('$(_TestDirectory)deps/short/project/out/DepsApp.deps.json'))</_DepsJson>
    </PropertyGroup>
    <Error Condition="!$(_DepsJson.Contains('&quot;assemblyVersion&quot;: &quot;3.4.5.6&quot;')) or !$(_DepsJson.Contains('&quot;fileVersion&quot;: &quot;7.8.9.10&quot;')) or !$(_DepsJson.Contains('&quot;Logical.Project/2.0.0&quot;'))"
           Text="Deps actions must read generated dependency versions and retain project dependencies." />
    <Error Condition="$(_DepsJson.Contains('$(_TestDirectory)'))" Text="Deps JSON must not contain physical checkout paths." />
    <ItemGroup>
      <_DepsInvocationCandidate Include="$(_TestDirectory)deps/missing/project/obj/genbuild/build.ninja.actions/*.json" />
      <_DepsMissingInvocation Include="@(_DepsInvocationCandidate)" Condition="$([System.IO.File]::ReadAllText('%(_DepsInvocationCandidate.Identity)').Contains('Microsoft.NET.Build.Tasks.WriteDepsFile'))" />
    </ItemGroup>
    <Error Condition="'@(_DepsMissingInvocation->Count())' != '1'" Text="GenerateBuildDependencyFile must emit a single independent deps writer." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_DepsMissingInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_DepsMissingExitCode" />
    </Exec>
    <Error Condition="'$(_DepsMissingExitCode)' == '0' or Exists('$(_TestDirectory)deps/missing/project/out/DepsApp.deps.json')"
           Text="Deps execution must fail on missing declared binaries rather than emit empty versions." />
  </Target>
  <Target Name="TestCsc">
    <MakeDir Directories="$(_TestDirectory)csc" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj" DestinationFolder="$(_TestDirectory)csc" />
    <WriteLinesToFile File="$(_TestDirectory)csc/Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)csc/Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)csc/Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)csc/HelloWorld.csproj&quot;" />
    <ItemGroup>
      <_CscCase Include="short;another much longer checkout;embedded;compiler-error;ordinary;determinism;paths;response;generated-directory" />
      <_CscRoot Include="@(_CscCase->'$(_TestDirectory)csc/%(Identity)/project/')" />
      <_CscRelocation Include="short;another much longer checkout" />
      <_CscRejected Include="determinism" Arguments="-p:Deterministic=false" />
      <_CscRejected Include="paths" Arguments="-p:DeterministicSourcePaths=false" />
      <_CscRejected Include="response;generated-directory" />
    </ItemGroup>
    <MakeDir Directories="@(_CscRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Csc.proj" DestinationFiles="%(_CscRoot.Identity)Csc.proj" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Csc.cs" DestinationFiles="%(_CscRoot.Identity)Program.cs" />
    <Copy SourceFiles="$(_TestDirectory)csc/obj/frameworkreferences/HelloWorld.csproj.g.props" DestinationFiles="%(_CscRoot.Identity)FrameworkInputs.props" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)csc/%(_CscCase.Identity)/project/Csc.proj&quot;" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/%(_CscRelocation.Identity)/project/Csc.proj&quot;" />
    <Error Condition="Exists('$(_TestDirectory)csc/%(_CscRelocation.Identity)/project/obj/Generated.cs') or Exists('$(_TestDirectory)csc/%(_CscRelocation.Identity)/project/obj/Hello.dll')"
           Text="Compiler preparation must not write generated sources or compilation outputs." />
    <Exec WorkingDirectory="$(_TestDirectory)csc/%(_CscRelocation.Identity)/project" Command="ninja -f obj/genbuild/build.ninja" />
    <GetFileHash Files="@(_CscRelocation->'$(_TestDirectory)csc/%(Identity)/project/obj/Hello.dll')">
      <Output TaskParameter="Items" ItemName="_CscPeHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CscRelocation->'$(_TestDirectory)csc/%(Identity)/project/obj/Hello.pdb')">
      <Output TaskParameter="Items" ItemName="_CscPdbHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CscRelocation->'$(_TestDirectory)csc/%(Identity)/project/obj/ref/Hello.dll')">
      <Output TaskParameter="Items" ItemName="_CscRefHash" />
    </GetFileHash>
    <Error Condition="'@(_CscPeHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_CscPdbHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_CscRefHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Relocated compiler actions, including analyzers and the Regex generator, must produce identical assemblies and portable PDBs." />
    <Copy SourceFiles="$(_AppDirectory)/genbuild.runtimeconfig.json" DestinationFiles="$(_TestDirectory)csc/%(_CscRelocation.Identity)/project/obj/Hello.runtimeconfig.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)csc/short/project/obj/Hello.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CscProgramOutput" />
    </Exec>
    <Error Condition="'@(_CscProgramOutput)' != '/_/project/Program.cs;True;generated before compilation'"
           Text="Compiler actions must map CallerFilePath, execute generators and consume generated producer inputs." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/embedded/project/Csc.proj&quot; -p:DebugType=embedded" />
    <Exec WorkingDirectory="$(_TestDirectory)csc/embedded/project" Command="ninja -f obj/genbuild/build.ninja" />
    <Error Condition="Exists('$(_TestDirectory)csc/embedded/project/obj/Hello.pdb')" Text="Embedded debug information must not declare or emit a sidecar PDB." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)csc/ordinary/project/Csc.proj&quot; -t:Build" />
    <Error Condition="!Exists('$(_TestDirectory)csc/ordinary/project/obj/Hello.dll') or !Exists('$(_TestDirectory)csc/ordinary/project/obj/Hello.pdb')"
           Text="Ordinary Csc must retain its existing execution path." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/%(_CscRejected.Identity)/project/Csc.proj&quot; -p:TestCase=%(_CscRejected.Identity) %(_CscRejected.Arguments)"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_CscRejectedExitCode" />
    </Exec>
    <Error Condition="@(_CscRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Unsupported compiler modes must fail construction." />
    <Error Condition="Exists('$(_TestDirectory)csc/%(_CscRejected.Identity)/project/obj/genbuild/build.ninja') or Exists('$(_TestDirectory)csc/%(_CscRejected.Identity)/project/obj/genbuild/build.ninja.actions') or Exists('$(_TestDirectory)csc/%(_CscRejected.Identity)/project/obj/Generated.cs')"
           Text="Rejected compiler preparation must publish neither a graph nor generated files." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/compiler-error/project/Csc.proj&quot; -p:TestCase=compiler-error" />
    <Exec WorkingDirectory="$(_TestDirectory)csc/compiler-error/project" Command="ninja -f obj/genbuild/build.ninja"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_CscCompilerFailure" />
    </Exec>
    <Error Condition="'$(_CscCompilerFailure)' == '0' or Exists('$(_TestDirectory)csc/compiler-error/project/obj/Hello.dll')"
           Text="Independent compiler failures must fail execution without a successful assembly output." />
  </Target>
  <Target Name="TestSourceLink">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)SourceLink.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Roslyn/Microsoft.Managed.Core.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='InitializeSourceRootMappedPaths' or @Name='_InitializeSourceRootMappedPathsFromSourceControl' or @Name='_SetPathMapFromSourceRoots']">
      <Output TaskParameter="Result" ItemName="_SourceRootTarget" />
    </XmlPeek>
    <Error Condition="'@(_SourceRootTarget->Count())' != '3'" Text="The packaged Roslyn targets must contain source-root mapping and PathMap preparation." />
    <PropertyGroup>
      <_SourceRootXml>@(_SourceRootTarget, '')</_SourceRootXml>
      <_SourceRootXml>$(_SourceRootXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_SourceRootXml>
      <_StaleSourceLink>$(_TestDirectory)source-link/stale/SourceLink.sourcelink.json</_StaleSourceLink>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)SourceRoots.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_SourceRootXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_SourceLinkCase Include="graph" Baseline="ordinary" />
      <_SourceLinkCase Include="stale" Baseline="ordinary-stale" />
      <_SourceLinkCase Include="paths" Arguments="-p:DeterministicSourcePaths=false" Baseline="ordinary-paths" />
      <_SourceLinkCase Include="legacy-hosts" Arguments="-p:LegacyHosts=true" Baseline="ordinary-legacy-hosts" />
      <_EmptySourceLinkCase Include="empty;no-url" />
      <_RejectedSourceLinkCase Include="root-separator;nested-root;revision;host;wildcard;gitlab-version;bitbucket-version" />
    </ItemGroup>
    <MakeDir Directories="$(_TestDirectory)source-link/stale;$(_TestDirectory)source-link/empty;$(_TestDirectory)source-link/no-url" />
    <WriteLinesToFile File="$(_StaleSourceLink)" Lines="stale" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)source-link/%(_EmptySourceLinkCase.Identity)/SourceLink.sourcelink.json" Lines="unreferenced" Overwrite="true" />
    <GetFileHash Files="$(_StaleSourceLink)">
      <Output TaskParameter="Hash" PropertyName="_StaleSourceLinkBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_SourceLinkCase.Identity) %(_SourceLinkCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_SourceLinkCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)source-link/graph') or Exists('$(_TestDirectory)source-link/paths') or Exists('$(_TestDirectory)missing-source')"
           Text="Source mapping and formatting must not create outputs or require source directories during construction." />
    <GetFileHash Files="$(_StaleSourceLink)">
      <Output TaskParameter="Hash" PropertyName="_StaleSourceLinkAfter" />
    </GetFileHash>
    <Error Condition="'$(_StaleSourceLinkBefore)' != '$(_StaleSourceLinkAfter)'" Text="Construction must not rewrite stale SourceLink JSON." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f source-link-%(_SourceLinkCase.Identity).ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_SourceLinkCase.Baseline) %(_SourceLinkCase.Arguments)" />
    <GetFileHash Files="$(_TestDirectory)source-link/%(_SourceLinkCase.Identity)/SourceLink.sourcelink.json">
      <Output TaskParameter="Items" ItemName="_ExecutedSourceLinkHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)source-link/%(_SourceLinkCase.Baseline)/SourceLink.sourcelink.json">
      <Output TaskParameter="Items" ItemName="_OrdinarySourceLinkHash" />
    </GetFileHash>
    <Error Condition="'@(_ExecutedSourceLinkHash->'%(FileHash)')' != '@(_OrdinarySourceLinkHash->'%(FileHash)')'"
           Text="Independent SourceLink execution must preserve ordinary JSON bytes, escaping, ordering and encoding." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_EmptySourceLinkCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_EmptySourceLinkCase.Identity).ninja&quot;" />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f source-link-%(_EmptySourceLinkCase.Identity).ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)source-link/%(_EmptySourceLinkCase.Identity)/SourceLink.sourcelink.json">
      <Output TaskParameter="Lines" ItemName="_EmptySourceLinkContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_EmptySourceLinkContents)' != 'unreferenced;unreferenced'"
           Text="Empty hardened mappings must leave stale JSON unreferenced and unchanged." />
    <ItemGroup>
      <_EmptySourceLinkAction Include="$(_TestDirectory)source-link-empty.ninja.actions/*.json;$(_TestDirectory)source-link-no-url.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_EmptySourceLinkAction)' != ''" Text="Empty SourceLink mappings must not emit file actions." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_RejectedSourceLinkCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_RejectedSourceLinkExitCode" />
    </Exec>
    <Error Condition="@(_RejectedSourceLinkExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Invalid source-root or provider metadata must fail construction." />
    <Error Condition="Exists('$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja') or Exists('$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja.actions') or Exists('$(_TestDirectory)source-link/%(_RejectedSourceLinkCase.Identity)')"
           Text="Rejected source mapping must publish neither a partial graph nor SourceLink JSON." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=action-failure -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-action-failure.ninja&quot;" />
    <ItemGroup>
      <_SourceLinkFailureInvocation Include="$(_TestDirectory)source-link-action-failure.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_SourceLinkFailureInvocation->Count())' != '1'" Text="SourceLink generation must emit only its file writer action." />
    <MakeDir Directories="$(_TestDirectory)source-link/action-failure/SourceLink.sourcelink.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_SourceLinkFailureInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_SourceLinkFailureExitCode" />
    </Exec>
    <Error Condition="'$(_SourceLinkFailureExitCode)' == '0'" Text="SourceLink publication failures must stop independent execution." />
  </Target>
  <Target Name="TestIncrementalCaches">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)IncrementalCaches.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='_GenerateCompileDependencyCache' or @Name='_GenerateCompileInputs']">
      <Output TaskParameter="Result" ItemName="_CompileCacheTarget" />
    </XmlPeek>
    <Error Condition="'@(_CompileCacheTarget->Count())' != '2'" Text="The packaged Common targets must contain compile input preparation and its cache wrapper." />
    <WriteLinesToFile File="$(_TestDirectory)IncrementalCaches.Common.targets"
                      Lines="&lt;Project&gt;;@(_CompileCacheTarget);&lt;/Project&gt;" Overwrite="true" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='_GenerateRuntimeConfigurationFilesInputCache']">
      <Output TaskParameter="Result" ItemName="_RuntimeCacheTarget" />
    </XmlPeek>
    <Error Condition="'@(_RuntimeCacheTarget->Count())' != '1'" Text="The packaged SDK must contain the runtime configuration cache wrapper." />
    <PropertyGroup>
      <_RuntimeCacheXml>@(_RuntimeCacheTarget)</_RuntimeCacheXml>
      <_RuntimeCacheXml>$(_RuntimeCacheXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_RuntimeCacheXml>
      <_StaleAssemblyInfo>$(_TestDirectory)incremental-caches/stale/IncrementalCaches.AssemblyInfo.cs</_StaleAssemblyInfo>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)IncrementalCaches.Sdk.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_RuntimeCacheXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_IncrementalCacheCase Include="clean;stale" />
      <_IncrementalCachePath Include="IncrementalCaches.AssemblyInfoInputs.cache;IncrementalCaches.proj.CoreCompileInputs.cache;runtimeconfig.inputs.cache" />
    </ItemGroup>
    <MakeDir Directories="$(_TestDirectory)incremental-caches/stale/%(_IncrementalCachePath.Identity)" />
    <WriteLinesToFile File="$(_StaleAssemblyInfo)" Lines="// stale generated source" Overwrite="true" />
    <GetFileHash Files="$(_StaleAssemblyInfo)">
      <Output TaskParameter="Hash" PropertyName="_StaleAssemblyInfoBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)IncrementalCaches.proj&quot; -p:TestCase=%(_IncrementalCacheCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)incremental-caches/clean')" Text="Cache-free graph construction must not write outputs or create cache directories." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('AssemblyInfoInputs.cache'))
                      or $([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('CoreCompileInputs.cache'))
                      or $([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('runtimeconfig.inputs.cache'))"
           Text="Incremental timestamp caches must not appear in the emitted graph." />
    <GetFileHash Files="$(_StaleAssemblyInfo)">
      <Output TaskParameter="Hash" PropertyName="_StaleAssemblyInfoAfter" />
    </GetFileHash>
    <Error Condition="'$(_StaleAssemblyInfoBefore)' != '$(_StaleAssemblyInfoAfter)'" Text="Construction must not rewrite existing assembly info." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f incremental-caches-%(_IncrementalCacheCase.Identity).ninja" />
    <MakeDir Directories="$(_TestDirectory)incremental-caches/ordinary" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)IncrementalCaches.proj&quot; -p:TestCase=ordinary" />
    <Error Condition="!Exists('$(_TestDirectory)incremental-caches/ordinary/%(_IncrementalCachePath.Identity)')"
           Text="Ordinary builds must still create their incremental cache files." />
    <Error Condition="Exists('$(_TestDirectory)incremental-caches/clean/%(_IncrementalCachePath.Identity)')"
           Text="Independent execution must not create incremental caches." />
    <GetFileHash Files="$(_TestDirectory)incremental-caches/clean/IncrementalCaches.AssemblyInfo.cs;$(_StaleAssemblyInfo);$(_TestDirectory)incremental-caches/ordinary/IncrementalCaches.AssemblyInfo.cs">
      <Output TaskParameter="Items" ItemName="_CacheFreeAssemblyInfo" />
    </GetFileHash>
    <Error Condition="'@(_CacheFreeAssemblyInfo->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Cache-free execution must replace stale source and match ordinary assembly info bytes." />
  </Target>
  <Target Name="TestAssemblyVersion">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)AssemblyVersion.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.GenerateAssemblyInfo.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='GetAssemblyVersion' or @Name='GetAssemblyAttributes']">
      <Output TaskParameter="Result" ItemName="_AssemblyVersionTarget" />
    </XmlPeek>
    <Error Condition="'@(_AssemblyVersionTarget->Count())' != '2'" Text="The packaged SDK must contain both assembly version targets." />
    <PropertyGroup>
      <_AssemblyVersionXml>@(_AssemblyVersionTarget, '')</_AssemblyVersionXml>
      <_AssemblyVersionXml>$(_AssemblyVersionXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_AssemblyVersionXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)AssemblyVersion.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_AssemblyVersionXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_AssemblyVersionCase Include="semver" Version="1.2.3-beta.4+build.5" AssemblyVersion="1.2.3.0" FileVersion="1.2.3.0" InformationalVersion="1.2.3-beta.4+build.5" />
      <_AssemblyVersionCase Include="revision" Version="2.3.4.5" AssemblyVersion="2.3.4.5" FileVersion="2.3.4.5" InformationalVersion="2.3.4.5" />
      <_AssemblyVersionCase Include="file-info-overrides" Version="1.2.3" AssemblyVersion="1.2.3.0" FileVersion="8.7.6.5" InformationalVersion="custom" Arguments="-p:InputFileVersion=8.7.6.5 -p:InputInformationalVersion=custom" />
      <_AssemblyVersionCase Include="assembly-override" Version="not-a-version" AssemblyVersion="9.8.7.6" FileVersion="9.8.7.6" InformationalVersion="not-a-version" Arguments="-p:InputAssemblyVersion=9.8.7.6" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=%(_AssemblyVersionCase.Identity) -p:InputVersion=%(_AssemblyVersionCase.Version) -p:ExpectedAssemblyVersion=%(_AssemblyVersionCase.AssemblyVersion) -p:ExpectedFileVersion=%(_AssemblyVersionCase.FileVersion) -p:ExpectedInformationalVersion=%(_AssemblyVersionCase.InformationalVersion) %(_AssemblyVersionCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)assembly-version-%(_AssemblyVersionCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)assembly-version/%(_AssemblyVersionCase.Identity)/%(_AssemblyVersionCase.AssemblyVersion).txt')" Text="Assembly version derivation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f assembly-version-%(_AssemblyVersionCase.Identity).ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)assembly-version/%(_AssemblyVersionCase.Identity)/%(_AssemblyVersionCase.AssemblyVersion).txt">
      <Output TaskParameter="Lines" ItemName="_AssemblyVersionContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_AssemblyVersionContents)' != '@(_AssemblyVersionCase->'%(AssemblyVersion)|%(FileVersion)|%(InformationalVersion)')'"
           Text="Assembly version actions must receive the derived version values." />
    <MakeDir Directories="$(_TestDirectory)assembly-version/ordinary-%(_AssemblyVersionCase.Identity)" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=ordinary-%(_AssemblyVersionCase.Identity) -p:InputVersion=%(_AssemblyVersionCase.Version) -p:ExpectedAssemblyVersion=%(_AssemblyVersionCase.AssemblyVersion) -p:ExpectedFileVersion=%(_AssemblyVersionCase.FileVersion) -p:ExpectedInformationalVersion=%(_AssemblyVersionCase.InformationalVersion) %(_AssemblyVersionCase.Arguments)" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=invalid -p:InputVersion=not-a-version -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)assembly-version-invalid.ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)assembly-version-invalid.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_InvalidAssemblyVersionExitCode" />
    </Exec>
    <Error Condition="'$(_InvalidAssemblyVersionExitCode)' == '0' or !$([System.IO.File]::ReadAllText('$(_TestDirectory)assembly-version-invalid.log').Contains('NETSDK1018'))"
           Text="Invalid assembly versions must retain their SDK diagnostic." />
    <Error Condition="Exists('$(_TestDirectory)assembly-version-invalid.ninja') or Exists('$(_TestDirectory)assembly-version-invalid.ninja.actions') or Exists('$(_TestDirectory)assembly-version/invalid')"
           Text="Invalid assembly versions must not publish a graph or execute file actions." />
  </Target>
  <Target Name="TestFrameworkAttribute">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)FrameworkAttribute.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='GenerateTargetFrameworkMonikerAttribute']">
      <Output TaskParameter="Result" ItemName="_FrameworkAttributeTarget" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.CSharp.CurrentVersion.targets"
             Query="/Project/Target[@Name='_SetTargetFrameworkMonikerAttribute']">
      <Output TaskParameter="Result" ItemName="_FrameworkAttributeTarget" />
    </XmlPeek>
    <Error Condition="'@(_FrameworkAttributeTarget->Count())' != '2'" Text="The packaged Common and C# targets must contain framework attribute preparation and publication." />
    <WriteLinesToFile File="$(_TestDirectory)FrameworkAttribute.targets"
                      Lines="&lt;Project&gt;;@(_FrameworkAttributeTarget);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)framework-attribute.ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)framework-attribute/graph/generated.cs')" Text="Framework attribute construction must not write its output." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f framework-attribute.ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)framework-attribute/graph/generated.cs">
      <Output TaskParameter="Lines" ItemName="_FrameworkAttributeContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_FrameworkAttributeContents)' != '// &lt;autogenerated /&gt;;using System%3b;using System.Reflection%3b;[assembly: global::System.Runtime.Versioning.TargetFrameworkAttribute(&quot;.NETCoreApp,Version=v10.0&quot;, FrameworkDisplayName = &quot;.NET 10.0&quot;)]'"
           Text="The framework attribute action did not publish the expected content." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=ordinary" />
    <Error Condition="!Exists('$(_TestDirectory)framework-attribute/ordinary/generated.cs')" Text="Ordinary framework attribute generation must still write its output." />
    <GetFileHash Files="$(_TestDirectory)framework-attribute/graph/generated.cs;$(_TestDirectory)framework-attribute/ordinary/generated.cs">
      <Output TaskParameter="Items" ItemName="_FrameworkAttributeHash" />
    </GetFileHash>
    <Error Condition="'@(_FrameworkAttributeHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Independent framework attribute publication must preserve ordinary source bytes, including escaped semicolons." />
    <MakeDir Directories="$(_TestDirectory)framework-attribute/ordinary-failure/generated.cs" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=ordinary-failure -flp:&quot;LogFile=$(_TestDirectory)framework-attribute-ordinary-failure.log;WarningsOnly&quot;" />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)framework-attribute-ordinary-failure.log').Contains('MSB3491'))"
           Text="Ordinary framework attribute write failures must remain warnings." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=action-failure -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)framework-attribute-failure.ninja&quot;" />
    <ItemGroup>
      <_FrameworkAttributeFailureInvocation Include="$(_TestDirectory)framework-attribute-failure.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_FrameworkAttributeFailureInvocation->Count())' != '1'" Text="Framework attribute generation must emit one file action." />
    <MakeDir Directories="$(_TestDirectory)framework-attribute/action-failure/generated.cs" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_FrameworkAttributeFailureInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_FrameworkAttributeFailureExitCode" />
    </Exec>
    <Error Condition="'$(_FrameworkAttributeFailureExitCode)' == '0'" Text="Hardened framework attribute write failures must stop execution." />
  </Target>
  <Target Name="TestProjectStyles">
    <WriteLinesToFile File="$(_TestDirectory)packages.config" Lines="&lt;packages /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)packages.ProjectStyle.config" Lines="&lt;packages /&gt;" Overwrite="true" />
    <ItemGroup>
      <_ProjectStyleCase Include="explicit" Style="PackageReference" HasReference="false" />
      <_ProjectStyleCase Include="mixed-case" Style="pAcKaGeReFeReNcE" HasReference="false" />
      <_ProjectStyleCase Include="items" Style="" HasReference="true" />
      <_ProjectStyleRejectedCase Include="discovery" Style="" HasReference="false" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="override" Style="PackagesConfig" HasReference="true" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="unknown" Style="invalid" HasReference="true" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="duplicate" Style="PackageReference" HasReference="false" Duplicate="true" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=%(_ProjectStyleCase.Identity) -p:InputRestoreProjectStyle=%(_ProjectStyleCase.Style) -p:IncludePackageReference=%(_ProjectStyleCase.HasReference) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)style-%(_ProjectStyleCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)style-%(_ProjectStyleCase.Identity).txt')" Text="Classification and validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;style-%(_ProjectStyleCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)style-%(_ProjectStyleCase.Identity).txt')" Text="Classification did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=%(_ProjectStyleRejectedCase.Identity) -p:InputRestoreProjectStyle=%(_ProjectStyleRejectedCase.Style) -p:IncludePackageReference=%(_ProjectStyleRejectedCase.HasReference) -p:IncludeDuplicate=%(_ProjectStyleRejectedCase.Duplicate) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_ProjectStyleRejectedExitCode" />
    </Exec>
    <Error Condition="@(_ProjectStyleRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Unsupported classification and duplicate items must fail." />
    <Error Condition="Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).txt')"
           Text="Rejected construction must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=ordinary -p:ExpectedStyle=PackagesConfig -p:ExpectedCompatible=false" />
    <Error Condition="!Exists('$(_TestDirectory)style-ordinary.txt')" Text="Ordinary project-style classification must retain packages.config discovery." />
  </Target>
  <Target Name="TestExecutableReferences">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='ValidateExecutableReferences']">
      <Output TaskParameter="Result" ItemName="_ExecutableValidationTarget" />
    </XmlPeek>
    <Error Condition="'@(_ExecutableValidationTarget->Count())' != '1'" Text="The packaged SDK must contain one executable-reference validation target." />
    <PropertyGroup>
      <_ExecutableValidationXml>@(_ExecutableValidationTarget)</_ExecutableValidationXml>
      <_ExecutableValidationXml>$(_ExecutableValidationXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_ExecutableValidationXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)ExecutableReferences.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_ExecutableValidationXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_ExecutableReferenceCase Include="empty" Arguments="-p:HasReference=false -p:InputSelfContained=true" />
      <_ExecutableReferenceCase Include="matching" Arguments="" />
      <_ExecutableReferenceCase Include="legacy-metadata" Arguments="-p:UseAttributes=false" />
      <_ExecutableReferenceCase Include="non-executable" Arguments="-p:InputIsExecutable=false -p:InputSelfContained=true" />
      <_ExecutableReferenceCase Include="global-self-contained" Arguments="-p:SelfContained=true" />
      <_ExecutableReferenceCase Include="local-rid" Arguments="-p:InputRuntimeIdentifier=test-rid -p:ReferenceMajor=7" />
      <_ExecutableReferenceCase Include="global-rid-explicit" Arguments="-p:RuntimeIdentifier=test-rid -p:ReferenceMajor=7 -p:ReferenceSelfContainedSpecified=true" />
      <_ExecutableReferenceCase Include="global-rid-modern" Arguments="-p:RuntimeIdentifier=test-rid" />
      <_ExecutableReferenceRejectedCase Include="local-self-contained" Arguments="-p:InputSelfContained=true" Error="NETSDK1150" />
      <_ExecutableReferenceRejectedCase Include="child-self-contained" Arguments="-p:ReferenceSelfContained=true" Error="NETSDK1151" />
      <_ExecutableReferenceRejectedCase Include="global-rid-inferred" Arguments="-p:RuntimeIdentifier=test-rid -p:ReferenceMajor=7" Error="NETSDK1151" />
      <_ExecutableReferenceRejectedCase Include="rid-agnostic" Arguments="-p:SelfContained=true -p:ReferenceIsRidAgnostic=true" Error="NETSDK1150" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=%(_ExecutableReferenceCase.Identity) %(_ExecutableReferenceCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).txt')" Text="Executable-reference validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;executable-%(_ExecutableReferenceCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).txt')" Text="Executable-reference validation did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=%(_ExecutableReferenceRejectedCase.Identity) %(_ExecutableReferenceRejectedCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_ExecutableReferenceRejectedExitCode" />
    </Exec>
    <Error Condition="@(_ExecutableReferenceRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Incompatible executable references must fail." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).log').Contains('%(_ExecutableReferenceRejectedCase.Error)'))"
           Text="Executable-reference validation did not report the expected SDK diagnostic." />
    <Error Condition="Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).txt')"
           Text="Rejected executable-reference validation must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=ordinary-global -p:SelfContained=true" />
    <Error Condition="!Exists('$(_TestDirectory)executable-ordinary-global.txt')" Text="Ordinary executable-reference validation must retain global-property propagation." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=ordinary-mismatch -p:InputSelfContained=true -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)executable-ordinary-mismatch.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_OrdinaryExecutableReferenceExitCode" />
    </Exec>
    <Error Condition="'$(_OrdinaryExecutableReferenceExitCode)' == '0' or Exists('$(_TestDirectory)executable-ordinary-mismatch.txt') or !$([System.IO.File]::ReadAllText('$(_TestDirectory)executable-ordinary-mismatch.log').Contains('NETSDK1150'))"
           Text="Ordinary executable-reference validation must retain incompatible-reference errors." />
  </Target>
  <Target Name="TestEditorConfig">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)EditorConfig.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Roslyn/Microsoft.Managed.Core.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='GenerateMSBuildEditorConfigFileShouldRun' or @Name='GenerateMSBuildEditorConfigFileCore']">
      <Output TaskParameter="Result" ItemName="_EditorConfigTarget" />
    </XmlPeek>
    <Error Condition="'@(_EditorConfigTarget->Count())' != '2'" Text="The packaged Roslyn targets must contain both editorconfig targets." />
    <PropertyGroup>
      <_EditorConfigXml>@(_EditorConfigTarget, '')</_EditorConfigXml>
      <_EditorConfigXml>$(_EditorConfigXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_EditorConfigXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)EditorConfig.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_EditorConfigXml);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig.ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)editorconfig/graph/generated.editorconfig')"
           Text="Editorconfig construction must not write the configuration." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f editorconfig.ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=ordinary" />
    <GetFileHash Files="$(_TestDirectory)editorconfig/ordinary/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_OrdinaryEditorConfigHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)editorconfig/graph/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_GraphEditorConfigHash" />
    </GetFileHash>
    <Error Condition="'$(_OrdinaryEditorConfigHash)' == '' or '$(_OrdinaryEditorConfigHash)' != '$(_GraphEditorConfigHash)'"
           Text="Independent editorconfig execution must preserve the ordinary task's exact bytes." />
    <WriteLinesToFile File="$(_TestDirectory)editorconfig/graph/generated.editorconfig" Lines="stale output" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig-overwrite.ninja&quot;" />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)editorconfig/graph/generated.editorconfig').Contains('stale output'))"
           Text="Construction must not overwrite an existing editorconfig." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f editorconfig-overwrite.ninja" />
    <GetFileHash Files="$(_TestDirectory)editorconfig/graph/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_OverwrittenEditorConfigHash" />
    </GetFileHash>
    <Error Condition="'$(_OrdinaryEditorConfigHash)' != '$(_OverwrittenEditorConfigHash)'"
           Text="Editorconfig actions must overwrite stale output without appending or changing encoding." />
    <ItemGroup>
      <_EditorConfigRejectedMetadata Include="ModifiedTime;CreatedTime;AccessedTime;mOdIfIeDtImE" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=%(_EditorConfigRejectedMetadata.Identity) -p:RequestedMetadata=%(_EditorConfigRejectedMetadata.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_EditorConfigRejectedExitCode" />
    </Exec>
    <Error Condition="@(_EditorConfigRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Filesystem-derived editorconfig metadata must fail construction." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).log').Contains('requires a filesystem query'))"
           Text="Editorconfig metadata rejection must report its zero-I/O constraint." />
    <Error Condition="Exists('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja') or Exists('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja.actions') or Exists('$(_TestDirectory)editorconfig/%(_EditorConfigRejectedMetadata.Identity)/generated.editorconfig')"
           Text="Rejected editorconfig formatting must not publish a partial graph or execute file actions." />
  </Target>
  <Target Name="TestWinMDReferences">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='_BlockWinMDsOnUnsupportedTFMs']">
      <Output TaskParameter="Result" ItemName="_WinMDValidationTarget" />
    </XmlPeek>
    <Error Condition="'@(_WinMDValidationTarget->Count())' != '1'" Text="The packaged SDK must contain one WinMD validation target." />
    <PropertyGroup>
      <_WinMDValidationXml>@(_WinMDValidationTarget)</_WinMDValidationXml>
      <_WinMDValidationXml>$(_WinMDValidationXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_WinMDValidationXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)WinMDReferences.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_WinMDValidationXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_WinMDCase Include="empty" Arguments="-p:HasManagedReference=false" />
      <_WinMDCase Include="managed" Arguments="" />
      <_WinMDCase Include="lookalikes" Arguments="-p:HasLookalikeReferences=true" />
      <_WinMDRejectedCase Include="mixed" WinMDExtension="winmd" />
      <_WinMDRejectedCase Include="uppercase" WinMDExtension="WINMD" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=%(_WinMDCase.Identity) %(_WinMDCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)winmd-%(_WinMDCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)winmd-%(_WinMDCase.Identity).txt')" Text="WinMD validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;winmd-%(_WinMDCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)winmd-%(_WinMDCase.Identity).txt')" Text="WinMD validation did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=%(_WinMDRejectedCase.Identity) -p:HasWinMDReference=true -p:WinMDExtension=%(_WinMDRejectedCase.WinMDExtension) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_WinMDRejectedExitCode" />
    </Exec>
    <Error Condition="@(_WinMDRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="WinMD references must fail hardened construction." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('NETSDK1130'))
                      or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('sample.%(_WinMDRejectedCase.WinMDExtension)'))
                      or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('another.WinMd'))"
           Text="Hardened WinMD validation must report every WinMD by name without reading missing managed references." />
    <Error Condition="Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).txt')"
           Text="Rejected WinMD validation must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=ordinary-managed" />
    <Error Condition="!Exists('$(_TestDirectory)winmd-ordinary-managed.txt')" Text="Ordinary validation without WinMD references must not inspect managed assemblies." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=ordinary-mixed -p:HasWinMDReference=true -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)winmd-ordinary-mixed.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_OrdinaryWinMDExitCode" />
    </Exec>
    <Error Condition="'$(_OrdinaryWinMDExitCode)' == '0' or Exists('$(_TestDirectory)winmd-ordinary-mixed.txt') or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-ordinary-mixed.log').Contains('System.IO.FileNotFoundException'))"
           Text="Ordinary builds must retain the existing PE-inspecting WinMD checker." />
  </Target>
</Project>
