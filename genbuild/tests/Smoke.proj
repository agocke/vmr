<Project DefaultTargets="Test">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <GenBuildApp Condition="'$(GenBuildApp)' == ''">$(MSBuildThisFileDirectory)../../artifacts/bin/genbuild/$(Configuration)/genbuild.dll</GenBuildApp>
    <GenBuildTestHost Condition="'$(GenBuildTestHost)' == ''">$(DOTNET_HOST_PATH)</GenBuildTestHost>
    <_TestDirectory>$(MSBuildThisFileDirectory)../../artifacts/obj/genbuild-smoke/$([System.Guid]::NewGuid())/with spaces/</_TestDirectory>
    <_App>&quot;$(GenBuildTestHost)&quot; &quot;$(GenBuildApp)&quot;</_App>
    <_AppDirectory>$([System.IO.Path]::GetDirectoryName('$(GenBuildApp)'))</_AppDirectory>
  </PropertyGroup>
  <Target Name="Test">
    <Error Condition="!Exists('$(GenBuildApp)') or !Exists('$(GenBuildTestHost)')" Text="Build genbuild.proj first and set GenBuildTestHost to an external dotnet runtime." />
    <Error Condition="Exists('$(_AppDirectory)/shared') or Exists('$(_AppDirectory)/host') or Exists('$(_AppDirectory)/sdk')" Text="The app must not bundle a runtime or an SDK installation." />
    <MakeDir Directories="$(_TestDirectory)" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Action.proj;$(MSBuildThisFileDirectory)ProjectStyle.proj;$(MSBuildThisFileDirectory)ExecutableReferences.proj;$(MSBuildThisFileDirectory)WinMDReferences.proj;$(MSBuildThisFileDirectory)HelloWorld.csproj;$(MSBuildThisFileDirectory)HelloWorld.cs" DestinationFolder="$(_TestDirectory)" />
    <Exec Command="$(_App) --help" />
    <Exec Command="$(_App) invalid" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_InvalidExitCode" />
    </Exec>
    <Error Condition="'$(_InvalidExitCode)' == '0'" Text="Invalid commands must fail." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)missing.csproj&quot; -bl:&quot;$(_TestDirectory)missing-{}.binlog&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_MissingExitCode" />
    </Exec>
    <Error Condition="'$(_MissingExitCode)' == '0'" Text="The app must propagate MSBuild failure." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)Action.proj&quot; -bl:&quot;$(_TestDirectory)graph-{}.binlog&quot;" />
    <Error Condition="Exists('$(_TestDirectory)action.txt')" Text="Graph construction must not execute actions." />
    <Error Condition="!Exists('$(_TestDirectory)obj/genbuild/build.ninja')" Text="Graph construction did not emit the default Ninja file." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f obj/genbuild/build.ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)action.txt">
      <Output TaskParameter="Lines" ItemName="_ActionContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_ActionContents)' != 'executed outside MSBuild'" Text="The independent action host did not produce the expected contents." />
    <CallTarget Targets="TestProjectStyles" />
    <CallTarget Targets="TestExecutableReferences" />
    <CallTarget Targets="TestWinMDReferences" />
    <CallTarget Targets="TestEditorConfig" />
    <CallTarget Targets="TestFrameworkAttribute" />
    <CallTarget Targets="TestAssemblyVersion" />
    <CallTarget Targets="TestIncrementalCaches" />
    <CallTarget Targets="TestSourceLink" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)HelloWorld.csproj&quot; -bl:&quot;$(_TestDirectory)restore-{}.binlog&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)obj/project.assets.json') or !Exists('$(_TestDirectory)obj/frameworkreferences/HelloWorld.csproj.g.props')" Text="SDK restore must produce assets and capture framework-reference inputs using the app's targets." />
    <XmlPeek XmlInputPath="$(_TestDirectory)obj/frameworkreferences/HelloWorld.csproj.g.props" Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_CompileReference" />
    </XmlPeek>
    <Error Condition="'@(_CompileReference)' == ''" Text="Restore did not capture compiler reference inputs." />
    <WriteLinesToFile File="$(_TestDirectory)compile.rsp" Lines="@(_CompileReference->'-r:&quot;%(Identity)&quot;');&quot;$(_TestDirectory)HelloWorld.cs&quot;" Overwrite="true" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; --roll-forward Major &quot;$(_AppDirectory)/toolset/Roslyn/bincore/csc.dll&quot; -noconfig -nostdlib+ -target:exe -out:&quot;$(_TestDirectory)HelloWorld.dll&quot; @&quot;$(_TestDirectory)compile.rsp&quot;" />
    <Copy SourceFiles="$(_AppDirectory)/genbuild.runtimeconfig.json" DestinationFiles="$(_TestDirectory)HelloWorld.runtimeconfig.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)HelloWorld.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_ProgramOutput" />
    </Exec>
    <Error Condition="'@(_ProgramOutput)' != 'Hello from genbuild.'" Text="The program compiled with the packaged compiler did not run correctly on the external runtime." />
    <Message Importance="high" Text="genbuild smoke checks passed: CLI failures, graph-only construction, independent execution, project-style classification, duplicate-item, executable-reference and WinMD validation, editorconfig and framework attribute generation, assembly version derivation, cache-free assembly generation, source-root mapping and SourceLink publication, SDK restore, and packaged compiler execution. $(_TestDirectory)" />
  </Target>
  <Target Name="TestSourceLink">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)SourceLink.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Roslyn/Microsoft.Managed.Core.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='InitializeSourceRootMappedPaths' or @Name='_InitializeSourceRootMappedPathsFromSourceControl' or @Name='_SetPathMapFromSourceRoots']">
      <Output TaskParameter="Result" ItemName="_SourceRootTarget" />
    </XmlPeek>
    <Error Condition="'@(_SourceRootTarget->Count())' != '3'" Text="The packaged Roslyn targets must contain source-root mapping and PathMap preparation." />
    <PropertyGroup>
      <_SourceRootXml>@(_SourceRootTarget, '')</_SourceRootXml>
      <_SourceRootXml>$(_SourceRootXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_SourceRootXml>
      <_StaleSourceLink>$(_TestDirectory)source-link/stale/SourceLink.sourcelink.json</_StaleSourceLink>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)SourceRoots.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_SourceRootXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_SourceLinkCase Include="graph" Baseline="ordinary" />
      <_SourceLinkCase Include="stale" Baseline="ordinary-stale" />
      <_SourceLinkCase Include="paths" Arguments="-p:DeterministicSourcePaths=false" Baseline="ordinary-paths" />
      <_SourceLinkCase Include="legacy-hosts" Arguments="-p:LegacyHosts=true" Baseline="ordinary-legacy-hosts" />
      <_EmptySourceLinkCase Include="empty;no-url" />
      <_RejectedSourceLinkCase Include="root-separator;nested-root;revision;host;wildcard;gitlab-version;bitbucket-version" />
    </ItemGroup>
    <MakeDir Directories="$(_TestDirectory)source-link/stale;$(_TestDirectory)source-link/empty;$(_TestDirectory)source-link/no-url" />
    <WriteLinesToFile File="$(_StaleSourceLink)" Lines="stale" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)source-link/%(_EmptySourceLinkCase.Identity)/SourceLink.sourcelink.json" Lines="unreferenced" Overwrite="true" />
    <GetFileHash Files="$(_StaleSourceLink)">
      <Output TaskParameter="Hash" PropertyName="_StaleSourceLinkBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_SourceLinkCase.Identity) %(_SourceLinkCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_SourceLinkCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)source-link/graph') or Exists('$(_TestDirectory)source-link/paths') or Exists('$(_TestDirectory)missing-source')"
           Text="Source mapping and formatting must not create outputs or require source directories during construction." />
    <GetFileHash Files="$(_StaleSourceLink)">
      <Output TaskParameter="Hash" PropertyName="_StaleSourceLinkAfter" />
    </GetFileHash>
    <Error Condition="'$(_StaleSourceLinkBefore)' != '$(_StaleSourceLinkAfter)'" Text="Construction must not rewrite stale SourceLink JSON." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f source-link-%(_SourceLinkCase.Identity).ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_SourceLinkCase.Baseline) %(_SourceLinkCase.Arguments)" />
    <GetFileHash Files="$(_TestDirectory)source-link/%(_SourceLinkCase.Identity)/SourceLink.sourcelink.json">
      <Output TaskParameter="Items" ItemName="_ExecutedSourceLinkHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)source-link/%(_SourceLinkCase.Baseline)/SourceLink.sourcelink.json">
      <Output TaskParameter="Items" ItemName="_OrdinarySourceLinkHash" />
    </GetFileHash>
    <Error Condition="'@(_ExecutedSourceLinkHash->'%(FileHash)')' != '@(_OrdinarySourceLinkHash->'%(FileHash)')'"
           Text="Independent SourceLink execution must preserve ordinary JSON bytes, escaping, ordering and encoding." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_EmptySourceLinkCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_EmptySourceLinkCase.Identity).ninja&quot;" />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f source-link-%(_EmptySourceLinkCase.Identity).ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)source-link/%(_EmptySourceLinkCase.Identity)/SourceLink.sourcelink.json">
      <Output TaskParameter="Lines" ItemName="_EmptySourceLinkContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_EmptySourceLinkContents)' != 'unreferenced;unreferenced'"
           Text="Empty hardened mappings must leave stale JSON unreferenced and unchanged." />
    <ItemGroup>
      <_EmptySourceLinkAction Include="$(_TestDirectory)source-link-empty.ninja.actions/*.json;$(_TestDirectory)source-link-no-url.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_EmptySourceLinkAction)' != ''" Text="Empty SourceLink mappings must not emit file actions." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_RejectedSourceLinkCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_RejectedSourceLinkExitCode" />
    </Exec>
    <Error Condition="@(_RejectedSourceLinkExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Invalid source-root or provider metadata must fail construction." />
    <Error Condition="Exists('$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja') or Exists('$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja.actions') or Exists('$(_TestDirectory)source-link/%(_RejectedSourceLinkCase.Identity)')"
           Text="Rejected source mapping must publish neither a partial graph nor SourceLink JSON." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=action-failure -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-action-failure.ninja&quot;" />
    <ItemGroup>
      <_SourceLinkFailureInvocation Include="$(_TestDirectory)source-link-action-failure.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_SourceLinkFailureInvocation->Count())' != '1'" Text="SourceLink generation must emit only its file writer action." />
    <MakeDir Directories="$(_TestDirectory)source-link/action-failure/SourceLink.sourcelink.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_SourceLinkFailureInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_SourceLinkFailureExitCode" />
    </Exec>
    <Error Condition="'$(_SourceLinkFailureExitCode)' == '0'" Text="SourceLink publication failures must stop independent execution." />
  </Target>
  <Target Name="TestIncrementalCaches">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)IncrementalCaches.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='_GenerateCompileDependencyCache' or @Name='_GenerateCompileInputs']">
      <Output TaskParameter="Result" ItemName="_CompileCacheTarget" />
    </XmlPeek>
    <Error Condition="'@(_CompileCacheTarget->Count())' != '2'" Text="The packaged Common targets must contain compile input preparation and its cache wrapper." />
    <WriteLinesToFile File="$(_TestDirectory)IncrementalCaches.Common.targets"
                      Lines="&lt;Project&gt;;@(_CompileCacheTarget);&lt;/Project&gt;" Overwrite="true" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='_GenerateRuntimeConfigurationFilesInputCache']">
      <Output TaskParameter="Result" ItemName="_RuntimeCacheTarget" />
    </XmlPeek>
    <Error Condition="'@(_RuntimeCacheTarget->Count())' != '1'" Text="The packaged SDK must contain the runtime configuration cache wrapper." />
    <PropertyGroup>
      <_RuntimeCacheXml>@(_RuntimeCacheTarget)</_RuntimeCacheXml>
      <_RuntimeCacheXml>$(_RuntimeCacheXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_RuntimeCacheXml>
      <_StaleAssemblyInfo>$(_TestDirectory)incremental-caches/stale/IncrementalCaches.AssemblyInfo.cs</_StaleAssemblyInfo>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)IncrementalCaches.Sdk.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_RuntimeCacheXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_IncrementalCacheCase Include="clean;stale" />
      <_IncrementalCachePath Include="IncrementalCaches.AssemblyInfoInputs.cache;IncrementalCaches.proj.CoreCompileInputs.cache;runtimeconfig.inputs.cache" />
    </ItemGroup>
    <MakeDir Directories="$(_TestDirectory)incremental-caches/stale/%(_IncrementalCachePath.Identity)" />
    <WriteLinesToFile File="$(_StaleAssemblyInfo)" Lines="// stale generated source" Overwrite="true" />
    <GetFileHash Files="$(_StaleAssemblyInfo)">
      <Output TaskParameter="Hash" PropertyName="_StaleAssemblyInfoBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)IncrementalCaches.proj&quot; -p:TestCase=%(_IncrementalCacheCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)incremental-caches/clean')" Text="Cache-free graph construction must not write outputs or create cache directories." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('AssemblyInfoInputs.cache'))
                      or $([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('CoreCompileInputs.cache'))
                      or $([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('runtimeconfig.inputs.cache'))"
           Text="Incremental timestamp caches must not appear in the emitted graph." />
    <GetFileHash Files="$(_StaleAssemblyInfo)">
      <Output TaskParameter="Hash" PropertyName="_StaleAssemblyInfoAfter" />
    </GetFileHash>
    <Error Condition="'$(_StaleAssemblyInfoBefore)' != '$(_StaleAssemblyInfoAfter)'" Text="Construction must not rewrite existing assembly info." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f incremental-caches-%(_IncrementalCacheCase.Identity).ninja" />
    <MakeDir Directories="$(_TestDirectory)incremental-caches/ordinary" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)IncrementalCaches.proj&quot; -p:TestCase=ordinary" />
    <Error Condition="!Exists('$(_TestDirectory)incremental-caches/ordinary/%(_IncrementalCachePath.Identity)')"
           Text="Ordinary builds must still create their incremental cache files." />
    <Error Condition="Exists('$(_TestDirectory)incremental-caches/clean/%(_IncrementalCachePath.Identity)')"
           Text="Independent execution must not create incremental caches." />
    <GetFileHash Files="$(_TestDirectory)incremental-caches/clean/IncrementalCaches.AssemblyInfo.cs;$(_StaleAssemblyInfo);$(_TestDirectory)incremental-caches/ordinary/IncrementalCaches.AssemblyInfo.cs">
      <Output TaskParameter="Items" ItemName="_CacheFreeAssemblyInfo" />
    </GetFileHash>
    <Error Condition="'@(_CacheFreeAssemblyInfo->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Cache-free execution must replace stale source and match ordinary assembly info bytes." />
  </Target>
  <Target Name="TestAssemblyVersion">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)AssemblyVersion.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.GenerateAssemblyInfo.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='GetAssemblyVersion' or @Name='GetAssemblyAttributes']">
      <Output TaskParameter="Result" ItemName="_AssemblyVersionTarget" />
    </XmlPeek>
    <Error Condition="'@(_AssemblyVersionTarget->Count())' != '2'" Text="The packaged SDK must contain both assembly version targets." />
    <PropertyGroup>
      <_AssemblyVersionXml>@(_AssemblyVersionTarget, '')</_AssemblyVersionXml>
      <_AssemblyVersionXml>$(_AssemblyVersionXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_AssemblyVersionXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)AssemblyVersion.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_AssemblyVersionXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_AssemblyVersionCase Include="semver" Version="1.2.3-beta.4+build.5" AssemblyVersion="1.2.3.0" FileVersion="1.2.3.0" InformationalVersion="1.2.3-beta.4+build.5" />
      <_AssemblyVersionCase Include="revision" Version="2.3.4.5" AssemblyVersion="2.3.4.5" FileVersion="2.3.4.5" InformationalVersion="2.3.4.5" />
      <_AssemblyVersionCase Include="file-info-overrides" Version="1.2.3" AssemblyVersion="1.2.3.0" FileVersion="8.7.6.5" InformationalVersion="custom" Arguments="-p:InputFileVersion=8.7.6.5 -p:InputInformationalVersion=custom" />
      <_AssemblyVersionCase Include="assembly-override" Version="not-a-version" AssemblyVersion="9.8.7.6" FileVersion="9.8.7.6" InformationalVersion="not-a-version" Arguments="-p:InputAssemblyVersion=9.8.7.6" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=%(_AssemblyVersionCase.Identity) -p:InputVersion=%(_AssemblyVersionCase.Version) -p:ExpectedAssemblyVersion=%(_AssemblyVersionCase.AssemblyVersion) -p:ExpectedFileVersion=%(_AssemblyVersionCase.FileVersion) -p:ExpectedInformationalVersion=%(_AssemblyVersionCase.InformationalVersion) %(_AssemblyVersionCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)assembly-version-%(_AssemblyVersionCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)assembly-version/%(_AssemblyVersionCase.Identity)/%(_AssemblyVersionCase.AssemblyVersion).txt')" Text="Assembly version derivation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f assembly-version-%(_AssemblyVersionCase.Identity).ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)assembly-version/%(_AssemblyVersionCase.Identity)/%(_AssemblyVersionCase.AssemblyVersion).txt">
      <Output TaskParameter="Lines" ItemName="_AssemblyVersionContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_AssemblyVersionContents)' != '@(_AssemblyVersionCase->'%(AssemblyVersion)|%(FileVersion)|%(InformationalVersion)')'"
           Text="Assembly version actions must receive the derived version values." />
    <MakeDir Directories="$(_TestDirectory)assembly-version/ordinary-%(_AssemblyVersionCase.Identity)" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=ordinary-%(_AssemblyVersionCase.Identity) -p:InputVersion=%(_AssemblyVersionCase.Version) -p:ExpectedAssemblyVersion=%(_AssemblyVersionCase.AssemblyVersion) -p:ExpectedFileVersion=%(_AssemblyVersionCase.FileVersion) -p:ExpectedInformationalVersion=%(_AssemblyVersionCase.InformationalVersion) %(_AssemblyVersionCase.Arguments)" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=invalid -p:InputVersion=not-a-version -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)assembly-version-invalid.ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)assembly-version-invalid.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_InvalidAssemblyVersionExitCode" />
    </Exec>
    <Error Condition="'$(_InvalidAssemblyVersionExitCode)' == '0' or !$([System.IO.File]::ReadAllText('$(_TestDirectory)assembly-version-invalid.log').Contains('NETSDK1018'))"
           Text="Invalid assembly versions must retain their SDK diagnostic." />
    <Error Condition="Exists('$(_TestDirectory)assembly-version-invalid.ninja') or Exists('$(_TestDirectory)assembly-version-invalid.ninja.actions') or Exists('$(_TestDirectory)assembly-version/invalid')"
           Text="Invalid assembly versions must not publish a graph or execute file actions." />
  </Target>
  <Target Name="TestFrameworkAttribute">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)FrameworkAttribute.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='GenerateTargetFrameworkMonikerAttribute']">
      <Output TaskParameter="Result" ItemName="_FrameworkAttributeTarget" />
    </XmlPeek>
    <Error Condition="'@(_FrameworkAttributeTarget->Count())' != '1'" Text="The packaged Common targets must contain one framework attribute target." />
    <WriteLinesToFile File="$(_TestDirectory)FrameworkAttribute.targets"
                      Lines="&lt;Project&gt;;@(_FrameworkAttributeTarget);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)framework-attribute.ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)framework-attribute/graph/generated.cs')" Text="Framework attribute construction must not write its output." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f framework-attribute.ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)framework-attribute/graph/generated.cs">
      <Output TaskParameter="Lines" ItemName="_FrameworkAttributeContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_FrameworkAttributeContents)' != '[assembly: global::System.Runtime.Versioning.TargetFrameworkAttribute(&quot;.NETCoreApp,Version=v10.0&quot;)]'"
           Text="The framework attribute action did not publish the expected content." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=ordinary" />
    <Error Condition="!Exists('$(_TestDirectory)framework-attribute/ordinary/generated.cs')" Text="Ordinary framework attribute generation must still write its output." />
    <MakeDir Directories="$(_TestDirectory)framework-attribute/ordinary-failure/generated.cs" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=ordinary-failure -flp:&quot;LogFile=$(_TestDirectory)framework-attribute-ordinary-failure.log;WarningsOnly&quot;" />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)framework-attribute-ordinary-failure.log').Contains('MSB3491'))"
           Text="Ordinary framework attribute write failures must remain warnings." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=action-failure -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)framework-attribute-failure.ninja&quot;" />
    <ItemGroup>
      <_FrameworkAttributeFailureInvocation Include="$(_TestDirectory)framework-attribute-failure.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_FrameworkAttributeFailureInvocation->Count())' != '1'" Text="Framework attribute generation must emit one file action." />
    <MakeDir Directories="$(_TestDirectory)framework-attribute/action-failure/generated.cs" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_FrameworkAttributeFailureInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_FrameworkAttributeFailureExitCode" />
    </Exec>
    <Error Condition="'$(_FrameworkAttributeFailureExitCode)' == '0'" Text="Hardened framework attribute write failures must stop execution." />
  </Target>
  <Target Name="TestProjectStyles">
    <WriteLinesToFile File="$(_TestDirectory)packages.config" Lines="&lt;packages /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)packages.ProjectStyle.config" Lines="&lt;packages /&gt;" Overwrite="true" />
    <ItemGroup>
      <_ProjectStyleCase Include="explicit" Style="PackageReference" HasReference="false" />
      <_ProjectStyleCase Include="mixed-case" Style="pAcKaGeReFeReNcE" HasReference="false" />
      <_ProjectStyleCase Include="items" Style="" HasReference="true" />
      <_ProjectStyleRejectedCase Include="discovery" Style="" HasReference="false" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="override" Style="PackagesConfig" HasReference="true" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="unknown" Style="invalid" HasReference="true" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="duplicate" Style="PackageReference" HasReference="false" Duplicate="true" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=%(_ProjectStyleCase.Identity) -p:InputRestoreProjectStyle=%(_ProjectStyleCase.Style) -p:IncludePackageReference=%(_ProjectStyleCase.HasReference) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)style-%(_ProjectStyleCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)style-%(_ProjectStyleCase.Identity).txt')" Text="Classification and validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;style-%(_ProjectStyleCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)style-%(_ProjectStyleCase.Identity).txt')" Text="Classification did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=%(_ProjectStyleRejectedCase.Identity) -p:InputRestoreProjectStyle=%(_ProjectStyleRejectedCase.Style) -p:IncludePackageReference=%(_ProjectStyleRejectedCase.HasReference) -p:IncludeDuplicate=%(_ProjectStyleRejectedCase.Duplicate) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_ProjectStyleRejectedExitCode" />
    </Exec>
    <Error Condition="@(_ProjectStyleRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Unsupported classification and duplicate items must fail." />
    <Error Condition="Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).txt')"
           Text="Rejected construction must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=ordinary -p:ExpectedStyle=PackagesConfig -p:ExpectedCompatible=false" />
    <Error Condition="!Exists('$(_TestDirectory)style-ordinary.txt')" Text="Ordinary project-style classification must retain packages.config discovery." />
  </Target>
  <Target Name="TestExecutableReferences">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='ValidateExecutableReferences']">
      <Output TaskParameter="Result" ItemName="_ExecutableValidationTarget" />
    </XmlPeek>
    <Error Condition="'@(_ExecutableValidationTarget->Count())' != '1'" Text="The packaged SDK must contain one executable-reference validation target." />
    <PropertyGroup>
      <_ExecutableValidationXml>@(_ExecutableValidationTarget)</_ExecutableValidationXml>
      <_ExecutableValidationXml>$(_ExecutableValidationXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_ExecutableValidationXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)ExecutableReferences.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_ExecutableValidationXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_ExecutableReferenceCase Include="empty" Arguments="-p:HasReference=false -p:InputSelfContained=true" />
      <_ExecutableReferenceCase Include="matching" Arguments="" />
      <_ExecutableReferenceCase Include="legacy-metadata" Arguments="-p:UseAttributes=false" />
      <_ExecutableReferenceCase Include="non-executable" Arguments="-p:InputIsExecutable=false -p:InputSelfContained=true" />
      <_ExecutableReferenceCase Include="global-self-contained" Arguments="-p:SelfContained=true" />
      <_ExecutableReferenceCase Include="local-rid" Arguments="-p:InputRuntimeIdentifier=test-rid -p:ReferenceMajor=7" />
      <_ExecutableReferenceCase Include="global-rid-explicit" Arguments="-p:RuntimeIdentifier=test-rid -p:ReferenceMajor=7 -p:ReferenceSelfContainedSpecified=true" />
      <_ExecutableReferenceCase Include="global-rid-modern" Arguments="-p:RuntimeIdentifier=test-rid" />
      <_ExecutableReferenceRejectedCase Include="local-self-contained" Arguments="-p:InputSelfContained=true" Error="NETSDK1150" />
      <_ExecutableReferenceRejectedCase Include="child-self-contained" Arguments="-p:ReferenceSelfContained=true" Error="NETSDK1151" />
      <_ExecutableReferenceRejectedCase Include="global-rid-inferred" Arguments="-p:RuntimeIdentifier=test-rid -p:ReferenceMajor=7" Error="NETSDK1151" />
      <_ExecutableReferenceRejectedCase Include="rid-agnostic" Arguments="-p:SelfContained=true -p:ReferenceIsRidAgnostic=true" Error="NETSDK1150" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=%(_ExecutableReferenceCase.Identity) %(_ExecutableReferenceCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).txt')" Text="Executable-reference validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;executable-%(_ExecutableReferenceCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).txt')" Text="Executable-reference validation did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=%(_ExecutableReferenceRejectedCase.Identity) %(_ExecutableReferenceRejectedCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_ExecutableReferenceRejectedExitCode" />
    </Exec>
    <Error Condition="@(_ExecutableReferenceRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Incompatible executable references must fail." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).log').Contains('%(_ExecutableReferenceRejectedCase.Error)'))"
           Text="Executable-reference validation did not report the expected SDK diagnostic." />
    <Error Condition="Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).txt')"
           Text="Rejected executable-reference validation must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=ordinary-global -p:SelfContained=true" />
    <Error Condition="!Exists('$(_TestDirectory)executable-ordinary-global.txt')" Text="Ordinary executable-reference validation must retain global-property propagation." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=ordinary-mismatch -p:InputSelfContained=true -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)executable-ordinary-mismatch.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_OrdinaryExecutableReferenceExitCode" />
    </Exec>
    <Error Condition="'$(_OrdinaryExecutableReferenceExitCode)' == '0' or Exists('$(_TestDirectory)executable-ordinary-mismatch.txt') or !$([System.IO.File]::ReadAllText('$(_TestDirectory)executable-ordinary-mismatch.log').Contains('NETSDK1150'))"
           Text="Ordinary executable-reference validation must retain incompatible-reference errors." />
  </Target>
  <Target Name="TestEditorConfig">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)EditorConfig.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Roslyn/Microsoft.Managed.Core.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='GenerateMSBuildEditorConfigFileShouldRun' or @Name='GenerateMSBuildEditorConfigFileCore']">
      <Output TaskParameter="Result" ItemName="_EditorConfigTarget" />
    </XmlPeek>
    <Error Condition="'@(_EditorConfigTarget->Count())' != '2'" Text="The packaged Roslyn targets must contain both editorconfig targets." />
    <PropertyGroup>
      <_EditorConfigXml>@(_EditorConfigTarget, '')</_EditorConfigXml>
      <_EditorConfigXml>$(_EditorConfigXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_EditorConfigXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)EditorConfig.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_EditorConfigXml);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig.ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)editorconfig/graph/generated.editorconfig')"
           Text="Editorconfig construction must not write the configuration." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f editorconfig.ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=ordinary" />
    <GetFileHash Files="$(_TestDirectory)editorconfig/ordinary/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_OrdinaryEditorConfigHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)editorconfig/graph/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_GraphEditorConfigHash" />
    </GetFileHash>
    <Error Condition="'$(_OrdinaryEditorConfigHash)' == '' or '$(_OrdinaryEditorConfigHash)' != '$(_GraphEditorConfigHash)'"
           Text="Independent editorconfig execution must preserve the ordinary task's exact bytes." />
    <WriteLinesToFile File="$(_TestDirectory)editorconfig/graph/generated.editorconfig" Lines="stale output" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig-overwrite.ninja&quot;" />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)editorconfig/graph/generated.editorconfig').Contains('stale output'))"
           Text="Construction must not overwrite an existing editorconfig." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f editorconfig-overwrite.ninja" />
    <GetFileHash Files="$(_TestDirectory)editorconfig/graph/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_OverwrittenEditorConfigHash" />
    </GetFileHash>
    <Error Condition="'$(_OrdinaryEditorConfigHash)' != '$(_OverwrittenEditorConfigHash)'"
           Text="Editorconfig actions must overwrite stale output without appending or changing encoding." />
    <ItemGroup>
      <_EditorConfigRejectedMetadata Include="ModifiedTime;CreatedTime;AccessedTime;mOdIfIeDtImE" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=%(_EditorConfigRejectedMetadata.Identity) -p:RequestedMetadata=%(_EditorConfigRejectedMetadata.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_EditorConfigRejectedExitCode" />
    </Exec>
    <Error Condition="@(_EditorConfigRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Filesystem-derived editorconfig metadata must fail construction." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).log').Contains('requires a filesystem query'))"
           Text="Editorconfig metadata rejection must report its zero-I/O constraint." />
    <Error Condition="Exists('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja') or Exists('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja.actions') or Exists('$(_TestDirectory)editorconfig/%(_EditorConfigRejectedMetadata.Identity)/generated.editorconfig')"
           Text="Rejected editorconfig formatting must not publish a partial graph or execute file actions." />
  </Target>
  <Target Name="TestWinMDReferences">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='_BlockWinMDsOnUnsupportedTFMs']">
      <Output TaskParameter="Result" ItemName="_WinMDValidationTarget" />
    </XmlPeek>
    <Error Condition="'@(_WinMDValidationTarget->Count())' != '1'" Text="The packaged SDK must contain one WinMD validation target." />
    <PropertyGroup>
      <_WinMDValidationXml>@(_WinMDValidationTarget)</_WinMDValidationXml>
      <_WinMDValidationXml>$(_WinMDValidationXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_WinMDValidationXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)WinMDReferences.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_WinMDValidationXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_WinMDCase Include="empty" Arguments="-p:HasManagedReference=false" />
      <_WinMDCase Include="managed" Arguments="" />
      <_WinMDCase Include="lookalikes" Arguments="-p:HasLookalikeReferences=true" />
      <_WinMDRejectedCase Include="mixed" WinMDExtension="winmd" />
      <_WinMDRejectedCase Include="uppercase" WinMDExtension="WINMD" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=%(_WinMDCase.Identity) %(_WinMDCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)winmd-%(_WinMDCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)winmd-%(_WinMDCase.Identity).txt')" Text="WinMD validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;winmd-%(_WinMDCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)winmd-%(_WinMDCase.Identity).txt')" Text="WinMD validation did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=%(_WinMDRejectedCase.Identity) -p:HasWinMDReference=true -p:WinMDExtension=%(_WinMDRejectedCase.WinMDExtension) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_WinMDRejectedExitCode" />
    </Exec>
    <Error Condition="@(_WinMDRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="WinMD references must fail hardened construction." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('NETSDK1130'))
                      or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('sample.%(_WinMDRejectedCase.WinMDExtension)'))
                      or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('another.WinMd'))"
           Text="Hardened WinMD validation must report every WinMD by name without reading missing managed references." />
    <Error Condition="Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).txt')"
           Text="Rejected WinMD validation must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=ordinary-managed" />
    <Error Condition="!Exists('$(_TestDirectory)winmd-ordinary-managed.txt')" Text="Ordinary validation without WinMD references must not inspect managed assemblies." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=ordinary-mixed -p:HasWinMDReference=true -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)winmd-ordinary-mixed.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_OrdinaryWinMDExitCode" />
    </Exec>
    <Error Condition="'$(_OrdinaryWinMDExitCode)' == '0' or Exists('$(_TestDirectory)winmd-ordinary-mixed.txt') or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-ordinary-mixed.log').Contains('System.IO.FileNotFoundException'))"
           Text="Ordinary builds must retain the existing PE-inspecting WinMD checker." />
  </Target>
</Project>
