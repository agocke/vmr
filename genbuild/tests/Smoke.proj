<Project DefaultTargets="Test">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <GenBuildApp Condition="'$(GenBuildApp)' == ''">$(MSBuildThisFileDirectory)../../artifacts/bin/genbuild/$(Configuration)/genbuild.dll</GenBuildApp>
    <GenBuildTestHost Condition="'$(GenBuildTestHost)' == ''">$(DOTNET_HOST_PATH)</GenBuildTestHost>
    <_TestDirectory>$(MSBuildThisFileDirectory)../../artifacts/obj/genbuild-smoke/$([System.Guid]::NewGuid())/with spaces/</_TestDirectory>
    <_App>&quot;$(GenBuildTestHost)&quot; &quot;$(GenBuildApp)&quot;</_App>
    <_AppDirectory>$([System.IO.Path]::GetDirectoryName('$(GenBuildApp)'))</_AppDirectory>
  </PropertyGroup>
  <Target Name="Test">
    <Error Condition="!Exists('$(GenBuildApp)') or !Exists('$(GenBuildTestHost)')" Text="Build genbuild.proj first and set GenBuildTestHost to an external dotnet runtime." />
    <Error Condition="Exists('$(_AppDirectory)/shared') or Exists('$(_AppDirectory)/host') or Exists('$(_AppDirectory)/sdk')" Text="The app must not bundle a runtime or an SDK installation." />
    <MakeDir Directories="$(_TestDirectory)" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Action.proj;$(MSBuildThisFileDirectory)ProjectStyle.proj;$(MSBuildThisFileDirectory)ExecutableReferences.proj;$(MSBuildThisFileDirectory)WinMDReferences.proj;$(MSBuildThisFileDirectory)HelloWorld.csproj;$(MSBuildThisFileDirectory)HelloWorld.cs" DestinationFolder="$(_TestDirectory)" />
    <Exec Command="$(_App) --help" />
    <Exec Command="$(_App) invalid" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_InvalidExitCode" />
    </Exec>
    <Error Condition="'$(_InvalidExitCode)' == '0'" Text="Invalid commands must fail." />
    <CallTarget Targets="TestNuGetSdkResolution" />
    <CallTarget Targets="TestDirectoryImports" />
    <CallTarget Targets="TestArcadeLayout" />
    <CallTarget Targets="TestArcadeTargetFrameworkInputs" />
    <CallTarget Targets="TestResourceMetadata" />
    <CallTarget Targets="TestRuntimeResourceCompilation" />
    <CallTarget Targets="TestInternalsVisibleTo" />
    <CallTarget Targets="TestRuntimeGenAPI" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)missing.csproj&quot; -bl:&quot;$(_TestDirectory)missing-{}.binlog&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_MissingExitCode" />
    </Exec>
    <Error Condition="'$(_MissingExitCode)' == '0'" Text="The app must propagate MSBuild failure." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)Action.proj&quot; -bl:&quot;$(_TestDirectory)graph-{}.binlog&quot;" />
    <Error Condition="Exists('$(_TestDirectory)action.txt')" Text="Graph construction must not execute actions." />
    <Error Condition="!Exists('$(_TestDirectory)obj/genbuild/build.ninja')" Text="Graph construction did not emit the default Ninja file." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f obj/genbuild/build.ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)action.txt">
      <Output TaskParameter="Lines" ItemName="_ActionContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_ActionContents)' != 'executed outside MSBuild'" Text="The independent action host did not produce the expected contents." />
    <CallTarget Targets="TestProjectStyles" />
    <CallTarget Targets="TestExecutableReferences" />
    <CallTarget Targets="TestWinMDReferences" />
    <CallTarget Targets="TestEditorConfig" />
    <CallTarget Targets="TestFrameworkAttribute" />
    <CallTarget Targets="TestAssemblyVersion" />
    <CallTarget Targets="TestIncrementalCaches" />
    <CallTarget Targets="TestSourceLink" />
    <CallTarget Targets="TestArcadeRepositoryInfo" />
    <CallTarget Targets="TestRoslynAnalyzerConfig" />
    <CallTarget Targets="TestCsc" />
    <CallTarget Targets="TestCopyOutputs" />
    <CallTarget Targets="TestSourceCopies" />
    <CallTarget Targets="TestCleanup" />
    <CallTarget Targets="TestDeps" />
    <CallTarget Targets="TestRuntimeConfig" />
    <CallTarget Targets="TestRuntimePackageConfig" />
    <PropertyGroup>
      <_SdkGraph>$([System.IO.Path]::GetFullPath('$(_TestDirectory)sdk-build.ninja'))</_SdkGraph>
      <_SdkHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_SdkHostOS>
      <_SdkHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_SdkHostOS>
      <_SdkHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_SdkHostOS>
      <_SdkHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_SdkHostOS>
      <_SdkArguments>-p:DirectoryBuildPropsPath=&quot;$(_TestDirectory)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_TestDirectory)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_TestDirectory)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_SdkHostOS)</_SdkArguments>
      <_LegacyCleanFile>$(_TestDirectory)obj/Debug/net11.0/HelloWorld.csproj.FileListAbsolute.txt</_LegacyCleanFile>
    </PropertyGroup>
    <MakeDir Directories="$(_LegacyCleanFile)" />
    <WriteLinesToFile File="$(_LegacyCleanFile).hardened.props" Lines="not an MSBuild project" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)HelloWorld.csproj&quot; $(_SdkArguments) -bl:&quot;$(_TestDirectory)restore-{}.binlog&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)obj/project.assets.json') or !Exists('$(_TestDirectory)obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props') or !Exists('$(_TestDirectory)obj/nugetinputs/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props')" Text="SDK restore must produce assets and capture NuGet and framework-reference inputs using the app's targets." />
    <CallTarget Targets="TestNuGetInputs" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)HelloWorld.csproj&quot; $(_SdkArguments) -p:MSBuildEmitActionGraph=&quot;$(_SdkGraph)&quot; -bl:&quot;$(_TestDirectory)sdk-build-{}.binlog&quot;" />
    <Error Condition="!Exists('$(_SdkGraph)') or !Exists('$(_SdkGraph).actions') or Exists('$(_TestDirectory)obj/Debug/net11.0/HelloWorld.dll') or Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.dll') or Exists('$(_TestDirectory)obj/Debug/net11.0/.NETCoreApp,Version=v11.0.AssemblyAttributes.cs')"
           Text="SDK Build must emit its graph without executing product actions." />
    <ReadLinesFromFile File="$(_LegacyCleanFile).hardened.props">
      <Output TaskParameter="Lines" PropertyName="_LegacyCleanSnapshot" />
    </ReadLinesFromFile>
    <Error Condition="'$(_LegacyCleanSnapshot)' != 'not an MSBuild project' or $([System.IO.File]::ReadAllText('$(_SdkGraph)').Contains('FileListAbsolute.txt'))"
           Text="Restore and graph construction must ignore obsolete clean snapshots and ledger state." />
    <XmlPeek XmlInputPath="$(_TestDirectory)obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_CompileReference" />
    </XmlPeek>
    <Error Condition="'@(_CompileReference)' == ''" Text="Restore did not capture compiler reference inputs." />
    <XmlPeek XmlInputPath="$(_TestDirectory)obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" Query="/Project/ItemGroup/_FrameworkReferenceManifestRuntimeFramework/@Include">
      <Output TaskParameter="Result" ItemName="_PreparedRuntimeFramework" />
    </XmlPeek>
    <Error Condition="'@(_PreparedRuntimeFramework)' != 'Microsoft.NETCore.App'" Text="Preparation must capture only the runtime frameworks selected by the project's targeting packs." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;$(_SdkGraph)&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.dll') or !Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.pdb') or !Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.deps.json') or !Exists('$(_TestDirectory)bin/Debug/net11.0/HelloWorld.runtimeconfig.json')"
           Text="Independent SDK graph execution must publish its assembly, symbols and runtime manifests." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)bin/Debug/net11.0/HelloWorld.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SdkProgramOutput" />
    </Exec>
    <Error Condition="'@(_SdkProgramOutput)' != 'Hello from genbuild.'" Text="The program built by the SDK action graph did not run correctly on the external runtime." />
    <CallTarget Targets="TestProjectReferences" />
    <CallTarget Targets="TestConfiguredPreparation" />
    <CallTarget Targets="TestDiscoveryPreparation" />
    <CallTarget Targets="TestFrameworkBasics" />
    <CallTarget Targets="TestRuntimeReferences" />
    <CallTarget Targets="TestExplicitReferences" />
    <CallTarget Targets="TestRuntimeTrimming" />
    <CallTarget Targets="TestPackageReferences" />
    <CallTarget Targets="TestFrameworkPackageReferences" />
    <WriteLinesToFile File="$(_TestDirectory)compile.rsp" Lines="@(_CompileReference->'-r:&quot;%(Identity)&quot;');&quot;$(_TestDirectory)HelloWorld.cs&quot;" Overwrite="true" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; --roll-forward Major &quot;$(_AppDirectory)/toolset/Roslyn/bincore/csc.dll&quot; -noconfig -nostdlib+ -target:exe -out:&quot;$(_TestDirectory)HelloWorld.dll&quot; @&quot;$(_TestDirectory)compile.rsp&quot;" />
    <Copy SourceFiles="$(_AppDirectory)/genbuild.runtimeconfig.json" DestinationFiles="$(_TestDirectory)HelloWorld.runtimeconfig.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)HelloWorld.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_ProgramOutput" />
    </Exec>
    <Error Condition="'@(_ProgramOutput)' != 'Hello from genbuild.'" Text="The program compiled with the packaged compiler did not run correctly on the external runtime." />
    <Message Importance="high" Text="genbuild smoke checks passed: CLI failures, prepared package-SDK replay, graph-only construction, independent execution, project-style classification, duplicate-item, executable-reference and WinMD validation, editorconfig and framework attribute generation, assembly version derivation, cache-free assembly generation, source-root mapping and SourceLink publication, SDK restore, cleanup-free Build graph execution and program startup, packaged compiler execution, assembly/reference/PDB copying, dependency-manifest and runtime-config publication, cross-project action graphs, SDK project-reference execution and startup, child framework metadata, source-built NuGet framework selection and native-manifest metadata queries. $(_TestDirectory)" />
  </Target>
  <Target Name="TestArcadeLayout">
    <PropertyGroup>
      <_ArcadeLayoutRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'arcade-layout'))</_ArcadeLayoutRoot>
      <_ArcadeProjectLayoutPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../../src/arcade/src/Microsoft.DotNet.Arcade.Sdk/tools/ProjectLayout.props'))</_ArcadeProjectLayoutPath>
      <_ArcadeLayoutArguments>-p:ArcadeProjectLayoutPath=&quot;$(_ArcadeProjectLayoutPath)&quot; -p:ArcadeLayoutDotNetTool=&quot;$(GenBuildTestHost)&quot; -p:Configuration=Release -p:OutDirName=&quot;nested folder/./discard/../layout space&quot;</_ArcadeLayoutArguments>
    </PropertyGroup>
    <ItemGroup>
      <_ArcadeLayoutCase Include="AnyCPU" Platform="AnyCPU" />
      <_ArcadeLayoutCase Include="x64" Platform="x64" />
      <_ArcadeLayoutCase Include="override" Platform="x64" />
      <_ArcadeLayoutCase Update="@(_ArcadeLayoutCase)">
        <Root>$([MSBuild]::NormalizeDirectory('$(_ArcadeLayoutRoot)', '%(Identity)'))</Root>
        <Arguments>$(_ArcadeLayoutArguments) -p:Platform=%(_ArcadeLayoutCase.Platform) -p:LayoutCase=%(_ArcadeLayoutCase.Identity)</Arguments>
      </_ArcadeLayoutCase>
    </ItemGroup>
    <MakeDir Directories="%(_ArcadeLayoutCase.Root)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ArcadeLayout.proj" DestinationFiles="%(_ArcadeLayoutCase.Root)ArcadeLayout.proj" />
    <Exec Command="$(_App) restore &quot;%(_ArcadeLayoutCase.Root)ArcadeLayout.proj&quot; -t:Build %(_ArcadeLayoutCase.Arguments) -p:ResultFile=&quot;%(_ArcadeLayoutCase.Root)ordinary.txt&quot; -bl:&quot;%(_ArcadeLayoutCase.Root)ordinary.binlog&quot;" />
    <Exec Command="$(_App) build &quot;%(_ArcadeLayoutCase.Root)ArcadeLayout.proj&quot; %(_ArcadeLayoutCase.Arguments) -p:ResultFile=&quot;%(_ArcadeLayoutCase.Root)graph.txt&quot; -p:MSBuildEmitActionGraph=&quot;%(_ArcadeLayoutCase.Root)build.ninja&quot; -bl:&quot;%(_ArcadeLayoutCase.Root)build.binlog&quot;" />
    <Error Condition="!Exists('%(_ArcadeLayoutCase.Root)build.ninja') or !Exists('%(_ArcadeLayoutCase.Root)build.ninja.actions') or Exists('%(_ArcadeLayoutCase.Root)graph.txt')"
           Text="Arcade layout graph construction must emit independent actions without writing the layout result (%(_ArcadeLayoutCase.Identity))." />
    <Exec WorkingDirectory="%(_ArcadeLayoutCase.Root)" Command="ninja -f build.ninja" />
    <Error Condition="$([System.IO.File]::ReadAllText('%(_ArcadeLayoutCase.Root)ordinary.txt')) != $([System.IO.File]::ReadAllText('%(_ArcadeLayoutCase.Root)graph.txt'))"
           Text="Source Arcade layout paths, including trailing separators, must match ordinary execution (%(_ArcadeLayoutCase.Identity))." />
    <Message Importance="high" Text="Source Arcade layout smoke checks passed: AnyCPU, x64, explicit base paths, graph-only construction and ordinary-equivalent Ninja output. $(_ArcadeLayoutRoot)" />
  </Target>
  <Target Name="TestArcadeTargetFrameworkInputs">
    <PropertyGroup>
      <_ArcadeInputsRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'arcade-targetframework-inputs'))</_ArcadeInputsRoot>
      <_ArcadeInputsPackage>$([MSBuild]::NormalizeDirectory('$(_AppDirectory)', 'toolset/Arcade/TargetFramework'))</_ArcadeInputsPackage>
      <_ArcadeInputsArguments>-p:ArcadeTargetFrameworkDirectory=&quot;$(_ArcadeInputsPackage)&quot; -p:TargetFramework=net11.0-linux -p:PreparationMarker=parent -p:ParentOnlyProperty=parent -p:ArcadeInputPoison=EXPANDED</_ArcadeInputsArguments>
      <_ArcadeInputsBaselineRoot>$(_ArcadeInputsRoot)baseline/</_ArcadeInputsBaselineRoot>
      <_ArcadeInputsBaselineArguments>$(_ArcadeInputsArguments) -p:Configuration=Debug -p:Platform=AnyCPU -p:RuntimeIdentifierGraphPath=runtime.json</_ArcadeInputsBaselineArguments>
    </PropertyGroup>
    <ItemGroup>
      <_ArcadeInputsCase Include="baseline" Configuration="Debug" Platform="AnyCPU" GraphArgument="-p:RuntimeIdentifierGraphPath=runtime.json" />
      <_ArcadeInputsCase Include="omit" Configuration="Release" Platform="x86" />
      <_ArcadeInputsCase Update="@(_ArcadeInputsCase)">
        <Root>$([MSBuild]::NormalizeDirectory('$(_ArcadeInputsRoot)', '%(_ArcadeInputsCase.Identity)'))</Root>
        <Arguments>$(_ArcadeInputsArguments) -p:TestCase=%(_ArcadeInputsCase.Identity) -p:Configuration=%(_ArcadeInputsCase.Configuration) -p:Platform=%(_ArcadeInputsCase.Platform) %(_ArcadeInputsCase.GraphArgument)</Arguments>
        <Inputs>obj/targetframeworkinputs/%(_ArcadeInputsCase.Configuration)/%(_ArcadeInputsCase.Platform)/net11.0-linux/ArcadeTargetFrameworkInputs.proj.g.props</Inputs>
      </_ArcadeInputsCase>
    </ItemGroup>
    <MakeDir Directories="%(_ArcadeInputsCase.Root)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ArcadeTargetFrameworkInputs.proj;$(MSBuildThisFileDirectory)ArcadeTargetFrameworkInputs.proj;$(MSBuildThisFileDirectory)ArcadeTargetFrameworkInputs.proj;$(MSBuildThisFileDirectory)ArcadeTargetFrameworkInputs.proj;$(MSBuildThisFileDirectory)ArcadeTargetFrameworkInputs.proj"
          DestinationFiles="%(_ArcadeInputsCase.Root)ArcadeTargetFrameworkInputs.proj;%(_ArcadeInputsCase.Root)Nearest.proj;%(_ArcadeInputsCase.Root)Platform.proj;%(_ArcadeInputsCase.Root)Bypass.proj;%(_ArcadeInputsCase.Root)Incompatible.proj" />
    <!-- An ignored JSON field detects expression expansion and percent/semicolon corruption on replay. -->
    <WriteLinesToFile File="%(_ArcadeInputsCase.Root)runtime.json" Overwrite="true"
                      Lines="{&quot;runtimes&quot;:{&quot;linux&quot;:{&quot;#import&quot;:[&quot;unix&quot;]},&quot;unix&quot;:{&quot;#import&quot;:[&quot;any&quot;]},&quot;any&quot;:{}},&quot;transport&quot;:&quot;%24(ArcadeInputPoison)%253B%3B100%25done&quot;}" />
    <Exec Command="$(_App) restore &quot;%(_ArcadeInputsCase.Root)ArcadeTargetFrameworkInputs.proj&quot; -t:Restore %(_ArcadeInputsCase.Arguments) -p:MSBuildRestoreGraphInputs=false -p:_MSBuildPreparingGraphInputs=true -bl:&quot;%(_ArcadeInputsCase.Root)no-restore-flag.binlog&quot;" />
    <Error Condition="Exists('%(_ArcadeInputsCase.Root)%(_ArcadeInputsCase.Inputs)')"
           Text="Arcade inputs must not be captured without MSBuildRestoreGraphInputs." />
    <Exec Command="$(_App) restore &quot;%(_ArcadeInputsCase.Root)ArcadeTargetFrameworkInputs.proj&quot; -t:Restore %(_ArcadeInputsCase.Arguments) -p:MSBuildRestoreGraphInputs=true -p:_MSBuildPreparingGraphInputs=false -bl:&quot;%(_ArcadeInputsCase.Root)no-preparation-flag.binlog&quot;" />
    <Error Condition="Exists('%(_ArcadeInputsCase.Root)%(_ArcadeInputsCase.Inputs)')"
           Text="Arcade inputs must not be captured outside graph-input preparation." />
    <Exec Command="$(_App) restore &quot;%(_ArcadeInputsCase.Root)ArcadeTargetFrameworkInputs.proj&quot; -t:Ordinary %(_ArcadeInputsCase.Arguments) -p:_MSBuildPreparingGraphInputs=true -p:ResultFile=&quot;%(_ArcadeInputsCase.Root)ordinary.txt&quot; -bl:&quot;%(_ArcadeInputsCase.Root)ordinary.binlog&quot;" />
    <Error Condition="!Exists('%(_ArcadeInputsCase.Root)%(_ArcadeInputsCase.Inputs)') or !Exists('%(_ArcadeInputsCase.Root)ordinary.txt')"
           Text="Ordinary Arcade negotiation must capture configured inputs and provide the metadata oracle." />
    <Move SourceFiles="%(_ArcadeInputsCase.Root)runtime.json" DestinationFiles="%(_ArcadeInputsCase.Root)runtime.saved.json" />
    <Exec Command="$(_App) build &quot;%(_ArcadeInputsCase.Root)ArcadeTargetFrameworkInputs.proj&quot; %(_ArcadeInputsCase.Arguments) -p:ResultFile=&quot;%(_ArcadeInputsCase.Root)graph.txt&quot; -p:MSBuildEmitActionGraph=&quot;%(_ArcadeInputsCase.Root)build.ninja&quot; -bl:&quot;%(_ArcadeInputsCase.Root)build.binlog&quot;" />
    <Error Condition="!Exists('%(_ArcadeInputsCase.Root)build.ninja') or !Exists('%(_ArcadeInputsCase.Root)build.ninja.actions') or
                      Exists('%(_ArcadeInputsCase.Root)graph.txt') or Exists('%(_ArcadeInputsCase.Root)runtime.json')"
           Text="Arcade graph construction must use captured JSON without reading the live graph or executing publication actions." />
    <Exec WorkingDirectory="%(_ArcadeInputsCase.Root)" Command="ninja -f build.ninja" />
    <Error Condition="$([System.IO.File]::ReadAllText('%(_ArcadeInputsCase.Root)ordinary.txt')) != $([System.IO.File]::ReadAllText('%(_ArcadeInputsCase.Root)graph.txt'))"
           Text="Ordinary and hardened Arcade selection must preserve identical framework/RID/configuration metadata and literal JSON (%(_ArcadeInputsCase.Identity))." />

    <Move SourceFiles="$(_ArcadeInputsBaselineRoot)runtime.saved.json" DestinationFiles="$(_ArcadeInputsBaselineRoot)runtime.json" />
    <Exec Command="$(_App) restore &quot;$(_ArcadeInputsBaselineRoot)ArcadeTargetFrameworkInputs.proj&quot; -t:Ordinary $(_ArcadeInputsBaselineArguments) -p:TestCase=incompatible -p:_MSBuildPreparingGraphInputs=true -p:ResultFile=&quot;$(_ArcadeInputsBaselineRoot)ordinary-incompatible.txt&quot; -bl:&quot;$(_ArcadeInputsBaselineRoot)ordinary-incompatible.binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_ArcadeInputsOrdinaryIncompatibleExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_ArcadeInputsOrdinaryIncompatibleOutput" />
    </Exec>
    <PropertyGroup>
      <_ArcadeInputsOrdinaryIncompatibleLog>@(_ArcadeInputsOrdinaryIncompatibleOutput)</_ArcadeInputsOrdinaryIncompatibleLog>
    </PropertyGroup>
    <Error Condition="'$(_ArcadeInputsOrdinaryIncompatibleExit)' == '0' or !$(_ArcadeInputsOrdinaryIncompatibleLog.Contains('cannot be referenced')) or
                      Exists('$(_ArcadeInputsBaselineRoot)ordinary-incompatible.txt')"
           Text="Ordinary incompatible references must report the existing diagnostic rather than silently disappear." />
    <Move SourceFiles="$(_ArcadeInputsBaselineRoot)runtime.json" DestinationFiles="$(_ArcadeInputsBaselineRoot)runtime.saved.json" />
    <ItemGroup>
      <_ArcadeInputsFailure Include="missing" Arguments="-p:TargetFrameworkInputsPath=missing.props" />
      <_ArcadeInputsFailure Include="version" Arguments="-p:_TargetFrameworkInputsVersion=2" />
      <_ArcadeInputsFailure Include="empty" Arguments="-p:_TargetFrameworkInputsRuntimeGraphContents=" />
      <_ArcadeInputsFailure Include="source" Arguments="-p:RuntimeIdentifierGraphPath=other.json" />
      <_ArcadeInputsFailure Include="incompatible" Arguments="-p:TestCase=incompatible" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_ArcadeInputsBaselineRoot)ArcadeTargetFrameworkInputs.proj&quot; $(_ArcadeInputsBaselineArguments) %(_ArcadeInputsFailure.Arguments) -p:ResultFile=&quot;$(_ArcadeInputsBaselineRoot)bad-%(_ArcadeInputsFailure.Identity).txt&quot; -p:MSBuildEmitActionGraph=&quot;$(_ArcadeInputsBaselineRoot)bad-%(_ArcadeInputsFailure.Identity).ninja&quot; -bl:&quot;$(_ArcadeInputsBaselineRoot)bad-%(_ArcadeInputsFailure.Identity).binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" ItemName="_ArcadeInputsFailureExitCodes" />
      <Output TaskParameter="ConsoleOutput" ItemName="_ArcadeInputsFailureOutput" />
    </Exec>
    <PropertyGroup>
      <_ArcadeInputsFailureLog>@(_ArcadeInputsFailureOutput)</_ArcadeInputsFailureLog>
    </PropertyGroup>
    <Error Condition="'@(_ArcadeInputsFailureExitCodes->Count())' != '5' or '%(_ArcadeInputsFailureExitCodes.Identity)' == '0'"
           Text="Missing, unsupported, empty, wrong-source and incompatible Arcade inputs must all fail." />
    <Error Condition="!$(_ArcadeInputsFailureLog.Contains('MSB4019')) or
                      !$(_ArcadeInputsFailureLog.Contains('Target-framework inputs are missing or incompatible')) or
                      !$(_ArcadeInputsFailureLog.Contains('cannot be referenced'))"
           Text="Arcade failures must come from the required import, input validation and existing compatibility diagnostic." />
    <Error Condition="Exists('$(_ArcadeInputsBaselineRoot)bad-%(_ArcadeInputsFailure.Identity).ninja') or
                      Exists('$(_ArcadeInputsBaselineRoot)bad-%(_ArcadeInputsFailure.Identity).ninja.actions') or
                      Exists('$(_ArcadeInputsBaselineRoot)bad-%(_ArcadeInputsFailure.Identity).txt')"
           Text="Rejected Arcade inputs must not publish a graph, action directory or result (%(_ArcadeInputsFailure.Identity))." />
    <PropertyGroup>
      <_ArcadeSdkRoot>$(_ArcadeInputsRoot)sdk-package/</_ArcadeSdkRoot>
      <_ArcadeSdkPackageVersion>1.0.0-smoke-$([System.Guid]::NewGuid().ToString('N'))</_ArcadeSdkPackageVersion>
      <_ArcadeSdkInputs>$(_ArcadeSdkRoot)app/obj/targetframeworkinputs/Debug/AnyCPU/net11.0/ArcadeTargetFrameworkPackage.csproj.g.props</_ArcadeSdkInputs>
      <_ArcadeSdkHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_ArcadeSdkHostOS>
      <_ArcadeSdkHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_ArcadeSdkHostOS>
      <_ArcadeSdkHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_ArcadeSdkHostOS>
      <_ArcadeSdkHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_ArcadeSdkHostOS>
      <_ArcadeSdkArguments>-p:DirectoryBuildPropsPath=&quot;$(_ArcadeSdkRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_ArcadeSdkRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_ArcadeSdkRoot)Directory.Packages.props&quot; -p:RestoreSources=&quot;$(_ArcadeSdkRoot)feed&quot; -p:ArcadeTargetFrameworkPackageVersion=$(_ArcadeSdkPackageVersion) -p:Configuration=Debug -p:Platform=AnyCPU -p:MSBuildGraphHostOS=$(_ArcadeSdkHostOS) -p:NuGetAudit=false</_ArcadeSdkArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_ArcadeSdkRoot)package;$(_ArcadeSdkRoot)feed;$(_ArcadeSdkRoot)app" />
    <WriteLinesToFile File="$(_ArcadeSdkRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_ArcadeSdkRoot)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_ArcadeSdkRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <ItemGroup>
      <_ArcadeSdkPackageFile Include="$(_ArcadeInputsPackage)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ArcadeSdkPackageFile)"
          DestinationFiles="@(_ArcadeSdkPackageFile->'$(_ArcadeSdkRoot)package/%(RecursiveDir)%(Filename)%(Extension)')" />
    <WriteLinesToFile File="$(_ArcadeSdkRoot)package/Microsoft.DotNet.Build.Tasks.TargetFramework.nuspec" Overwrite="true"
                      Lines="&lt;package&gt;&lt;metadata&gt;&lt;id&gt;Microsoft.DotNet.Build.Tasks.TargetFramework&lt;/id&gt;&lt;version&gt;$(_ArcadeSdkPackageVersion)&lt;/version&gt;&lt;authors&gt;genbuild&lt;/authors&gt;&lt;description&gt;Local staged Arcade capture fixture&lt;/description&gt;&lt;/metadata&gt;&lt;/package&gt;" />
    <ZipDirectory SourceDirectory="$(_ArcadeSdkRoot)package"
                  DestinationFile="$(_ArcadeSdkRoot)feed/Microsoft.DotNet.Build.Tasks.TargetFramework.$(_ArcadeSdkPackageVersion).nupkg" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ArcadeTargetFrameworkPackage.csproj" DestinationFolder="$(_ArcadeSdkRoot)app" />
    <!-- No explicit capture target or preparation flag: fresh evaluation must see NuGet's generated imports. -->
    <Exec Command="$(_App) restore &quot;$(_ArcadeSdkRoot)app/ArcadeTargetFrameworkPackage.csproj&quot; $(_ArcadeSdkArguments) -bl:&quot;$(_ArcadeSdkRoot)restore.binlog&quot;" />
    <Error Condition="!Exists('$(_ArcadeSdkRoot)app/obj/ArcadeTargetFrameworkPackage.csproj.nuget.g.props') or
                      !Exists('$(_ArcadeSdkRoot)app/obj/ArcadeTargetFrameworkPackage.csproj.nuget.g.targets') or
                      !Exists('$(_ArcadeSdkInputs)') or Exists('$(_ArcadeSdkRoot)app/bin')"
           Text="Normal SDK Restore must import the newly restored Arcade task package and capture its configured runtime graph without building products." />
    <XmlPeek XmlInputPath="$(_ArcadeSdkInputs)" Query="/Project/PropertyGroup/_TargetFrameworkInputsVersion/text()">
      <Output TaskParameter="Result" PropertyName="_ArcadeSdkInputsVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_ArcadeSdkInputs)" Query="/Project/PropertyGroup/_TargetFrameworkInputsRuntimeGraphPath/text()">
      <Output TaskParameter="Result" PropertyName="_ArcadeSdkRuntimeGraphPath" />
    </XmlPeek>
    <Error Condition="'$(_ArcadeSdkInputsVersion)' != '1' or
                      '$(_ArcadeSdkRuntimeGraphPath)' != $([MSBuild]::NormalizePath('$(_AppDirectory)', 'toolset/PortableRuntimeIdentifierGraph.json'))"
           Text="Automatic package capture must record version 1 and the real SDK-selected portable runtime graph." />
    <Exec Command="$(_App) build &quot;$(_ArcadeSdkRoot)app/ArcadeTargetFrameworkPackage.csproj&quot; $(_ArcadeSdkArguments) -p:MSBuildEmitActionGraph=&quot;$(_ArcadeSdkRoot)build.ninja&quot; -bl:&quot;$(_ArcadeSdkRoot)build.binlog&quot;" />
    <Error Condition="!Exists('$(_ArcadeSdkRoot)build.ninja') or !Exists('$(_ArcadeSdkRoot)build.ninja.actions') or Exists('$(_ArcadeSdkRoot)app/bin')"
           Text="A fresh SDK graph must import the actual restored Arcade package and prepared inputs without executing product actions." />
    <Move SourceFiles="$(_ArcadeSdkInputs)" DestinationFiles="$(_ArcadeSdkInputs).saved" />
    <Exec Command="$(_App) build &quot;$(_ArcadeSdkRoot)app/ArcadeTargetFrameworkPackage.csproj&quot; $(_ArcadeSdkArguments) -p:MSBuildEmitActionGraph=&quot;$(_ArcadeSdkRoot)missing-input.ninja&quot; -bl:&quot;$(_ArcadeSdkRoot)missing-input.binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_ArcadeSdkMissingInputsExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_ArcadeSdkMissingInputsOutput" />
    </Exec>
    <PropertyGroup>
      <_ArcadeSdkMissingInputsLog>@(_ArcadeSdkMissingInputsOutput)</_ArcadeSdkMissingInputsLog>
    </PropertyGroup>
    <Error Condition="'$(_ArcadeSdkMissingInputsExit)' == '0' or !$(_ArcadeSdkMissingInputsLog.Contains('MSB4019')) or
                      !$(_ArcadeSdkMissingInputsLog.Contains('ArcadeTargetFrameworkPackage.csproj.g.props')) or
                      Exists('$(_ArcadeSdkRoot)missing-input.ninja') or Exists('$(_ArcadeSdkRoot)missing-input.ninja.actions')"
           Text="A missing real package-captured input must fail its required import before fresh SDK graph publication." />
    <ItemGroup>
      <_ArcadeSdkProduct Include="$(_ArcadeSdkRoot)app/bin/**/*;$(_ArcadeSdkRoot)app/obj/**/*.dll;$(_ArcadeSdkRoot)app/obj/**/*.pdb" />
    </ItemGroup>
    <Error Condition="'@(_ArcadeSdkProduct)' != ''" Text="SDK package preparation and graph construction must not compile or publish products." />
    <Message Importance="high" Text="Arcade target-framework inputs smoke checks passed: ordinary parity, platform fallback, multi-TFM RID metadata, explicit overrides, configured queries, literal JSON replay without a live graph, omission, fail-closed inputs and automatic capture through fresh SDK/NuGet package imports. $(_ArcadeInputsRoot)" />
  </Target>
  <Target Name="TestDirectoryImports">
    <PropertyGroup>
      <_DirectoryImportsRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'directory-imports'))</_DirectoryImportsRoot>
    </PropertyGroup>
    <MakeDir Directories="$(_DirectoryImportsRoot)WithFiles/child/App;$(_DirectoryImportsRoot)NoFiles/child/App" />
    <WriteLinesToFile File="$(_DirectoryImportsRoot)Directory.Build.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;DirectoryImportProps&gt;outside&lt;/DirectoryImportProps&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_DirectoryImportsRoot)Directory.Build.targets"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;DirectoryImportTargets&gt;outside&lt;/DirectoryImportTargets&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_DirectoryImportsRoot)Directory.Packages.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;DirectoryImportPackages&gt;outside&lt;/DirectoryImportPackages&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_DirectoryImportsRoot)WithFiles/Directory.Build.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;DirectoryImportProps&gt;root&lt;/DirectoryImportProps&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_DirectoryImportsRoot)WithFiles/child/Directory.Build.props"
                      Lines="&lt;Project&gt;&lt;Import Project=&quot;../Directory.Build.props&quot; /&gt;&lt;PropertyGroup&gt;&lt;DirectoryImportProps&gt;nearest&lt;/DirectoryImportProps&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_DirectoryImportsRoot)WithFiles/Directory.Build.targets"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;DirectoryImportTargets&gt;root-targets&lt;/DirectoryImportTargets&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_DirectoryImportsRoot)WithFiles/Directory.Packages.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;DirectoryImportPackages&gt;root-packages&lt;/DirectoryImportPackages&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_DirectoryImportProject Include="$(_DirectoryImportsRoot)WithFiles/child/App/App.csproj"
                               Root="$(_DirectoryImportsRoot)WithFiles/" Props="nearest" Targets="root-targets" Packages="root-packages" />
      <_DirectoryImportProject Include="$(_DirectoryImportsRoot)NoFiles/child/App/App.csproj"
                               Root="$(_DirectoryImportsRoot)NoFiles/" />
      <_DirectoryImportProject Update="@(_DirectoryImportProject)">
        <Arguments>-p:MSBuildGraphRepositoryRoot=&quot;%(_DirectoryImportProject.Root)&quot; -p:ExpectedDirectoryImportProps=&quot;%(_DirectoryImportProject.Props)&quot; -p:ExpectedDirectoryImportTargets=&quot;%(_DirectoryImportProject.Targets)&quot; -p:ExpectedDirectoryImportPackages=&quot;%(_DirectoryImportProject.Packages)&quot;</Arguments>
      </_DirectoryImportProject>
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)DirectoryImports.csproj" DestinationFiles="%(_DirectoryImportProject.Identity)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.cs" DestinationFiles="%(_DirectoryImportProject.Root)child/App/HelloWorld.cs" />
    <Exec Command="$(_App) restore &quot;%(_DirectoryImportProject.Identity)&quot; %(_DirectoryImportProject.Arguments) -bl:&quot;%(_DirectoryImportProject.Root)restore.binlog&quot;" />
    <Exec Command="$(_App) build &quot;%(_DirectoryImportProject.Identity)&quot; %(_DirectoryImportProject.Arguments) -p:MSBuildEmitActionGraph=&quot;%(_DirectoryImportProject.Root)build.ninja&quot; -bl:&quot;%(_DirectoryImportProject.Root)build.binlog&quot;" />
    <Error Condition="Exists('%(_DirectoryImportProject.Root)child/App/bin/Debug/net11.0/App.dll')"
           Text="Directory import resolution must not execute product actions during preparation or graph construction." />
    <Exec WorkingDirectory="%(_DirectoryImportProject.Root)child/App" Command="ninja -f &quot;%(_DirectoryImportProject.Root)build.ninja&quot;" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;%(_DirectoryImportProject.Root)child/App/bin/Debug/net11.0/App.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_DirectoryImportOutput" />
    </Exec>
    <Error Condition="'@(_DirectoryImportOutput->Count())' != '2' or '%(_DirectoryImportOutput.Identity)' != 'Hello from genbuild.'"
           Text="Repository-bounded directory imports must produce independently executable SDK graphs." />
  </Target>
  <Target Name="TestFrameworkBasics">
    <MSBuild Projects="$(MSBuildThisFileDirectory)WindowsSdkVersions.proj" Properties="GenBuildToolsetDirectory=$(_AppDirectory)/toolset/" />
    <PropertyGroup>
      <_FrameworkBasicsRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'framework-basics'))</_FrameworkBasicsRoot>
      <_FrameworkBasicsHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_FrameworkBasicsHostOS>
      <_FrameworkBasicsHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_FrameworkBasicsHostOS>
      <_FrameworkBasicsHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_FrameworkBasicsHostOS>
      <_FrameworkBasicsHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_FrameworkBasicsHostOS>
      <_FrameworkBasicsArguments>-p:DirectoryBuildPropsPath=&quot;$(_FrameworkBasicsRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_FrameworkBasicsRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_FrameworkBasicsRoot)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_FrameworkBasicsHostOS)</_FrameworkBasicsArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_FrameworkBasicsRoot)App;$(_FrameworkBasicsRoot)Library;$(_FrameworkBasicsRoot)Multiple" />
    <WriteLinesToFile File="$(_FrameworkBasicsRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_FrameworkBasicsRoot)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_FrameworkBasicsRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)FrameworkBasics.csproj;$(MSBuildThisFileDirectory)FrameworkBasics.csproj;$(MSBuildThisFileDirectory)FrameworkBasics.csproj"
          DestinationFiles="$(_FrameworkBasicsRoot)App/App.csproj;$(_FrameworkBasicsRoot)Library/Library.csproj;$(_FrameworkBasicsRoot)Multiple/Multiple.csproj" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/App/Program.cs;$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs;$(MSBuildThisFileDirectory)FrameworkBasicsComponent.cs"
          DestinationFiles="$(_FrameworkBasicsRoot)App/Program.cs;$(_FrameworkBasicsRoot)Library/Greeting.cs;$(_FrameworkBasicsRoot)Multiple/Component.cs" />
    <Exec Command="$(_App) restore &quot;$(_FrameworkBasicsRoot)App/App.csproj&quot; $(_FrameworkBasicsArguments) -bl:&quot;$(_FrameworkBasicsRoot)restore.binlog&quot;" />
    <Exec Command="$(_App) restore &quot;$(_FrameworkBasicsRoot)Multiple/Multiple.csproj&quot; $(_FrameworkBasicsArguments) -bl:&quot;$(_FrameworkBasicsRoot)multiple-restore.binlog&quot;" />
    <XmlPeek XmlInputPath="$(_FrameworkBasicsRoot)Library/obj/frameworkreferences/Debug/AnyCPU/netstandard2.0/Library.csproj.g.props"
             Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_FrameworkBasicsLibraryPack" />
    </XmlPeek>
    <Error Condition="'@(_FrameworkBasicsLibraryPack)' != '' or Exists('$(_FrameworkBasicsRoot)Library/bin') or Exists('$(_FrameworkBasicsRoot)App/bin') or Exists('$(_FrameworkBasicsRoot)Multiple/bin')"
           Text="Preparation must not snapshot package-authored references as pack inventory or prebuild products." />
    <Exec Command="$(_App) build &quot;$(_FrameworkBasicsRoot)App/App.csproj&quot; $(_FrameworkBasicsArguments) -p:MSBuildEmitActionGraph=&quot;$(_FrameworkBasicsRoot)build.ninja&quot; -bl:&quot;$(_FrameworkBasicsRoot)build.binlog&quot;" />
    <Exec Command="$(_App) build &quot;$(_FrameworkBasicsRoot)Multiple/Multiple.csproj&quot; $(_FrameworkBasicsArguments) -p:MSBuildEmitActionGraph=&quot;$(_FrameworkBasicsRoot)multiple.ninja&quot; -bl:&quot;$(_FrameworkBasicsRoot)multiple-build.binlog&quot;" />
    <Exec Command="$(_App) build &quot;$(_FrameworkBasicsRoot)Multiple/Multiple.csproj&quot; $(_FrameworkBasicsArguments) -p:DisableImplicitFrameworkReferences=true -p:MSBuildEmitActionGraph=&quot;$(_FrameworkBasicsRoot)stale.ninja&quot; -flp:&quot;LogFile=$(_FrameworkBasicsRoot)stale.log;Verbosity=quiet&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_FrameworkBasicsStaleExit" />
    </Exec>
    <Error Condition="'$(_FrameworkBasicsStaleExit)' == '0' or Exists('$(_FrameworkBasicsRoot)stale.ninja') or
                      !$([System.IO.File]::ReadAllText('$(_FrameworkBasicsRoot)stale.log').Contains('NETSDK1255'))"
           Text="Changed framework inputs must require a fresh Restore instead of replaying stale inventory or discovering packs." />
    <Error Condition="Exists('$(_FrameworkBasicsRoot)App/bin/Debug/net11.0/App.dll') or Exists('$(_FrameworkBasicsRoot)Library/bin/Debug/netstandard2.0/Library.dll') or Exists('$(_FrameworkBasicsRoot)Multiple/bin/Debug/net10.0/Multiple.dll')"
           Text="Framework decomposition must preserve graph-only construction and future project producers." />
    <Exec WorkingDirectory="$(_FrameworkBasicsRoot)App" Command="ninja -f &quot;$(_FrameworkBasicsRoot)build.ninja&quot;" />
    <Exec WorkingDirectory="$(_FrameworkBasicsRoot)Multiple" Command="ninja -f &quot;$(_FrameworkBasicsRoot)multiple.ninja&quot;" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_FrameworkBasicsRoot)App/bin/Debug/net11.0/App.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_FrameworkBasicsOutput" />
    </Exec>
    <Error Condition="'$(_FrameworkBasicsOutput)' != 'Hello from a project reference.' or
                      !Exists('$(_FrameworkBasicsRoot)Multiple/bin/Debug/net10.0/Multiple.dll') or
                      Exists('$(_FrameworkBasicsRoot)App/bin/Debug/net11.0/netstandard.dll')"
           Text="Independent execution must compile the package-backed library and combined targeting-pack inputs without copying reference facades." />
  </Target>
  <Target Name="TestConfiguredPreparation">
    <PropertyGroup>
      <_ConfiguredRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'configured-preparation'))</_ConfiguredRoot>
      <_ConfiguredHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_ConfiguredHostOS>
      <_ConfiguredHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_ConfiguredHostOS>
      <_ConfiguredHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_ConfiguredHostOS>
      <_ConfiguredHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_ConfiguredHostOS>
      <_ConfiguredArguments>-p:DirectoryBuildPropsPath=&quot;$(_ConfiguredRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_ConfiguredRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_ConfiguredRoot)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_ConfiguredHostOS) -p:PreparationMarker=parent -p:ParentOnlyProperty=parent</_ConfiguredArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_ConfiguredRoot)Parent;$(_ConfiguredRoot)Child" />
    <WriteLinesToFile File="$(_ConfiguredRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_ConfiguredRoot)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_ConfiguredRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ConfiguredPreparation.csproj;$(MSBuildThisFileDirectory)ConfiguredPreparation.csproj"
          DestinationFiles="$(_ConfiguredRoot)Parent/Parent.csproj;$(_ConfiguredRoot)Child/Child.csproj" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/App/Program.cs;$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs"
          DestinationFiles="$(_ConfiguredRoot)Parent/Program.cs;$(_ConfiguredRoot)Child/Greeting.cs" />
    <WriteLinesToFile File="$(_ConfiguredRoot)Parent/Debug.inputs" Lines="parent debug" Overwrite="true" />
    <WriteLinesToFile File="$(_ConfiguredRoot)Parent/Release.inputs" Lines="parent release" Overwrite="true" />
    <WriteLinesToFile File="$(_ConfiguredRoot)Child/Release.inputs" Lines="child release" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_ConfiguredRoot)Parent/Parent.csproj&quot; $(_ConfiguredArguments) -p:TargetFramework=net11.0 -p:Configuration=Debug -bl:&quot;$(_ConfiguredRoot)debug-restore.binlog&quot;" />
    <Exec Command="$(_App) restore &quot;$(_ConfiguredRoot)Parent/Parent.csproj&quot; $(_ConfiguredArguments) -p:TargetFramework=net10.0 -p:Configuration=Debug -bl:&quot;$(_ConfiguredRoot)net10-restore.binlog&quot;" />
    <Exec Command="$(_App) restore &quot;$(_ConfiguredRoot)Parent/Parent.csproj&quot; $(_ConfiguredArguments) -p:TargetFramework=net11.0 -p:Configuration=Release -bl:&quot;$(_ConfiguredRoot)release-restore.binlog&quot;" />
    <ItemGroup>
      <_ConfiguredSnapshot Include="$(_ConfiguredRoot)Parent/obj/frameworkreferences/Debug/AnyCPU/net11.0/Parent.csproj.g.props;$(_ConfiguredRoot)Parent/obj/frameworkreferences/Debug/AnyCPU/net10.0/Parent.csproj.g.props;$(_ConfiguredRoot)Parent/obj/frameworkreferences/Release/AnyCPU/net11.0/Parent.csproj.g.props;$(_ConfiguredRoot)Child/obj/frameworkreferences/Release/AnyCPU/net10.0/Child.csproj.g.props" />
      <_ConfiguredSnapshot Include="$(_ConfiguredRoot)Parent/obj/nugetinputs/Debug/AnyCPU/net11.0/Parent.csproj.g.props;$(_ConfiguredRoot)Parent/obj/nugetinputs/Debug/AnyCPU/net10.0/Parent.csproj.g.props;$(_ConfiguredRoot)Parent/obj/nugetinputs/Release/AnyCPU/net11.0/Parent.csproj.g.props;$(_ConfiguredRoot)Child/obj/nugetinputs/Release/AnyCPU/net10.0/Child.csproj.g.props" />
    </ItemGroup>
    <Error Condition="!Exists('%(_ConfiguredSnapshot.Identity)')" Text="Missing configured preparation snapshot: %(_ConfiguredSnapshot.Identity)" />
    <Error Condition="Exists('$(_ConfiguredRoot)Parent/bin') or Exists('$(_ConfiguredRoot)Child/bin') or Exists('$(_ConfiguredRoot)Child/obj/cscinputs/Debug') or Exists('$(_ConfiguredRoot)Child/obj/cscinputs/Release/AnyCPU/net11.0')"
           Text="Preparation must not build products or force the parent's configuration/framework onto its child." />
    <XmlPeek XmlInputPath="$(_ConfiguredRoot)Parent/obj/cscinputs/Debug/AnyCPU/net11.0/Parent.csproj.g.props" Query="/Project/ItemGroup/_CscPreparedToolInput/@Include">
      <Output TaskParameter="Result" ItemName="_ConfiguredDebugInput" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_ConfiguredRoot)Parent/obj/cscinputs/Release/AnyCPU/net11.0/Parent.csproj.g.props" Query="/Project/ItemGroup/_CscPreparedToolInput/@Include">
      <Output TaskParameter="Result" ItemName="_ConfiguredReleaseInput" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_ConfiguredRoot)Child/obj/cscinputs/Release/AnyCPU/net10.0/Child.csproj.g.props" Query="/Project/ItemGroup/_CscPreparedToolInput/@Include">
      <Output TaskParameter="Result" ItemName="_ConfiguredChildInput" />
    </XmlPeek>
    <PropertyGroup>
      <_ConfiguredDebugInputs>@(_ConfiguredDebugInput)</_ConfiguredDebugInputs>
      <_ConfiguredReleaseInputs>@(_ConfiguredReleaseInput)</_ConfiguredReleaseInputs>
      <_ConfiguredChildInputs>@(_ConfiguredChildInput)</_ConfiguredChildInputs>
    </PropertyGroup>
    <Error Condition="!$(_ConfiguredDebugInputs.Contains('Debug.inputs')) or $(_ConfiguredDebugInputs.Contains('Release.inputs')) or !$(_ConfiguredReleaseInputs.Contains('Release.inputs')) or !$(_ConfiguredChildInputs.Contains('Release.inputs'))"
           Text="Compiler inputs must remain distinct across configured preparations." />
    <Exec Command="$(_App) restore &quot;$(_ConfiguredRoot)Parent/Parent.csproj&quot; $(_ConfiguredArguments) -p:Configuration=Debug -bl:&quot;$(_ConfiguredRoot)outer-build-rejected.binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_ConfiguredOuterExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_ConfiguredOuterOutput" />
    </Exec>
    <PropertyGroup>
      <_ConfiguredOuterLog>@(_ConfiguredOuterOutput)</_ConfiguredOuterLog>
    </PropertyGroup>
    <Error Condition="'$(_ConfiguredOuterExit)' == '0' or !$(_ConfiguredOuterLog.Contains('NETSDK1247')) or Exists('$(_ConfiguredRoot)Parent/obj/frameworkreferences/Debug/AnyCPU/Parent.csproj.g.props') or Exists('$(_ConfiguredRoot)Parent/obj/genbuild/build.ninja')"
           Text="Outer preparation must require a selected framework and publish neither outer snapshots nor a graph." />
    <Exec Command="$(_App) restore &quot;$(_ConfiguredRoot)Parent/Parent.csproj&quot; $(_ConfiguredArguments) -p:TargetFramework=net11.0 -p:Configuration=Debug -p:ForcePreparationBuild=true -bl:&quot;$(_ConfiguredRoot)product-build-rejected.binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_ConfiguredProductBuildExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_ConfiguredProductBuildOutput" />
    </Exec>
    <PropertyGroup>
      <_ConfiguredProductBuildLog>@(_ConfiguredProductBuildOutput)</_ConfiguredProductBuildLog>
    </PropertyGroup>
    <Error Condition="'$(_ConfiguredProductBuildExit)' == '0' or !$(_ConfiguredProductBuildLog.Contains('Graph-input preparation cannot build project outputs')) or Exists('$(_ConfiguredRoot)Parent/bin') or Exists('$(_ConfiguredRoot)Child/bin')"
           Text="Preparation must explicitly reject attempts to prebuild product or tool outputs." />
    <Exec Command="$(_App) build &quot;$(_ConfiguredRoot)Parent/Parent.csproj&quot; $(_ConfiguredArguments) -p:TargetFramework=net11.0 -p:Configuration=Debug -p:MSBuildEmitActionGraph=&quot;$(_ConfiguredRoot)build.ninja&quot; -bl:&quot;$(_ConfiguredRoot)build.binlog&quot;" />
    <Error Condition="Exists('$(_ConfiguredRoot)Parent/bin/Debug/net11.0/Parent.dll') or Exists('$(_ConfiguredRoot)Child/bin/Release/net10.0/Child.dll')"
           Text="Configured graph construction must not compile products." />
    <Exec WorkingDirectory="$(_ConfiguredRoot)Parent" Command="ninja -f &quot;$(_ConfiguredRoot)build.ninja&quot;" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_ConfiguredRoot)Parent/bin/Debug/net11.0/Parent.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ConfiguredProgramOutput" />
    </Exec>
    <Error Condition="'$(_ConfiguredProgramOutput)' != 'Hello from a project reference.' or !Exists('$(_ConfiguredRoot)Child/bin/Release/net10.0/Child.dll')"
           Text="Configured preparation must support independent compilation with the negotiated child." />
  </Target>
  <Target Name="TestDiscoveryPreparation">
    <PropertyGroup>
      <_PreparedFactsRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'discovery-preparation'))</_PreparedFactsRoot>
      <_PreparedFactsHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_PreparedFactsHostOS>
      <_PreparedFactsHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_PreparedFactsHostOS>
      <_PreparedFactsHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_PreparedFactsHostOS>
      <_PreparedFactsHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_PreparedFactsHostOS>
      <_PreparedFactsArguments>-p:DirectoryBuildPropsPath=&quot;$(_PreparedFactsRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_PreparedFactsRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_PreparedFactsRoot)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_PreparedFactsHostOS)</_PreparedFactsArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_PreparedFactsRoot)App;$(_PreparedFactsRoot)Library" />
    <WriteLinesToFile File="$(_PreparedFactsRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_PreparedFactsRoot)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_PreparedFactsRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)DiscoveryPreparation.csproj;$(MSBuildThisFileDirectory)DiscoveryPreparation.csproj;$(MSBuildThisFileDirectory)ProjectReference/Metadata.proj;$(MSBuildThisFileDirectory)ProjectReference/App/Program.cs;$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs"
          DestinationFiles="$(_PreparedFactsRoot)App/App.csproj;$(_PreparedFactsRoot)Library/Library.csproj;$(_PreparedFactsRoot)Metadata.proj;$(_PreparedFactsRoot)App/Program.cs;$(_PreparedFactsRoot)Library/Greeting.cs" />
    <Exec Command="$(_App) restore &quot;$(_PreparedFactsRoot)App/App.csproj&quot; $(_PreparedFactsArguments) -bl:&quot;$(_PreparedFactsRoot)restore.binlog&quot;" />
    <ItemGroup>
      <_PreparedFactKind Include="frameworkreferences;nugetinputs;cscinputs;sourcelink">
        <ManifestExtension>props</ManifestExtension>
      </_PreparedFactKind>
      <_PreparedFactKind Condition="'%(_PreparedFactKind.Identity)' == 'sourcelink'">
        <ManifestExtension>targets</ManifestExtension>
      </_PreparedFactKind>
      <_DiscoveredPreparedFramework Include="net11.0;net10.0;netstandard2.0;net462" />
      <_DiscoveredPreparedFact Include="@(_DiscoveredPreparedFramework->'$(_PreparedFactsRoot)Library/obj/frameworkreferences/Debug/AnyCPU/%(Identity)/Library.csproj.g.props');
                                       @(_DiscoveredPreparedFramework->'$(_PreparedFactsRoot)Library/obj/nugetinputs/Debug/AnyCPU/%(Identity)/Library.csproj.g.props');
                                       @(_DiscoveredPreparedFramework->'$(_PreparedFactsRoot)Library/obj/cscinputs/Debug/AnyCPU/%(Identity)/Library.csproj.g.props');
                                       @(_DiscoveredPreparedFramework->'$(_PreparedFactsRoot)Library/obj/sourcelink/Debug/AnyCPU/%(Identity)/Library.csproj.g.targets')" />
      <_MissingDiscoveredPreparedFact Include="@(_PreparedFactKind)">
        <Path>$(_PreparedFactsRoot)Library/obj/%(Identity)/Debug/AnyCPU/net10.0/Library.csproj.g.%(ManifestExtension)</Path>
      </_MissingDiscoveredPreparedFact>
    </ItemGroup>
    <Error Condition="!Exists('%(_DiscoveredPreparedFact.Identity)')"
           Text="Restore must capture inputs for every configured framework request reached during discovery: %(_DiscoveredPreparedFact.Identity)" />
    <Error Condition="Exists('$(_PreparedFactsRoot)App/bin') or Exists('$(_PreparedFactsRoot)Library/bin') or
                      Exists('$(_PreparedFactsRoot)Library/obj/cscinputs/Release')"
           Text="Discovery-inclusive capture must not compile products or synthesize unrequested configurations." />
    <Exec Command="$(_App) restore &quot;$(_PreparedFactsRoot)Metadata.proj&quot; -t:Build $(_PreparedFactsArguments) -p:MetadataFile=ordinary.txt -bl:&quot;$(_PreparedFactsRoot)ordinary.binlog&quot;" />
    <Exec Command="$(_App) build &quot;$(_PreparedFactsRoot)Metadata.proj&quot; $(_PreparedFactsArguments) -p:MetadataFile=discovered.txt -p:MSBuildEmitActionGraph=&quot;$(_PreparedFactsRoot)discovered-metadata.ninja&quot; -bl:&quot;$(_PreparedFactsRoot)discovered-metadata.binlog&quot;" />
    <Error Condition="Exists('$(_PreparedFactsRoot)discovered.txt') or Exists('$(_PreparedFactsRoot)App/bin') or Exists('$(_PreparedFactsRoot)Library/bin')"
           Text="Metadata graph construction must not execute actions or compile projects." />
    <Exec WorkingDirectory="$(_PreparedFactsRoot)" Command="ninja -f discovered-metadata.ninja" />
    <GetFileHash Files="$(_PreparedFactsRoot)ordinary.txt;$(_PreparedFactsRoot)discovered.txt">
      <Output TaskParameter="Items" ItemName="_PreparedFactsMetadataHash" />
    </GetFileHash>
    <ReadLinesFromFile File="$(_PreparedFactsRoot)discovered.txt">
      <Output TaskParameter="Lines" PropertyName="_PreparedFactsMetadata" />
    </ReadLinesFromFile>
    <Error Condition="@(_PreparedFactsMetadataHash->'%(FileHash)'->Distinct()->Count()) != '1' or !$(_PreparedFactsMetadata.Contains('net11.0;net10.0;netstandard2.0;net462'))"
           Text="Prepared discovery must advertise every framework and match ordinary execution." />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="TestMissingDiscoveredPreparedFact"
             Properties="GenBuildApp=$(GenBuildApp);GenBuildTestHost=$(GenBuildTestHost);PreparedFactsRoot=$(_PreparedFactsRoot);PreparedFactPath=%(_MissingDiscoveredPreparedFact.Path);PreparedFactKind=%(_MissingDiscoveredPreparedFact.Identity);PreparedFactsHostOS=$(_PreparedFactsHostOS)" />
    <Exec Command="$(_App) build &quot;$(_PreparedFactsRoot)App/App.csproj&quot; $(_PreparedFactsArguments) -p:MSBuildEmitActionGraph=&quot;$(_PreparedFactsRoot)build.ninja&quot; -bl:&quot;$(_PreparedFactsRoot)build.binlog&quot;" />
    <Error Condition="Exists('$(_PreparedFactsRoot)App/bin/Debug/net11.0/App.dll') or Exists('$(_PreparedFactsRoot)Library/bin/Debug/net11.0/Library.dll')"
           Text="Selected-framework graph construction must not prebuild either project." />
    <Exec WorkingDirectory="$(_PreparedFactsRoot)App" Command="ninja -f &quot;$(_PreparedFactsRoot)build.ninja&quot;" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_PreparedFactsRoot)App/bin/Debug/net11.0/App.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PreparedFactsProgramOutput" />
    </Exec>
    <Error Condition="'$(_PreparedFactsProgramOutput)' != 'Hello from a project reference.' or
                      Exists('$(_PreparedFactsRoot)Library/bin/Debug/net10.0') or
                      Exists('$(_PreparedFactsRoot)Library/bin/Debug/netstandard2.0') or
                      Exists('$(_PreparedFactsRoot)Library/bin/Debug/net462')"
           Text="Independent execution must compile only the selected closure, not the other frameworks inspected during discovery." />
  </Target>
  <Target Name="TestMissingDiscoveredPreparedFact">
    <PropertyGroup>
      <_MissingFactGraph>$(PreparedFactsRoot)missing-$(PreparedFactKind).ninja</_MissingFactGraph>
    </PropertyGroup>
    <Move SourceFiles="$(PreparedFactPath)" DestinationFiles="$(PreparedFactPath).saved" />
    <Exec Command="$(_App) build &quot;$(PreparedFactsRoot)Metadata.proj&quot; -p:MSBuildGraphHostOS=$(PreparedFactsHostOS) -p:DirectoryBuildPropsPath=&quot;$(PreparedFactsRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(PreparedFactsRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(PreparedFactsRoot)Directory.Packages.props&quot; -p:MetadataFile=rejected-$(PreparedFactKind).txt -p:MSBuildEmitActionGraph=&quot;$(_MissingFactGraph)&quot; -bl:&quot;$(PreparedFactsRoot)missing-$(PreparedFactKind).binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_MissingFactExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_MissingFactOutput" />
    </Exec>
    <Move SourceFiles="$(PreparedFactPath).saved" DestinationFiles="$(PreparedFactPath)" />
    <PropertyGroup>
      <_MissingFactLog>@(_MissingFactOutput)</_MissingFactLog>
    </PropertyGroup>
    <Error Condition="'$(_MissingFactExitCode)' == '0' or !$(_MissingFactLog.Contains('MSB4019')) or !$(_MissingFactLog.Contains('$(PreparedFactKind)')) or
                      Exists('$(_MissingFactGraph)') or Exists('$(_MissingFactGraph).actions') or Exists('$(PreparedFactsRoot)rejected-$(PreparedFactKind).txt')"
           Text="Missing $(PreparedFactKind) facts for a discovered framework must fail its required import without publishing a graph or executing actions." />
  </Target>
  <Target Name="TestRuntimeGenAPI">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RuntimeGenAPI.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../src/runtime/eng/resolveContract.targets"
             Query="/Project/Target[@Name='AddImplementationAssembliesToGenAPIResolutionPath']">
      <Output TaskParameter="Result" ItemName="_RuntimeGenAPITarget" />
    </XmlPeek>
    <Error Condition="'@(_RuntimeGenAPITarget->Count())' != '1'" Text="Missing runtime GenAPI resolution hook." />
    <WriteLinesToFile File="$(_TestDirectory)RuntimeGenAPI.targets"
                      Lines="&lt;Project&gt;;@(_RuntimeGenAPITarget);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_RuntimeGenAPIOrdinaryCase Include="normal" Invocation="Build" CoreLibLayout="both" Arguments="" />
      <_RuntimeGenAPIOrdinaryCase Include="direct" Invocation="GenerateReferenceAssemblySource" CoreLibLayout="both" Arguments="-p:ExpectGenAPI=true -p:ExpectImplementationPaths=true" />
      <_RuntimeGenAPIOrdinaryCase Include="alias" Invocation="GenerateReferenceSource" CoreLibLayout="il" Arguments="-p:ExpectGenAPI=true -p:ExpectImplementationPaths=true" />
      <_RuntimeGenAPIOrdinaryCase Include="triggered" Invocation="Build" CoreLibLayout="both" Arguments="-p:GenerateReferenceAssemblySource=true -p:ExpectGenAPI=true -p:ExpectImplementationPaths=true" />
      <_RuntimeGenAPIOrdinaryCase Include="missing" Invocation="GenerateReferenceAssemblySource" CoreLibLayout="missing" Arguments="-p:ExpectGenAPI=true" />
      <_RuntimeGenAPIOrdinaryCase Include="override" Invocation="GenerateReferenceAssemblySource" CoreLibLayout="both" Arguments="-p:GenAPILibPath=custom -p:ExpectGenAPI=true" />
      <_RuntimeGenAPIOrdinaryCase Include="mono" Invocation="GenerateReferenceAssemblySource" CoreLibLayout="both" Arguments="-p:RuntimeFlavor=Mono -p:ExpectGenAPI=true" />
      <_RuntimeGenAPIOrdinaryCase Include="outer" Invocation="GenerateReferenceAssemblySource" CoreLibLayout="both" Arguments="-p:IsCrossTargetingBuild=true -p:ExpectGenAPI=true" />
      <_RuntimeGenAPICase Include="@(_RuntimeGenAPIOrdinaryCase)" />
      <_RuntimeGenAPICase Include="graph" CoreLibLayout="both" />
    </ItemGroup>
    <MakeDir Directories="$(_TestDirectory)runtime-genapi/%(_RuntimeGenAPICase.Identity)/coreclr/IL" />
    <WriteLinesToFile Condition="'%(_RuntimeGenAPICase.CoreLibLayout)' == 'both'"
                      File="$(_TestDirectory)runtime-genapi/%(_RuntimeGenAPICase.Identity)/coreclr/System.Private.CoreLib.dll"
                      Lines="metadata-path sentinel" Overwrite="true" />
    <WriteLinesToFile Condition="'%(_RuntimeGenAPICase.CoreLibLayout)' != 'missing'"
                      File="$(_TestDirectory)runtime-genapi/%(_RuntimeGenAPICase.Identity)/coreclr/IL/System.Private.CoreLib.dll"
                      Lines="metadata-path sentinel" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)RuntimeGenAPI.proj&quot; -p:TestCase=graph -p:CoreLibLayout=both -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)runtime-genapi.ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)runtime-genapi/graph/selection.txt')"
           Text="Normal compilation must not perform GenAPI discovery or execute publication during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f runtime-genapi.ninja" />
    <Error Condition="!Exists('$(_TestDirectory)runtime-genapi/graph/selection.txt')"
           Text="Independent execution must publish the normal-build selection check." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)RuntimeGenAPI.proj&quot; -p:TestCase=%(_RuntimeGenAPIOrdinaryCase.Identity) -p:CoreLibLayout=%(_RuntimeGenAPIOrdinaryCase.CoreLibLayout) -p:Invocation=%(_RuntimeGenAPIOrdinaryCase.Invocation) %(_RuntimeGenAPIOrdinaryCase.Arguments)" />
    <Error Condition="!Exists('$(_TestDirectory)runtime-genapi/%(_RuntimeGenAPIOrdinaryCase.Identity)/selection.txt')"
           Text="Every ordinary GenAPI entry-point and path-policy case must execute its checks." />
  </Target>
  <Target Name="TestRuntimeReferences">
    <PropertyGroup>
      <_RuntimeReferencesRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'runtime-references'))</_RuntimeReferencesRoot>
      <_RuntimeReferencesHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_RuntimeReferencesHostOS>
      <_RuntimeReferencesHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_RuntimeReferencesHostOS>
      <_RuntimeReferencesHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_RuntimeReferencesHostOS>
      <_RuntimeReferencesHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_RuntimeReferencesHostOS>
      <_RuntimeReferencesArguments>-p:DirectoryBuildPropsPath=&quot;$(_RuntimeReferencesRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_RuntimeReferencesRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_RuntimeReferencesRoot)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_RuntimeReferencesHostOS)</_RuntimeReferencesArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_RuntimeReferencesRoot)Parent;$(_RuntimeReferencesRoot)Replacement;$(_RuntimeReferencesRoot)Tool" />
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../src/runtime/Directory.Build.targets"
             Query="/Project/Target[@Name='FilterImplicitAssemblyReferences']">
      <Output TaskParameter="Result" ItemName="_RuntimeReferenceFilter" />
    </XmlPeek>
    <Error Condition="'@(_RuntimeReferenceFilter->Count())' != '1'" Text="Missing runtime reference filter." />
    <WriteLinesToFile File="$(_RuntimeReferencesRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_RuntimeReferencesRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_RuntimeReferencesRoot)Directory.Build.targets"
                      Lines="&lt;Project&gt;;@(_RuntimeReferenceFilter);&lt;/Project&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RuntimeReferences.csproj;$(MSBuildThisFileDirectory)RuntimeReferences.csproj;$(MSBuildThisFileDirectory)RuntimeReferences.csproj"
          DestinationFiles="$(_RuntimeReferencesRoot)Parent/Parent.csproj;$(_RuntimeReferencesRoot)Replacement/Replacement.csproj;$(_RuntimeReferencesRoot)Tool/Tool.csproj" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/App/Program.cs;$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs;$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs"
          DestinationFiles="$(_RuntimeReferencesRoot)Parent/Program.cs;$(_RuntimeReferencesRoot)Replacement/Greeting.cs;$(_RuntimeReferencesRoot)Tool/Greeting.cs" />
    <Exec Command="$(_App) restore &quot;$(_RuntimeReferencesRoot)Parent/Parent.csproj&quot; $(_RuntimeReferencesArguments) -bl:&quot;$(_RuntimeReferencesRoot)restore.binlog&quot;" />
    <Error Condition="Exists('$(_RuntimeReferencesRoot)Tool/bin') or Exists('$(_RuntimeReferencesRoot)Replacement/bin')"
           Text="Targeting-pack discovery must not build project or tool dependencies." />
    <XmlPeek XmlInputPath="$(_RuntimeReferencesRoot)Parent/obj/frameworkreferences/Debug/AnyCPU/net11.0/Parent.csproj.g.props"
             Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_RuntimePackCandidate" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_RuntimeReferencesRoot)Parent/obj/frameworkreferences/Debug/AnyCPU/net11.0/Parent.csproj.g.props"
             Query="/Project/ItemGroup/_FrameworkReferenceManifestAnalyzer/@Include">
      <Output TaskParameter="Result" ItemName="_RuntimePackAnalyzer" />
    </XmlPeek>
    <PropertyGroup>
      <_RuntimePackCandidateNames>@(_RuntimePackCandidate->'%(Filename)')</_RuntimePackCandidateNames>
    </PropertyGroup>
    <Error Condition="!$(_RuntimePackCandidateNames.Contains('System.Linq')) or !$(_RuntimePackCandidateNames.Contains('Fixture.Replacement')) or '@(_RuntimePackAnalyzer)' == ''"
           Text="Preparation must retain raw targeting-pack references and analyzers before project-dependent filtering." />
    <Exec Command="$(_App) build &quot;$(_RuntimeReferencesRoot)Parent/Parent.csproj&quot; $(_RuntimeReferencesArguments) -t:CheckAnalyzerReplacement -p:TestAnalyzerReplacement=true -p:MSBuildEmitActionGraph=&quot;$(_RuntimeReferencesRoot)analyzer-replacement.ninja&quot; -bl:&quot;$(_RuntimeReferencesRoot)analyzer-replacement.binlog&quot;" />
    <Exec Command="$(_App) build &quot;$(_RuntimeReferencesRoot)Parent/Parent.csproj&quot; $(_RuntimeReferencesArguments) -p:MSBuildEmitActionGraph=&quot;$(_RuntimeReferencesRoot)build.ninja&quot; -bl:&quot;$(_RuntimeReferencesRoot)build.binlog&quot;" />
    <Error Condition="Exists('$(_RuntimeReferencesRoot)Tool/bin/Debug/net11.0/Tool.dll') or Exists('$(_RuntimeReferencesRoot)Replacement/bin/Debug/net11.0/Fixture.Replacement.dll')"
           Text="Construction must retain tool/project producers without executing them." />
    <Exec WorkingDirectory="$(_RuntimeReferencesRoot)Parent" Command="ninja -f &quot;$(_RuntimeReferencesRoot)build.ninja&quot;" />
    <Error Condition="!Exists('$(_RuntimeReferencesRoot)Tool/bin/Debug/net11.0/Tool.dll')"
           Text="Build-order-only tool references must retain their producer actions." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_RuntimeReferencesRoot)Parent/bin/Debug/net11.0/Parent.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RuntimeReferencesOutput" />
    </Exec>
    <Error Condition="'$(_RuntimeReferencesOutput)' != 'Hello from a project reference.'"
           Text="The independently built program must consume its project replacement." />
  </Target>
  <Target Name="TestExplicitReferences">
    <PropertyGroup>
      <_ExplicitRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'explicit-references'))</_ExplicitRoot>
      <_ExplicitHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_ExplicitHostOS>
      <_ExplicitHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_ExplicitHostOS>
      <_ExplicitHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_ExplicitHostOS>
      <_ExplicitHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_ExplicitHostOS>
      <_ExplicitArguments>-p:DirectoryBuildPropsPath=&quot;$(_ExplicitRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_ExplicitRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_ExplicitRoot)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_ExplicitHostOS)</_ExplicitArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_ExplicitRoot)Parent;$(_ExplicitRoot)Tool" />
    <WriteLinesToFile File="$(_ExplicitRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_ExplicitRoot)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_ExplicitRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ExplicitReferences.csproj;$(MSBuildThisFileDirectory)ExplicitReferences.csproj"
          DestinationFiles="$(_ExplicitRoot)Parent/Parent.csproj;$(_ExplicitRoot)Tool/Tool.csproj" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ExplicitReferences.cs;$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs"
          DestinationFiles="$(_ExplicitRoot)Parent/Program.cs;$(_ExplicitRoot)Tool/Greeting.cs" />
    <Exec Command="$(_App) restore &quot;$(_ExplicitRoot)Parent/Parent.csproj&quot; $(_ExplicitArguments) -p:DisableImplicitFrameworkReferences=true -p:FrameworkReferenceFetchManifestPath=&quot;$(_ExplicitRoot)empty-framework.g.props&quot; -bl:&quot;$(_ExplicitRoot)empty-framework.binlog&quot;" />
    <XmlPeek XmlInputPath="$(_ExplicitRoot)empty-framework.g.props" Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_EmptyFrameworkPack" />
    </XmlPeek>
    <Error Condition="'@(_EmptyFrameworkPack)' != ''"
           Text="An empty framework-reference list is valid and must not capture project-declared references as pack facts." />
    <Exec Command="$(_App) restore &quot;$(_ExplicitRoot)Parent/Parent.csproj&quot; $(_ExplicitArguments) -bl:&quot;$(_ExplicitRoot)restore.binlog&quot;" />
    <Error Condition="Exists('$(_ExplicitRoot)Parent/bin') or Exists('$(_ExplicitRoot)Tool/bin')"
           Text="Preparing explicit references must not require referenced binaries or prebuild their producers." />
    <XmlPeek XmlInputPath="$(_ExplicitRoot)Parent/obj/frameworkreferences/Debug/AnyCPU/net11.0/Parent.csproj.g.props"
             Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_ExplicitPackReference" />
    </XmlPeek>
    <PropertyGroup>
      <_ExplicitPackNames>@(_ExplicitPackReference->'%(Filename)%(Extension)')</_ExplicitPackNames>
    </PropertyGroup>
    <Error Condition="'@(_ExplicitPackReference)' == '' or $(_ExplicitPackNames.Contains('Tool.dll'))"
           Text="Framework facts must contain only targeting-pack candidates, not project-declared file references." />
    <WriteLinesToFile File="$(_ExplicitRoot)legacy.g.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_ExplicitRoot)Parent/Parent.csproj&quot; $(_ExplicitArguments) -p:MSBuildRestoreGraphInputs=false -p:EnableFrameworkReferenceFetchManifest=true -p:FrameworkReferenceFetchManifestPath=&quot;$(_ExplicitRoot)legacy.g.props&quot; -p:ExplicitReference=Tool -bl:&quot;$(_ExplicitRoot)legacy-rejected.binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_LegacyExplicitExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_LegacyExplicitOutput" />
    </Exec>
    <PropertyGroup>
      <_LegacyExplicitLog>@(_LegacyExplicitOutput)</_LegacyExplicitLog>
    </PropertyGroup>
    <Error Condition="'$(_LegacyExplicitExit)' == '0' or !$(_LegacyExplicitLog.Contains('NETSDK1247')) or Exists('$(_ExplicitRoot)legacy.g.props')"
           Text="Legacy manifest-only Restore must still reject named references and invalidate stale snapshots." />
    <ItemGroup>
      <_RejectedExplicitReference Include="name" Reference="Tool" />
      <_RejectedExplicitReference Include="missing" Reference="missing/Tool.dll" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_ExplicitRoot)Parent/Parent.csproj&quot; $(_ExplicitArguments) -p:ExplicitReference=&quot;%(_RejectedExplicitReference.Reference)&quot; -p:RejectedReference=true -p:MSBuildEmitActionGraph=&quot;$(_ExplicitRoot)%(_RejectedExplicitReference.Identity).ninja&quot; -bl:&quot;$(_ExplicitRoot)%(_RejectedExplicitReference.Identity).binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" ItemName="_RejectedExplicitExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_RejectedExplicitOutput" />
    </Exec>
    <PropertyGroup>
      <_RejectedExplicitLog>@(_RejectedExplicitOutput)</_RejectedExplicitLog>
    </PropertyGroup>
    <Error Condition="!$(_RejectedExplicitLog.Contains('MSB3671')) or !$(_RejectedExplicitLog.Contains('MSB4286'))"
           Text="Explicit-reference failures must diagnose assembly names and missing declared inputs." />
    <Error Condition="'%(_RejectedExplicitExit.Identity)' == '0' or
                      Exists('$(_ExplicitRoot)%(_RejectedExplicitReference.Identity).ninja') or Exists('$(_ExplicitRoot)%(_RejectedExplicitReference.Identity).ninja.actions')"
           Text="Invalid explicit references must fail without name/HintPath fallbacks or partial graph publication." />
    <Exec Command="$(_App) build &quot;$(_ExplicitRoot)Parent/Parent.csproj&quot; $(_ExplicitArguments) -p:MSBuildEmitActionGraph=&quot;$(_ExplicitRoot)build.ninja&quot; -bl:&quot;$(_ExplicitRoot)build.binlog&quot;" />
    <Error Condition="Exists('$(_ExplicitRoot)Parent/bin/Debug/net11.0/Parent.dll') or Exists('$(_ExplicitRoot)Tool/bin/Debug/net11.0/Tool.dll')"
           Text="Explicit-reference graph construction must not execute producers." />
    <Exec WorkingDirectory="$(_ExplicitRoot)Parent" Command="ninja -f &quot;$(_ExplicitRoot)build.ninja&quot;" />
    <Error Condition="!Exists('$(_ExplicitRoot)Parent/bin/Debug/net11.0/Tool.dll') or !Exists('$(_ExplicitRoot)Parent/bin/Debug/net11.0/Tool.pdb')"
           Text="Independent execution must preserve explicit reference copy-local metadata and symbols." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_ExplicitRoot)Parent/bin/Debug/net11.0/Parent.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ExplicitProgramOutput" />
    </Exec>
    <Error Condition="'$(_ExplicitProgramOutput)' != 'Hello from a project reference.'"
           Text="Independent compilation must preserve explicit reference aliases and use the declared producer." />
  </Target>
  <Target Name="TestRuntimeTrimming">
    <PropertyGroup>
      <_RuntimeTrimmingRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'runtime-trimming'))</_RuntimeTrimmingRoot>
      <_RuntimeILLinkTargets>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../../src/runtime/eng/illink.targets'))</_RuntimeILLinkTargets>
      <_RuntimeTrimmingArguments>-p:MSBuildRestoreGraphInputs=false -p:RuntimeILLinkTargets=&quot;$(_RuntimeILLinkTargets)&quot; -p:DirectoryBuildPropsPath=&quot;$(_RuntimeTrimmingRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_RuntimeTrimmingRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_RuntimeTrimmingRoot)Directory.Packages.props&quot;</_RuntimeTrimmingArguments>
    </PropertyGroup>
    <ItemGroup>
      <_RuntimeTrimmingCase Include="portable" Arguments="-p:DebugType=portable" />
      <_RuntimeTrimmingCase Include="embedded" Arguments="-p:DebugType=embedded" />
      <_RuntimeTrimmingCase Include="no-symbols" Arguments="-p:DebugType=none" />
      <_RuntimeTrimmingCase Include="no-rewrite" Arguments="-p:DebugType=portable -p:ILLinkRewritePDBs=false" />
      <_RuntimeTrimmingCase Include="untrimmed" Arguments="-p:DebugType=portable -p:ILLinkTrimAssembly=false" />
    </ItemGroup>
    <MakeDir Directories="$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)" />
    <WriteLinesToFile File="$(_RuntimeTrimmingRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_RuntimeTrimmingRoot)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_RuntimeTrimmingRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RuntimeTrimming.csproj"
          DestinationFiles="$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)/RuntimeTrimming.csproj" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs"
          DestinationFiles="$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)/Greeting.cs" />
    <Exec Command="$(_App) restore &quot;$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)/RuntimeTrimming.csproj&quot; $(_RuntimeTrimmingArguments) %(_RuntimeTrimmingCase.Arguments) -bl:&quot;$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)-restore.binlog&quot;" />
    <Exec Command="$(_App) restore &quot;$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)/RuntimeTrimming.csproj&quot; -t:Build $(_RuntimeTrimmingArguments) %(_RuntimeTrimmingCase.Arguments) -bl:&quot;$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)-build.binlog&quot;" />
    <ItemGroup>
      <_RuntimeTrimmedCase Include="@(_RuntimeTrimmingCase)" Exclude="untrimmed" />
      <_RuntimeTrimmedCase>
        <LinkMarker>$([System.IO.File]::ReadAllText('$(_RuntimeTrimmingRoot)%(_RuntimeTrimmedCase.Identity)/obj/Debug/net11.0/linker-ran'))</LinkMarker>
        <CompilerTimestamp>$([System.IO.File]::GetLastWriteTimeUtc('$(_RuntimeTrimmingRoot)%(_RuntimeTrimmedCase.Identity)/obj/Debug/net11.0/PreTrim/RuntimeTrimming.dll').Ticks)</CompilerTimestamp>
      </_RuntimeTrimmedCase>
    </ItemGroup>
    <Exec Command="$(_App) restore &quot;$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)/RuntimeTrimming.csproj&quot; -t:Build $(_RuntimeTrimmingArguments) %(_RuntimeTrimmingCase.Arguments) -p:ExpectExistingTrimOutputs=true -bl:&quot;$(_RuntimeTrimmingRoot)%(_RuntimeTrimmingCase.Identity)-incremental.binlog&quot;" />
    <ItemGroup>
      <_RuntimeTrimmedCase>
        <CurrentLinkMarker>$([System.IO.File]::ReadAllText('$(_RuntimeTrimmingRoot)%(_RuntimeTrimmedCase.Identity)/obj/Debug/net11.0/linker-ran'))</CurrentLinkMarker>
        <CurrentCompilerTimestamp>$([System.IO.File]::GetLastWriteTimeUtc('$(_RuntimeTrimmingRoot)%(_RuntimeTrimmedCase.Identity)/obj/Debug/net11.0/PreTrim/RuntimeTrimming.dll').Ticks)</CurrentCompilerTimestamp>
      </_RuntimeTrimmedCase>
    </ItemGroup>
    <Error Condition="'%(_RuntimeTrimmedCase.LinkMarker)' != '%(_RuntimeTrimmedCase.CurrentLinkMarker)' or
                      '%(_RuntimeTrimmedCase.CompilerTimestamp)' != '%(_RuntimeTrimmedCase.CurrentCompilerTimestamp)'"
           Text="An unchanged %(_RuntimeTrimmedCase.Identity) build must reuse both compiler and linker outputs." />
    <Delete Files="$(_RuntimeTrimmingRoot)portable/obj/Debug/net11.0/RuntimeTrimming.pdb" />
    <Exec Command="$(_App) restore &quot;$(_RuntimeTrimmingRoot)portable/RuntimeTrimming.csproj&quot; -t:Build $(_RuntimeTrimmingArguments) -p:DebugType=portable -p:ExpectExistingTrimOutputs=true -bl:&quot;$(_RuntimeTrimmingRoot)missing-symbols.binlog&quot;" />
    <PropertyGroup>
      <_RecoveredLinkMarker>$([System.IO.File]::ReadAllText('$(_RuntimeTrimmingRoot)portable/obj/Debug/net11.0/linker-ran'))</_RecoveredLinkMarker>
      <_RecoveredCompilerTimestamp>$([System.IO.File]::GetLastWriteTimeUtc('$(_RuntimeTrimmingRoot)portable/obj/Debug/net11.0/PreTrim/RuntimeTrimming.dll').Ticks)</_RecoveredCompilerTimestamp>
    </PropertyGroup>
    <Error Condition="'%(_RuntimeTrimmedCase.Identity)' == 'portable' and
                      ('%(_RuntimeTrimmedCase.CompilerTimestamp)' != '$(_RecoveredCompilerTimestamp)' or
                       '%(_RuntimeTrimmedCase.LinkMarker)' == '$(_RecoveredLinkMarker)')"
           Text="Recovering final symbols must rerun linking without rewriting the compiler output." />
  </Target>
  <Target Name="TestPackageReferences">
    <PropertyGroup>
      <_PackageRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'package-references'))</_PackageRoot>
      <_PackageSeedArguments>-p:DirectoryBuildPropsPath=&quot;$(_PackageRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_PackageRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_PackageRoot)Directory.Packages.props&quot; -p:RestoreSources=&quot;$(_PackageRoot)feed&quot;</_PackageSeedArguments>
      <_PackageArguments>$(_PackageSeedArguments) -p:RestorePackagesPath=&quot;$(_PackageRoot)packages&quot;</_PackageArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_PackageRoot)seed;$(_PackageRoot)feed;$(_PackageRoot)package/ref/net11.0;$(_PackageRoot)package/lib/net11.0;$(_PackageRoot)package/analyzers/dotnet/roslyn4.0/cs;$(_PackageRoot)package/analyzers/dotnet/roslyn99.0/cs;$(_PackageRoot)package/analyzers/dotnet/vb;$(_PackageRoot)app" />
    <WriteLinesToFile File="$(_PackageRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_PackageRoot)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_PackageRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj" DestinationFolder="$(_PackageRoot)seed" />
    <Exec Command="$(_App) restore &quot;$(_PackageRoot)seed/HelloWorld.csproj&quot; $(_PackageSeedArguments) -bl:&quot;$(_PackageRoot)seed.binlog&quot;" />
    <XmlPeek XmlInputPath="$(_PackageRoot)seed/obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_PackageCompilerReference" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_PackageRoot)seed/obj/nugetinputs/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" Query="/Project/ItemGroup/_NuGetInput[@Include='%2524/project/restore/packagesPath']/Value/text()">
      <Output TaskParameter="Result" PropertyName="_PackageSeedCache" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_PackageRoot)seed/obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" Query="(/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/NuGetPackageVersion/text())[1]">
      <Output TaskParameter="Result" PropertyName="_PackageFrameworkVersion" />
    </XmlPeek>
    <ItemGroup>
      <_PackageFrameworkArchive Include="$(_PackageSeedCache)/microsoft.netcore.app.ref/$(_PackageFrameworkVersion)/*.nupkg;$(_PackageSeedCache)/microsoft.aspnetcore.app.ref/$(_PackageFrameworkVersion)/*.nupkg" />
    </ItemGroup>
    <Error Condition="'@(_PackageFrameworkArchive->Count())' != '2'" Text="The standalone toolset's matching framework archives must be available locally for this offline fixture." />
    <Copy SourceFiles="@(_PackageFrameworkArchive)" DestinationFolder="$(_PackageRoot)feed" />
    <WriteLinesToFile File="$(_PackageRoot)compile.rsp" Lines="@(_PackageCompilerReference->'-r:&quot;%(Identity)&quot;')" Overwrite="true" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; --roll-forward Major &quot;$(_AppDirectory)/toolset/Roslyn/bincore/csc.dll&quot; -noconfig -nostdlib+ -target:library -deterministic+ -out:&quot;$(_PackageRoot)package/lib/net11.0/PackageApi.dll&quot; -refout:&quot;$(_PackageRoot)package/ref/net11.0/PackageApi.dll&quot; -debug:portable -pdb:&quot;$(_PackageRoot)package/lib/net11.0/PackageApi.pdb&quot; @&quot;$(_PackageRoot)compile.rsp&quot; &quot;$(MSBuildThisFileDirectory)PackageLibrary.cs&quot;" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; --roll-forward Major &quot;$(_AppDirectory)/toolset/Roslyn/bincore/csc.dll&quot; -noconfig -nostdlib+ -target:library -deterministic+ -out:&quot;$(_PackageRoot)package/analyzers/dotnet/roslyn4.0/cs/PackageGenerator.dll&quot; -r:&quot;$(_AppDirectory)/toolset/Roslyn/bincore/Microsoft.CodeAnalysis.dll&quot; @&quot;$(_PackageRoot)compile.rsp&quot; &quot;$(MSBuildThisFileDirectory)PackageGenerator.cs&quot;" />
    <Copy SourceFiles="$(_PackageRoot)package/analyzers/dotnet/roslyn4.0/cs/PackageGenerator.dll" DestinationFolder="$(_PackageRoot)package/analyzers/dotnet/roslyn99.0/cs" />
    <WriteLinesToFile File="$(_PackageRoot)package/analyzers/dotnet/vb/NotAnAnalyzer.dll" Lines="Wrong-language assets must never be loaded." Overwrite="true" />
    <WriteLinesToFile File="$(_PackageRoot)package/GenBuild.Smoke.Package.nuspec"
                      Lines="&lt;package&gt;&lt;metadata&gt;&lt;id&gt;GenBuild.Smoke.Package&lt;/id&gt;&lt;version&gt;1.0.0&lt;/version&gt;&lt;authors&gt;genbuild&lt;/authors&gt;&lt;description&gt;Offline package selection fixture&lt;/description&gt;&lt;/metadata&gt;&lt;/package&gt;" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(_PackageRoot)package" DestinationFile="$(_PackageRoot)feed/GenBuild.Smoke.Package.1.0.0.nupkg" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)PackageReferences.csproj;$(MSBuildThisFileDirectory)PackageProgram.cs" DestinationFolder="$(_PackageRoot)app" />
    <Exec Command="$(_App) restore &quot;$(_PackageRoot)app/PackageReferences.csproj&quot; $(_PackageArguments) -bl:&quot;$(_PackageRoot)restore.binlog&quot;" />
    <Error Condition="Exists('$(_PackageRoot)app/bin') or !Exists('$(_PackageRoot)app/obj/nugetinputs/Debug/AnyCPU/net11.0/PackageReferences.csproj.g.props')" Text="Package preparation must capture context without compiling the consumer." />
    <XmlPeek XmlInputPath="$(_PackageRoot)app/obj/nugetinputs/Debug/AnyCPU/net11.0/PackageReferences.csproj.g.props" Query="/Project/PropertyGroup/_NuGetPackageContextVersion/text()">
      <Output TaskParameter="Result" PropertyName="_PackageContextVersion" />
    </XmlPeek>
    <Error Condition="'$(_PackageContextVersion)' != '1'" Text="Restore must capture the package-discovery context." />
    <ItemGroup>
      <_PackageCacheFile Include="$(_PackageRoot)packages/**/*" />
    </ItemGroup>
    <Move SourceFiles="@(_PackageCacheFile)" DestinationFiles="@(_PackageCacheFile->'$(_PackageRoot)unavailable/%(RecursiveDir)%(Filename)%(Extension)')" />
    <RemoveDir Directories="$(_PackageRoot)packages" />
    <Move SourceFiles="$(_PackageRoot)app/obj/project.assets.json" DestinationFiles="$(_PackageRoot)assets.saved" />
    <Exec Command="$(_App) build &quot;$(_PackageRoot)app/PackageReferences.csproj&quot; $(_PackageArguments) -p:TestCase=selection -p:MSBuildEmitActionGraph=&quot;$(_PackageRoot)selection.ninja&quot; -bl:&quot;$(_PackageRoot)selection.binlog&quot;" />
    <Error Condition="!Exists('$(_PackageRoot)selection.ninja') or Exists('$(_PackageRoot)selected-assets.txt') or Exists('$(_PackageRoot)packages') or Exists('$(_PackageRoot)app/obj/project.assets.json') or Exists('$(_PackageRoot)app/bin')"
           Text="Package selection must construct from facts without JSON, package directories or consumer binaries." />
    <Exec WorkingDirectory="$(_PackageRoot)app" Command="ninja -f &quot;$(_PackageRoot)selection.ninja&quot;" />
    <ReadLinesFromFile File="$(_PackageRoot)selected-assets.txt">
      <Output TaskParameter="Lines" ItemName="_SelectedPackageAsset" />
    </ReadLinesFromFile>
    <Error Condition="!@(_SelectedPackageAsset->AnyHaveMetadataValue('Identity', 'compile|$(_PackageRoot)packages/genbuild.smoke.package/1.0.0/ref/net11.0/PackageApi.dll')) or
                      !@(_SelectedPackageAsset->AnyHaveMetadataValue('Identity', 'runtime|$(_PackageRoot)packages/genbuild.smoke.package/1.0.0/lib/net11.0/PackageApi.dll')) or
                      !@(_SelectedPackageAsset->AnyHaveMetadataValue('Identity', 'analyzer|$(_PackageRoot)packages/genbuild.smoke.package/1.0.0/analyzers/dotnet/roslyn4.0/cs/PackageGenerator.dll'))"
           Text="Prepared selection must preserve compile/runtime separation and compatible generator paths without probing files." />
    <Move SourceFiles="@(_PackageCacheFile->'$(_PackageRoot)unavailable/%(RecursiveDir)%(Filename)%(Extension)')" DestinationFiles="@(_PackageCacheFile)" />
    <Move SourceFiles="$(_PackageRoot)assets.saved" DestinationFiles="$(_PackageRoot)app/obj/project.assets.json" />
    <Exec Command="$(_App) build &quot;$(_PackageRoot)app/PackageReferences.csproj&quot; $(_PackageArguments) -p:MSBuildEmitActionGraph=&quot;$(_PackageRoot)package.ninja&quot; -bl:&quot;$(_PackageRoot)build.binlog&quot;" />
    <Error Condition="!Exists('$(_PackageRoot)package.ninja') or Exists('$(_PackageRoot)app/bin') or Exists('$(_PackageRoot)app/obj/Debug/net11.0/PackageReferences.dll')"
           Text="Full graph construction must validate external inputs without compiling the consumer." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_PackageRoot)package.ninja').Contains('/ref/net11.0/PackageApi.dll')) or !$([System.IO.File]::ReadAllText('$(_PackageRoot)package.ninja').Contains('/lib/net11.0/PackageApi.dll')) or !$([System.IO.File]::ReadAllText('$(_PackageRoot)package.ninja').Contains('/roslyn4.0/cs/PackageGenerator.dll')) or $([System.IO.File]::ReadAllText('$(_PackageRoot)package.ninja').Contains('/roslyn99.0/')) or $([System.IO.File]::ReadAllText('$(_PackageRoot)package.ninja').Contains('NotAnAnalyzer.dll'))"
           Text="The graph must distinguish compile/runtime assets and select only compatible package generators." />
    <Exec WorkingDirectory="$(_PackageRoot)app" Command="ninja -f &quot;$(_PackageRoot)package.ninja&quot;" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_PackageRoot)app/bin/Debug/net11.0/PackageReferences.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_PackageProgramOutput" />
    </Exec>
    <Error Condition="'@(_PackageProgramOutput)' != 'runtime package implementation + package generator ran'"
           Text="Independent compilation must use the package generator and publish its runtime implementation." />
    <Exec Command="$(_App) restore &quot;$(_PackageRoot)app/PackageReferences.csproj&quot; $(_PackageArguments) -p:MSBuildRestoreGraphInputs=false -t:Build -p:UseSharedCompilation=false -p:OutputPath=&quot;$(_PackageRoot)ordinary/bin/&quot; -p:IntermediateOutputPath=&quot;$(_PackageRoot)ordinary/obj/&quot; -bl:&quot;$(_PackageRoot)ordinary.binlog&quot;" />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_PackageRoot)app/bin/Debug/net11.0/PackageReferences.deps.json')) != $([System.IO.File]::ReadAllText('$(_PackageRoot)ordinary/bin/PackageReferences.deps.json')) or $([System.IO.File]::ReadAllText('$(_PackageRoot)app/bin/Debug/net11.0/PackageReferences.runtimeconfig.json')) != $([System.IO.File]::ReadAllText('$(_PackageRoot)ordinary/bin/PackageReferences.runtimeconfig.json'))"
           Text="Package dependency and runtime manifests must preserve ordinary Build semantics." />
    <GetFileHash Files="$(_PackageRoot)packages/genbuild.smoke.package/1.0.0/lib/net11.0/PackageApi.dll;$(_PackageRoot)app/bin/Debug/net11.0/PackageApi.dll;$(_PackageRoot)ordinary/bin/PackageApi.dll">
      <Output TaskParameter="Items" ItemName="_PackageRuntimeHash" />
    </GetFileHash>
    <Error Condition="'@(_PackageRuntimeHash->'%(FileHash)'->Distinct()->Count())' != '1'" Text="Publication must copy the implementation, not the reference assembly." />
    <Exec Command="$(_App) build &quot;$(_PackageRoot)app/PackageReferences.csproj&quot; $(_PackageArguments) -p:TestCase=missing-location -p:MSBuildEmitActionGraph=&quot;$(_PackageRoot)missing-location.ninja&quot; -bl:&quot;$(_PackageRoot)missing-location.binlog&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_PackageMissingLocationExit" />
    </Exec>
    <Exec Command="$(_App) build &quot;$(_PackageRoot)app/PackageReferences.csproj&quot; $(_PackageArguments) -p:_NuGetPackageContextVersion=2 -p:MSBuildEmitActionGraph=&quot;$(_PackageRoot)invalid-context.ninja&quot; -bl:&quot;$(_PackageRoot)invalid-context.binlog&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_PackageInvalidContextExit" />
    </Exec>
    <Error Condition="'$(_PackageMissingLocationExit)' == '0' or '$(_PackageInvalidContextExit)' == '0' or Exists('$(_PackageRoot)missing-location.ninja') or Exists('$(_PackageRoot)missing-location.ninja.actions') or Exists('$(_PackageRoot)invalid-context.ninja') or Exists('$(_PackageRoot)invalid-context.ninja.actions')"
           Text="Missing locations and invalid package context must fail without publishing partial graphs." />
  </Target>
  <Target Name="TestPreparedConflicts">
    <PropertyGroup>
      <_PreparedConflictsRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'prepared-conflicts'))</_PreparedConflictsRoot>
    </PropertyGroup>
    <MakeDir Directories="$(_PreparedConflictsRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)PreparedConflicts.proj" DestinationFolder="$(_PreparedConflictsRoot)" />
    <ItemGroup>
      <_PreparedConflictCase Include="file-version;file-facts;preferred;override;aliases;producer;platform" />
      <_InvalidConflictCase Include="format;missing;invalid-version;ambiguous" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_PreparedConflictsRoot)PreparedConflicts.proj&quot; -p:TestCase=%(_PreparedConflictCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_PreparedConflictsRoot)%(_PreparedConflictCase.Identity).ninja&quot; -bl:&quot;$(_PreparedConflictsRoot)%(_PreparedConflictCase.Identity).binlog&quot;" />
    <Error Condition="Exists('$(_PreparedConflictsRoot)absent') or Exists('$(_PreparedConflictsRoot)%(_PreparedConflictCase.Identity).txt')"
           Text="Conflict selection must not read or produce the absent candidate binaries or execute actions." />
    <Exec Command="$(_App) build &quot;$(_PreparedConflictsRoot)PreparedConflicts.proj&quot; -p:TestCase=%(_InvalidConflictCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_PreparedConflictsRoot)%(_InvalidConflictCase.Identity).ninja&quot; -flp:&quot;LogFile=$(_PreparedConflictsRoot)%(_InvalidConflictCase.Identity).log;Verbosity=quiet&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_InvalidConflictExit" />
    </Exec>
    <Error Condition="'$(_InvalidConflictExit)' == '0' or Exists('$(_PreparedConflictsRoot)%(_InvalidConflictCase.Identity).ninja') or
                      !$([System.IO.File]::ReadAllText('$(_PreparedConflictsRoot)%(_InvalidConflictCase.Identity).log').Contains('NETSDK1255'))"
           Text="Missing, malformed or unresolved conflict facts must fail explicitly without publishing a graph." />
  </Target>
  <Target Name="TestFrameworkPackageReferences" DependsOnTargets="TestPreparedConflicts">
    <PropertyGroup>
      <_ArbitrationRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'framework-packages'))</_ArbitrationRoot>
      <_ArbitrationSeedArguments>-p:DirectoryBuildPropsPath=&quot;$(_ArbitrationRoot)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_ArbitrationRoot)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_ArbitrationRoot)Directory.Packages.props&quot; -p:RestoreSources=&quot;$(_ArbitrationRoot)feed&quot;</_ArbitrationSeedArguments>
      <_ArbitrationArguments>$(_ArbitrationSeedArguments) -p:RestorePackagesPath=&quot;$(_ArbitrationRoot)packages&quot;</_ArbitrationArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_ArbitrationRoot)seed;$(_ArbitrationRoot)feed" />
    <WriteLinesToFile File="$(_ArbitrationRoot)Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_ArbitrationRoot)Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_ArbitrationRoot)Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj" DestinationFolder="$(_ArbitrationRoot)seed" />
    <Exec Command="$(_App) restore &quot;$(_ArbitrationRoot)seed/HelloWorld.csproj&quot; $(_ArbitrationSeedArguments) -bl:&quot;$(_ArbitrationRoot)seed.binlog&quot;" />
    <XmlPeek XmlInputPath="$(_ArbitrationRoot)seed/obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" Query="/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/@Include">
      <Output TaskParameter="Result" ItemName="_ArbitrationCompilerReference" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_ArbitrationRoot)seed/obj/nugetinputs/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" Query="/Project/ItemGroup/_NuGetInput[@Include='%2524/project/restore/packagesPath']/Value/text()">
      <Output TaskParameter="Result" PropertyName="_ArbitrationSeedCache" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_ArbitrationRoot)seed/obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" Query="(/Project/ItemGroup/_FrameworkReferenceManifestCompileReference/NuGetPackageVersion/text())[1]">
      <Output TaskParameter="Result" PropertyName="_ArbitrationFrameworkVersion" />
    </XmlPeek>
    <ItemGroup>
      <_ArbitrationFrameworkArchive Include="$(_ArbitrationSeedCache)/microsoft.netcore.app.ref/$(_ArbitrationFrameworkVersion)/*.nupkg;$(_ArbitrationSeedCache)/microsoft.aspnetcore.app.ref/$(_ArbitrationFrameworkVersion)/*.nupkg" />
      <_ArbitrationLibraryReference Include="@(_ArbitrationCompilerReference)" Condition="'%(_ArbitrationCompilerReference.Filename)' != 'System.Collections.Immutable'" />
      <_ArbitrationCase Include="12.0.0" ExpectedOutput="newer package selected" />
      <_ArbitrationCase Include="10.0.0" ExpectedOutput="framework selected" />
    </ItemGroup>
    <Error Condition="'@(_ArbitrationFrameworkArchive->Count())' != '2'" Text="Matching framework archives must be available for the offline arbitration fixture." />
    <Copy SourceFiles="@(_ArbitrationFrameworkArchive)" DestinationFolder="$(_ArbitrationRoot)feed" />
    <WriteLinesToFile File="$(_ArbitrationRoot)compile.rsp" Lines="@(_ArbitrationLibraryReference->'-r:&quot;%(Identity)&quot;')" Overwrite="true" />
    <MakeDir Directories="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/package/ref/net11.0;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/package/lib/net11.0;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app" />
    <WriteLinesToFile File="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/Version.cs"
                      Lines="[assembly: System.Reflection.AssemblyVersion(&quot;%(_ArbitrationCase.Identity).0&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;%(_ArbitrationCase.Identity).0&quot;)]" Overwrite="true" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; --roll-forward Major &quot;$(_AppDirectory)/toolset/Roslyn/bincore/csc.dll&quot; -noconfig -nostdlib+ -target:library -deterministic+ -out:&quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/package/lib/net11.0/System.Collections.Immutable.dll&quot; -refout:&quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/package/ref/net11.0/System.Collections.Immutable.dll&quot; @&quot;$(_ArbitrationRoot)compile.rsp&quot; &quot;$(MSBuildThisFileDirectory)FrameworkPackageLibrary.cs&quot; &quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/Version.cs&quot;" />
    <WriteLinesToFile File="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/package/System.Collections.Immutable.nuspec"
                      Lines="&lt;package&gt;&lt;metadata&gt;&lt;id&gt;System.Collections.Immutable&lt;/id&gt;&lt;version&gt;%(_ArbitrationCase.Identity)&lt;/version&gt;&lt;authors&gt;genbuild&lt;/authors&gt;&lt;description&gt;Reference arbitration fixture&lt;/description&gt;&lt;/metadata&gt;&lt;/package&gt;" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/package" DestinationFile="$(_ArbitrationRoot)feed/System.Collections.Immutable.%(_ArbitrationCase.Identity).nupkg" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)FrameworkPackageReferences.csproj;$(MSBuildThisFileDirectory)FrameworkPackageProgram.cs"
          DestinationFiles="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/App.csproj;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/Program.cs" />
    <Exec Command="$(_App) restore &quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/App.csproj&quot; $(_ArbitrationArguments) -p:ReplacementVersion=%(_ArbitrationCase.Identity) -bl:&quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/restore.binlog&quot;" />
    <Exec Command="$(_App) restore &quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/App.csproj&quot; -t:ResolveReferences -p:MSBuildRestoreGraphInputs=false $(_ArbitrationArguments) -p:ReplacementVersion=%(_ArbitrationCase.Identity) -bl:&quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/ordinary-selection.binlog&quot;" />
    <ItemGroup>
      <_ArbitrationCacheFile Include="$(_ArbitrationRoot)packages/**/*" />
    </ItemGroup>
    <Move SourceFiles="@(_ArbitrationCacheFile)" DestinationFiles="@(_ArbitrationCacheFile->'$(_ArbitrationRoot)unavailable/%(RecursiveDir)%(Filename)%(Extension)')" />
    <RemoveDir Directories="$(_ArbitrationRoot)packages" />
    <Move SourceFiles="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/obj/project.assets.json" DestinationFiles="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/assets.saved" />
    <Exec Command="$(_App) build &quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/App.csproj&quot; $(_ArbitrationArguments) -p:ReplacementVersion=%(_ArbitrationCase.Identity) -p:TestCase=selection -p:MSBuildEmitActionGraph=&quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/selection.ninja&quot; -bl:&quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/selection.binlog&quot;" />
    <Error Condition="Exists('$(_ArbitrationRoot)packages') or Exists('$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/obj/project.assets.json') or Exists('$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/bin/Debug/net11.0/App.dll')"
           Text="Reference selection must work from facts without package files, JSON or product binaries." />
    <Move SourceFiles="@(_ArbitrationCacheFile->'$(_ArbitrationRoot)unavailable/%(RecursiveDir)%(Filename)%(Extension)')" DestinationFiles="@(_ArbitrationCacheFile)" />
    <Move SourceFiles="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/assets.saved" DestinationFiles="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/obj/project.assets.json" />
    <Exec Command="$(_App) build &quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/App.csproj&quot; $(_ArbitrationArguments) -p:ReplacementVersion=%(_ArbitrationCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/build.ninja&quot; -bl:&quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/build.binlog&quot;" />
    <Error Condition="Exists('$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/bin/Debug/net11.0/App.dll')"
           Text="Arbitrated graph construction must not compile products." />
    <Exec WorkingDirectory="$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app" Command="ninja -f &quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/build.ninja&quot;" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_ArbitrationRoot)%(_ArbitrationCase.Identity)/app/bin/Debug/net11.0/App.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_ArbitrationProgramOutput" />
    </Exec>
    <Error Condition="'@(_ArbitrationProgramOutput)' != '@(_ArbitrationCase->'%(ExpectedOutput)')'"
           Text="Independent execution must use the package replacement or the retained framework according to SDK policy." />
    <Error Condition="!Exists('$(_ArbitrationRoot)12.0.0/app/bin/Debug/net11.0/System.Collections.Immutable.dll') or Exists('$(_ArbitrationRoot)10.0.0/app/bin/Debug/net11.0/System.Collections.Immutable.dll')"
           Text="Runtime publication must agree with package/framework conflict policy." />
  </Target>
  <Target Name="TestNuGetInputs">
    <PropertyGroup>
      <_NuGetInputsRoot>$([MSBuild]::NormalizeDirectory('$(_TestDirectory)', 'nuget-inputs'))</_NuGetInputsRoot>
      <_NuGetManifest>$(_NuGetInputsRoot)obj/nugetinputs/HelloWorld.csproj.g.props</_NuGetManifest>
      <_NuGetFactsOutput>$(_NuGetInputsRoot)version.txt</_NuGetFactsOutput>
    </PropertyGroup>
    <MakeDir Directories="$(_NuGetInputsRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj;$(MSBuildThisFileDirectory)HelloWorld.cs;$(MSBuildThisFileDirectory)NuGetInputs.proj"
          DestinationFolder="$(_NuGetInputsRoot)" />
    <Exec Command="$(_App) restore &quot;$(_NuGetInputsRoot)HelloWorld.csproj&quot; $(_SdkArguments) -p:MSBuildRestoreGraphInputs=false -bl:&quot;$(_NuGetInputsRoot)ordinary-restore.binlog&quot;" />
    <Error Condition="!Exists('$(_NuGetInputsRoot)obj/project.assets.json') or Exists('$(_NuGetManifest)')"
           Text="Ordinary Restore without graph-input preparation must not create a NuGet fact manifest." />
    <Exec Command="$(_App) restore &quot;$(_NuGetInputsRoot)HelloWorld.csproj&quot; $(_SdkArguments) -p:MSBuildRestoreGraphInputs=false -t:_CaptureNuGetInputs -bl:&quot;$(_NuGetInputsRoot)capture.binlog&quot;" />
    <Error Condition="!Exists('$(_NuGetManifest)') or Exists('$(_NuGetInputsRoot)bin')"
           Text="Explicit ordinary preparation must capture NuGet facts without compiling the project." />
    <Delete Files="$(_NuGetInputsRoot)obj/project.assets.json" />
    <Exec Command="$(_App) build &quot;$(_NuGetInputsRoot)NuGetInputs.proj&quot; -p:NuGetInputsPath=&quot;$(_NuGetManifest)&quot; -p:NuGetFactsOutput=&quot;$(_NuGetFactsOutput)&quot; -p:MSBuildEmitActionGraph=&quot;$(_NuGetInputsRoot)facts.ninja&quot; -bl:&quot;$(_NuGetInputsRoot)facts.binlog&quot;" />
    <Error Condition="Exists('$(_NuGetFactsOutput)')"
           Text="Using imported NuGet facts during construction must not execute the file action." />
    <Exec WorkingDirectory="$(_NuGetInputsRoot)" Command="ninja -f facts.ninja" />
    <ReadLinesFromFile File="$(_NuGetFactsOutput)">
      <Output TaskParameter="Lines" PropertyName="_NuGetAssetsVersion" />
    </ReadLinesFromFile>
    <Error Condition="'$(_NuGetAssetsVersion)' != '4'"
           Text="An independent action must receive the numeric value from prepared NuGet facts without reopening JSON." />
    <PropertyGroup>
      <_NuGetAssetManifest>$(_NuGetInputsRoot)asset-inputs.props</_NuGetAssetManifest>
      <_NuGetAssetOutput>$(_NuGetInputsRoot)assets.txt</_NuGetAssetOutput>
      <_NuGetAssetArguments>-p:NuGetInputsPath=&quot;$(_NuGetAssetManifest)&quot; -p:NuGetFactsOutput=&quot;$(_NuGetAssetOutput)&quot; -p:TestNuGetAssetViews=true</_NuGetAssetArguments>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)NuGetAssets.json" DestinationFolder="$(_NuGetInputsRoot)" />
    <Exec Command="$(_App) restore &quot;$(_NuGetInputsRoot)HelloWorld.csproj&quot; $(_SdkArguments) -p:MSBuildRestoreGraphInputs=false -t:_CaptureNuGetInputs -p:ProjectAssetsFile=&quot;$(_NuGetInputsRoot)NuGetAssets.json&quot; -p:NuGetInputsPath=&quot;$(_NuGetAssetManifest)&quot; -bl:&quot;$(_NuGetInputsRoot)asset-capture.binlog&quot;" />
    <Delete Files="$(_NuGetInputsRoot)NuGetAssets.json;$(_NuGetInputsRoot)obj/project.assets.json" />
    <Exec Command="$(_App) build &quot;$(_NuGetInputsRoot)NuGetInputs.proj&quot; $(_NuGetAssetArguments) -p:MSBuildEmitActionGraph=&quot;$(_NuGetInputsRoot)assets.ninja&quot; -bl:&quot;$(_NuGetInputsRoot)asset-views.binlog&quot;" />
    <Error Condition="Exists('$(_NuGetAssetOutput)') or Exists('$(_NuGetInputsRoot)bin') or
                      Exists('$(_NuGetInputsRoot)NuGetAssets.json') or Exists('$(_NuGetInputsRoot)obj/project.assets.json')"
           Text="Pure asset views must construct without assets JSON, file publication or prebuilt project outputs." />
    <Exec WorkingDirectory="$(_NuGetInputsRoot)" Command="ninja -f assets.ninja" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/MSBuild.dll&quot; &quot;$(_NuGetInputsRoot)NuGetInputs.proj&quot; $(_NuGetAssetArguments) -t:Build -p:NuGetFactsOutput=&quot;$(_NuGetInputsRoot)ordinary-assets.txt&quot; -bl:&quot;$(_NuGetInputsRoot)ordinary-asset-views.binlog&quot;" />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_NuGetAssetOutput)')) != $([System.IO.File]::ReadAllText('$(_NuGetInputsRoot)ordinary-assets.txt'))"
           Text="Ordinary and independently executed consumers must receive identical asset views." />
    <ReadLinesFromFile File="$(_NuGetAssetOutput)">
      <Output TaskParameter="Lines" ItemName="_NuGetAssetLines" />
    </ReadLinesFromFile>
    <Error Condition="!@(_NuGetAssetLines->AnyHaveMetadataValue('Identity', 'compile|Library/1.0.0|bin/placeholder/Renamed.Library.dll|')) or
                     !@(_NuGetAssetLines->AnyHaveMetadataValue('Identity', 'compile|Package/1.2.3|ref/net11.0/Package.dll|custom'))"
           Text="Asset views must retain future project paths, package aliases and compile/runtime separation." />
    <Exec Command="$(_App) build &quot;$(_NuGetInputsRoot)NuGetInputs.proj&quot; $(_NuGetAssetArguments) -p:NuGetAssetsTarget=missing -p:MSBuildEmitActionGraph=&quot;$(_NuGetInputsRoot)missing-target.ninja&quot; -bl:&quot;$(_NuGetInputsRoot)missing-target.binlog&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_NuGetMissingTargetExitCode" />
    </Exec>
    <Exec Command="$(_App) build &quot;$(_NuGetInputsRoot)NuGetInputs.proj&quot; $(_NuGetAssetArguments) -p:_NuGetInputsFormatVersion=2 -p:MSBuildEmitActionGraph=&quot;$(_NuGetInputsRoot)invalid-format.ninja&quot; -bl:&quot;$(_NuGetInputsRoot)invalid-format.binlog&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_NuGetInvalidFormatExitCode" />
    </Exec>
    <Error Condition="'$(_NuGetMissingTargetExitCode)' == '0' or '$(_NuGetInvalidFormatExitCode)' == '0' or
                     Exists('$(_NuGetInputsRoot)missing-target.ninja') or Exists('$(_NuGetInputsRoot)missing-target.ninja.actions') or
                     Exists('$(_NuGetInputsRoot)invalid-format.ninja') or Exists('$(_NuGetInputsRoot)invalid-format.ninja.actions')"
           Text="Missing targets and unsupported fact formats must fail without partial graph publication." />
  </Target>
  <Target Name="TestNuGetSdkResolution">
    <PropertyGroup>
      <_SdkPackageRoot>$(_TestDirectory)package-sdk/</_SdkPackageRoot>
    </PropertyGroup>
    <MakeDir Directories="$(_SdkPackageRoot)package/Sdk;$(_SdkPackageRoot)feed" />
    <WriteLinesToFile File="$(_SdkPackageRoot)package/GenBuild.Smoke.Sdk.nuspec"
                      Lines="&lt;package&gt;&lt;metadata&gt;&lt;id&gt;GenBuild.Smoke.Sdk&lt;/id&gt;&lt;version&gt;1.0.0&lt;/version&gt;&lt;authors&gt;genbuild&lt;/authors&gt;&lt;description&gt;Local SDK resolver smoke fixture&lt;/description&gt;&lt;/metadata&gt;&lt;/package&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_SdkPackageRoot)package/Sdk/Sdk.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;ResolvedGenBuildTestSdk&gt;local-sdk-package&lt;/ResolvedGenBuildTestSdk&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_SdkPackageRoot)package/Sdk/Sdk.targets"
                      Lines="&lt;Project&gt;&lt;Target Name=&quot;Restore&quot;&gt;&lt;WriteLinesToFile File=&quot;sdk-restored.txt&quot; Lines=&quot;%24(ResolvedGenBuildTestSdk)&quot; Overwrite=&quot;true&quot; /&gt;&lt;/Target&gt;&lt;Target Name=&quot;Build&quot;&gt;&lt;WriteLinesToFile File=&quot;%24(MSBuildProjectDirectory)/sdk-built.txt&quot; Lines=&quot;%24(ResolvedGenBuildTestSdk)&quot; Overwrite=&quot;true&quot; DeclaredInputs=&quot;&quot; DeclaredOutputs=&quot;%24(MSBuildProjectDirectory)/sdk-built.txt&quot; /&gt;&lt;/Target&gt;&lt;/Project&gt;" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(_SdkPackageRoot)package" DestinationFile="$(_SdkPackageRoot)feed/GenBuild.Smoke.Sdk.1.0.0.nupkg" />
    <WriteLinesToFile File="$(_SdkPackageRoot)NuGet.Config"
                      Lines="&lt;configuration&gt;&lt;packageSources&gt;&lt;clear /&gt;&lt;add key=&quot;local&quot; value=&quot;feed&quot; /&gt;&lt;/packageSources&gt;&lt;config&gt;&lt;add key=&quot;globalPackagesFolder&quot; value=&quot;packages&quot; /&gt;&lt;/config&gt;&lt;/configuration&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_SdkPackageRoot)global.json"
                      Lines="{ &quot;msbuild-sdks&quot;: { &quot;GenBuild.Smoke.Sdk&quot;: &quot;1.0.0&quot; } }" Overwrite="true" />
    <WriteLinesToFile File="$(_SdkPackageRoot)Sdk.proj" Lines="&lt;Project Sdk=&quot;GenBuild.Smoke.Sdk&quot; /&gt;" Overwrite="true" />
    <Exec WorkingDirectory="$(_SdkPackageRoot)" Command="$(_App) restore &quot;$(_SdkPackageRoot)Sdk.proj&quot; -bl:&quot;$(_SdkPackageRoot)restore.binlog&quot;" />
    <ReadLinesFromFile File="$(_SdkPackageRoot)sdk-restored.txt">
      <Output TaskParameter="Lines" PropertyName="_SdkRestoreResult" />
    </ReadLinesFromFile>
    <Error Condition="'$(_SdkRestoreResult)' != 'local-sdk-package' or !Exists('$(_SdkPackageRoot)packages/genbuild.smoke.sdk/1.0.0/Sdk/Sdk.props')" Text="Restore must resolve the globally pinned SDK package from the local feed using the source-built NuGet SDK resolver." />
    <Exec WorkingDirectory="$(_SdkPackageRoot)" Command="$(_App) build &quot;$(_SdkPackageRoot)Sdk.proj&quot; -p:MSBuildGraphSdkBindingsDirectory=&quot;$(_SdkPackageRoot)missing-bindings&quot; -p:MSBuildEmitActionGraph=&quot;$(_SdkPackageRoot)missing.ninja&quot; -bl:&quot;$(_SdkPackageRoot)missing.binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_SdkBuildExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_SdkBuildOutput" />
    </Exec>
    <PropertyGroup>
      <_SdkBuildLog>@(_SdkBuildOutput)</_SdkBuildLog>
    </PropertyGroup>
    <Error Condition="'$(_SdkBuildExitCode)' == '0' or !$(_SdkBuildLog.Contains('missing prepared SDK binding')) or Exists('$(_SdkPackageRoot)missing.ninja') or Exists('$(_SdkPackageRoot)missing.ninja.actions')"
           Text="Hardened Build must reject uncaptured package-SDK imports without running SDK discovery or publishing a partial graph." />
    <WriteLinesToFile File="$(_SdkPackageRoot)NuGet.Config"
                      Lines="&lt;configuration&gt;&lt;packageSources&gt;&lt;clear /&gt;&lt;/packageSources&gt;&lt;config&gt;&lt;add key=&quot;globalPackagesFolder&quot; value=&quot;unavailable-packages&quot; /&gt;&lt;/config&gt;&lt;/configuration&gt;" Overwrite="true" />
    <Delete Files="$(_SdkPackageRoot)feed/GenBuild.Smoke.Sdk.1.0.0.nupkg" />
    <WriteLinesToFile File="$(_SdkPackageRoot)packages/genbuild.smoke.sdk/1.0.0/Sdk/Sdk.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;ResolvedGenBuildTestSdk&gt;live-sdk-authoring&lt;/ResolvedGenBuildTestSdk&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <Exec WorkingDirectory="$(_SdkPackageRoot)" Command="$(_App) build &quot;$(_SdkPackageRoot)Sdk.proj&quot; -p:MSBuildEmitActionGraph=&quot;$(_SdkPackageRoot)build.ninja&quot; -bl:&quot;$(_SdkPackageRoot)build.binlog&quot;" />
    <Error Condition="!Exists('$(_SdkPackageRoot)build.ninja') or Exists('$(_SdkPackageRoot)sdk-built.txt') or Exists('$(_SdkPackageRoot)unavailable-packages')"
           Text="Prepared SDK bindings must permit graph-only construction without package-SDK rediscovery." />
    <Exec WorkingDirectory="$(_SdkPackageRoot)" Command="ninja -f build.ninja" />
    <ReadLinesFromFile File="$(_SdkPackageRoot)sdk-built.txt">
      <Output TaskParameter="Lines" PropertyName="_SdkBuildResult" />
    </ReadLinesFromFile>
    <Error Condition="'$(_SdkBuildResult)' != 'live-sdk-authoring'"
           Text="SDK bindings must preserve live props/targets authoring and independently executable actions, not snapshot evaluated source values." />
    <WriteLinesToFile File="$(_SdkPackageRoot)Sdk.proj" Lines="&lt;Project Sdk=&quot;GenBuild.Smoke.Sdk/2.0.0&quot; /&gt;" Overwrite="true" />
    <Exec WorkingDirectory="$(_SdkPackageRoot)" Command="$(_App) build &quot;$(_SdkPackageRoot)Sdk.proj&quot; -p:MSBuildEmitActionGraph=&quot;$(_SdkPackageRoot)stale.ninja&quot; -bl:&quot;$(_SdkPackageRoot)stale.binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_StaleSdkBindingExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_StaleSdkBindingOutput" />
    </Exec>
    <PropertyGroup>
      <_StaleSdkBindingLog>@(_StaleSdkBindingOutput)</_StaleSdkBindingLog>
    </PropertyGroup>
    <Error Condition="'$(_StaleSdkBindingExitCode)' == '0' or !$(_StaleSdkBindingLog.Contains('missing prepared SDK binding')) or Exists('$(_SdkPackageRoot)stale.ninja') or Exists('$(_SdkPackageRoot)stale.ninja.actions')"
           Text="Changing an SDK request must require a fresh prepared binding, not reuse a previous version or rediscover it." />
  </Target>
  <Target Name="TestProjectReferences">
    <PropertyGroup>
      <_ProjectReferenceRoot>$(_TestDirectory)project-references/</_ProjectReferenceRoot>
      <_ProjectReferenceGraph>$([System.IO.Path]::GetFullPath('$(_ProjectReferenceRoot)build.ninja'))</_ProjectReferenceGraph>
      <_ProjectReferenceHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_ProjectReferenceHostOS>
      <_ProjectReferenceHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_ProjectReferenceHostOS>
      <_ProjectReferenceHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_ProjectReferenceHostOS>
      <_ProjectReferenceHostOS Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">freebsd</_ProjectReferenceHostOS>
      <_ProjectReferenceArguments>-p:DirectoryBuildPropsPath=&quot;$(_TestDirectory)Directory.Build.props&quot; -p:DirectoryBuildTargetsPath=&quot;$(_TestDirectory)Directory.Build.targets&quot; -p:DirectoryPackagesPropsPath=&quot;$(_TestDirectory)Directory.Packages.props&quot; -p:MSBuildGraphHostOS=$(_ProjectReferenceHostOS)</_ProjectReferenceArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_ProjectReferenceRoot)App;$(_ProjectReferenceRoot)Library" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/Actions.proj;$(MSBuildThisFileDirectory)ProjectReference/Metadata.proj;$(MSBuildThisFileDirectory)ProjectReference/FrameworkSelection.proj" DestinationFolder="$(_ProjectReferenceRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/Library/Actions.proj;$(MSBuildThisFileDirectory)ProjectReference/Library/Library.csproj;$(MSBuildThisFileDirectory)ProjectReference/Library/Greeting.cs" DestinationFolder="$(_ProjectReferenceRoot)Library" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/App/App.csproj;$(MSBuildThisFileDirectory)ProjectReference/App/Program.cs" DestinationFolder="$(_ProjectReferenceRoot)App" />
    <Exec Command="$(_App) restore &quot;$(_ProjectReferenceRoot)App/App.csproj&quot; $(_ProjectReferenceArguments) -bl:&quot;$(_ProjectReferenceRoot)restore.binlog&quot;" />
    <Error Condition="!Exists('$(_ProjectReferenceRoot)App/obj/project.assets.json') or !Exists('$(_ProjectReferenceRoot)Library/obj/project.assets.json') or !Exists('$(_ProjectReferenceRoot)App/obj/frameworkreferences/Debug/AnyCPU/net11.0/App.csproj.g.props') or !Exists('$(_ProjectReferenceRoot)Library/obj/frameworkreferences/Debug/AnyCPU/net11.0/Library.csproj.g.props') or !Exists('$(_ProjectReferenceRoot)App/obj/cscinputs/Debug/AnyCPU/net11.0/App.csproj.g.props') or !Exists('$(_ProjectReferenceRoot)Library/obj/cscinputs/Debug/AnyCPU/net11.0/Library.csproj.g.props') or !Exists('$(_ProjectReferenceRoot)App/obj/nugetinputs/Debug/AnyCPU/net11.0/App.csproj.g.props') or !Exists('$(_ProjectReferenceRoot)Library/obj/nugetinputs/Debug/AnyCPU/net11.0/Library.csproj.g.props')"
           Text="SDK Restore must prepare NuGet/framework/compiler inputs throughout the project-reference closure." />
    <Error Condition="Exists('$(_ProjectReferenceRoot)App/bin') or Exists('$(_ProjectReferenceRoot)Library/bin') or Exists('$(_ProjectReferenceRoot)App/obj/Debug/net11.0/App.dll') or Exists('$(_ProjectReferenceRoot)Library/obj/Debug/net11.0/Renamed.Library.dll')"
           Text="Project-reference preparation must not prebuild referenced assemblies." />
    <Exec Command="$(_App) restore &quot;$(_ProjectReferenceRoot)Metadata.proj&quot; -t:Build $(_ProjectReferenceArguments) -p:MetadataFile=ordinary-metadata.txt -bl:&quot;$(_ProjectReferenceRoot)ordinary-metadata.binlog&quot;" />
    <Exec Command="$(_App) build &quot;$(_ProjectReferenceRoot)Metadata.proj&quot; $(_ProjectReferenceArguments) -p:MetadataFile=metadata.txt -p:MSBuildEmitActionGraph=&quot;$(_ProjectReferenceRoot)metadata.ninja&quot; -bl:&quot;$(_ProjectReferenceRoot)metadata.binlog&quot;" />
    <Error Condition="Exists('$(_ProjectReferenceRoot)metadata.txt') or Exists('$(_ProjectReferenceRoot)Library/bin') or $([System.IO.Directory]::GetFiles('$(_ProjectReferenceRoot)metadata.ninja.actions', '*.json').Length) != '1'"
           Text="SDK target-framework metadata must be computed during construction without child file actions." />
    <Exec WorkingDirectory="$(_ProjectReferenceRoot)" Command="ninja -f metadata.ninja" />
    <PropertyGroup>
      <_ProjectReferenceMetadataBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_ProjectReferenceRoot)metadata.txt'))))</_ProjectReferenceMetadataBytes>
      <_ProjectReferenceOrdinaryMetadataBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_ProjectReferenceRoot)ordinary-metadata.txt'))))</_ProjectReferenceOrdinaryMetadataBytes>
    </PropertyGroup>
    <Error Condition="'$(_ProjectReferenceMetadataBytes)' != '$(_ProjectReferenceOrdinaryMetadataBytes)'"
           Text="SDK target-framework metadata returned to parent construction must match ordinary execution." />
    <CallTarget Targets="TestFrameworkSelection" />
    <CallTarget Targets="TestNativeManifest" />
    <CallTarget Targets="TestReferencePaths" />
    <Exec Command="$(_App) build &quot;$(_ProjectReferenceRoot)Actions.proj&quot; -p:MSBuildEmitActionGraph=&quot;$(_ProjectReferenceGraph)&quot; -bl:&quot;$(_ProjectReferenceRoot)build.binlog&quot;" />
    <Error Condition="Exists('$(_ProjectReferenceRoot)out/application.txt') or Exists('$(_ProjectReferenceRoot)Library/out/library.txt') or Exists('$(_ProjectReferenceRoot)Library/obj/genbuild/build.ninja')"
           Text="Child requests must contribute actions to the root graph without executing or publishing their own graph." />
    <Error Condition="$([System.IO.Directory]::GetFiles('$(_ProjectReferenceGraph).actions', '*.json').Length) != '2'"
           Text="Repeated child targets must contribute their producer exactly once." />
    <Exec WorkingDirectory="$(_ProjectReferenceRoot)" Command="ninja -f &quot;$(_ProjectReferenceGraph)&quot;" />
    <ReadLinesFromFile File="$(_ProjectReferenceRoot)out/application.txt">
      <Output TaskParameter="Lines" PropertyName="_ProjectReferenceContents" />
    </ReadLinesFromFile>
    <Error Condition="'$(_ProjectReferenceContents)' != 'Hello from a child project.'"
           Text="The root action must consume the independently generated child artifact." />
    <PropertyGroup>
      <_ProjectReferenceBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_ProjectReferenceRoot)out/application.txt'))))</_ProjectReferenceBytes>
    </PropertyGroup>
    <Exec Command="$(_App) restore &quot;$(_ProjectReferenceRoot)Actions.proj&quot; -t:Build -bl:&quot;$(_ProjectReferenceRoot)ordinary.binlog&quot;" />
    <PropertyGroup>
      <_ProjectReferenceOrdinaryBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_ProjectReferenceRoot)out/application.txt'))))</_ProjectReferenceOrdinaryBytes>
    </PropertyGroup>
    <Error Condition="'$(_ProjectReferenceBytes)' != '$(_ProjectReferenceOrdinaryBytes)'"
           Text="Independent project-reference outputs must match ordinary execution." />
    <Exec Command="$(_App) build &quot;$(_ProjectReferenceRoot)App/App.csproj&quot; $(_ProjectReferenceArguments) -p:MSBuildEmitActionGraph=&quot;$(_ProjectReferenceRoot)sdk.ninja&quot; -bl:&quot;$(_ProjectReferenceRoot)sdk.binlog&quot;" />
    <Error Condition="Exists('$(_ProjectReferenceRoot)App/bin/Debug/net11.0/App.dll') or Exists('$(_ProjectReferenceRoot)Library/bin/Debug/net11.0/Renamed.Library.dll') or Exists('$(_ProjectReferenceRoot)Library/obj/Debug/net11.0/Renamed.Library.dll')"
           Text="SDK project-reference construction must not prebuild either project." />
    <Exec WorkingDirectory="$(_ProjectReferenceRoot)" Command="ninja -f sdk.ninja" />
    <Error Condition="!Exists('$(_ProjectReferenceRoot)App/bin/Debug/net11.0/Renamed.Library.dll') or !Exists('$(_ProjectReferenceRoot)App/bin/Debug/net11.0/Renamed.Library.pdb')"
           Text="Copy-local publication must include the explicitly declared implementation assembly and symbols." />
    <GetFileHash Files="$(_ProjectReferenceRoot)Library/bin/Debug/net11.0/Renamed.Library.dll;$(_ProjectReferenceRoot)App/bin/Debug/net11.0/Renamed.Library.dll">
      <Output TaskParameter="Items" ItemName="_SdkProjectReferenceAssemblyHash" />
    </GetFileHash>
    <GetFileHash Files="$(_ProjectReferenceRoot)Library/bin/Debug/net11.0/Renamed.Library.pdb;$(_ProjectReferenceRoot)App/bin/Debug/net11.0/Renamed.Library.pdb">
      <Output TaskParameter="Items" ItemName="_SdkProjectReferenceSymbolsHash" />
    </GetFileHash>
    <Error Condition="@(_SdkProjectReferenceAssemblyHash->'%(FileHash)'->Distinct()->Count()) != '1' or @(_SdkProjectReferenceSymbolsHash->'%(FileHash)'->Distinct()->Count()) != '1'"
           Text="Copy-local outputs must match the producer artifacts byte for byte." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_ProjectReferenceRoot)App/bin/Debug/net11.0/App.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SdkProjectReferenceProgramOutput" />
    </Exec>
    <Error Condition="'@(_SdkProjectReferenceProgramOutput)' != 'Hello from a project reference.'"
           Text="The independently built SDK executable must load and call its renamed project-reference implementation." />
    <Copy SourceFiles="$(_ProjectReferenceRoot)App/bin/Debug/net11.0/App.deps.json" DestinationFiles="$(_ProjectReferenceRoot)independent.deps.json" />
    <Exec Command="$(_App) restore &quot;$(_ProjectReferenceRoot)App/App.csproj&quot; -t:Build $(_ProjectReferenceArguments) -p:MSBuildRestoreGraphInputs=false -p:UseSharedCompilation=false -bl:&quot;$(_ProjectReferenceRoot)sdk-ordinary.binlog&quot;" />
    <GetFileHash Files="$(_ProjectReferenceRoot)independent.deps.json;$(_ProjectReferenceRoot)App/bin/Debug/net11.0/App.deps.json">
      <Output TaskParameter="Items" ItemName="_SdkProjectReferenceDepsHash" />
    </GetFileHash>
    <Error Condition="@(_SdkProjectReferenceDepsHash->'%(FileHash)'->Distinct()->Count()) != '1'"
           Text="Project-reference dependency manifests must match ordinary Build, including renamed outputs and versions." />
  </Target>
  <Target Name="TestReferencePaths">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='ResolveAssemblyReferences' or @Name='_ValidateHardenedAssemblySearchPaths' or @Name='FindReferenceAssembliesForReferences' or @Name='_CopyFilesMarkedCopyLocal']">
      <Output TaskParameter="Result" ItemName="_ReferencePathTarget" />
    </XmlPeek>
    <Error Condition="'@(_ReferencePathTarget->Count())' != '4'" Text="The packaged Common targets must contain reference resolution and copy-local publication." />
    <ItemGroup>
      <_ReferencePathCase Include="normal;stale;write-failure;private-false;common-output;raw-filename" />
      <_ReferencePathNegative Include="name;name-hint;name-raw-filename" Code="MSB3671" />
      <_ReferencePathNegative Include="hardlink;symlink;read-only" Code="MSB3098" />
      <_ReferencePathCase Include="@(_ReferencePathNegative)" />
      <_ReferencePathRoot Include="@(_ReferencePathCase->'$(_TestDirectory)reference-paths/%(Identity)/')" />
      <_ReferencePathExecution Include="normal;stale;private-false;common-output;raw-filename" />
    </ItemGroup>
    <MakeDir Directories="@(_ReferencePathRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/ReferencePaths.proj" DestinationFolder="%(_ReferencePathRoot.Identity)" />
    <WriteLinesToFile File="%(_ReferencePathRoot.Identity)ReferencePaths.targets" Lines="&lt;Project&gt;;@(_ReferencePathTarget);&lt;/Project&gt;" Overwrite="true" />
    <MakeDir Directories="$(_TestDirectory)reference-paths/stale/out/nested" />
    <WriteLinesToFile File="$(_TestDirectory)reference-paths/stale/out/nested/implementation.dll" Lines="old assembly" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)reference-paths/stale/out/nested/implementation.pdb" Lines="old symbols" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)reference-paths/%(_ReferencePathCase.Identity)/ReferencePaths.proj&quot; -p:Case=%(_ReferencePathCase.Identity)"
          Condition="'%(_ReferencePathCase.Code)' == ''" />
    <Error Condition="Exists('$(_TestDirectory)reference-paths/normal/generated') or Exists('$(_TestDirectory)reference-paths/normal/out') or Exists('$(_TestDirectory)reference-paths/raw-filename/generated') or Exists('$(_TestDirectory)reference-paths/raw-filename/out')"
           Text="Explicit reference resolution and copy-local construction must not read generated assemblies or publish files." />
    <ReadLinesFromFile File="$(_TestDirectory)reference-paths/stale/out/nested/implementation.dll">
      <Output TaskParameter="Lines" PropertyName="_ReferencePathStaleContents" />
    </ReadLinesFromFile>
    <Error Condition="'$(_ReferencePathStaleContents)' != 'old assembly'" Text="Copy-local construction must leave old output untouched." />
    <Exec WorkingDirectory="$(_TestDirectory)reference-paths/%(_ReferencePathExecution.Identity)" Command="ninja -f obj/genbuild/build.ninja" />
    <GetFileHash Files="$(_TestDirectory)reference-paths/normal/generated/implementation.dll;$(_TestDirectory)reference-paths/normal/out/nested/implementation.dll;$(_TestDirectory)reference-paths/stale/out/nested/implementation.dll;$(_TestDirectory)reference-paths/raw-filename/out/nested/implementation.dll">
      <Output TaskParameter="Items" ItemName="_ReferencePathAssemblyHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)reference-paths/normal/generated/implementation.pdb;$(_TestDirectory)reference-paths/normal/out/nested/implementation.pdb;$(_TestDirectory)reference-paths/stale/out/nested/implementation.pdb;$(_TestDirectory)reference-paths/raw-filename/out/nested/implementation.pdb">
      <Output TaskParameter="Items" ItemName="_ReferencePathSymbolsHash" />
    </GetFileHash>
    <Error Condition="@(_ReferencePathAssemblyHash->'%(FileHash)'->Distinct()->Count()) != '1' or @(_ReferencePathSymbolsHash->'%(FileHash)'->Distinct()->Count()) != '1'"
           Text="Copy-local must use the explicit implementation and symbols, honor destination metadata and replace stale bytes." />
    <Error Condition="Exists('$(_TestDirectory)reference-paths/private-false/out') or Exists('$(_TestDirectory)reference-paths/common-output/out') or Exists('$(_TestDirectory)reference-paths/normal/out/nested/api.dll')"
           Text="Private=false and common-output opt-outs must be honored; compile reference assemblies are not runtime copies." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)reference-paths/%(_ReferencePathNegative.Identity)/ReferencePaths.proj&quot; -p:Case=%(_ReferencePathNegative.Identity) -flp:&quot;LogFile=$(_TestDirectory)reference-paths/%(_ReferencePathNegative.Identity)/rejected.log;Verbosity=quiet&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_ReferencePathRejectedExitCode" />
    </Exec>
    <Error Condition="@(_ReferencePathRejectedExitCode->AnyHaveMetadataValue('Identity', '0')) or !$([System.IO.File]::ReadAllText('$(_TestDirectory)reference-paths/%(_ReferencePathNegative.Identity)/rejected.log').Contains('%(_ReferencePathNegative.Code)')) or Exists('$(_TestDirectory)reference-paths/%(_ReferencePathNegative.Identity)/obj/genbuild/build.ninja') or Exists('$(_TestDirectory)reference-paths/%(_ReferencePathNegative.Identity)/obj/genbuild/build.ninja.actions') or Exists('$(_TestDirectory)reference-paths/%(_ReferencePathNegative.Identity)/generated')"
           Text="Non-path references, even with HintPath, and unsupported copy-local modes must fail explicitly without partial graphs or execution." />
    <Exec WorkingDirectory="$(_TestDirectory)reference-paths/write-failure"
          Command="ninja -f obj/genbuild/build.ninja &quot;$([System.IO.Path]::GetFullPath('$(_TestDirectory)reference-paths/write-failure/generated/implementation.dll'))&quot; &quot;$([System.IO.Path]::GetFullPath('$(_TestDirectory)reference-paths/write-failure/generated/implementation.pdb'))&quot;" />
    <MakeDir Directories="$(_TestDirectory)reference-paths/write-failure/out/nested/implementation.dll" />
    <ItemGroup>
      <_ReferencePathInvocation Include="$(_TestDirectory)reference-paths/write-failure/obj/genbuild/build.ninja.actions/*.json" />
      <_ReferencePathCopyInvocation Include="@(_ReferencePathInvocation)"
                                   Condition="$([System.IO.File]::ReadAllText('%(_ReferencePathInvocation.Identity)').Contains('Microsoft.Build.Tasks.CopyFiles'))" />
    </ItemGroup>
    <Error Condition="'@(_ReferencePathCopyInvocation->Count())' != '1'" Text="Copy-local publication must be an independent declared action." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_ReferencePathCopyInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_ReferencePathCopyFailureExitCode" />
    </Exec>
    <Error Condition="'$(_ReferencePathCopyFailureExitCode)' == '0'" Text="Independent copy-local publication failure must be fatal." />
  </Target>
  <Target Name="TestFrameworkSelection">
    <PropertyGroup>
      <_FrameworkSelectionRoot>$(_TestDirectory)project-references/</_FrameworkSelectionRoot>
    </PropertyGroup>
    <ItemGroup>
      <_FrameworkSelectionCase Include="exact" Expected="net8.0" />
      <_FrameworkSelectionCase Include="nearest" Expected="net7.0" />
      <_FrameworkSelectionCase Include="alias" Expected="second" />
      <_FrameworkSelectionCase Include="platform" Expected="desktop" />
      <_FrameworkSelectionCase Include="fallback" Expected="net461" />
      <_FrameworkSelectionCase Include="unspecified" Expected="" />
      <_FrameworkSelectionFailure Include="incompatible;invalid" />
    </ItemGroup>
    <Exec Command="$(_App) restore &quot;$(_FrameworkSelectionRoot)FrameworkSelection.proj&quot; -t:Build -p:Case=%(_FrameworkSelectionCase.Identity) -p:ResultFile=%(_FrameworkSelectionCase.Identity)-ordinary.txt -bl:&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity)-ordinary.binlog&quot;" />
    <Exec Command="$(_App) build &quot;$(_FrameworkSelectionRoot)FrameworkSelection.proj&quot; -p:Case=%(_FrameworkSelectionCase.Identity) -p:ResultFile=%(_FrameworkSelectionCase.Identity).txt -p:MSBuildEmitActionGraph=&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).ninja&quot; -bl:&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).binlog&quot;" />
    <Error Condition="Exists('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).txt') or Exists('$(_FrameworkSelectionRoot)missing') or $([System.IO.Directory]::GetFiles('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).ninja.actions', '*.json').Length) != '1'"
           Text="Framework selection must use supplied metadata without inspecting referenced project files or publishing content." />
    <Exec WorkingDirectory="$(_FrameworkSelectionRoot)" Command="ninja -f %(_FrameworkSelectionCase.Identity).ninja" />
    <ItemGroup>
      <_FrameworkSelectionCase>
        <ActualBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).txt'))))</ActualBytes>
        <OrdinaryBytes>$([System.Convert]::ToBase64String($([System.IO.File]::ReadAllBytes('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity)-ordinary.txt'))))</OrdinaryBytes>
        <ContainsExpected>$([System.IO.File]::ReadAllText('$(_FrameworkSelectionRoot)%(_FrameworkSelectionCase.Identity).txt').Contains('|%(_FrameworkSelectionCase.Expected)|literal;value'))</ContainsExpected>
      </_FrameworkSelectionCase>
    </ItemGroup>
    <Error Condition="'%(_FrameworkSelectionCase.ActualBytes)' != '%(_FrameworkSelectionCase.OrdinaryBytes)'"
           Text="Independent framework selection must preserve ordinary assigned metadata." />
    <Error Condition="'%(_FrameworkSelectionCase.ContainsExpected)' != 'true'"
           Text="Framework selection did not return the expected nearest target alias and original metadata." />
    <Exec Command="$(_App) build &quot;$(_FrameworkSelectionRoot)FrameworkSelection.proj&quot; -p:Case=%(_FrameworkSelectionFailure.Identity) -p:ResultFile=%(_FrameworkSelectionFailure.Identity).txt -p:MSBuildEmitActionGraph=&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).ninja&quot; -bl:&quot;$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).binlog&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_FrameworkSelectionFailureExitCode" />
    </Exec>
    <Error Condition="'%(_FrameworkSelectionFailureExitCode.Identity)' == '0'"
           Text="Invalid or incompatible frameworks must fail." />
    <Error Condition="Exists('$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).ninja') or Exists('$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).ninja.actions') or Exists('$(_FrameworkSelectionRoot)%(_FrameworkSelectionFailure.Identity).txt')"
           Text="Invalid or incompatible frameworks must fail without publishing partial action graphs or content." />
  </Target>
  <Target Name="TestResourceMetadata">
    <PropertyGroup>
      <_ResourceMetadataRoot>$(_TestDirectory)resource-metadata/</_ResourceMetadataRoot>
    </PropertyGroup>
    <MakeDir Directories="$(_ResourceMetadataRoot)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.CSharp.CurrentVersion.targets"
             Query="/Project/Target[@Name='CreateManifestResourceNames']">
      <Output TaskParameter="Result" ItemName="_ResourceMetadataTargets" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='ResolveKeySource']">
      <Output TaskParameter="Result" ItemName="_ResourceMetadataTargets" />
    </XmlPeek>
    <Error Condition="'@(_ResourceMetadataTargets->Count())' != '2'" Text="Resource and signing tests must use the packaged targets." />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ResourceMetadata.proj" DestinationFolder="$(_ResourceMetadataRoot)" />
    <WriteLinesToFile File="$(_ResourceMetadataRoot)ResourceMetadata.targets" Lines="&lt;Project&gt;;@(_ResourceMetadataTargets);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_ResourceMetadataRoot)ResourceMetadata.proj&quot; -p:ResultFile=graph.txt -bl:&quot;$(_ResourceMetadataRoot)build.binlog&quot;" />
    <Error Condition="Exists('$(_ResourceMetadataRoot)missing') or Exists('$(_ResourceMetadataRoot)graph.txt')"
           Text="Resource naming and key selection must not require resource/source/key files or execute actions during construction." />
    <Exec WorkingDirectory="$(_ResourceMetadataRoot)" Command="ninja -f obj/genbuild/build.ninja" />
    <Exec Command="$(_App) restore &quot;$(_ResourceMetadataRoot)ResourceMetadata.proj&quot; -t:Build -p:ResultFile=ordinary.txt -bl:&quot;$(_ResourceMetadataRoot)ordinary.binlog&quot;" />
    <GetFileHash Files="$(_ResourceMetadataRoot)graph.txt;$(_ResourceMetadataRoot)ordinary.txt">
      <Output TaskParameter="Items" ItemName="_ResourceMetadataHash" />
    </GetFileHash>
    <Error Condition="'@(_ResourceMetadataHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Resource metadata and explicit signing paths must match ordinary execution." />
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../src/runtime/src/tools/illink/src/linker/Mono.Linker.csproj"
             Query="/Project/ItemGroup/EmbeddedResource[@Update]">
      <Output TaskParameter="Result" ItemName="_RuntimeResourceMetadata" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../src/runtime/src/tools/illink/src/ILLink.Shared/ILLink.Shared.projitems"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:ItemGroup/msb:EmbeddedResource">
      <Output TaskParameter="Result" ItemName="_RuntimeResourceMetadata" />
    </XmlPeek>
    <Error Condition="'@(_RuntimeResourceMetadata->Count())' != '2'" Text="Missing ILLink resource authoring." />
    <PropertyGroup>
      <_RuntimeResourceMetadataXml>@(_RuntimeResourceMetadata, '')</_RuntimeResourceMetadataXml>
      <_RuntimeResourceMetadataXml>$(_RuntimeResourceMetadataXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_RuntimeResourceMetadataXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_ResourceMetadataRoot)RuntimeResourceMetadata.props"
                      Lines="&lt;Project&gt;&lt;ItemGroup&gt;;$(_RuntimeResourceMetadataXml);&lt;/ItemGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_ResourceMetadataRoot)ResourceMetadata.proj&quot; -p:TestCase=illink -p:ResultFile=illink-graph.txt -p:MSBuildEmitActionGraph=&quot;$(_ResourceMetadataRoot)illink.ninja&quot;" />
    <Error Condition="Exists('$(_ResourceMetadataRoot)Resources') or Exists('$(_ResourceMetadataRoot)SharedStrings.resx') or Exists('$(_ResourceMetadataRoot)illink-graph.txt')"
           Text="Explicit ILLink naming must not require source/resource files or execute publication during construction." />
    <Exec WorkingDirectory="$(_ResourceMetadataRoot)" Command="ninja -f illink.ninja" />
    <Exec Command="$(_App) restore &quot;$(_ResourceMetadataRoot)ResourceMetadata.proj&quot; -t:Build -p:TestCase=illink -p:ResultFile=illink-ordinary.txt" />
    <GetFileHash Files="$(_ResourceMetadataRoot)illink-graph.txt;$(_ResourceMetadataRoot)illink-ordinary.txt">
      <Output TaskParameter="Items" ItemName="_IllinkResourceMetadataHash" />
    </GetFileHash>
    <Error Condition="'@(_IllinkResourceMetadataHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Explicit ILLink resource names must match ordinary execution while the source naming convention remains enabled." />
    <ItemGroup>
      <_ResourceMetadataRejected Include="convention;dependent" Code="MSB3672" />
      <_ResourceMetadataRejected Include="pfx;missing-key;certificate;certificate-file;container;manifest" Code="MSB3673" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_ResourceMetadataRoot)ResourceMetadata.proj&quot; -p:TestCase=%(_ResourceMetadataRejected.Identity) -p:ResultFile=%(_ResourceMetadataRejected.Identity).txt -p:MSBuildEmitActionGraph=&quot;$(_ResourceMetadataRoot)%(_ResourceMetadataRejected.Identity).ninja&quot; -flp:&quot;LogFile=$(_ResourceMetadataRoot)%(_ResourceMetadataRejected.Identity).log;Verbosity=quiet&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_ResourceMetadataRejectedExit" />
    </Exec>
    <Error Condition="@(_ResourceMetadataRejectedExit->AnyHaveMetadataValue('Identity', '0')) or
                      !$([System.IO.File]::ReadAllText('$(_ResourceMetadataRoot)%(_ResourceMetadataRejected.Identity).log').Contains('%(_ResourceMetadataRejected.Code)')) or
                      Exists('$(_ResourceMetadataRoot)%(_ResourceMetadataRejected.Identity).ninja') or Exists('$(_ResourceMetadataRoot)%(_ResourceMetadataRejected.Identity).ninja.actions') or
                      Exists('$(_ResourceMetadataRoot)%(_ResourceMetadataRejected.Identity).txt') or Exists('$(_ResourceMetadataRoot)missing')"
           Text="Source-dependent naming and machine-backed signing must fail explicitly without partial graphs or execution." />
  </Target>
  <Target Name="TestRuntimeResourceCompilation">
    <PropertyGroup>
      <_RuntimeResourceRoot>$(_TestDirectory)runtime-resource-compilation/</_RuntimeResourceRoot>
    </PropertyGroup>
    <MakeDir Directories="$(_RuntimeResourceRoot)inputs" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RuntimeResourceCompilation.proj" DestinationFolder="$(_RuntimeResourceRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../src/runtime/src/tools/illink/src/linker/Resources/Strings.resx;$(MSBuildThisFileDirectory)../../src/runtime/src/tools/illink/src/ILLink.Shared/SharedStrings.resx"
          DestinationFolder="$(_RuntimeResourceRoot)inputs" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='CoreResGen']">
      <Output TaskParameter="Result" PropertyName="_RuntimeResourceTarget" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Query="/*[local-name()='Project']/*[local-name()='PropertyGroup']/*[local-name()='GenerateResourceUsePreserializedResources']">
      <Output TaskParameter="Result" PropertyName="_RuntimeResourceDefault" />
    </XmlPeek>
    <Error Condition="'$(_RuntimeResourceTarget)' == '' or '$(_RuntimeResourceDefault)' == ''"
           Text="Runtime resource compilation must use the packaged target and SDK serialization default." />
    <PropertyGroup>
      <_RuntimeResourceDefault>$(_RuntimeResourceDefault.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_RuntimeResourceDefault>
    </PropertyGroup>
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../src/runtime/src/tools/illink/src/linker/Mono.Linker.csproj"
             Query="/Project/PropertyGroup/GenerateResourceUsePreserializedResources">
      <Output TaskParameter="Result" PropertyName="_RuntimeResourcePolicy" />
    </XmlPeek>
    <WriteLinesToFile File="$(_RuntimeResourceRoot)ResourceDefaults.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;;$(_RuntimeResourceDefault);&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_RuntimeResourceRoot)ResourcePolicy.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;;$(_RuntimeResourcePolicy);&lt;/PropertyGroup&gt;&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_RuntimeResourceRoot)ResourceCompilation.targets"
                      Lines="&lt;Project&gt;;$(_RuntimeResourceTarget);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_RuntimeResourceRoot)RuntimeResourceCompilation.proj&quot; -t:Build -p:TestCase=baseline -p:UseRuntimePolicy=false" />
    <Exec Command="$(_App) restore &quot;$(_RuntimeResourceRoot)RuntimeResourceCompilation.proj&quot; -t:Build -p:TestCase=ordinary" />
    <Exec Command="$(_App) restore &quot;$(_RuntimeResourceRoot)RuntimeResourceCompilation.proj&quot; -p:TestCase=graph" />
    <Exec Command="$(_App) build &quot;$(_RuntimeResourceRoot)RuntimeResourceCompilation.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_RuntimeResourceRoot)build.ninja&quot;" />
    <Error Condition="Exists('$(_RuntimeResourceRoot)obj/graph/Strings.resx') or
                      Exists('$(_RuntimeResourceRoot)obj/graph/SharedStrings.resx') or
                      Exists('$(_RuntimeResourceRoot)obj/graph/Mono.Linker.Resources.Strings.resources') or
                      Exists('$(_RuntimeResourceRoot)obj/graph/ILLink.Shared.SharedStrings.resources')"
           Text="Resource construction must not execute RESX producers or create compiled resources." />
    <Exec WorkingDirectory="$(_RuntimeResourceRoot)" Command="ninja -f build.ninja" />
    <ItemGroup>
      <_RuntimeResourceFile Include="Mono.Linker.Resources.Strings.resources;ILLink.Shared.SharedStrings.resources" />
    </ItemGroup>
    <GetFileHash Files="@(_RuntimeResourceFile->'$(_RuntimeResourceRoot)obj/baseline/%(Identity)')">
      <Output TaskParameter="Items" ItemName="_RuntimeResourceBaselineHash" />
    </GetFileHash>
    <GetFileHash Files="@(_RuntimeResourceFile->'$(_RuntimeResourceRoot)obj/ordinary/%(Identity)')">
      <Output TaskParameter="Items" ItemName="_RuntimeResourceOrdinaryHash" />
    </GetFileHash>
    <GetFileHash Files="@(_RuntimeResourceFile->'$(_RuntimeResourceRoot)obj/graph/%(Identity)')">
      <Output TaskParameter="Items" ItemName="_RuntimeResourceGraphHash" />
    </GetFileHash>
    <Error Condition="'@(_RuntimeResourceBaselineHash->'%(FileHash)')' != '@(_RuntimeResourceOrdinaryHash->'%(FileHash)')' or
                      '@(_RuntimeResourceBaselineHash->'%(FileHash)')' != '@(_RuntimeResourceGraphHash->'%(FileHash)')' or
                      Exists('$(_RuntimeResourceRoot)obj/graph/RuntimeResourceCompilation.proj.GenerateResource.cache')"
           Text="Actual ILLink resources must preserve SDK-default preserialized bytes in ordinary and independent execution, without an action-side incremental cache." />
  </Target>
  <Target Name="TestInternalsVisibleTo">
    <PropertyGroup>
      <_IvtRoot>$(_TestDirectory)internals-visible-to/</_IvtRoot>
      <_IvtSource>obj/InternalsVisibleTo.InternalsVisibleTo.cs</_IvtSource>
    </PropertyGroup>
    <ItemGroup>
      <_IvtCase Include="csharp;visualbasic;fsharp;empty" />
      <_IvtExecution Include="csharp;visualbasic;empty" />
      <_IvtDirectory Include="@(_IvtCase->'$(_IvtRoot)%(Identity)/action/');@(_IvtExecution->'$(_IvtRoot)%(Identity)/ordinary/')" />
    </ItemGroup>
    <MakeDir Directories="@(_IvtDirectory);$(_IvtRoot)csharp/action/obj" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)InternalsVisibleTo.proj" DestinationFolder="%(_IvtDirectory.Identity)" />
    <WriteLinesToFile File="$(_IvtRoot)csharp/action/$(_IvtSource)" Lines="stale generated attributes" Overwrite="true" />
    <GetFileHash Files="$(_IvtRoot)csharp/action/$(_IvtSource)">
      <Output TaskParameter="Hash" PropertyName="_IvtStaleBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_IvtRoot)%(_IvtCase.Identity)/action/InternalsVisibleTo.proj&quot; -p:TestCase=%(_IvtCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_IvtRoot)%(_IvtCase.Identity)/action/build.ninja&quot;" />
    <GetFileHash Files="$(_IvtRoot)csharp/action/$(_IvtSource)">
      <Output TaskParameter="Hash" PropertyName="_IvtStaleAfter" />
    </GetFileHash>
    <Error Condition="'$(_IvtStaleBefore)' != '$(_IvtStaleAfter)' or Exists('$(_IvtRoot)visualbasic/action/obj') or
                      Exists('$(_IvtRoot)fsharp/action/obj') or Exists('$(_IvtRoot)empty/action/obj') or
                      Exists('$(_IvtRoot)%(_IvtCase.Identity)/action/items.txt')"
           Text="IVT construction must not create generated sources, change stale output or publish metadata files." />
    <Exec WorkingDirectory="$(_IvtRoot)%(_IvtExecution.Identity)/action" Command="ninja -f build.ninja" />
    <Exec Command="$(_App) restore &quot;$(_IvtRoot)%(_IvtExecution.Identity)/ordinary/InternalsVisibleTo.proj&quot; -t:Build -p:TestCase=%(_IvtExecution.Identity)" />
    <ItemGroup>
      <_IvtResult Include="csharp" SourceExtension=".cs" />
      <_IvtResult Include="visualbasic" SourceExtension=".vb" />
    </ItemGroup>
    <GetFileHash Files="$(_IvtRoot)%(_IvtResult.Identity)/action/obj/InternalsVisibleTo.InternalsVisibleTo%(_IvtResult.SourceExtension)">
      <Output TaskParameter="Items" ItemName="_IvtActionSourceHash" />
    </GetFileHash>
    <GetFileHash Files="$(_IvtRoot)%(_IvtResult.Identity)/ordinary/obj/InternalsVisibleTo.InternalsVisibleTo%(_IvtResult.SourceExtension)">
      <Output TaskParameter="Items" ItemName="_IvtOrdinarySourceHash" />
    </GetFileHash>
    <Error Condition="'@(_IvtActionSourceHash->'%(FileHash)')' != '@(_IvtOrdinarySourceHash->'%(FileHash)')'"
           Text="Independent IVT generation must match ordinary source bytes." />
    <GetFileHash Files="$(_IvtRoot)%(_IvtExecution.Identity)/action/items.txt">
      <Output TaskParameter="Items" ItemName="_IvtActionItemsHash" />
    </GetFileHash>
    <GetFileHash Files="$(_IvtRoot)%(_IvtExecution.Identity)/ordinary/items.txt">
      <Output TaskParameter="Items" ItemName="_IvtOrdinaryItemsHash" />
    </GetFileHash>
    <Error Condition="'@(_IvtActionItemsHash->'%(FileHash)')' != '@(_IvtOrdinaryItemsHash->'%(FileHash)')' or
                      Exists('$(_IvtRoot)empty/action/obj') or Exists('$(_IvtRoot)empty/ordinary/obj')"
           Text="Static IVT compile and clean items must match ordinary publication, including empty no-ops." />
    <PropertyGroup>
      <_IvtCSharp>$([System.IO.File]::ReadAllText('$(_IvtRoot)csharp/action/$(_IvtSource)'))</_IvtCSharp>
      <_IvtVisualBasic>$([System.IO.File]::ReadAllText('$(_IvtRoot)visualbasic/action/obj/InternalsVisibleTo.InternalsVisibleTo.vb'))</_IvtVisualBasic>
    </PropertyGroup>
    <Error Condition="!$(_IvtCSharp.Contains('ExplicitFriend, PublicKey=0123')) or !$(_IvtCSharp.Contains('InheritedFriend, PublicKey=abcd')) or
                      !$(_IvtVisualBasic.Contains('ExplicitFriend, PublicKey=0123')) or !$(_IvtVisualBasic.Contains('&quot;InheritedFriend&quot;'))"
           Text="IVT generation must preserve explicit keys, project-key fallback and unsigned friend names." />
    <ItemGroup>
      <_IvtFSharpInvocation Include="$(_IvtRoot)fsharp/action/build.ninja.actions/*.json" />
      <_IvtFSharpItems Include="@(_IvtFSharpInvocation)"
                       Condition="$([System.IO.File]::ReadAllText('%(_IvtFSharpInvocation.Identity)').Contains('&quot;taskType&quot;:&quot;Microsoft.Build.Tasks.WriteLinesToFile&quot;'))" />
    </ItemGroup>
    <Error Condition="'@(_IvtFSharpItems->Count())' != '1'" Text="F# IVT construction must emit one metadata writer." />
    <ReadLinesFromFile File="@(_IvtFSharpItems)">
      <Output TaskParameter="Lines" PropertyName="_IvtFSharpItemsJson" />
    </ReadLinesFromFile>
    <Error Condition="!$(_IvtFSharpItemsJson.Contains('&quot;itemSpec&quot;:&quot;CompileBefore=obj/InternalsVisibleTo.InternalsVisibleTo.fs&quot;')) or
                      !$(_IvtFSharpItemsJson.Contains('&quot;itemSpec&quot;:&quot;FileWrites=obj/InternalsVisibleTo.InternalsVisibleTo.fs&quot;')) or
                      $(_IvtFSharpItemsJson.Contains('&quot;itemSpec&quot;:&quot;Compile='))"
           Text="F# IVT construction must statically publish CompileBefore rather than Compile." />
  </Target>
  <Target Name="TestNativeManifest">
    <PropertyGroup>
      <_NativeManifestRoot>$(_TestDirectory)native-manifest/</_NativeManifestRoot>
    </PropertyGroup>
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='GetNativeManifest']">
      <Output TaskParameter="Result" PropertyName="_NativeManifestXml" />
    </XmlPeek>
    <Error Condition="'$(_NativeManifestXml)' == ''" Text="The packaged native-manifest query target is missing." />
    <MakeDir Directories="$(_NativeManifestRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ProjectReference/NativeManifest.proj" DestinationFolder="$(_NativeManifestRoot)" />
    <WriteLinesToFile File="$(_NativeManifestRoot)NativeManifest.targets" Lines="&lt;Project&gt;;$(_NativeManifestXml);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -t:Build -p:ResultFile=ordinary-empty.txt" />
    <Exec Command="$(_App) build &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -p:ResultFile=absent.txt -p:MSBuildEmitActionGraph=&quot;$(_NativeManifestRoot)absent.ninja&quot;" />
    <Error Condition="Exists('$(_NativeManifestRoot)absent.txt') or Exists('$(_NativeManifestRoot)native.manifest')"
           Text="A native-manifest metadata query must not publish content during construction." />
    <Exec WorkingDirectory="$(_NativeManifestRoot)" Command="ninja -f absent.ninja" />
    <WriteLinesToFile File="$(_NativeManifestRoot)native.manifest" Lines="stale native manifest" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -t:Build -p:ResultFile=ordinary-stale.txt" />
    <Exec Command="$(_App) build &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -p:ResultFile=stale.txt -p:MSBuildEmitActionGraph=&quot;$(_NativeManifestRoot)stale.ninja&quot;" />
    <Error Condition="Exists('$(_NativeManifestRoot)stale.txt')" Text="A stale native manifest must not cause construction-time publication." />
    <Exec WorkingDirectory="$(_NativeManifestRoot)" Command="ninja -f stale.ninja" />
    <GetFileHash Files="$(_NativeManifestRoot)ordinary-empty.txt;$(_NativeManifestRoot)absent.txt;$(_NativeManifestRoot)stale.txt">
      <Output TaskParameter="Items" ItemName="_NativeManifestHash" />
    </GetFileHash>
    <Error Condition="'@(_NativeManifestHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Hardened queries without manifest generation must match the ordinary empty result, regardless of stale output." />
    <ReadLinesFromFile File="$(_NativeManifestRoot)ordinary-stale.txt">
      <Output TaskParameter="Lines" PropertyName="_OrdinaryNativeManifest" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_ExpectedOrdinaryNativeManifest>Native;Native.Library|$([System.IO.Path]::GetFullPath('$(_NativeManifestRoot)native.manifest'))</_ExpectedOrdinaryNativeManifest>
    </PropertyGroup>
    <Error Condition="'$(_OrdinaryNativeManifest)' != '$(_ExpectedOrdinaryNativeManifest)'"
           Text="Ordinary native-manifest queries must retain their existing output discovery." />
    <ReadLinesFromFile File="$(_NativeManifestRoot)native.manifest">
      <Output TaskParameter="Lines" PropertyName="_StaleNativeManifest" />
    </ReadLinesFromFile>
    <Error Condition="'$(_StaleNativeManifest)' != 'stale native manifest'" Text="Native-manifest metadata queries must leave old output untouched." />
    <ItemGroup>
      <_NativeManifestFailure Include="clickonce;appx;native;com" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_NativeManifestRoot)NativeManifest.proj&quot; -p:Case=%(_NativeManifestFailure.Identity) -p:ResultFile=%(_NativeManifestFailure.Identity).txt -p:MSBuildEmitActionGraph=&quot;$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).ninja&quot; -flp:&quot;LogFile=$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).log;Verbosity=quiet&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_NativeManifestFailureExitCode" />
    </Exec>
    <Error Condition="'%(_NativeManifestFailureExitCode.Identity)' == '0'" Text="Requested native-manifest discovery remains unsupported and must fail explicitly." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).log').Contains('MSB4287')) or Exists('$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).ninja') or Exists('$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).ninja.actions') or Exists('$(_NativeManifestRoot)%(_NativeManifestFailure.Identity).txt')"
           Text="Requested native-manifest discovery must fail without partial graphs or content." />
  </Target>
  <Target Name="TestCleanup">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='IncrementalClean' or @Name='_CleanGetCurrentAndPriorFileWrites' or @Name='_CleanRecordFileWrites']">
      <Output TaskParameter="Result" ItemName="_CleanupTarget" />
    </XmlPeek>
    <Error Condition="'@(_CleanupTarget->Count())' != '3'" Text="The packaged Common targets must contain the ordinary cleanup closure." />
    <ItemGroup>
      <_CleanupCase Include="fresh;stale;obstructed;ordinary" />
      <_CleanupExecution Include="fresh;stale;obstructed" />
      <_CleanupPrior Include="stale;ordinary" />
      <_CleanupRoot Include="@(_CleanupCase->'$(_TestDirectory)cleanup/%(Identity)/')" />
    </ItemGroup>
    <MakeDir Directories="@(_CleanupRoot->'%(Identity)out');@(_CleanupRoot->'%(Identity)obj')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Cleanup.proj" DestinationFolder="%(_CleanupRoot.Identity)" />
    <WriteLinesToFile File="%(_CleanupRoot.Identity)Cleanup.targets" Lines="&lt;Project&gt;;@(_CleanupTarget);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/obj/ledger.txt"
                      Lines="$([System.IO.Path]::GetFullPath('$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/out/obsolete.txt'));$([System.IO.Path]::GetFullPath('$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/obj/obsolete.txt'))"
                      Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/out/obsolete.txt" Lines="prior output" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)cleanup/%(_CleanupPrior.Identity)/obj/obsolete.txt" Lines="prior intermediate" Overwrite="true" />
    <WriteLinesToFile File="%(_CleanupRoot.Identity)out/user.txt" Lines="not an owned output" Overwrite="true" />
    <MakeDir Directories="$(_TestDirectory)cleanup/obstructed/obj/ledger.txt;$(_TestDirectory)cleanup/obstructed/obj/ledger.txt.hardened.props" />
    <ReadLinesFromFile File="$(_TestDirectory)cleanup/stale/obj/ledger.txt">
      <Output TaskParameter="Lines" PropertyName="_CleanupPriorLedger" />
    </ReadLinesFromFile>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/Cleanup.proj&quot;" />
    <Error Condition="Exists('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/out/current.txt') or Exists('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/obj/intermediate.txt')"
           Text="Cleanup-free graph construction must not execute product actions." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/obj/genbuild/build.ninja').Contains('ledger.txt'))"
           Text="Legacy cleanup state must not be a graph input or output." />
    <Exec WorkingDirectory="$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)" Command="ninja -f obj/genbuild/build.ninja" />
    <Error Condition="!Exists('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/out/current.txt') or !Exists('$(_TestDirectory)cleanup/%(_CleanupExecution.Identity)/obj/intermediate.txt')"
           Text="Omitting cleanup must preserve product actions." />
    <ReadLinesFromFile File="$(_TestDirectory)cleanup/stale/obj/ledger.txt">
      <Output TaskParameter="Lines" PropertyName="_CleanupAfterLedger" />
    </ReadLinesFromFile>
    <Error Condition="'$(_CleanupAfterLedger)' != '$(_CleanupPriorLedger)' or !Exists('$(_TestDirectory)cleanup/stale/out/obsolete.txt') or !Exists('$(_TestDirectory)cleanup/stale/obj/obsolete.txt') or Exists('$(_TestDirectory)cleanup/fresh/obj/ledger.txt') or !Exists('$(_TestDirectory)cleanup/obstructed/obj/ledger.txt')"
           Text="Hardened execution must not read, reconcile, create or delete legacy cleanup state or obsolete outputs." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)cleanup/ordinary/Cleanup.proj&quot; -t:Produce,IncrementalClean" />
    <Error Condition="Exists('$(_TestDirectory)cleanup/ordinary/out/obsolete.txt') or Exists('$(_TestDirectory)cleanup/ordinary/obj/obsolete.txt')"
           Text="Ordinary builds must retain incremental cleanup." />
    <ReadLinesFromFile File="$(_TestDirectory)cleanup/ordinary/obj/ledger.txt">
      <Output TaskParameter="Lines" ItemName="_CleanupOrdinaryLedger" />
    </ReadLinesFromFile>
    <Error Condition="'@(_CleanupOrdinaryLedger->Count())' != '2' or !@(_CleanupOrdinaryLedger->AnyHaveMetadataValue('Identity', '$([System.IO.Path]::GetFullPath('$(_TestDirectory)cleanup/ordinary/out/current.txt'))')) or !@(_CleanupOrdinaryLedger->AnyHaveMetadataValue('Identity', '$([System.IO.Path]::GetFullPath('$(_TestDirectory)cleanup/ordinary/obj/intermediate.txt'))'))"
           Text="Ordinary builds must reconcile and retain the current output ledger." />
    <Error Condition="!Exists('%(_CleanupRoot.Identity)out/user.txt')"
           Text="Neither build profile may delete unowned files." />
  </Target>
  <Target Name="TestCopyOutputs">
    <MakeDir Directories="$(_TestDirectory)copies" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj" DestinationFolder="$(_TestDirectory)copies" />
    <WriteLinesToFile File="$(_TestDirectory)copies/Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)copies/Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)copies/Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)copies/HelloWorld.csproj&quot;" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets" Query="/Project/Target[@Name='CopyFilesToOutputDirectory']">
      <Output TaskParameter="Result" ItemName="_CopyOutputTarget" />
    </XmlPeek>
    <Error Condition="'@(_CopyOutputTarget->Count())' != '1'" Text="The packaged Common targets must contain build-output publication." />
    <ItemGroup>
      <_CopyCase Include="short;another longer checkout;stale;ordinary;write-failure" Mode="normal" />
      <_CopyCase Include="disabled" Mode="disabled" />
      <_CopyCase Include="skip-product" Mode="skip-product" />
      <_CopyCase Include="no-symbols" Mode="no-symbols" />
      <_CopyNegative Include="hardlink" Mode="hardlink" />
      <_CopyNegative Include="symlink" Mode="symlink" />
      <_CopyNegative Include="read-only" Mode="read-only" />
      <_CopyNegative Include="link-error" Mode="link-error" />
      <_CopyNegative Include="self-copy" Mode="self-copy" />
      <_CopyCase Include="@(_CopyNegative)" />
      <_CopyRoot Include="@(_CopyCase->'$(_TestDirectory)copies/%(Identity)/project/')" />
      <_CopyExecution Include="short;another longer checkout;stale;disabled;skip-product;no-symbols" />
    </ItemGroup>
    <MakeDir Directories="@(_CopyRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)CopyOutputs.proj;$(MSBuildThisFileDirectory)Csc.proj" DestinationFolder="%(_CopyRoot.Identity)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Csc.cs" DestinationFiles="%(_CopyRoot.Identity)Program.cs" />
    <Copy SourceFiles="$(_TestDirectory)copies/obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" DestinationFiles="%(_CopyRoot.Identity)FrameworkInputs.props" />
    <WriteLinesToFile File="%(_CopyRoot.Identity)CopyOutputs.targets" Lines="&lt;Project&gt;;@(_CopyOutputTarget);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)copies/%(_CopyCase.Identity)/project/CopyOutputs.proj&quot; -p:TestCase=%(_CopyCase.Mode)" />
    <MakeDir Directories="$(_TestDirectory)copies/stale/project/out/ref;$(_TestDirectory)copies/stale/project/obj/copy.marker" />
    <WriteLinesToFile File="$(_TestDirectory)copies/stale/project/out/Hello.dll" Lines="stale main" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)copies/stale/project/out/ref/renamed.dll" Lines="stale ref" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)copies/stale/project/out/Hello.pdb" Lines="stale PDB" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)copies/%(_CopyCase.Identity)/project/CopyOutputs.proj&quot; -p:TestCase=%(_CopyCase.Mode)"
          Condition="'%(_CopyCase.Identity)' != 'ordinary' and '%(_CopyCase.Identity)' != 'hardlink' and '%(_CopyCase.Identity)' != 'symlink' and '%(_CopyCase.Identity)' != 'read-only' and '%(_CopyCase.Identity)' != 'link-error' and '%(_CopyCase.Identity)' != 'self-copy'" />
    <Error Condition="Exists('$(_TestDirectory)copies/short/project/obj/Hello.dll') or Exists('$(_TestDirectory)copies/short/project/out/Hello.dll') or Exists('$(_TestDirectory)copies/short/project/out/ref/renamed.dll') or Exists('$(_TestDirectory)copies/short/project/out/Hello.pdb')"
           Text="Build-output construction must not compile or copy any files." />
    <ReadLinesFromFile File="$(_TestDirectory)copies/stale/project/out/Hello.dll">
      <Output TaskParameter="Lines" PropertyName="_CopyStaleMain" />
    </ReadLinesFromFile>
    <Error Condition="'$(_CopyStaleMain)' != 'stale main'" Text="Copy construction must leave stale destination content untouched." />
    <Exec WorkingDirectory="$(_TestDirectory)copies/%(_CopyExecution.Identity)/project" Command="ninja -f obj/genbuild/build.ninja" />
    <MakeDir Directories="$(_TestDirectory)copies/ordinary/project/out/ref" />
    <Copy SourceFiles="$(_TestDirectory)copies/short/project/obj/Hello.dll;$(_TestDirectory)copies/short/project/obj/ref/Hello.dll;$(_TestDirectory)copies/short/project/obj/Hello.pdb"
          DestinationFiles="$(_TestDirectory)copies/ordinary/project/obj/Hello.dll;$(_TestDirectory)copies/ordinary/project/obj/ref/Hello.dll;$(_TestDirectory)copies/ordinary/project/obj/Hello.pdb" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)copies/ordinary/project/CopyOutputs.proj&quot; -t:CopyFilesToOutputDirectory -p:TestCase=normal" />
    <ItemGroup>
      <_CopyResult Include="short;another longer checkout;stale;ordinary" />
      <_CopyMainResult Include="@(_CopyResult->'$(_TestDirectory)copies/%(Identity)/project/out/Hello.dll')" />
      <_CopyRefResult Include="@(_CopyResult->'$(_TestDirectory)copies/%(Identity)/project/out/ref/renamed.dll')" />
      <_CopyPdbResult Include="@(_CopyResult->'$(_TestDirectory)copies/%(Identity)/project/out/Hello.pdb')" />
    </ItemGroup>
    <GetFileHash Files="@(_CopyMainResult)">
      <Output TaskParameter="Items" ItemName="_CopyMainHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CopyRefResult)">
      <Output TaskParameter="Items" ItemName="_CopyRefHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CopyPdbResult)">
      <Output TaskParameter="Items" ItemName="_CopyPdbHash" />
    </GetFileHash>
    <Error Condition="'@(_CopyMainHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_CopyRefHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_CopyPdbHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Relocated main/reference/PDB copies must match ordinary bytes and replace stale outputs." />
    <Error Condition="Exists('$(_TestDirectory)copies/disabled/project/out/Hello.dll') or Exists('$(_TestDirectory)copies/disabled/project/out/ref/renamed.dll') or Exists('$(_TestDirectory)copies/disabled/project/out/Hello.pdb') or Exists('$(_TestDirectory)copies/no-symbols/project/out/Hello.pdb')"
           Text="Disabled copies must not publish artifacts." />
    <Error Condition="Exists('$(_TestDirectory)copies/skip-product/project/out/Hello.dll') or Exists('$(_TestDirectory)copies/skip-product/project/out/ref/renamed.dll') or !Exists('$(_TestDirectory)copies/skip-product/project/out/Hello.pdb')"
           Text="Skipping the product must preserve independent symbol-copy selection." />
    <Error Condition="!Exists('$(_TestDirectory)copies/ordinary/project/obj/copy.marker') or !Exists('$(_TestDirectory)copies/stale/project/obj/copy.marker')"
           Text="Ordinary marker behavior and the hardened obstructing marker directory must be retained." />
    <Error Condition="'%(_CopyExecution.Identity)' != 'stale' and Exists('$(_TestDirectory)copies/%(_CopyExecution.Identity)/project/obj/copy.marker')"
           Text="Hardened copy publication must not write timestamp/cache markers." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)copies/%(_CopyNegative.Identity)/project/CopyOutputs.proj&quot; -p:TestCase=%(_CopyNegative.Mode)"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_CopyRejectedExitCode" />
    </Exec>
    <Error Condition="@(_CopyRejectedExitCode->AnyHaveMetadataValue('Identity', '0')) or Exists('$(_TestDirectory)copies/%(_CopyNegative.Identity)/project/obj/genbuild/build.ninja') or Exists('$(_TestDirectory)copies/%(_CopyNegative.Identity)/project/obj/genbuild/build.ninja.actions') or Exists('$(_TestDirectory)copies/%(_CopyNegative.Identity)/project/obj/Hello.dll')"
           Text="Unsupported copy modes must fail without a graph, action invocations or compiled output." />
    <Exec WorkingDirectory="$(_TestDirectory)copies/write-failure/project" Command="ninja -f obj/genbuild/build.ninja &quot;$([System.IO.Path]::GetFullPath('$(_TestDirectory)copies/write-failure/project/obj/Hello.dll'))&quot;" />
    <MakeDir Directories="$(_TestDirectory)copies/write-failure/project/out/Hello.dll" />
    <ItemGroup>
      <_CopyInvocationCandidate Include="$(_TestDirectory)copies/write-failure/project/obj/genbuild/build.ninja.actions/*.json" />
      <_CopyFailureInvocation Include="@(_CopyInvocationCandidate)"
                              Condition="$([System.IO.File]::ReadAllText('%(_CopyInvocationCandidate.Identity)').Contains('Microsoft.Build.Tasks.CopyFiles')) and $([System.IO.File]::ReadAllText('%(_CopyInvocationCandidate.Identity)').Contains('Hello.dll')) and !$([System.IO.File]::ReadAllText('%(_CopyInvocationCandidate.Identity)').Contains('renamed.dll'))" />
    </ItemGroup>
    <Error Condition="'@(_CopyFailureInvocation->Count())' != '1'" Text="The main-assembly copy must be an independent action." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_CopyFailureInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_CopyFailureExitCode" />
    </Exec>
    <Error Condition="'$(_CopyFailureExitCode)' == '0'" Text="Independent copy publication errors must be fatal." />
  </Target>
  <Target Name="TestSourceCopies">
    <PropertyGroup>
      <_SourceCopyRoot>$(_TestDirectory)source-copies/</_SourceCopyRoot>
    </PropertyGroup>
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='_ValidateHardenedSourceCopyOptions' or @Name='_CopyOutOfDateSourceItemsToOutputDirectory' or @Name='_CopyOutOfDateSourceItemsToOutputDirectoryAlways' or @Name='_CopyDifferingSourceItemsToOutputDirectory']">
      <Output TaskParameter="Result" ItemName="_SourceCopyTarget" />
    </XmlPeek>
    <Error Condition="'@(_SourceCopyTarget->Count())' != '4'" Text="The packaged source-copy targets and option validation must be present." />
    <ItemGroup>
      <_SourceCopyCase Include="normal;empty;hardlink;symlink;read-only" />
      <_SourceCopyExecution Include="normal;empty" />
      <_SourceCopyRejected Include="hardlink;symlink;read-only" />
      <_SourceCopyDirectory Include="@(_SourceCopyCase->'$(_SourceCopyRoot)%(Identity)/action/');@(_SourceCopyExecution->'$(_SourceCopyRoot)%(Identity)/ordinary/')" />
      <_SourceCopyOutput Include="preserve/static.txt;preserve/generated.txt;always/static.txt;always/generated.txt;different/static.txt;different/generated.txt" />
    </ItemGroup>
    <MakeDir Directories="@(_SourceCopyDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)SourceCopies.proj" DestinationFolder="%(_SourceCopyDirectory.Identity)" />
    <WriteLinesToFile File="%(_SourceCopyDirectory.Identity)SourceCopies.targets"
                      Lines="&lt;Project&gt;;@(_SourceCopyTarget);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="%(_SourceCopyDirectory.Identity)inputs/static.txt" Lines="source content" Overwrite="true" />
    <WriteLinesToFile File="$(_SourceCopyRoot)normal/action/out/%(_SourceCopyOutput.Identity)" Lines="stale copy" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_SourceCopyRoot)%(_SourceCopyExecution.Identity)/action/SourceCopies.proj&quot; -p:TestCase=%(_SourceCopyExecution.Identity) -p:MSBuildEmitActionGraph=&quot;$(_SourceCopyRoot)%(_SourceCopyExecution.Identity)/action/build.ninja&quot;" />
    <Error Condition="Exists('$(_SourceCopyRoot)normal/action/obj/generated.txt') or
                      Exists('$(_SourceCopyRoot)normal/action/items.txt') or Exists('$(_SourceCopyRoot)empty/action/out')"
           Text="Source-copy construction must execute neither producers, copies nor metadata publication." />
    <ReadLinesFromFile File="$(_SourceCopyRoot)normal/action/out/%(_SourceCopyOutput.Identity)">
      <Output TaskParameter="Lines" ItemName="_SourceCopyStale" />
    </ReadLinesFromFile>
    <Error Condition="'@(_SourceCopyStale->Distinct())' != 'stale copy'" Text="Construction must leave every stale content copy untouched." />
    <Exec WorkingDirectory="$(_SourceCopyRoot)%(_SourceCopyExecution.Identity)/action" Command="ninja -f build.ninja" />
    <Exec Command="$(_App) restore &quot;$(_SourceCopyRoot)%(_SourceCopyExecution.Identity)/ordinary/SourceCopies.proj&quot; -t:Build -p:TestCase=%(_SourceCopyExecution.Identity)" />
    <GetFileHash Files="$(_SourceCopyRoot)normal/action/out/%(_SourceCopyOutput.Identity)">
      <Output TaskParameter="Items" ItemName="_SourceCopyActionHash" />
    </GetFileHash>
    <GetFileHash Files="$(_SourceCopyRoot)normal/ordinary/out/%(_SourceCopyOutput.Identity)">
      <Output TaskParameter="Items" ItemName="_SourceCopyOrdinaryHash" />
    </GetFileHash>
    <Error Condition="'@(_SourceCopyActionHash->'%(FileHash)')' != '@(_SourceCopyOrdinaryHash->'%(FileHash)')'"
           Text="All source-copy modes must independently consume future inputs and match ordinary output bytes." />
    <GetFileHash Files="$(_SourceCopyRoot)%(_SourceCopyExecution.Identity)/action/items.txt">
      <Output TaskParameter="Items" ItemName="_SourceCopyActionItemsHash" />
    </GetFileHash>
    <GetFileHash Files="$(_SourceCopyRoot)%(_SourceCopyExecution.Identity)/ordinary/items.txt">
      <Output TaskParameter="Items" ItemName="_SourceCopyOrdinaryItemsHash" />
    </GetFileHash>
    <Error Condition="'@(_SourceCopyActionItemsHash->'%(FileHash)')' != '@(_SourceCopyOrdinaryItemsHash->'%(FileHash)')'"
           Text="Source-copy FileWrites must match ordinary bookkeeping, including empty no-ops." />
    <Exec Command="$(_App) build &quot;$(_SourceCopyRoot)%(_SourceCopyRejected.Identity)/action/SourceCopies.proj&quot; -p:TestCase=%(_SourceCopyRejected.Identity) -p:MSBuildEmitActionGraph=&quot;$(_SourceCopyRoot)%(_SourceCopyRejected.Identity)/action/build.ninja&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_SourceCopyRejectedExitCode" />
    </Exec>
    <Error Condition="@(_SourceCopyRejectedExitCode->AnyHaveMetadataValue('Identity', '0')) or
                      Exists('$(_SourceCopyRoot)%(_SourceCopyRejected.Identity)/action/build.ninja') or
                      Exists('$(_SourceCopyRoot)%(_SourceCopyRejected.Identity)/action/build.ninja.actions')"
           Text="Unsupported source-copy link/read-only policies must fail without a partial graph." />
  </Target>
  <Target Name="TestRuntimePackageConfig" DependsOnTargets="TestRuntimeConfig">
    <PropertyGroup>
      <_RuntimePackageRoot>$(_TestDirectory)runtime-package-config/</_RuntimePackageRoot>
      <_RuntimePackageOutput>out/RuntimeApp.runtimeconfig.pack.json</_RuntimePackageOutput>
      <_RuntimePackageArguments>-p:TestPackageConfig=true -p:ArcadeBuildTasksProps=&quot;$(_AppDirectory)/toolset/Arcade/Sdk/tools/BuildTasks.props&quot;</_RuntimePackageArguments>
    </PropertyGroup>
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../src/runtime/src/tools/illink/src/linker/Mono.Linker.csproj"
             Query="/Project/Target[@Name='_ComputePackRuntimeConfigFilePath' or @Name='GeneratePackageRuntimeConfig']">
      <Output TaskParameter="Result" ItemName="_RuntimePackageTarget" />
    </XmlPeek>
    <Error Condition="'@(_RuntimePackageTarget->Count())' != '2'" Text="The linker runtime-config path and transformation targets must be present." />
    <ItemGroup>
      <_RuntimePackageCase Include="generated;escaped-template;other-framework;write-failure" />
      <_RuntimePackageExecution Include="generated;escaped-template" />
      <_RuntimePackageDirectory Include="@(_RuntimePackageCase->'$(_RuntimePackageRoot)%(Identity)/action/');@(_RuntimePackageCase->'$(_RuntimePackageRoot)%(Identity)/ordinary/')" />
    </ItemGroup>
    <MakeDir Directories="@(_RuntimePackageDirectory);$(_RuntimePackageRoot)generated/action/out" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RuntimeConfig.proj" DestinationFolder="%(_RuntimePackageDirectory.Identity)" />
    <WriteLinesToFile File="%(_RuntimePackageDirectory.Identity)RuntimeConfig.targets"
                      Lines="&lt;Project&gt;;$(_RuntimeConfigXml);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="%(_RuntimePackageDirectory.Identity)RuntimePackageConfig.targets"
                      Lines="&lt;Project&gt;;@(_RuntimePackageTarget);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_RuntimePackageRoot)generated/action/$(_RuntimePackageOutput)" Lines="stale package config" Overwrite="true" />
    <GetFileHash Files="$(_RuntimePackageRoot)generated/action/$(_RuntimePackageOutput)">
      <Output TaskParameter="Hash" PropertyName="_RuntimePackageStaleBefore" />
    </GetFileHash>
    <Exec Command="$(_App) restore &quot;$(_RuntimePackageRoot)%(_RuntimePackageCase.Identity)/action/RuntimeConfig.proj&quot; -p:TestCase=%(_RuntimePackageCase.Identity) $(_RuntimePackageArguments)" />
    <Exec Command="$(_App) build &quot;$(_RuntimePackageRoot)%(_RuntimePackageCase.Identity)/action/RuntimeConfig.proj&quot; -p:TestCase=%(_RuntimePackageCase.Identity) $(_RuntimePackageArguments) -p:MSBuildEmitActionGraph=&quot;$(_RuntimePackageRoot)%(_RuntimePackageCase.Identity)/action/build.ninja&quot;" />
    <GetFileHash Files="$(_RuntimePackageRoot)generated/action/$(_RuntimePackageOutput)">
      <Output TaskParameter="Hash" PropertyName="_RuntimePackageStaleAfter" />
    </GetFileHash>
    <Error Condition="'$(_RuntimePackageStaleBefore)' != '$(_RuntimePackageStaleAfter)' or
                      Exists('$(_RuntimePackageRoot)generated/action/obj/generated.template.json') or
                      Exists('$(_RuntimePackageRoot)generated/action/out/RuntimeApp.runtimeconfig.json') or
                      Exists('$(_RuntimePackageRoot)escaped-template/action/$(_RuntimePackageOutput)')"
           Text="Package runtime-config construction must preserve stale output and execute neither templates nor runtime-config producers." />
    <Exec WorkingDirectory="$(_RuntimePackageRoot)%(_RuntimePackageExecution.Identity)/action" Command="ninja -f build.ninja &quot;$(_RuntimePackageRoot)%(_RuntimePackageExecution.Identity)/action/$(_RuntimePackageOutput)&quot;" />
    <Exec Command="$(_App) restore &quot;$(_RuntimePackageRoot)%(_RuntimePackageCase.Identity)/ordinary/RuntimeConfig.proj&quot; -p:TestCase=%(_RuntimePackageCase.Identity) $(_RuntimePackageArguments)" />
    <Exec Command="$(_App) restore &quot;$(_RuntimePackageRoot)%(_RuntimePackageCase.Identity)/ordinary/RuntimeConfig.proj&quot; -t:Build -p:TestCase=%(_RuntimePackageCase.Identity) $(_RuntimePackageArguments)" />
    <ItemGroup>
      <_RuntimePackageComparable Include="@(_RuntimePackageExecution)" />
    </ItemGroup>
    <GetFileHash Files="$(_RuntimePackageRoot)%(_RuntimePackageComparable.Identity)/action/$(_RuntimePackageOutput)">
      <Output TaskParameter="Items" ItemName="_RuntimePackageActionHash" />
    </GetFileHash>
    <GetFileHash Files="$(_RuntimePackageRoot)%(_RuntimePackageComparable.Identity)/ordinary/$(_RuntimePackageOutput)">
      <Output TaskParameter="Items" ItemName="_RuntimePackageOrdinaryHash" />
    </GetFileHash>
    <Error Condition="'@(_RuntimePackageActionHash->'%(FileHash)')' != '@(_RuntimePackageOrdinaryHash->'%(FileHash)')' or
                      Exists('$(_RuntimePackageRoot)other-framework/action/$(_RuntimePackageOutput)') or
                      Exists('$(_RuntimePackageRoot)other-framework/ordinary/$(_RuntimePackageOutput)')"
           Text="Independent package runtime-config generation must preserve ordinary bytes and inactive-framework no-ops." />
    <PropertyGroup>
      <_RuntimePackageContents>$([System.IO.File]::ReadAllText('$(_RuntimePackageRoot)generated/action/$(_RuntimePackageOutput)'))</_RuntimePackageContents>
    </PropertyGroup>
    <Error Condition="!$(_RuntimePackageContents.Contains('&quot;version&quot;: &quot;12.34.56-preview.1&quot;')) or $(_RuntimePackageContents.Contains('&quot;version&quot;: &quot;11.0.0&quot;'))"
           Text="Package runtime-config generation must replace each framework version with the runtime version being built." />
    <MakeDir Directories="$(_RuntimePackageRoot)write-failure/action/$(_RuntimePackageOutput)" />
    <Exec WorkingDirectory="$(_RuntimePackageRoot)write-failure/action"
          Command="ninja -f build.ninja &quot;$(_RuntimePackageRoot)write-failure/action/$(_RuntimePackageOutput)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_RuntimePackageFailureExitCode" />
    </Exec>
    <Error Condition="'$(_RuntimePackageFailureExitCode)' == '0'" Text="Package runtime-config write failures must fail independent execution." />
  </Target>
  <Target Name="TestRuntimeConfig">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:PropertyGroup[msb:UserRuntimeConfig or msb:GenerateProbingPathsToRuntimeConfigDevFile or msb:ProjectRuntimeConfigFilePath] | /msb:Project/msb:ItemGroup[msb:GenerateRuntimeConfigurationFilesInputs] | /msb:Project/msb:Target[@Name='GenerateBuildRuntimeConfigurationFiles' or @Name='_GenerateRuntimeConfigurationFilesInputCache']">
      <Output TaskParameter="Result" ItemName="_RuntimeConfigFragment" />
    </XmlPeek>
    <Error Condition="'@(_RuntimeConfigFragment->Count())' != '7'" Text="The packaged SDK must contain runtime-config defaults, input selection and publication." />
    <PropertyGroup>
      <_RuntimeConfigXml>@(_RuntimeConfigFragment, '')</_RuntimeConfigXml>
      <_RuntimeConfigXml>$(_RuntimeConfigXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_RuntimeConfigXml>
    </PropertyGroup>
    <ItemGroup>
      <_RuntimeConfigCase Include="short;another longer checkout;stale" Mode="generated" />
      <_RuntimeConfigCase Include="existing-template" Mode="existing-template" />
      <_RuntimeConfigCase Include="late-parameter" Mode="late-parameter" />
      <_RuntimeConfigCase Include="self-contained" Mode="self-contained" />
      <_RuntimeConfigCase Include="no-template" Mode="no-template" />
      <_RuntimeConfigCase Include="default-roll-forward" Mode="default-roll-forward" />
      <_RuntimeConfigCase Include="late-default" Mode="late-default" />
      <_RuntimeConfigCase Include="release" Mode="release" />
      <_RuntimeConfigCase Include="missing-template" Mode="missing-template" />
      <_RuntimeConfigNegative Include="deleted-template" Mode="deleted-template" />
      <_RuntimeConfigNegative Include="package-probe" Mode="package-probe" />
      <_RuntimeConfigNegative Include="absolute-template" Mode="absolute-template" />
      <_RuntimeConfigNegative Include="malformed-template" Mode="malformed-template" />
      <_RuntimeConfigNegative Include="write-failure" Mode="write-failure" />
      <_RuntimeConfigCase Include="@(_RuntimeConfigNegative)" />
      <_RuntimeConfigRoot Include="@(_RuntimeConfigCase->'$(_TestDirectory)runtime-config/%(Identity)/project/')" />
      <_RuntimeConfigOrdinary Include="generated;self-contained;no-template;default-roll-forward;release" />
      <_RuntimeConfigRoot Include="@(_RuntimeConfigOrdinary->'$(_TestDirectory)runtime-config/ordinary-%(Identity)/project/')" />
    </ItemGroup>
    <MakeDir Directories="@(_RuntimeConfigRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RuntimeConfig.proj" DestinationFiles="%(_RuntimeConfigRoot.Identity)RuntimeConfig.proj" />
    <WriteLinesToFile File="%(_RuntimeConfigRoot.Identity)RuntimeConfig.targets" Lines="&lt;Project&gt;;$(_RuntimeConfigXml);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/absolute-template/project/runtimeconfig.template.json"
                      Lines="{&quot;additionalProbingPaths&quot;:[&quot;/machine-specific/packages&quot;]}" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/malformed-template/project/runtimeconfig.template.json" Lines="not JSON" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/deleted-template/project/missing.template.json" Lines="{}" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/existing-template/project/runtimeconfig.template.json"
                      Lines="{&quot;configProperties&quot;:{&quot;setting&quot;:&quot;generated after construction&quot;,&quot;count&quot;:4,&quot;enabled&quot;:false,&quot;text&quot;:&quot;a+b&quot;}}" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)runtime-config/%(_RuntimeConfigCase.Identity)/project/RuntimeConfig.proj&quot; &quot;-p:TestCase=%(_RuntimeConfigCase.Mode)&quot;" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/late-default/project/runtimeconfig.template.json"
                      Lines="{&quot;selectedDuringEvaluation&quot;:true}" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/stale/project/out/RuntimeApp.runtimeconfig.json" Lines="old main" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)runtime-config/stale/project/out/RuntimeApp.runtimeconfig.dev.json" Lines="old dev" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)runtime-config/%(_RuntimeConfigCase.Identity)/project/RuntimeConfig.proj&quot; &quot;-p:TestCase=%(_RuntimeConfigCase.Mode)&quot;"
          Condition="'%(_RuntimeConfigCase.Identity)' != 'missing-template'" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)runtime-config/missing-template/project/RuntimeConfig.proj&quot; -p:TestCase=missing-template"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_MissingRuntimeConfigTemplateExitCode" />
    </Exec>
    <Error Condition="'$(_MissingRuntimeConfigTemplateExitCode)' == '0' or Exists('$(_TestDirectory)runtime-config/missing-template/project/obj/genbuild/build.ninja') or Exists('$(_TestDirectory)runtime-config/missing-template/project/obj/genbuild/build.ninja.actions')"
           Text="An explicit missing template without a producer must fail without publishing a graph." />
    <Error Condition="Exists('$(_TestDirectory)runtime-config/short/project/obj/generated.template.json') or Exists('$(_TestDirectory)runtime-config/short/project/out/RuntimeApp.runtimeconfig.json') or Exists('$(_TestDirectory)runtime-config/short/project/out/RuntimeApp.runtimeconfig.dev.json')"
           Text="Runtime-config construction must not execute template producers or JSON writers." />
    <ReadLinesFromFile File="$(_TestDirectory)runtime-config/stale/project/out/RuntimeApp.runtimeconfig.json">
      <Output TaskParameter="Lines" PropertyName="_StaleRuntimeConfigMain" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_TestDirectory)runtime-config/stale/project/out/RuntimeApp.runtimeconfig.dev.json">
      <Output TaskParameter="Lines" PropertyName="_StaleRuntimeConfigDev" />
    </ReadLinesFromFile>
    <Error Condition="'$(_StaleRuntimeConfigMain)' != 'old main' or '$(_StaleRuntimeConfigDev)' != 'old dev'" Text="Runtime-config construction must leave stale outputs untouched." />
    <ItemGroup>
      <_RuntimeConfigExecution Include="@(_RuntimeConfigCase)" Exclude="@(_RuntimeConfigNegative);missing-template" />
    </ItemGroup>
    <Exec WorkingDirectory="$(_TestDirectory)runtime-config/%(_RuntimeConfigExecution.Identity)/project" Command="ninja -f obj/genbuild/build.ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)runtime-config/ordinary-%(_RuntimeConfigOrdinary.Identity)/project/RuntimeConfig.proj&quot; -p:TestCase=%(_RuntimeConfigOrdinary.Identity)" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)runtime-config/ordinary-%(_RuntimeConfigOrdinary.Identity)/project/RuntimeConfig.proj&quot; -t:Build -p:TestCase=%(_RuntimeConfigOrdinary.Identity)" />
    <ItemGroup>
      <_RuntimeConfigRelocated Include="short;another longer checkout;stale;existing-template;late-parameter;ordinary-generated" />
      <_RuntimeConfigComparable Include="self-contained;no-template;default-roll-forward;release" />
    </ItemGroup>
    <GetFileHash Files="@(_RuntimeConfigRelocated->'$(_TestDirectory)runtime-config/%(Identity)/project/out/RuntimeApp.runtimeconfig.json')">
      <Output TaskParameter="Items" ItemName="_RuntimeConfigMainHash" />
    </GetFileHash>
    <GetFileHash Files="@(_RuntimeConfigRelocated->'$(_TestDirectory)runtime-config/%(Identity)/project/out/RuntimeApp.runtimeconfig.dev.json')">
      <Output TaskParameter="Items" ItemName="_RuntimeConfigDevHash" />
    </GetFileHash>
    <Error Condition="'@(_RuntimeConfigMainHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_RuntimeConfigDevHash->'%(FileHash)'->Distinct()->Count())' != '1'" Text="Relocated runtime-config actions must match ordinary main/dev JSON bytes." />
    <ItemGroup>
      <_RuntimeConfigPair Include="$(_TestDirectory)runtime-config/%(_RuntimeConfigComparable.Identity)/project/out/RuntimeApp.runtimeconfig.json">
        <Baseline>$(_TestDirectory)runtime-config/ordinary-%(_RuntimeConfigComparable.Identity)/project/out/RuntimeApp.runtimeconfig.json</Baseline>
      </_RuntimeConfigPair>
      <_RuntimeConfigPair Include="$(_TestDirectory)runtime-config/%(_RuntimeConfigComparable.Identity)/project/out/RuntimeApp.runtimeconfig.dev.json" Condition="'%(_RuntimeConfigComparable.Identity)' != 'release'">
        <Baseline>$(_TestDirectory)runtime-config/ordinary-%(_RuntimeConfigComparable.Identity)/project/out/RuntimeApp.runtimeconfig.dev.json</Baseline>
      </_RuntimeConfigPair>
    </ItemGroup>
    <GetFileHash Files="@(_RuntimeConfigPair)">
      <Output TaskParameter="Items" ItemName="_RuntimeConfigPairHash" />
    </GetFileHash>
    <ItemGroup>
      <_RuntimeConfigBaseline Include="%(_RuntimeConfigPairHash.Baseline)" ExpectedHash="%(_RuntimeConfigPairHash.FileHash)" />
    </ItemGroup>
    <GetFileHash Files="@(_RuntimeConfigBaseline)">
      <Output TaskParameter="Items" ItemName="_RuntimeConfigBaselineHash" />
    </GetFileHash>
    <Error Condition="'%(_RuntimeConfigBaselineHash.ExpectedHash)' != '%(_RuntimeConfigBaselineHash.FileHash)'"
           Text="Runtime-config framework/self-contained semantics must match ordinary generation." />
    <Error Condition="Exists('$(_TestDirectory)runtime-config/release/project/out/RuntimeApp.runtimeconfig.dev.json')"
           Text="Release must not publish an inactive dev config." />
    <PropertyGroup>
      <_LateRuntimeConfig>$([System.IO.File]::ReadAllText('$(_TestDirectory)runtime-config/late-default/project/out/RuntimeApp.runtimeconfig.json'))</_LateRuntimeConfig>
      <_GeneratedRuntimeConfig>$([System.IO.File]::ReadAllText('$(_TestDirectory)runtime-config/short/project/out/RuntimeApp.runtimeconfig.json'))</_GeneratedRuntimeConfig>
      <_DefaultRuntimeConfig>$([System.IO.File]::ReadAllText('$(_TestDirectory)runtime-config/default-roll-forward/project/out/RuntimeApp.runtimeconfig.json'))</_DefaultRuntimeConfig>
    </PropertyGroup>
    <Error Condition="$(_DefaultRuntimeConfig.Contains('&quot;rollForward&quot;'))"
           Text="An unset RollForward must retain the ordinary task default and remain absent from runtime configuration." />
    <Error Condition="!$(_LateRuntimeConfig.Contains('&quot;selectedDuringEvaluation&quot;: true'))"
           Text="The engine must select a default template present during fresh Build evaluation." />
    <Error Condition="!$(_GeneratedRuntimeConfig.Contains('generated after construction')) or !$(_GeneratedRuntimeConfig.Contains('&quot;count&quot;: 12')) or $(_GeneratedRuntimeConfig.Contains('$(_TestDirectory)'))"
           Text="Runtime-config execution must merge generated templates and host overrides without physical paths." />
    <MakeDir Directories="$(_TestDirectory)runtime-config/write-failure/project/out/RuntimeApp.runtimeconfig.json" />
    <Delete Files="$(_TestDirectory)runtime-config/deleted-template/project/missing.template.json" />
    <ItemGroup>
      <_RuntimeConfigInvocationCandidate Include="$(_TestDirectory)runtime-config/%(_RuntimeConfigNegative.Identity)/project/obj/genbuild/build.ninja.actions/*.json">
        <Case>%(_RuntimeConfigNegative.Identity)</Case>
      </_RuntimeConfigInvocationCandidate>
      <_RuntimeConfigFailureInvocation Include="@(_RuntimeConfigInvocationCandidate)" Condition="$([System.IO.File]::ReadAllText('%(_RuntimeConfigInvocationCandidate.Identity)').Contains('&quot;taskType&quot;:&quot;WriteRuntimeConfig&quot;'))" />
    </ItemGroup>
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;%(_RuntimeConfigFailureInvocation.Identity)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_RuntimeConfigFailureExitCode" />
    </Exec>
    <Error Condition="'@(_RuntimeConfigFailureInvocation->Count())' != '5' or @(_RuntimeConfigFailureExitCode->AnyHaveMetadataValue('Identity', '0'))"
           Text="Invalid/missing runtime-config inputs and write failures must fail independent execution." />
    <Error Condition="Exists('$(_TestDirectory)runtime-config/%(_RuntimeConfigNegative.Identity)/project/out/RuntimeApp.runtimeconfig.dev.json')"
           Text="Invalid runtime-config actions must not publish a dev file." />
  </Target>
  <Target Name="TestDeps">
    <MakeDir Directories="$(_TestDirectory)deps" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj" DestinationFolder="$(_TestDirectory)deps" />
    <WriteLinesToFile File="$(_TestDirectory)deps/Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)deps/Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)deps/Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)deps/HelloWorld.csproj&quot;" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='GenerateBuildDependencyFile']">
      <Output TaskParameter="Result" ItemName="_DepsTarget" />
    </XmlPeek>
    <Error Condition="'@(_DepsTarget->Count())' != '1'" Text="The packaged SDK must contain GenerateBuildDependencyFile." />
    <PropertyGroup>
      <_DepsTargetXml>@(_DepsTarget)</_DepsTargetXml>
      <_DepsTargetXml>$(_DepsTargetXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_DepsTargetXml>
    </PropertyGroup>
    <ItemGroup>
      <_DepsCase Include="short;another longer checkout;stale;ordinary;missing" />
      <_DepsExecution Include="short;another longer checkout;stale" />
      <_DepsRoot Include="@(_DepsCase->'$(_TestDirectory)deps/%(Identity)/project/')" />
    </ItemGroup>
    <MakeDir Directories="@(_DepsRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Deps.proj;$(MSBuildThisFileDirectory)Csc.proj" DestinationFolder="%(_DepsRoot.Identity)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Csc.cs" DestinationFiles="%(_DepsRoot.Identity)Program.cs" />
    <Copy SourceFiles="$(_TestDirectory)deps/obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" DestinationFiles="%(_DepsRoot.Identity)FrameworkInputs.props" />
    <WriteLinesToFile File="%(_DepsRoot.Identity)Deps.targets" Lines="&lt;Project&gt;;$(_DepsTargetXml);&lt;/Project&gt;" Overwrite="true" />
    <WriteLinesToFile File="%(_DepsRoot.Identity)Version.cs"
                      Lines="[assembly: System.Reflection.AssemblyVersion(&quot;3.4.5.6&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;7.8.9.10&quot;)]" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)deps/%(_DepsCase.Identity)/project/Deps.proj&quot;" />
    <WriteLinesToFile File="$(_TestDirectory)deps/stale/project/out/DepsApp.deps.json" Lines="stale JSON must not survive" Overwrite="true" />
    <GetFileHash Files="$(_TestDirectory)deps/stale/project/out/DepsApp.deps.json">
      <Output TaskParameter="Hash" PropertyName="_DepsStaleBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)deps/%(_DepsCase.Identity)/project/Deps.proj&quot;" Condition="'%(_DepsCase.Identity)' != 'ordinary'" />
    <Error Condition="Exists('$(_TestDirectory)deps/%(_DepsExecution.Identity)/project/obj/Hello.dll')" Text="Deps graph construction must not execute its compiler producer." />
    <Error Condition="Exists('$(_TestDirectory)deps/short/project/out/DepsApp.deps.json') or Exists('$(_TestDirectory)deps/another longer checkout/project/out/DepsApp.deps.json')"
           Text="Deps graph construction must not write JSON." />
    <GetFileHash Files="$(_TestDirectory)deps/stale/project/out/DepsApp.deps.json">
      <Output TaskParameter="Hash" PropertyName="_DepsStaleAfter" />
    </GetFileHash>
    <Error Condition="'$(_DepsStaleBefore)' != '$(_DepsStaleAfter)'" Text="Deps graph construction must not inspect or change old output contents." />
    <Exec WorkingDirectory="$(_TestDirectory)deps/%(_DepsExecution.Identity)/project" Command="ninja -f obj/genbuild/build.ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)deps/ordinary/project/Deps.proj&quot; -t:Build" />
    <ItemGroup>
      <_DepsResult Include="@(_DepsExecution);ordinary" />
    </ItemGroup>
    <GetFileHash Files="@(_DepsResult->'$(_TestDirectory)deps/%(Identity)/project/out/DepsApp.deps.json')">
      <Output TaskParameter="Items" ItemName="_DepsHash" />
    </GetFileHash>
    <Error Condition="'@(_DepsHash->'%(FileHash)'->Distinct()->Count())' != '1'" Text="Relocated deps actions must match ordinary JSON bytes, including referenced binary versions." />
    <PropertyGroup>
      <_DepsJson>$([System.IO.File]::ReadAllText('$(_TestDirectory)deps/short/project/out/DepsApp.deps.json'))</_DepsJson>
    </PropertyGroup>
    <Error Condition="!$(_DepsJson.Contains('&quot;assemblyVersion&quot;: &quot;3.4.5.6&quot;')) or !$(_DepsJson.Contains('&quot;fileVersion&quot;: &quot;7.8.9.10&quot;')) or !$(_DepsJson.Contains('&quot;Logical.Project/2.0.0&quot;'))"
           Text="Deps actions must read generated dependency versions and retain project dependencies." />
    <Error Condition="$(_DepsJson.Contains('$(_TestDirectory)'))" Text="Deps JSON must not contain physical checkout paths." />
    <ItemGroup>
      <_DepsInvocationCandidate Include="$(_TestDirectory)deps/missing/project/obj/genbuild/build.ninja.actions/*.json" />
      <_DepsMissingInvocation Include="@(_DepsInvocationCandidate)" Condition="$([System.IO.File]::ReadAllText('%(_DepsInvocationCandidate.Identity)').Contains('&quot;taskType&quot;:&quot;WriteDepsFile&quot;'))" />
    </ItemGroup>
    <Error Condition="'@(_DepsMissingInvocation->Count())' != '1'" Text="GenerateBuildDependencyFile must emit a single independent deps writer." />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_DepsMissingInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_DepsMissingExitCode" />
    </Exec>
    <Error Condition="'$(_DepsMissingExitCode)' == '0' or Exists('$(_TestDirectory)deps/missing/project/out/DepsApp.deps.json')"
           Text="Deps execution must fail on missing declared binaries rather than emit empty versions." />
  </Target>
  <Target Name="TestCsc">
    <MakeDir Directories="$(_TestDirectory)csc" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)HelloWorld.csproj" DestinationFolder="$(_TestDirectory)csc" />
    <WriteLinesToFile File="$(_TestDirectory)csc/Directory.Build.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)csc/Directory.Build.targets" Lines="&lt;Project /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)csc/Directory.Packages.props" Lines="&lt;Project /&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)csc/HelloWorld.csproj&quot;" />
    <ItemGroup>
      <_CscCase Include="short;another much longer checkout;embedded;compiler-error;ordinary;determinism;paths;response;generated-directory;signed;resource-graph;resource-ordinary;resource-linked;resource-typed;resource-source;resource-tool;resource-runtime;resource-architecture;resource-preserialized;resource-accessors;resource-accessors-ordinary;resource-accessors-language;skip-analyzers;skip-analyzers-ordinary;skip-analyzers-compiler-error" />
      <_CscRoot Include="@(_CscCase->'$(_TestDirectory)csc/%(Identity)/project/')" />
      <_CscRelocation Include="short;another much longer checkout" />
      <_CscRejected Include="determinism" Arguments="-p:Deterministic=false" />
      <_CscRejected Include="paths" Arguments="-p:DeterministicSourcePaths=false" />
      <_CscRejected Include="response;generated-directory" />
    </ItemGroup>
    <MakeDir Directories="@(_CscRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Csc.proj" DestinationFiles="%(_CscRoot.Identity)Csc.proj" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Csc.cs" DestinationFiles="%(_CscRoot.Identity)Program.cs" />
    <Copy SourceFiles="$(_TestDirectory)csc/obj/frameworkreferences/Debug/AnyCPU/net11.0/HelloWorld.csproj.g.props" DestinationFiles="%(_CscRoot.Identity)FrameworkInputs.props" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='ResolveKeySource']">
      <Output TaskParameter="Result" PropertyName="_CscSigningTarget" />
    </XmlPeek>
    <WriteLinesToFile File="$(_TestDirectory)csc/signed/project/Signing.targets"
                      Lines="&lt;Project&gt;;$(_CscSigningTarget);&lt;/Project&gt;" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../src/msbuild/src/MSFT.snk" DestinationFiles="$(_TestDirectory)csc/signed/project/public.snk" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='CoreResGen' or @Name='_GenerateCompileInputs']">
      <Output TaskParameter="Result" ItemName="_CscResourceTargets" />
    </XmlPeek>
    <Error Condition="'@(_CscResourceTargets->Count())' != '2'" Text="Resource compilation must use the packaged resource and compiler-input targets." />
    <WriteLinesToFile File="%(_CscRoot.Identity)Resources.targets"
                      Lines="&lt;Project&gt;;@(_CscResourceTargets);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)csc/%(_CscCase.Identity)/project/Csc.proj&quot;" />
    <PropertyGroup>
      <_CscSkipRoot>$(_TestDirectory)csc/skip-analyzers/project/</_CscSkipRoot>
      <_CscSkipMarker>$(_CscSkipRoot)obj/Csc.proj.BuildWithSkipAnalyzers</_CscSkipMarker>
      <_CscSkipFailureRoot>$(_TestDirectory)csc/skip-analyzers-compiler-error/project/</_CscSkipFailureRoot>
      <_CscSkipFailureMarker>$(_CscSkipFailureRoot)obj/Csc.proj.BuildWithSkipAnalyzers</_CscSkipFailureMarker>
      <_CscSkipOrdinaryRoot>$(_TestDirectory)csc/skip-analyzers-ordinary/project/</_CscSkipOrdinaryRoot>
      <_CscSkipOrdinaryMarker>$(_CscSkipOrdinaryRoot)obj/Csc.proj.BuildWithSkipAnalyzers</_CscSkipOrdinaryMarker>
      <_CscEnabledMarker>$(_TestDirectory)csc/short/project/obj/Csc.proj.BuildWithSkipAnalyzers</_CscEnabledMarker>
    </PropertyGroup>
    <WriteLinesToFile File="$(_CscSkipMarker)" Lines="stale marker" Overwrite="true" />
    <Touch Files="$(_CscSkipMarker);$(_CscSkipFailureMarker);$(_CscSkipOrdinaryMarker);$(_CscEnabledMarker)" Time="2000-01-01T00:00:00" />
    <GetFileHash Files="$(_CscSkipMarker)">
      <Output TaskParameter="Hash" PropertyName="_CscSkipMarkerHashBefore" />
    </GetFileHash>
    <PropertyGroup>
      <_CscSkipMarkerTimeBefore>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscSkipMarker)').Ticks)</_CscSkipMarkerTimeBefore>
      <_CscSkipFailureTimeBefore>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscSkipFailureMarker)').Ticks)</_CscSkipFailureTimeBefore>
      <_CscSkipOrdinaryTimeBefore>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscSkipOrdinaryMarker)').Ticks)</_CscSkipOrdinaryTimeBefore>
      <_CscEnabledMarkerTimeBefore>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscEnabledMarker)').Ticks)</_CscEnabledMarkerTimeBefore>
    </PropertyGroup>
    <Exec Command="$(_App) build &quot;$(_CscSkipRoot)Csc.proj&quot; -p:TestCase=skip-analyzers" />
    <GetFileHash Files="$(_CscSkipMarker)">
      <Output TaskParameter="Hash" PropertyName="_CscSkipMarkerHashAfter" />
    </GetFileHash>
    <PropertyGroup>
      <_CscSkipMarkerTimeAfter>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscSkipMarker)').Ticks)</_CscSkipMarkerTimeAfter>
    </PropertyGroup>
    <Error Condition="'$(_CscSkipMarkerHashBefore)' != '$(_CscSkipMarkerHashAfter)' or
                      '$(_CscSkipMarkerTimeBefore)' != '$(_CscSkipMarkerTimeAfter)' or
                      Exists('$(_CscSkipRoot)obj/Generated.cs') or Exists('$(_CscSkipRoot)obj/Hello.dll')"
           Text="Skipped-analyzer graph construction must preserve the prepared marker's bytes and timestamp without compiling." />
    <Exec WorkingDirectory="$(_CscSkipRoot)" Command="ninja -f obj/genbuild/build.ninja &quot;$([System.IO.Path]::GetFullPath('$(_CscSkipMarker)'))&quot;" />
    <Error Condition="!Exists('$(_CscSkipRoot)obj/Hello.dll') or !Exists('$(_CscSkipMarker)')"
           Text="Requesting the marker alone must also produce the compiled assembly." />
    <PropertyGroup>
      <_CscSkipMarkerContents>$([System.IO.File]::ReadAllText('$(_CscSkipMarker)'))</_CscSkipMarkerContents>
      <_CscSkipMarkerTimeAfter>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscSkipMarker)').Ticks)</_CscSkipMarkerTimeAfter>
      <_CscSkipAssemblyTime>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscSkipRoot)obj/Hello.dll').Ticks)</_CscSkipAssemblyTime>
    </PropertyGroup>
    <Error Condition="'$(_CscSkipMarkerContents)' != '' or $(_CscSkipMarkerTimeAfter) &lt; $(_CscSkipAssemblyTime)"
           Text="Requesting the marker alone must compile first, then overwrite stale marker contents after successful compilation." />
    <Delete Files="$(_CscSkipMarker)" />
    <Exec WorkingDirectory="$(_CscSkipRoot)" Command="ninja -f obj/genbuild/build.ninja &quot;$([System.IO.Path]::GetFullPath('$(_CscSkipMarker)'))&quot;" />
    <Error Condition="!Exists('$(_CscSkipMarker)')" Text="Independent marker execution must recreate a missing marker." />
    <PropertyGroup>
      <_CscSkipMarkerContents>$([System.IO.File]::ReadAllText('$(_CscSkipMarker)'))</_CscSkipMarkerContents>
    </PropertyGroup>
    <Error Condition="'$(_CscSkipMarkerContents)' != ''"
           Text="Independent marker execution must recreate a missing marker with empty contents." />
    <Exec Command="$(_App) build &quot;$(_CscSkipFailureRoot)Csc.proj&quot; -p:TestCase=skip-analyzers-compiler-error" />
    <Exec WorkingDirectory="$(_CscSkipFailureRoot)" Command="ninja -f obj/genbuild/build.ninja &quot;$([System.IO.Path]::GetFullPath('$(_CscSkipFailureMarker)'))&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_CscSkipFailureExit" />
    </Exec>
    <PropertyGroup>
      <_CscSkipFailureTimeAfter>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscSkipFailureMarker)').Ticks)</_CscSkipFailureTimeAfter>
    </PropertyGroup>
    <Error Condition="'$(_CscSkipFailureExit)' == '0' or Exists('$(_CscSkipFailureRoot)obj/Hello.dll') or
                      '$(_CscSkipFailureTimeBefore)' != '$(_CscSkipFailureTimeAfter)'"
           Text="Failed compilation must not run the skipped-analyzer marker action or advance its timestamp." />
    <WriteLinesToFile File="$(_CscSkipOrdinaryMarker)" Lines="ordinary marker" Overwrite="true" />
    <Touch Files="$(_CscSkipOrdinaryMarker)" Time="2000-01-01T00:00:00" />
    <GetFileHash Files="$(_CscSkipOrdinaryMarker)">
      <Output TaskParameter="Hash" PropertyName="_CscSkipOrdinaryHashBefore" />
    </GetFileHash>
    <Exec Command="$(_App) restore &quot;$(_CscSkipOrdinaryRoot)Csc.proj&quot; -t:Build -p:TestCase=skip-analyzers-ordinary -p:MSBuildRestoreGraphInputs=false" />
    <GetFileHash Files="$(_CscSkipOrdinaryMarker)">
      <Output TaskParameter="Hash" PropertyName="_CscSkipOrdinaryHashAfter" />
    </GetFileHash>
    <PropertyGroup>
      <_CscSkipOrdinaryTimeAfter>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscSkipOrdinaryMarker)').Ticks)</_CscSkipOrdinaryTimeAfter>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CscSkipOrdinaryRoot)obj/Hello.dll') or
                      '$(_CscSkipOrdinaryHashBefore)' != '$(_CscSkipOrdinaryHashAfter)' or
                      '$(_CscSkipOrdinaryTimeBefore)' == '$(_CscSkipOrdinaryTimeAfter)'"
           Text="Ordinary skipped-analyzer builds must retain Touch's timestamp update and preserve marker contents." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/%(_CscRelocation.Identity)/project/Csc.proj&quot;" />
    <Error Condition="Exists('$(_TestDirectory)csc/%(_CscRelocation.Identity)/project/obj/Generated.cs') or Exists('$(_TestDirectory)csc/%(_CscRelocation.Identity)/project/obj/Hello.dll')"
           Text="Compiler preparation must not write generated sources or compilation outputs." />
    <Exec WorkingDirectory="$(_TestDirectory)csc/%(_CscRelocation.Identity)/project" Command="ninja -f obj/genbuild/build.ninja" />
    <PropertyGroup>
      <_CscEnabledMarkerTimeAfter>$([System.IO.File]::GetLastWriteTimeUtc('$(_CscEnabledMarker)').Ticks)</_CscEnabledMarkerTimeAfter>
    </PropertyGroup>
    <Error Condition="'$(_CscEnabledMarkerTimeBefore)' != '$(_CscEnabledMarkerTimeAfter)'"
           Text="Analyzer-enabled compilation must not advance the skipped-analyzer marker." />
    <GetFileHash Files="@(_CscRelocation->'$(_TestDirectory)csc/%(Identity)/project/obj/Hello.dll')">
      <Output TaskParameter="Items" ItemName="_CscPeHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CscRelocation->'$(_TestDirectory)csc/%(Identity)/project/obj/Hello.pdb')">
      <Output TaskParameter="Items" ItemName="_CscPdbHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CscRelocation->'$(_TestDirectory)csc/%(Identity)/project/obj/ref/Hello.dll')">
      <Output TaskParameter="Items" ItemName="_CscRefHash" />
    </GetFileHash>
    <Error Condition="'@(_CscPeHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_CscPdbHash->'%(FileHash)'->Distinct()->Count())' != '1' or '@(_CscRefHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Relocated compiler actions, including analyzers and the Regex generator, must produce identical assemblies and portable PDBs." />
    <Copy SourceFiles="$(_AppDirectory)/genbuild.runtimeconfig.json" DestinationFiles="$(_TestDirectory)csc/%(_CscRelocation.Identity)/project/obj/Hello.runtimeconfig.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)csc/short/project/obj/Hello.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CscProgramOutput" />
    </Exec>
    <Error Condition="'@(_CscProgramOutput)' != '/_/project/Program.cs;True;generated before compilation'"
           Text="Compiler actions must map CallerFilePath, execute generators and consume generated producer inputs." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/signed/project/Csc.proj&quot; -p:TestCase=signed" />
    <Error Condition="Exists('$(_TestDirectory)csc/signed/project/obj/public.snk') or Exists('$(_TestDirectory)csc/signed/project/obj/Hello.dll')"
           Text="Signing-key selection must accept a future key producer without opening it or executing the compiler." />
    <Exec WorkingDirectory="$(_TestDirectory)csc/signed/project" Command="ninja -f obj/genbuild/build.ninja" />
    <GetAssemblyIdentity AssemblyFiles="$(_TestDirectory)csc/signed/project/obj/Hello.dll">
      <Output TaskParameter="Assemblies" ItemName="_CscSignedIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'@(_CscSignedIdentity->'%(PublicKeyToken)')' != 'B03F5F7F11D50A3A'"
           Text="The compiler must consume the produced public key and emit the expected signed assembly identity." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/resource-graph/project/Csc.proj&quot; -p:TestCase=resource-graph" />
    <Error Condition="Exists('$(_TestDirectory)csc/resource-graph/project/obj/Strings.resx') or
                      Exists('$(_TestDirectory)csc/resource-graph/project/obj/ResourceRoot.Strings.resources') or
                      Exists('$(_TestDirectory)csc/resource-graph/project/obj/Hello.dll')"
           Text="Resource graph construction must accept generated RESX inputs without producing resources or assemblies." />
    <Exec WorkingDirectory="$(_TestDirectory)csc/resource-graph/project" Command="ninja -f obj/genbuild/build.ninja" />
    <Copy SourceFiles="$(_AppDirectory)/genbuild.runtimeconfig.json" DestinationFiles="$(_TestDirectory)csc/resource-graph/project/obj/Hello.runtimeconfig.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)csc/resource-graph/project/obj/Hello.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CscResourceProgramOutput" />
    </Exec>
    <Error Condition="'@(_CscResourceProgramOutput)' != '/_/project/Program.cs;True;generated before compilation;[ inline &amp; generated ]'"
           Text="Independent resource and compiler actions must embed and retrieve the produced resource value." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/resource-accessors/project/Csc.proj&quot; -p:TestCase=resource-accessors" />
    <Error Condition="Exists('$(_TestDirectory)csc/resource-accessors/project/obj/Strings.resx') or
                      Exists('$(_TestDirectory)csc/resource-accessors/project/obj/generated source/accessors.cs') or
                      Exists('$(_TestDirectory)csc/resource-accessors/project/obj/Hello.dll')"
           Text="Resource-source construction must schedule a future RESX input and source output without executing either producer." />
    <Exec WorkingDirectory="$(_TestDirectory)csc/resource-accessors/project" Command="ninja -f obj/genbuild/build.ninja" />
    <Copy SourceFiles="$(_AppDirectory)/genbuild.runtimeconfig.json" DestinationFiles="$(_TestDirectory)csc/resource-accessors/project/obj/Hello.runtimeconfig.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_TestDirectory)csc/resource-accessors/project/obj/Hello.dll&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CscAccessorProgramOutput" />
    </Exec>
    <Error Condition="'@(_CscAccessorProgramOutput)' != '/_/project/Program.cs;True;generated before compilation;[ inline &amp; generated ];[ inline &amp; generated ];hello reader;quoted &quot;42&quot;'"
           Text="Independent Arcade source generation must feed compilation, resource lookup and named/numbered format methods." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)csc/resource-accessors-ordinary/project/Csc.proj&quot; -t:Build -p:TestCase=resource-accessors-ordinary" />
    <GetFileHash Files="$(_TestDirectory)csc/resource-accessors/project/obj/generated source/accessors.cs;$(_TestDirectory)csc/resource-accessors-ordinary/project/obj/generated source/accessors.cs">
      <Output TaskParameter="Items" ItemName="_CscAccessorSourceHash" />
    </GetFileHash>
    <Error Condition="'@(_CscAccessorSourceHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Captured Arcade source generation must preserve ordinary generated source bytes and options." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/resource-accessors-language/project/Csc.proj&quot; -p:TestCase=resource-accessors-language -p:Language=unsupported -flp:&quot;LogFile=$(_TestDirectory)csc/resource-accessors-language.log;Verbosity=quiet&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_CscAccessorLanguageExit" />
    </Exec>
    <Error Condition="'$(_CscAccessorLanguageExit)' == '0' or
                      !$([System.IO.File]::ReadAllText('$(_TestDirectory)csc/resource-accessors-language.log').Contains('support language:')) or
                      Exists('$(_TestDirectory)csc/resource-accessors-language/project/obj/genbuild/build.ninja') or
                      Exists('$(_TestDirectory)csc/resource-accessors-language/project/obj/genbuild/build.ninja.actions') or
                      Exists('$(_TestDirectory)csc/resource-accessors-language/project/obj/Strings.resx')"
           Text="Unsupported resource-source languages must fail before graph publication or action execution." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)csc/resource-ordinary/project/Csc.proj&quot; -t:Build -p:TestCase=resource-ordinary" />
    <ItemGroup>
      <_CscResourceFile Include="ResourceRoot.Strings.resources;ResourceRoot.Strings.fr.resources" />
      <_CscResourceRejected Include="source;tool;runtime;architecture;preserialized" />
      <_CscResourcePayloadRejected Include="linked;typed" />
    </ItemGroup>
    <GetFileHash Files="$(_TestDirectory)csc/resource-graph/project/obj/%(_CscResourceFile.Identity)">
      <Output TaskParameter="Items" ItemName="_CscResourceGraphHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)csc/resource-ordinary/project/obj/%(_CscResourceFile.Identity)">
      <Output TaskParameter="Items" ItemName="_CscResourceOrdinaryHash" />
    </GetFileHash>
    <Error Condition="'@(_CscResourceGraphHash->'%(FileHash)')' != '@(_CscResourceOrdinaryHash->'%(FileHash)')' or
                      Exists('$(_TestDirectory)csc/resource-graph/project/obj/Csc.proj.GenerateResource.cache')"
           Text="Main and culture resources must match ordinary bytes without using an incremental state cache." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/resource-%(_CscResourceRejected.Identity)/project/Csc.proj&quot; -p:TestCase=resource-%(_CscResourceRejected.Identity) -flp:&quot;LogFile=$(_TestDirectory)csc/resource-%(_CscResourceRejected.Identity).log;Verbosity=quiet&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_CscResourceRejectedExit" />
    </Exec>
    <Error Condition="@(_CscResourceRejectedExit->AnyHaveMetadataValue('Identity', '0')) or
                      !$([System.IO.File]::ReadAllText('$(_TestDirectory)csc/resource-%(_CscResourceRejected.Identity).log').Contains('MSB3674')) or
                      Exists('$(_TestDirectory)csc/resource-%(_CscResourceRejected.Identity)/project/obj/genbuild/build.ninja') or
                      Exists('$(_TestDirectory)csc/resource-%(_CscResourceRejected.Identity)/project/obj/genbuild/build.ninja.actions') or
                      Exists('$(_TestDirectory)csc/resource-%(_CscResourceRejected.Identity)/project/obj/Strings.resx')"
           Text="Unsupported resource compilation modes must fail explicitly before graph publication or action execution." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/resource-%(_CscResourcePayloadRejected.Identity)/project/Csc.proj&quot; -p:TestCase=resource-%(_CscResourcePayloadRejected.Identity)" />
    <Exec WorkingDirectory="$(_TestDirectory)csc/resource-%(_CscResourcePayloadRejected.Identity)/project" Command="ninja -f obj/genbuild/build.ninja"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_CscResourcePayloadExit" />
    </Exec>
    <Error Condition="@(_CscResourcePayloadExit->AnyHaveMetadataValue('Identity', '0')) or
                      Exists('$(_TestDirectory)csc/resource-%(_CscResourcePayloadRejected.Identity)/project/obj/ResourceRoot.Strings.resources') or
                      Exists('$(_TestDirectory)csc/resource-%(_CscResourcePayloadRejected.Identity)/project/obj/Hello.dll')"
           Text="Linked or typed resource payloads must fail execution before creating resources or compiling an assembly." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/embedded/project/Csc.proj&quot; -p:DebugType=embedded" />
    <Exec WorkingDirectory="$(_TestDirectory)csc/embedded/project" Command="ninja -f obj/genbuild/build.ninja" />
    <Error Condition="Exists('$(_TestDirectory)csc/embedded/project/obj/Hello.pdb')" Text="Embedded debug information must not declare or emit a sidecar PDB." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)csc/ordinary/project/Csc.proj&quot; -t:Build" />
    <Error Condition="!Exists('$(_TestDirectory)csc/ordinary/project/obj/Hello.dll') or !Exists('$(_TestDirectory)csc/ordinary/project/obj/Hello.pdb')"
           Text="Ordinary Csc must retain its existing execution path." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/%(_CscRejected.Identity)/project/Csc.proj&quot; -p:TestCase=%(_CscRejected.Identity) %(_CscRejected.Arguments)"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_CscRejectedExitCode" />
    </Exec>
    <Error Condition="@(_CscRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Unsupported compiler modes must fail construction." />
    <Error Condition="Exists('$(_TestDirectory)csc/%(_CscRejected.Identity)/project/obj/genbuild/build.ninja') or Exists('$(_TestDirectory)csc/%(_CscRejected.Identity)/project/obj/genbuild/build.ninja.actions') or Exists('$(_TestDirectory)csc/%(_CscRejected.Identity)/project/obj/Generated.cs')"
           Text="Rejected compiler preparation must publish neither a graph nor generated files." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)csc/compiler-error/project/Csc.proj&quot; -p:TestCase=compiler-error" />
    <Exec WorkingDirectory="$(_TestDirectory)csc/compiler-error/project" Command="ninja -f obj/genbuild/build.ninja"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_CscCompilerFailure" />
    </Exec>
    <Error Condition="'$(_CscCompilerFailure)' == '0' or Exists('$(_TestDirectory)csc/compiler-error/project/obj/Hello.dll')"
           Text="Independent compiler failures must fail execution without a successful assembly output." />
  </Target>
  <Target Name="TestRoslynAnalyzerConfig">
    <ItemGroup>
      <_AnalyzerConfigPackage Include="Microsoft.CodeAnalysis.Analyzers"
                              AssemblyName="Microsoft.CodeAnalysis.Analyzers"
                              Category="MicrosoftCodeAnalysisCorrectness" RuleId="RS1001" Version="3.11.0"
                              ReleaseTrackingOptOut="false" />
      <_AnalyzerConfigPackage Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                              AssemblyName="Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers"
                              Category="ApiDesign" RuleId="RS0030" Version="5.12.0"
                              ReleaseTrackingOptOut="true" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="TestRoslynAnalyzerConfigPackage"
             Properties="Configuration=$(Configuration);GenBuildApp=$(GenBuildApp);GenBuildTestHost=$(GenBuildTestHost);AnalyzerConfigPackage=%(_AnalyzerConfigPackage.Identity);AnalyzerConfigAssembly=%(_AnalyzerConfigPackage.AssemblyName);AnalyzerConfigCategory=%(_AnalyzerConfigPackage.Category);AnalyzerConfigRuleId=%(_AnalyzerConfigPackage.RuleId);AnalyzerConfigVersion=%(_AnalyzerConfigPackage.Version);AnalyzerConfigReleaseTrackingOptOut=%(_AnalyzerConfigPackage.ReleaseTrackingOptOut)" />
  </Target>
  <Target Name="TestRoslynAnalyzerConfigPackage">
    <PropertyGroup>
      <_AnalyzerConfigRoot>$(_TestDirectory)roslyn-analyzer-config/</_AnalyzerConfigRoot>
      <_AnalyzerConfigGenerator>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../../src/roslyn/artifacts/bin/GenerateDocumentationAndConfigFiles/$(Configuration)/net10.0/GenerateDocumentationAndConfigFiles.dll'))</_AnalyzerConfigGenerator>
      <_AnalyzerConfigBin>$(_AnalyzerConfigRoot)bin</_AnalyzerConfigBin>
      <_AnalyzerConfigAssembly>$(_AnalyzerConfigBin)/$(AnalyzerConfigAssembly)/$(Configuration)/netstandard2.0/</_AnalyzerConfigAssembly>
      <_AnalyzerConfigPrefix>$(AnalyzerConfigPackage.Replace('.', ''))</_AnalyzerConfigPrefix>
      <_AnalyzerConfigTargets>$(_AnalyzerConfigRoot)$(AnalyzerConfigPackage).targets</_AnalyzerConfigTargets>
      <_AnalyzerConfigArguments>-p:AnalyzerTargets=&quot;$(_AnalyzerConfigTargets)&quot;</_AnalyzerConfigArguments>
    </PropertyGroup>
    <MakeDir Directories="$(_AnalyzerConfigRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RoslynAnalyzerConfig.proj" DestinationFolder="$(_AnalyzerConfigRoot)" />
    <ItemGroup>
      <_AnalyzerConfigInput Include="$(MSBuildThisFileDirectory)../../src/roslyn/artifacts/bin/$(AnalyzerConfigAssembly)/$(Configuration)/netstandard2.0/*.dll" />
      <_AnalyzerConfigInput Include="$(MSBuildThisFileDirectory)../../src/roslyn/artifacts/bin/Microsoft.CodeAnalysis.BannedApiAnalyzers/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.BannedApiAnalyzers.dll"
                            Condition="'$(AnalyzerConfigPackage)' == 'Microsoft.CodeAnalysis.BannedApiAnalyzers'" />
    </ItemGroup>
    <Error Condition="'@(_AnalyzerConfigInput)' == ''" Text="Build the $(AnalyzerConfigAssembly) prototype test component first." />
    <Copy SourceFiles="@(_AnalyzerConfigInput)" DestinationFolder="$(_AnalyzerConfigAssembly)" />
    <WriteLinesToFile File="$(_AnalyzerConfigAssembly)AnalyzerReleases/$(AnalyzerConfigAssembly)/AnalyzerReleases.Shipped.md"
                      Lines="## Release 1.0;### New Rules;Rule ID | Category | Severity | Notes;--------|----------|----------|-------;$(AnalyzerConfigRuleId) | $(AnalyzerConfigCategory) | Warning | Fixture release"
                      Overwrite="true" Condition="'$(AnalyzerConfigReleaseTrackingOptOut)' != 'true'" />
    <WriteLinesToFile File="$(_AnalyzerConfigAssembly)AnalyzerReleases/$(AnalyzerConfigAssembly)/AnalyzerReleases.Unshipped.md"
                      Lines="" Overwrite="true" Condition="'$(AnalyzerConfigReleaseTrackingOptOut)' != 'true'" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; --roll-forward Major &quot;$(_AnalyzerConfigGenerator)&quot; --validateOnly false --analyzerRulesetsDir &quot;$(_AnalyzerConfigRoot)rulesets&quot; --analyzerEditorconfigsDir &quot;$(_AnalyzerConfigRoot)editorconfigs&quot; --analyzerGlobalconfigsDir &quot;$(_AnalyzerConfigRoot)config&quot; --binDirectory &quot;$(_AnalyzerConfigBin)&quot; --configuration $(Configuration) --tfm netstandard2.0 --assemblies $(AnalyzerConfigAssembly).dll --propsFileDir &quot;$(_AnalyzerConfigRoot)&quot; --propsFileName $(AnalyzerConfigPackage).props --targetsFileDir &quot;$(_AnalyzerConfigRoot)&quot; --targetsFileName $(AnalyzerConfigPackage).targets --propsFileToDisableNetAnalyzers &quot;&quot; --analyzerDocumentationFileDir &quot;$(_AnalyzerConfigRoot)docs&quot; --analyzerDocumentationFileName analyzers.md --analyzerSarifFileDir &quot;$(_AnalyzerConfigRoot)docs&quot; --analyzerSarifFileName analyzers.sarif --analyzerVersion $(AnalyzerConfigVersion) --analyzerPackageName $(AnalyzerConfigPackage) --containsPortedFxcopRules false --generateAnalyzerRulesMissingDocumentationFile false --releaseTrackingOptOut $(AnalyzerConfigReleaseTrackingOptOut) --validateOffline true" />
    <XmlPeek XmlInputPath="$(_AnalyzerConfigTargets)" Query="/Project/ItemGroup/_GlobalAnalyzerConfigAsset_$(_AnalyzerConfigPrefix)/@Include">
      <Output TaskParameter="Result" ItemName="_DeclaredAnalyzerConfig" />
    </XmlPeek>
    <ItemGroup>
      <_GeneratedAnalyzerConfig Include="$(_AnalyzerConfigRoot)config/*.globalconfig" />
      <_DeclaredAnalyzerConfigName Include="@(_DeclaredAnalyzerConfig->'%(Filename)%(Extension)')" />
      <_GeneratedAnalyzerConfigName Include="@(_GeneratedAnalyzerConfig->'%(Filename)%(Extension)')" />
      <_MissingAnalyzerConfig Include="@(_DeclaredAnalyzerConfigName)" Exclude="@(_GeneratedAnalyzerConfigName)" />
      <_UndeclaredAnalyzerConfig Include="@(_GeneratedAnalyzerConfigName)" Exclude="@(_DeclaredAnalyzerConfigName)" />
      <_RoslynAnalyzerConfigCase Include="empty" />
      <_RoslynAnalyzerConfigCase Include="default"
                                Arguments="-p:$(_AnalyzerConfigPrefix)RulesVersion=1">
        <BaseConfig Condition="'$(AnalyzerConfigReleaseTrackingOptOut)' != 'true'">analysislevel_1_default.globalconfig</BaseConfig>
      </_RoslynAnalyzerConfigCase>
      <_RoslynAnalyzerConfigCase Include="all-errors"
                                Arguments="-p:$(_AnalyzerConfigPrefix)RulesVersion=1 -p:AnalysisMode=AllEnabledByDefault -p:CodeAnalysisTreatWarningsAsErrors=true">
        <BaseConfig Condition="'$(AnalyzerConfigReleaseTrackingOptOut)' != 'true'">analysislevel_1_all_warnaserror.globalconfig</BaseConfig>
      </_RoslynAnalyzerConfigCase>
      <_RoslynAnalyzerConfigCase Include="category"
                                Arguments="-p:$(_AnalyzerConfigPrefix)RulesVersion=1 -p:$(_AnalyzerConfigPrefix)$(AnalyzerConfigCategory)RulesVersion=1 -p:AnalysisMode$(AnalyzerConfigCategory)=AllDisabledByDefault">
        <BaseConfig Condition="'$(AnalyzerConfigReleaseTrackingOptOut)' != 'true'">analysislevel_1_default.globalconfig</BaseConfig>
        <CategoryConfig Condition="'$(AnalyzerConfigReleaseTrackingOptOut)' != 'true'">analysislevel$(AnalyzerConfigCategory.ToLowerInvariant())_1_none.globalconfig</CategoryConfig>
      </_RoslynAnalyzerConfigCase>
      <_RoslynAnalyzerConfigCase Include="unsupported"
                                Arguments="-p:$(_AnalyzerConfigPrefix)RulesVersion=999.0" />
      <_RoslynAnalyzerConfigCase Include="skipped"
                                Arguments="-p:$(_AnalyzerConfigPrefix)RulesVersion=1 -p:SkipGlobalAnalyzerConfigForPackage=true" />
    </ItemGroup>
    <Error Condition="('$(AnalyzerConfigReleaseTrackingOptOut)' != 'true' and '@(_DeclaredAnalyzerConfig)' == '') or ('$(AnalyzerConfigReleaseTrackingOptOut)' == 'true' and '@(_DeclaredAnalyzerConfig)' != '') or '@(_MissingAnalyzerConfig)' != '' or '@(_UndeclaredAnalyzerConfig)' != ''"
           Text="Roslyn's declared analyzer-config inventory must match the files emitted by the generator." />
    <MakeDir Directories="$(_AnalyzerConfigRoot)held-config" />
    <Move SourceFiles="@(_GeneratedAnalyzerConfig)" DestinationFiles="@(_GeneratedAnalyzerConfig->'$(_AnalyzerConfigRoot)held-config/%(Filename)%(Extension)')"
          Condition="'@(_GeneratedAnalyzerConfig)' != ''" />
    <Exec Command="$(_App) build &quot;$(_AnalyzerConfigRoot)RoslynAnalyzerConfig.proj&quot; $(_AnalyzerConfigArguments) -p:TestCase=%(_RoslynAnalyzerConfigCase.Identity) -p:ExpectedBaseConfig=%(_RoslynAnalyzerConfigCase.BaseConfig) -p:ExpectedCategoryConfig=%(_RoslynAnalyzerConfigCase.CategoryConfig) %(_RoslynAnalyzerConfigCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_AnalyzerConfigRoot)%(_RoslynAnalyzerConfigCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_AnalyzerConfigRoot)selection')"
           Text="Analyzer-config selection must not execute publication actions during construction." />
    <Move SourceFiles="@(_GeneratedAnalyzerConfig->'$(_AnalyzerConfigRoot)held-config/%(Filename)%(Extension)')" DestinationFiles="@(_GeneratedAnalyzerConfig)"
          Condition="'@(_GeneratedAnalyzerConfig)' != ''" />
    <Exec WorkingDirectory="$(_AnalyzerConfigRoot)" Command="ninja -f %(_RoslynAnalyzerConfigCase.Identity).ninja" />
    <Exec Command="$(_App) restore &quot;$(_AnalyzerConfigRoot)RoslynAnalyzerConfig.proj&quot; $(_AnalyzerConfigArguments) -p:TestCase=ordinary-%(_RoslynAnalyzerConfigCase.Identity) -p:ExpectedBaseConfig=%(_RoslynAnalyzerConfigCase.BaseConfig) -p:ExpectedCategoryConfig=%(_RoslynAnalyzerConfigCase.CategoryConfig) %(_RoslynAnalyzerConfigCase.Arguments)" />
    <GetFileHash Files="$(_AnalyzerConfigRoot)selection/%(_RoslynAnalyzerConfigCase.Identity).txt">
      <Output TaskParameter="Items" ItemName="_RoslynAnalyzerReplayHash" />
    </GetFileHash>
    <GetFileHash Files="$(_AnalyzerConfigRoot)selection/ordinary-%(_RoslynAnalyzerConfigCase.Identity).txt">
      <Output TaskParameter="Items" ItemName="_RoslynAnalyzerOrdinaryHash" />
    </GetFileHash>
    <Error Condition="'@(_RoslynAnalyzerReplayHash->'%(FileHash)')' != '@(_RoslynAnalyzerOrdinaryHash->'%(FileHash)')'"
           Text="Declared Roslyn analyzer-config selection must match ordinary execution." />
    <WriteLinesToFile File="$(_AnalyzerConfigRoot)config/analysislevel_1_default.globalconfig"
                      Lines="is_global = true" Overwrite="true" Condition="'$(AnalyzerConfigReleaseTrackingOptOut)' == 'true'" />
    <Exec Command="$(_App) restore &quot;$(_AnalyzerConfigRoot)RoslynAnalyzerConfig.proj&quot; $(_AnalyzerConfigArguments) -p:TestCase=ordinary-custom -p:$(_AnalyzerConfigPrefix)RulesVersion=1 -p:ExpectedBaseConfig=analysislevel_1_default.globalconfig -p:CustomConfigDirectory=&quot;$(_AnalyzerConfigRoot)config&quot;" />
    <Exec Command="$(_App) build &quot;$(_AnalyzerConfigRoot)RoslynAnalyzerConfig.proj&quot; $(_AnalyzerConfigArguments) -p:$(_AnalyzerConfigPrefix)RulesVersion=1 -p:ExpectedBaseConfig=analysislevel_1_default.globalconfig -p:CustomConfigDirectory=&quot;$(_AnalyzerConfigRoot)config&quot; -p:MSBuildEmitActionGraph=&quot;$(_AnalyzerConfigRoot)custom.ninja&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_CustomAnalyzerConfigExitCode" />
    </Exec>
    <Error Condition="'$(_CustomAnalyzerConfigExitCode)' == '0' or Exists('$(_AnalyzerConfigRoot)custom.ninja') or Exists('$(_AnalyzerConfigRoot)custom.ninja.actions')"
           Text="Undeclared custom analyzer-config directories must fail without publishing a partial graph." />
  </Target>
  <Target Name="TestArcadeRepositoryInfo">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ArcadeRepositoryInfo.proj" DestinationFolder="$(_TestDirectory)" />
    <ItemGroup>
      <_ArcadeRepositoryCase Include="dnceng"
                             PreparedUrl="https://dev.azure.com/dnceng/internal/_git/org-repo.git"
                             OrdinaryUrl="ssh://git@ssh.dev.azure.com/v3/dnceng/internal/org-repo.git"
                             ExpectedUrl="https://github.com/org/repo.git" />
      <_ArcadeRepositoryCase Include="devdiv"
                             PreparedUrl="https://devdiv.visualstudio.com/DevDiv/_git/ORG-REPO-Trusted"
                             OrdinaryUrl="https://devdiv.visualstudio.com/DevDiv/_git/ORG-REPO-Trusted"
                             ExpectedUrl="https://github.com/org/repo" />
      <_ArcadeRepositoryCase Include="disabled"
                             PreparedUrl="https://dev.azure.com/dnceng/internal/_git/org-repo.git"
                             OrdinaryUrl="https://dev.azure.com/dnceng/internal/_git/org-repo.git"
                             ExpectedUrl="https://dev.azure.com/dnceng/internal/_git/org-repo.git"
                             Arguments="-p:DisableSourceLinkUrlTranslation=true" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ArcadeRepositoryInfo.proj&quot; -p:Replay=true -p:TestCase=%(_ArcadeRepositoryCase.Identity) -p:InputUrl=%(_ArcadeRepositoryCase.PreparedUrl) -p:ExpectedUrl=%(_ArcadeRepositoryCase.ExpectedUrl) %(_ArcadeRepositoryCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)repository-info-%(_ArcadeRepositoryCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)repository-info') or Exists('$(_TestDirectory)missing-repository')"
           Text="Prepared Arcade URL translation must not execute file actions or inspect repository directories." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f repository-info-%(_ArcadeRepositoryCase.Identity).ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ArcadeRepositoryInfo.proj&quot; -p:TestCase=ordinary-%(_ArcadeRepositoryCase.Identity) -p:InputUrl=%(_ArcadeRepositoryCase.OrdinaryUrl) -p:ExpectedUrl=%(_ArcadeRepositoryCase.ExpectedUrl) %(_ArcadeRepositoryCase.Arguments)" />
    <GetFileHash Files="$(_TestDirectory)repository-info/%(_ArcadeRepositoryCase.Identity).txt">
      <Output TaskParameter="Items" ItemName="_ArcadeRepositoryReplayHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)repository-info/ordinary-%(_ArcadeRepositoryCase.Identity).txt">
      <Output TaskParameter="Items" ItemName="_ArcadeRepositoryOrdinaryHash" />
    </GetFileHash>
    <Error Condition="'@(_ArcadeRepositoryReplayHash->'%(FileHash)')' != '@(_ArcadeRepositoryOrdinaryHash->'%(FileHash)')'"
           Text="Prepared Arcade URL metadata must match ordinary provider translation and preserve opt-out behavior." />
  </Target>
  <Target Name="TestSourceLink">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)SourceLink.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Roslyn/Microsoft.Managed.Core.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='InitializeSourceRootMappedPaths' or @Name='_InitializeSourceRootMappedPathsFromSourceControl' or @Name='_SetPathMapFromSourceRoots']">
      <Output TaskParameter="Result" ItemName="_SourceRootTarget" />
    </XmlPeek>
    <Error Condition="'@(_SourceRootTarget->Count())' != '3'" Text="The packaged Roslyn targets must contain source-root mapping and PathMap preparation." />
    <PropertyGroup>
      <_SourceRootXml>@(_SourceRootTarget, '')</_SourceRootXml>
      <_SourceRootXml>$(_SourceRootXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_SourceRootXml>
      <_StaleSourceLink>$(_TestDirectory)source-link/stale/SourceLink.sourcelink.json</_StaleSourceLink>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)SourceRoots.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_SourceRootXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_SourceLinkCase Include="graph" Baseline="ordinary" />
      <_SourceLinkCase Include="stale" Baseline="ordinary-stale" />
      <_SourceLinkCase Include="paths" Arguments="-p:DeterministicSourcePaths=false" Baseline="ordinary-paths" />
      <_SourceLinkCase Include="legacy-hosts" Arguments="-p:LegacyHosts=true" Baseline="ordinary-legacy-hosts" />
      <_EmptySourceLinkCase Include="empty;no-url" />
      <_RejectedSourceLinkCase Include="root-separator;nested-root;revision;host;wildcard;gitlab-version;bitbucket-version" />
    </ItemGroup>
    <MakeDir Directories="$(_TestDirectory)source-link/stale;$(_TestDirectory)source-link/empty;$(_TestDirectory)source-link/no-url" />
    <WriteLinesToFile File="$(_StaleSourceLink)" Lines="stale" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)source-link/%(_EmptySourceLinkCase.Identity)/SourceLink.sourcelink.json" Lines="unreferenced" Overwrite="true" />
    <GetFileHash Files="$(_StaleSourceLink)">
      <Output TaskParameter="Hash" PropertyName="_StaleSourceLinkBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_SourceLinkCase.Identity) %(_SourceLinkCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_SourceLinkCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)source-link/graph') or Exists('$(_TestDirectory)source-link/paths') or Exists('$(_TestDirectory)missing-source')"
           Text="Source mapping and formatting must not create outputs or require source directories during construction." />
    <GetFileHash Files="$(_StaleSourceLink)">
      <Output TaskParameter="Hash" PropertyName="_StaleSourceLinkAfter" />
    </GetFileHash>
    <Error Condition="'$(_StaleSourceLinkBefore)' != '$(_StaleSourceLinkAfter)'" Text="Construction must not rewrite stale SourceLink JSON." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f source-link-%(_SourceLinkCase.Identity).ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_SourceLinkCase.Baseline) %(_SourceLinkCase.Arguments)" />
    <GetFileHash Files="$(_TestDirectory)source-link/%(_SourceLinkCase.Identity)/SourceLink.sourcelink.json">
      <Output TaskParameter="Items" ItemName="_ExecutedSourceLinkHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)source-link/%(_SourceLinkCase.Baseline)/SourceLink.sourcelink.json">
      <Output TaskParameter="Items" ItemName="_OrdinarySourceLinkHash" />
    </GetFileHash>
    <Error Condition="'@(_ExecutedSourceLinkHash->'%(FileHash)')' != '@(_OrdinarySourceLinkHash->'%(FileHash)')'"
           Text="Independent SourceLink execution must preserve ordinary JSON bytes, escaping, ordering and encoding." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_EmptySourceLinkCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_EmptySourceLinkCase.Identity).ninja&quot;" />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f source-link-%(_EmptySourceLinkCase.Identity).ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)source-link/%(_EmptySourceLinkCase.Identity)/SourceLink.sourcelink.json">
      <Output TaskParameter="Lines" ItemName="_EmptySourceLinkContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_EmptySourceLinkContents)' != 'unreferenced;unreferenced'"
           Text="Empty hardened mappings must leave stale JSON unreferenced and unchanged." />
    <ItemGroup>
      <_EmptySourceLinkAction Include="$(_TestDirectory)source-link-empty.ninja.actions/*.json;$(_TestDirectory)source-link-no-url.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_EmptySourceLinkAction)' != ''" Text="Empty SourceLink mappings must not emit file actions." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=%(_RejectedSourceLinkCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_RejectedSourceLinkExitCode" />
    </Exec>
    <Error Condition="@(_RejectedSourceLinkExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Invalid source-root or provider metadata must fail construction." />
    <Error Condition="Exists('$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja') or Exists('$(_TestDirectory)source-link-%(_RejectedSourceLinkCase.Identity).ninja.actions') or Exists('$(_TestDirectory)source-link/%(_RejectedSourceLinkCase.Identity)')"
           Text="Rejected source mapping must publish neither a partial graph nor SourceLink JSON." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)SourceLink.proj&quot; -p:TestCase=action-failure -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)source-link-action-failure.ninja&quot;" />
    <ItemGroup>
      <_SourceLinkFailureInvocation Include="$(_TestDirectory)source-link-action-failure.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_SourceLinkFailureInvocation->Count())' != '1'" Text="SourceLink generation must emit only its file writer action." />
    <MakeDir Directories="$(_TestDirectory)source-link/action-failure/SourceLink.sourcelink.json" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_SourceLinkFailureInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_SourceLinkFailureExitCode" />
    </Exec>
    <Error Condition="'$(_SourceLinkFailureExitCode)' == '0'" Text="SourceLink publication failures must stop independent execution." />
  </Target>
  <Target Name="TestIncrementalCaches">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)IncrementalCaches.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='_GenerateCompileDependencyCache' or @Name='_GenerateCompileInputs']">
      <Output TaskParameter="Result" ItemName="_CompileCacheTarget" />
    </XmlPeek>
    <Error Condition="'@(_CompileCacheTarget->Count())' != '2'" Text="The packaged Common targets must contain compile input preparation and its cache wrapper." />
    <WriteLinesToFile File="$(_TestDirectory)IncrementalCaches.Common.targets"
                      Lines="&lt;Project&gt;;@(_CompileCacheTarget);&lt;/Project&gt;" Overwrite="true" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='_GenerateRuntimeConfigurationFilesInputCache']">
      <Output TaskParameter="Result" ItemName="_RuntimeCacheTarget" />
    </XmlPeek>
    <Error Condition="'@(_RuntimeCacheTarget->Count())' != '1'" Text="The packaged SDK must contain the runtime configuration cache wrapper." />
    <PropertyGroup>
      <_RuntimeCacheXml>@(_RuntimeCacheTarget)</_RuntimeCacheXml>
      <_RuntimeCacheXml>$(_RuntimeCacheXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_RuntimeCacheXml>
      <_StaleAssemblyInfo>$(_TestDirectory)incremental-caches/stale/IncrementalCaches.AssemblyInfo.cs</_StaleAssemblyInfo>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)IncrementalCaches.Sdk.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_RuntimeCacheXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_IncrementalCacheCase Include="clean;stale" />
      <_IncrementalCachePath Include="IncrementalCaches.AssemblyInfoInputs.cache;IncrementalCaches.proj.CoreCompileInputs.cache;runtimeconfig.inputs.cache" />
    </ItemGroup>
    <MakeDir Directories="$(_TestDirectory)incremental-caches/stale/%(_IncrementalCachePath.Identity)" />
    <WriteLinesToFile File="$(_StaleAssemblyInfo)" Lines="// stale generated source" Overwrite="true" />
    <GetFileHash Files="$(_StaleAssemblyInfo)">
      <Output TaskParameter="Hash" PropertyName="_StaleAssemblyInfoBefore" />
    </GetFileHash>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)IncrementalCaches.proj&quot; -p:TestCase=%(_IncrementalCacheCase.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)incremental-caches/clean')" Text="Cache-free graph construction must not write outputs or create cache directories." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('AssemblyInfoInputs.cache'))
                      or $([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('CoreCompileInputs.cache'))
                      or $([System.IO.File]::ReadAllText('$(_TestDirectory)incremental-caches-%(_IncrementalCacheCase.Identity).ninja').Contains('runtimeconfig.inputs.cache'))"
           Text="Incremental timestamp caches must not appear in the emitted graph." />
    <GetFileHash Files="$(_StaleAssemblyInfo)">
      <Output TaskParameter="Hash" PropertyName="_StaleAssemblyInfoAfter" />
    </GetFileHash>
    <Error Condition="'$(_StaleAssemblyInfoBefore)' != '$(_StaleAssemblyInfoAfter)'" Text="Construction must not rewrite existing assembly info." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f incremental-caches-%(_IncrementalCacheCase.Identity).ninja" />
    <MakeDir Directories="$(_TestDirectory)incremental-caches/ordinary" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)IncrementalCaches.proj&quot; -p:TestCase=ordinary" />
    <Error Condition="!Exists('$(_TestDirectory)incremental-caches/ordinary/%(_IncrementalCachePath.Identity)')"
           Text="Ordinary builds must still create their incremental cache files." />
    <Error Condition="Exists('$(_TestDirectory)incremental-caches/clean/%(_IncrementalCachePath.Identity)')"
           Text="Independent execution must not create incremental caches." />
    <GetFileHash Files="$(_TestDirectory)incremental-caches/clean/IncrementalCaches.AssemblyInfo.cs;$(_StaleAssemblyInfo);$(_TestDirectory)incremental-caches/ordinary/IncrementalCaches.AssemblyInfo.cs">
      <Output TaskParameter="Items" ItemName="_CacheFreeAssemblyInfo" />
    </GetFileHash>
    <Error Condition="'@(_CacheFreeAssemblyInfo->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Cache-free execution must replace stale source and match ordinary assembly info bytes." />
  </Target>
  <Target Name="TestAssemblyVersion">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)AssemblyVersion.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.GenerateAssemblyInfo.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='GetAssemblyVersion' or @Name='GetAssemblyAttributes']">
      <Output TaskParameter="Result" ItemName="_AssemblyVersionTarget" />
    </XmlPeek>
    <Error Condition="'@(_AssemblyVersionTarget->Count())' != '2'" Text="The packaged SDK must contain both assembly version targets." />
    <PropertyGroup>
      <_AssemblyVersionXml>@(_AssemblyVersionTarget, '')</_AssemblyVersionXml>
      <_AssemblyVersionXml>$(_AssemblyVersionXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_AssemblyVersionXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)AssemblyVersion.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_AssemblyVersionXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_AssemblyVersionCase Include="semver" Version="1.2.3-beta.4+build.5" AssemblyVersion="1.2.3.0" FileVersion="1.2.3.0" InformationalVersion="1.2.3-beta.4+build.5" />
      <_AssemblyVersionCase Include="revision" Version="2.3.4.5" AssemblyVersion="2.3.4.5" FileVersion="2.3.4.5" InformationalVersion="2.3.4.5" />
      <_AssemblyVersionCase Include="file-info-overrides" Version="1.2.3" AssemblyVersion="1.2.3.0" FileVersion="8.7.6.5" InformationalVersion="custom" Arguments="-p:InputFileVersion=8.7.6.5 -p:InputInformationalVersion=custom" />
      <_AssemblyVersionCase Include="assembly-override" Version="not-a-version" AssemblyVersion="9.8.7.6" FileVersion="9.8.7.6" InformationalVersion="not-a-version" Arguments="-p:InputAssemblyVersion=9.8.7.6" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=%(_AssemblyVersionCase.Identity) -p:InputVersion=%(_AssemblyVersionCase.Version) -p:ExpectedAssemblyVersion=%(_AssemblyVersionCase.AssemblyVersion) -p:ExpectedFileVersion=%(_AssemblyVersionCase.FileVersion) -p:ExpectedInformationalVersion=%(_AssemblyVersionCase.InformationalVersion) %(_AssemblyVersionCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)assembly-version-%(_AssemblyVersionCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)assembly-version/%(_AssemblyVersionCase.Identity)/%(_AssemblyVersionCase.AssemblyVersion).txt')" Text="Assembly version derivation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f assembly-version-%(_AssemblyVersionCase.Identity).ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)assembly-version/%(_AssemblyVersionCase.Identity)/%(_AssemblyVersionCase.AssemblyVersion).txt">
      <Output TaskParameter="Lines" ItemName="_AssemblyVersionContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_AssemblyVersionContents)' != '@(_AssemblyVersionCase->'%(AssemblyVersion)|%(FileVersion)|%(InformationalVersion)')'"
           Text="Assembly version actions must receive the derived version values." />
    <MakeDir Directories="$(_TestDirectory)assembly-version/ordinary-%(_AssemblyVersionCase.Identity)" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=ordinary-%(_AssemblyVersionCase.Identity) -p:InputVersion=%(_AssemblyVersionCase.Version) -p:ExpectedAssemblyVersion=%(_AssemblyVersionCase.AssemblyVersion) -p:ExpectedFileVersion=%(_AssemblyVersionCase.FileVersion) -p:ExpectedInformationalVersion=%(_AssemblyVersionCase.InformationalVersion) %(_AssemblyVersionCase.Arguments)" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)AssemblyVersion.proj&quot; -p:TestCase=invalid -p:InputVersion=not-a-version -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)assembly-version-invalid.ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)assembly-version-invalid.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_InvalidAssemblyVersionExitCode" />
    </Exec>
    <Error Condition="'$(_InvalidAssemblyVersionExitCode)' == '0' or !$([System.IO.File]::ReadAllText('$(_TestDirectory)assembly-version-invalid.log').Contains('NETSDK1018'))"
           Text="Invalid assembly versions must retain their SDK diagnostic." />
    <Error Condition="Exists('$(_TestDirectory)assembly-version-invalid.ninja') or Exists('$(_TestDirectory)assembly-version-invalid.ninja.actions') or Exists('$(_TestDirectory)assembly-version/invalid')"
           Text="Invalid assembly versions must not publish a graph or execute file actions." />
  </Target>
  <Target Name="TestFrameworkAttribute">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)FrameworkAttribute.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.Common.CurrentVersion.targets"
             Query="/Project/Target[@Name='GenerateTargetFrameworkMonikerAttribute']">
      <Output TaskParameter="Result" ItemName="_FrameworkAttributeTarget" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Microsoft.CSharp.CurrentVersion.targets"
             Query="/Project/Target[@Name='_SetTargetFrameworkMonikerAttribute']">
      <Output TaskParameter="Result" ItemName="_FrameworkAttributeTarget" />
    </XmlPeek>
    <Error Condition="'@(_FrameworkAttributeTarget->Count())' != '2'" Text="The packaged Common and C# targets must contain framework attribute preparation and publication." />
    <WriteLinesToFile File="$(_TestDirectory)FrameworkAttribute.targets"
                      Lines="&lt;Project&gt;;@(_FrameworkAttributeTarget);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)framework-attribute.ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)framework-attribute/graph/generated.cs')" Text="Framework attribute construction must not write its output." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f framework-attribute.ninja" />
    <ReadLinesFromFile File="$(_TestDirectory)framework-attribute/graph/generated.cs">
      <Output TaskParameter="Lines" ItemName="_FrameworkAttributeContents" />
    </ReadLinesFromFile>
    <Error Condition="'@(_FrameworkAttributeContents)' != '// &lt;autogenerated /&gt;;using System%3b;using System.Reflection%3b;[assembly: global::System.Runtime.Versioning.TargetFrameworkAttribute(&quot;.NETCoreApp,Version=v10.0&quot;, FrameworkDisplayName = &quot;.NET 10.0&quot;)]'"
           Text="The framework attribute action did not publish the expected content." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=ordinary" />
    <Error Condition="!Exists('$(_TestDirectory)framework-attribute/ordinary/generated.cs')" Text="Ordinary framework attribute generation must still write its output." />
    <GetFileHash Files="$(_TestDirectory)framework-attribute/graph/generated.cs;$(_TestDirectory)framework-attribute/ordinary/generated.cs">
      <Output TaskParameter="Items" ItemName="_FrameworkAttributeHash" />
    </GetFileHash>
    <Error Condition="'@(_FrameworkAttributeHash->'%(FileHash)'->Distinct()->Count())' != '1'"
           Text="Independent framework attribute publication must preserve ordinary source bytes, including escaped semicolons." />
    <MakeDir Directories="$(_TestDirectory)framework-attribute/ordinary-failure/generated.cs" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=ordinary-failure -flp:&quot;LogFile=$(_TestDirectory)framework-attribute-ordinary-failure.log;WarningsOnly&quot;" />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)framework-attribute-ordinary-failure.log').Contains('MSB3491'))"
           Text="Ordinary framework attribute write failures must remain warnings." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)FrameworkAttribute.proj&quot; -p:TestCase=action-failure -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)framework-attribute-failure.ninja&quot;" />
    <ItemGroup>
      <_FrameworkAttributeFailureInvocation Include="$(_TestDirectory)framework-attribute-failure.ninja.actions/*.json" />
    </ItemGroup>
    <Error Condition="'@(_FrameworkAttributeFailureInvocation->Count())' != '1'" Text="Framework attribute generation must emit one file action." />
    <MakeDir Directories="$(_TestDirectory)framework-attribute/action-failure/generated.cs" />
    <Exec Command="&quot;$(GenBuildTestHost)&quot; &quot;$(_AppDirectory)/toolset/action-host/MSBuild.ActionTaskHost.dll&quot; --invocation &quot;@(_FrameworkAttributeFailureInvocation)&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_FrameworkAttributeFailureExitCode" />
    </Exec>
    <Error Condition="'$(_FrameworkAttributeFailureExitCode)' == '0'" Text="Hardened framework attribute write failures must stop execution." />
  </Target>
  <Target Name="TestProjectStyles">
    <WriteLinesToFile File="$(_TestDirectory)packages.config" Lines="&lt;packages /&gt;" Overwrite="true" />
    <WriteLinesToFile File="$(_TestDirectory)packages.ProjectStyle.config" Lines="&lt;packages /&gt;" Overwrite="true" />
    <ItemGroup>
      <_ProjectStyleCase Include="explicit" Style="PackageReference" HasReference="false" />
      <_ProjectStyleCase Include="mixed-case" Style="pAcKaGeReFeReNcE" HasReference="false" />
      <_ProjectStyleCase Include="items" Style="" HasReference="true" />
      <_ProjectStyleRejectedCase Include="discovery" Style="" HasReference="false" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="override" Style="PackagesConfig" HasReference="true" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="unknown" Style="invalid" HasReference="true" Duplicate="false" />
      <_ProjectStyleRejectedCase Include="duplicate" Style="PackageReference" HasReference="false" Duplicate="true" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=%(_ProjectStyleCase.Identity) -p:InputRestoreProjectStyle=%(_ProjectStyleCase.Style) -p:IncludePackageReference=%(_ProjectStyleCase.HasReference) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)style-%(_ProjectStyleCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)style-%(_ProjectStyleCase.Identity).txt')" Text="Classification and validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;style-%(_ProjectStyleCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)style-%(_ProjectStyleCase.Identity).txt')" Text="Classification did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=%(_ProjectStyleRejectedCase.Identity) -p:InputRestoreProjectStyle=%(_ProjectStyleRejectedCase.Style) -p:IncludePackageReference=%(_ProjectStyleRejectedCase.HasReference) -p:IncludeDuplicate=%(_ProjectStyleRejectedCase.Duplicate) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_ProjectStyleRejectedExitCode" />
    </Exec>
    <Error Condition="@(_ProjectStyleRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Unsupported classification and duplicate items must fail." />
    <Error Condition="Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)style-%(_ProjectStyleRejectedCase.Identity).txt')"
           Text="Rejected construction must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ProjectStyle.proj&quot; -p:TestCase=ordinary -p:ExpectedStyle=PackagesConfig -p:ExpectedCompatible=false" />
    <Error Condition="!Exists('$(_TestDirectory)style-ordinary.txt')" Text="Ordinary project-style classification must retain packages.config discovery." />
  </Target>
  <Target Name="TestExecutableReferences">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='ValidateExecutableReferences']">
      <Output TaskParameter="Result" ItemName="_ExecutableValidationTarget" />
    </XmlPeek>
    <Error Condition="'@(_ExecutableValidationTarget->Count())' != '1'" Text="The packaged SDK must contain one executable-reference validation target." />
    <PropertyGroup>
      <_ExecutableValidationXml>@(_ExecutableValidationTarget)</_ExecutableValidationXml>
      <_ExecutableValidationXml>$(_ExecutableValidationXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_ExecutableValidationXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)ExecutableReferences.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_ExecutableValidationXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_ExecutableReferenceCase Include="empty" Arguments="-p:HasReference=false -p:InputSelfContained=true" />
      <_ExecutableReferenceCase Include="matching" Arguments="" />
      <_ExecutableReferenceCase Include="legacy-metadata" Arguments="-p:UseAttributes=false" />
      <_ExecutableReferenceCase Include="non-executable" Arguments="-p:InputIsExecutable=false -p:InputSelfContained=true" />
      <_ExecutableReferenceCase Include="global-self-contained" Arguments="-p:SelfContained=true" />
      <_ExecutableReferenceCase Include="local-rid" Arguments="-p:InputRuntimeIdentifier=test-rid -p:ReferenceMajor=7" />
      <_ExecutableReferenceCase Include="global-rid-explicit" Arguments="-p:RuntimeIdentifier=test-rid -p:ReferenceMajor=7 -p:ReferenceSelfContainedSpecified=true" />
      <_ExecutableReferenceCase Include="global-rid-modern" Arguments="-p:RuntimeIdentifier=test-rid" />
      <_ExecutableReferenceRejectedCase Include="local-self-contained" Arguments="-p:InputSelfContained=true" Error="NETSDK1150" />
      <_ExecutableReferenceRejectedCase Include="child-self-contained" Arguments="-p:ReferenceSelfContained=true" Error="NETSDK1151" />
      <_ExecutableReferenceRejectedCase Include="global-rid-inferred" Arguments="-p:RuntimeIdentifier=test-rid -p:ReferenceMajor=7" Error="NETSDK1151" />
      <_ExecutableReferenceRejectedCase Include="rid-agnostic" Arguments="-p:SelfContained=true -p:ReferenceIsRidAgnostic=true" Error="NETSDK1150" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=%(_ExecutableReferenceCase.Identity) %(_ExecutableReferenceCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).txt')" Text="Executable-reference validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;executable-%(_ExecutableReferenceCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)executable-%(_ExecutableReferenceCase.Identity).txt')" Text="Executable-reference validation did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=%(_ExecutableReferenceRejectedCase.Identity) %(_ExecutableReferenceRejectedCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_ExecutableReferenceRejectedExitCode" />
    </Exec>
    <Error Condition="@(_ExecutableReferenceRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Incompatible executable references must fail." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).log').Contains('%(_ExecutableReferenceRejectedCase.Error)'))"
           Text="Executable-reference validation did not report the expected SDK diagnostic." />
    <Error Condition="Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)executable-%(_ExecutableReferenceRejectedCase.Identity).txt')"
           Text="Rejected executable-reference validation must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=ordinary-global -p:SelfContained=true" />
    <Error Condition="!Exists('$(_TestDirectory)executable-ordinary-global.txt')" Text="Ordinary executable-reference validation must retain global-property propagation." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)ExecutableReferences.proj&quot; -p:TestCase=ordinary-mismatch -p:InputSelfContained=true -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)executable-ordinary-mismatch.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_OrdinaryExecutableReferenceExitCode" />
    </Exec>
    <Error Condition="'$(_OrdinaryExecutableReferenceExitCode)' == '0' or Exists('$(_TestDirectory)executable-ordinary-mismatch.txt') or !$([System.IO.File]::ReadAllText('$(_TestDirectory)executable-ordinary-mismatch.log').Contains('NETSDK1150'))"
           Text="Ordinary executable-reference validation must retain incompatible-reference errors." />
  </Target>
  <Target Name="TestEditorConfig">
    <MakeDir Directories="$(_TestDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)EditorConfig.proj" DestinationFolder="$(_TestDirectory)" />
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Roslyn/Microsoft.Managed.Core.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='GenerateMSBuildEditorConfigFileShouldRun' or @Name='GenerateMSBuildEditorConfigFileCore']">
      <Output TaskParameter="Result" ItemName="_EditorConfigTarget" />
    </XmlPeek>
    <Error Condition="'@(_EditorConfigTarget->Count())' != '2'" Text="The packaged Roslyn targets must contain both editorconfig targets." />
    <PropertyGroup>
      <_EditorConfigXml>@(_EditorConfigTarget, '')</_EditorConfigXml>
      <_EditorConfigXml>$(_EditorConfigXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_EditorConfigXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)EditorConfig.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_EditorConfigXml);&lt;/Project&gt;" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig.ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)editorconfig/graph/generated.editorconfig')"
           Text="Editorconfig construction must not write the configuration." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f editorconfig.ninja" />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=ordinary" />
    <GetFileHash Files="$(_TestDirectory)editorconfig/ordinary/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_OrdinaryEditorConfigHash" />
    </GetFileHash>
    <GetFileHash Files="$(_TestDirectory)editorconfig/graph/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_GraphEditorConfigHash" />
    </GetFileHash>
    <Error Condition="'$(_OrdinaryEditorConfigHash)' == '' or '$(_OrdinaryEditorConfigHash)' != '$(_GraphEditorConfigHash)'"
           Text="Independent editorconfig execution must preserve the ordinary task's exact bytes." />
    <WriteLinesToFile File="$(_TestDirectory)editorconfig/graph/generated.editorconfig" Lines="stale output" Overwrite="true" />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=graph -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig-overwrite.ninja&quot;" />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)editorconfig/graph/generated.editorconfig').Contains('stale output'))"
           Text="Construction must not overwrite an existing editorconfig." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f editorconfig-overwrite.ninja" />
    <GetFileHash Files="$(_TestDirectory)editorconfig/graph/generated.editorconfig">
      <Output TaskParameter="Hash" PropertyName="_OverwrittenEditorConfigHash" />
    </GetFileHash>
    <Error Condition="'$(_OrdinaryEditorConfigHash)' != '$(_OverwrittenEditorConfigHash)'"
           Text="Editorconfig actions must overwrite stale output without appending or changing encoding." />
    <ItemGroup>
      <_EditorConfigRejectedMetadata Include="ModifiedTime;CreatedTime;AccessedTime;mOdIfIeDtImE" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)EditorConfig.proj&quot; -p:TestCase=%(_EditorConfigRejectedMetadata.Identity) -p:RequestedMetadata=%(_EditorConfigRejectedMetadata.Identity) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_EditorConfigRejectedExitCode" />
    </Exec>
    <Error Condition="@(_EditorConfigRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="Filesystem-derived editorconfig metadata must fail construction." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).log').Contains('requires a filesystem query'))"
           Text="Editorconfig metadata rejection must report its zero-I/O constraint." />
    <Error Condition="Exists('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja') or Exists('$(_TestDirectory)editorconfig-%(_EditorConfigRejectedMetadata.Identity).ninja.actions') or Exists('$(_TestDirectory)editorconfig/%(_EditorConfigRejectedMetadata.Identity)/generated.editorconfig')"
           Text="Rejected editorconfig formatting must not publish a partial graph or execute file actions." />
  </Target>
  <Target Name="TestWinMDReferences">
    <XmlPeek XmlInputPath="$(_AppDirectory)/toolset/Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.Sdk.targets"
             Namespaces="&lt;Namespace Prefix='msb' Uri='http://schemas.microsoft.com/developer/msbuild/2003' /&gt;"
             Query="/msb:Project/msb:Target[@Name='_BlockWinMDsOnUnsupportedTFMs']">
      <Output TaskParameter="Result" ItemName="_WinMDValidationTarget" />
    </XmlPeek>
    <Error Condition="'@(_WinMDValidationTarget->Count())' != '1'" Text="The packaged SDK must contain one WinMD validation target." />
    <PropertyGroup>
      <_WinMDValidationXml>@(_WinMDValidationTarget)</_WinMDValidationXml>
      <_WinMDValidationXml>$(_WinMDValidationXml.Replace(' xmlns="http://schemas.microsoft.com/developer/msbuild/2003"', ''))</_WinMDValidationXml>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestDirectory)WinMDReferences.targets"
                      Lines="&lt;Project xmlns='http://schemas.microsoft.com/developer/msbuild/2003'&gt;;$(_WinMDValidationXml);&lt;/Project&gt;" Overwrite="true" />
    <ItemGroup>
      <_WinMDCase Include="empty" Arguments="-p:HasManagedReference=false" />
      <_WinMDCase Include="managed" Arguments="" />
      <_WinMDCase Include="lookalikes" Arguments="-p:HasLookalikeReferences=true" />
      <_WinMDRejectedCase Include="mixed" WinMDExtension="winmd" />
      <_WinMDRejectedCase Include="uppercase" WinMDExtension="WINMD" />
    </ItemGroup>
    <Exec Command="$(_App) build &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=%(_WinMDCase.Identity) %(_WinMDCase.Arguments) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)winmd-%(_WinMDCase.Identity).ninja&quot;" />
    <Error Condition="Exists('$(_TestDirectory)winmd-%(_WinMDCase.Identity).txt')" Text="WinMD validation must not execute file actions during construction." />
    <Exec WorkingDirectory="$(_TestDirectory)" Command="ninja -f &quot;winmd-%(_WinMDCase.Identity).ninja&quot;" />
    <Error Condition="!Exists('$(_TestDirectory)winmd-%(_WinMDCase.Identity).txt')" Text="WinMD validation did not produce an executable graph." />
    <Exec Command="$(_App) build &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=%(_WinMDRejectedCase.Identity) -p:HasWinMDReference=true -p:WinMDExtension=%(_WinMDRejectedCase.WinMDExtension) -p:MSBuildEmitActionGraph=&quot;$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja&quot; -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" ItemName="_WinMDRejectedExitCode" />
    </Exec>
    <Error Condition="@(_WinMDRejectedExitCode->AnyHaveMetadataValue('Identity', '0'))" Text="WinMD references must fail hardened construction." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('NETSDK1130'))
                      or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('sample.%(_WinMDRejectedCase.WinMDExtension)'))
                      or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).log').Contains('another.WinMd'))"
           Text="Hardened WinMD validation must report every WinMD by name without reading missing managed references." />
    <Error Condition="Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja') or Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).ninja.actions') or Exists('$(_TestDirectory)winmd-%(_WinMDRejectedCase.Identity).txt')"
           Text="Rejected WinMD validation must neither publish a graph nor execute actions." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=ordinary-managed" />
    <Error Condition="!Exists('$(_TestDirectory)winmd-ordinary-managed.txt')" Text="Ordinary validation without WinMD references must not inspect managed assemblies." />
    <Exec Command="$(_App) restore &quot;$(_TestDirectory)WinMDReferences.proj&quot; -p:TestCase=ordinary-mixed -p:HasWinMDReference=true -noconsolelogger -flp:&quot;LogFile=$(_TestDirectory)winmd-ordinary-mixed.log;ErrorsOnly&quot;"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_OrdinaryWinMDExitCode" />
    </Exec>
    <Error Condition="'$(_OrdinaryWinMDExitCode)' == '0' or Exists('$(_TestDirectory)winmd-ordinary-mixed.txt') or !$([System.IO.File]::ReadAllText('$(_TestDirectory)winmd-ordinary-mixed.log').Contains('System.IO.FileNotFoundException'))"
           Text="Ordinary builds must retain the existing PE-inspecting WinMD checker." />
  </Target>
</Project>
