<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Target Name="RejectExtraPreparation"
          BeforeTargets="Restore;_CaptureNuGetInputs;_GenerateFrameworkReferenceFetchManifest;_CaptureApiCompatInputs;_PrepareHardenedGraphInputs;PrepareProjectReferences"
          Condition="'$(MSBuildHardenedGraph)' != 'true'">
    <Error Text="Acquisition facts must not require child Restore, capture, or configured reference preparation." />
  </Target>
</Project>
