<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableBinPlacing>false</EnableBinPlacing>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.Build.Tasks.TargetFramework"
                      Version="$(ArcadeTargetFrameworkPackageVersion)" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="_CaptureTargetFrameworkInputs">
    <Error Text="A newly restored Arcade package must not require configured capture." />
  </Target>
  <Target Name="CheckArcadePackageInputs" BeforeTargets="Build"
          Condition="'$(MSBuildHardenedGraph)' == 'true'">
    <Error Condition="'$(_RuntimeGraphInputsVersion)' != '1' Or '@(_RuntimeGraphResource)' == ''"
           Text="Fresh Build must import native runtime-graph facts registered before the package targets were available."
           DeclaredInputs="" DeclaredOutputs="" />
  </Target>
</Project>
