<Project>
  <PropertyGroup>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <TargetFramework>net11.0</TargetFramework>
    <TargetFrameworkMoniker>.NETCoreApp,Version=v11.0</TargetFrameworkMoniker>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/Root/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Library/Library.csproj" AdditionalProperties="Flavor=One" />
    <ProjectReference Include="Library/./Library.csproj" AdditionalProperties="Flavor=Two" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)/NuGet.targets" />
  <Target Name="CheckAcquisitionInputs" AfterTargets="Restore"
          Condition="'$(MSBuildRestoreGraphInputs)' == 'true'">
    <ItemGroup>
      <_InputRequest Include="@(_RestoreGraphEntryFiltered->WithMetadataValue('Type', 'NuGetInputRequest'))" />
      <_PackInputRequest Include="@(_RestoreGraphEntryFiltered->WithMetadataValue('Type', 'FrameworkPackInputRequest'))" />
      <_ApiCompatInputRequest Include="@(_RestoreGraphEntryFiltered->WithMetadataValue('Type', 'ApiCompatInputRequest'))" />
    </ItemGroup>
    <Error Condition="'@(_InputRequest->Count())' != '4' or '$(_NuGetInputModelsWritten)' != '1'"
           Text="Both framework visits in both acquisition contexts must produce bindings, but one shared assets model must be written once." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Library/obj/nugetinputs/Library.csproj.g.props')"
           Text="Child NuGet facts must exist immediately after root acquisition without running child Restore or capture targets." />
    <Error Condition="'@(_PackInputRequest->Count())' != '4' Or '$(_FrameworkPackInputModelsWritten)' != '1' Or
                      !Exists('$(MSBuildGraphSdkBindingsDirectory)/framework-pack-resources/inputs.g.props') Or
                      !Exists('$(MSBuildGraphSdkBindingsDirectory)/framework-pack-resources/platform-sdk-display-names.g.props') Or
                      !Exists('$(MSBuildProjectDirectory)/Library/obj/frameworkpackinputs/Library.csproj.g.props') Or
                      '@(_PackInputRequest->'%(LocatorFile)'->Distinct()->Count())' != '1'"
           Text="All acquisition contexts must contribute framework-pack bindings to one post-acquisition translation without child preparation." />
    <Error Condition="Exists('$(MSBuildProjectDirectory)/Library/obj/frameworkreferences')"
           Text="Acquisition must not publish configured framework-reference or platform display snapshots." />
    <Error Condition="'@(_ApiCompatInputRequest->Count())' != '4' Or '$(_ApiCompatInputModelsWritten)' != '1' Or
                      !Exists('$(MSBuildProjectDirectory)/Library/obj/apicompatinputs/Library.csproj.g.props') Or
                      Exists('$(MSBuildProjectDirectory)/Library/obj/apicompatinputs/Debug')"
           Text="ApiCompat facts must be unconfigured acquisition outputs even before package targets enable validation." />
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)/Library/obj/apicompatinputs/Library.csproj.g.props"
             Query="/Project/PropertyGroup/_ApiCompatPreparedDefaultSuppressionFile/text()">
      <Output TaskParameter="Result" PropertyName="_AcquiredDefaultSuppression" />
    </XmlPeek>
    <Error Condition="('$(ExpectedSuppressionPresent)' == 'true' And '$(_AcquiredDefaultSuppression)' != '$(MSBuildProjectDirectory)/Library/CompatibilitySuppressions.xml') Or
                      ('$(ExpectedSuppressionPresent)' != 'true' And '$(_AcquiredDefaultSuppression)' != '')"
           Text="Every successful acquisition must refresh both positive and negative default suppression facts." />
  </Target>
</Project>
