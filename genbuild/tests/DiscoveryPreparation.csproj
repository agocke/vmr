<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(MSBuildProjectName)' == 'App'">net11.0</TargetFramework>
    <TargetFrameworks Condition="'$(MSBuildProjectName)' == 'Library'">net11.0;net10.0;netstandard2.0;net462</TargetFrameworks>
    <OutputType Condition="'$(MSBuildProjectName)' == 'App'">Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableSourceControlManagerQueries>true</EnableSourceControlManagerQueries>
    <EnableSourceControlFetchManifest>true</EnableSourceControlFetchManifest>
    <_DiscoveryRestoreInputs>$(MSBuildProjectExtensionsPath)discovery-restore.g.props</_DiscoveryRestoreInputs>
  </PropertyGroup>
  <Import Project="$(_DiscoveryRestoreInputs)" Condition="Exists('$(_DiscoveryRestoreInputs)')" />
  <ItemGroup>
    <Compile Include="Program.cs" Condition="'$(MSBuildProjectName)' == 'App'" />
    <Compile Include="Greeting.cs" Condition="'$(MSBuildProjectName)' == 'Library'" />
    <ProjectReference Include="../Library/Library.csproj" Condition="'$(MSBuildProjectName)' == 'App'" />
  </ItemGroup>
  <Target Name="WriteDiscoveryRestoreInputs"
          AfterTargets="Restore"
          Condition="'$(MSBuildProjectName)' == 'Library'">
    <MakeDir Directories="$(MSBuildProjectExtensionsPath)" />
    <WriteLinesToFile File="$(_DiscoveryRestoreInputs)"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;DiscoveryRestoreInputsReady&gt;true&lt;/DiscoveryRestoreInputsReady&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;"
                      Overwrite="true" />
  </Target>
  <Target Name="CheckDiscoveryRestoreInputs"
          BeforeTargets="_CaptureNuGetInputs"
          Condition="'$(MSBuildProjectName)' == 'Library' and '$(_MSBuildPreparingGraphInputs)' == 'true'">
    <Error Condition="'$(DiscoveryRestoreInputsReady)' != 'true'"
           Text="Discovery capture must freshly import inputs generated by the project's Restore." />
  </Target>
</Project>
