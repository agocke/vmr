<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(MSBuildProjectName)' == 'App'">net11.0</TargetFramework>
    <TargetFrameworks Condition="'$(MSBuildProjectName)' == 'Library'">net11.0;net10.0;netstandard2.0;net462</TargetFrameworks>
    <OutputType Condition="'$(MSBuildProjectName)' == 'App'">Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableSourceControlManagerQueries>true</EnableSourceControlManagerQueries>
    <EnableSourceControlFetchManifest>true</EnableSourceControlFetchManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" Condition="'$(MSBuildProjectName)' == 'App'" />
    <Compile Include="Greeting.cs" Condition="'$(MSBuildProjectName)' == 'Library'" />
    <ProjectReference Include="../Library/Library.csproj" Condition="'$(MSBuildProjectName)' == 'App'" />
    <PackageReference Include="GenBuild.Discovery.Metadata" Version="1.0.0" PrivateAssets="all"
                      Condition="'$(MSBuildProjectName)' == 'Library'" />
  </ItemGroup>
  <Target Name="RejectDiscoveryChildRestore"
          BeforeTargets="Restore"
          Condition="'$(MSBuildHardenedGraph)' != 'true'">
    <Error Text="Discovery acquisition must not invoke child Restore, including nested Restore with graph-input collection disabled." />
  </Target>
  <Target Name="RejectDiscoveryPreparation"
          BeforeTargets="_CaptureNuGetInputs;_GenerateFrameworkReferenceFetchManifest;_CaptureApiCompatInputs;_PrepareHardenedGraphInputs;_CaptureHardenedGraphInputs;_CaptureHardenedGraphInputsForFrameworkDiscovery;PrepareProjectReferences"
          Condition="'$(MSBuildHardenedGraph)' != 'true'">
    <Error Text="Discovery facts must come from ordinary NuGet acquisition visits, without child Restore, capture or reference preparation." />
  </Target>
  <Target Name="CheckDiscoveryAcquisitionImports"
          BeforeTargets="_GenerateProjectRestoreGraphPerFramework"
          Condition="'$(MSBuildRestoreGraphInputs)' == 'true'">
    <Error Condition="'$(DiscoveryPackageMetadata)' != ''"
           Text="Acquisition must not depend on newly restored package Build authoring." />
  </Target>
</Project>
