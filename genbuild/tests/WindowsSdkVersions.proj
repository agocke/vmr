<Project DefaultTargets="Test">
  <PropertyGroup>
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <WindowsSdkSupportedTargetPlatformVersion Include="10.0.26100.1;10.0.26100.0;8.0" />
  </ItemGroup>
  <Import Project="$(GenBuildToolsetDirectory)Sdks/Microsoft.NET.Sdk/targets/Microsoft.NET.WindowsSdkSupportedTargetPlatforms.props" />
  <Target Name="Test">
    <Error Condition="'@(SdkSupportedTargetPlatformVersion->'%(Identity)=%(NormalizedSupportedTargetPlatformVersion)')' != '10.0.26100.1=10.0.26100.0;10.0.26100.0=;8.0='"
           Text="Conditional Windows SDK authoring must preserve CsWinRT normalization and unchanged platform versions." />
  </Target>
</Project>
