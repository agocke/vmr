<Project DefaultTargets="Build">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <GenBuildRoot>$(MSBuildThisFileDirectory)../</GenBuildRoot>
    <GenBuildOutputDirectory Condition="'$(GenBuildOutputDirectory)' == ''">$(GenBuildRoot)artifacts/bin/genbuild/$(Configuration)/</GenBuildOutputDirectory>
    <GenBuildOutputDirectory>$([MSBuild]::NormalizeDirectory('$(GenBuildOutputDirectory)'))</GenBuildOutputDirectory>
    <GenBuildToolsetDirectory>$(GenBuildOutputDirectory)toolset/</GenBuildToolsetDirectory>
    <GenBuildBootstrapSdk Condition="'$(GenBuildBootstrapSdk)' == ''">$(MSBuildToolsPath)/</GenBuildBootstrapSdk>
    <GenBuildDotNetHost Condition="'$(GenBuildDotNetHost)' == ''">$(DOTNET_HOST_PATH)</GenBuildDotNetHost>
    <GenBuildDotNetHost Condition="'$(GenBuildDotNetHost)' == '' and '$(OS)' != 'Windows_NT'">$([MSBuild]::NormalizePath('$(GenBuildBootstrapSdk)', '../../dotnet'))</GenBuildDotNetHost>
    <GenBuildDotNetHost Condition="'$(GenBuildDotNetHost)' == ''">$([MSBuild]::NormalizePath('$(GenBuildBootstrapSdk)', '../../dotnet.exe'))</GenBuildDotNetHost>
    <_MSBuild>&quot;$(GenBuildDotNetHost)&quot; &quot;$(GenBuildBootstrapSdk)MSBuild.dll&quot;</_MSBuild>
    <_BuildArguments>-p:Configuration=$(Configuration) -m:1 -nr:false -v:minimal</_BuildArguments>
    <GenBuildCCompiler Condition="'$(GenBuildCCompiler)' == ''">cc</GenBuildCCompiler>
    <GenBuildMSBuildArtifactsDirectory Condition="'$(GenBuildMSBuildArtifactsDirectory)' == ''">$(GenBuildRoot)src/msbuild/artifacts/</GenBuildMSBuildArtifactsDirectory>
    <GenBuildRoslynArtifactsDirectory Condition="'$(GenBuildRoslynArtifactsDirectory)' == ''">$(GenBuildRoot)src/roslyn/artifacts/</GenBuildRoslynArtifactsDirectory>
    <GenBuildSdkArtifactsDirectory Condition="'$(GenBuildSdkArtifactsDirectory)' == ''">$(GenBuildRoot)src/sdk/artifacts/</GenBuildSdkArtifactsDirectory>
    <GenBuildSourceLinkArtifactsDirectory Condition="'$(GenBuildSourceLinkArtifactsDirectory)' == ''">$(GenBuildRoot)src/sourcelink/artifacts/</GenBuildSourceLinkArtifactsDirectory>
    <GenBuildArcadeArtifactsDirectory Condition="'$(GenBuildArcadeArtifactsDirectory)' == ''">$(MSBuildThisFileDirectory)arcade/</GenBuildArcadeArtifactsDirectory>
    <GenBuildNativeHostArtifactsDirectory Condition="'$(GenBuildNativeHostArtifactsDirectory)' == ''">$(MSBuildThisFileDirectory)native-host/</GenBuildNativeHostArtifactsDirectory>
    <GenBuildMSBuildArtifactsDirectory>$([MSBuild]::NormalizeDirectory('$(GenBuildMSBuildArtifactsDirectory)'))</GenBuildMSBuildArtifactsDirectory>
    <GenBuildRoslynArtifactsDirectory>$([MSBuild]::NormalizeDirectory('$(GenBuildRoslynArtifactsDirectory)'))</GenBuildRoslynArtifactsDirectory>
    <GenBuildSdkArtifactsDirectory>$([MSBuild]::NormalizeDirectory('$(GenBuildSdkArtifactsDirectory)'))</GenBuildSdkArtifactsDirectory>
    <GenBuildSourceLinkArtifactsDirectory>$([MSBuild]::NormalizeDirectory('$(GenBuildSourceLinkArtifactsDirectory)'))</GenBuildSourceLinkArtifactsDirectory>
    <GenBuildArcadeArtifactsDirectory>$([MSBuild]::NormalizeDirectory('$(GenBuildArcadeArtifactsDirectory)'))</GenBuildArcadeArtifactsDirectory>
    <GenBuildNativeHostArtifactsDirectory>$([MSBuild]::NormalizeDirectory('$(GenBuildNativeHostArtifactsDirectory)'))</GenBuildNativeHostArtifactsDirectory>
    <GenBuildArcadeNuGetArtifactsDirectory Condition="'$(GenBuildArcadeNuGetArtifactsDirectory)' == ''">$(GenBuildArcadeArtifactsDirectory)nuget/</GenBuildArcadeNuGetArtifactsDirectory>
    <GenBuildMSBuildFrameworkAssembly Condition="'$(GenBuildMSBuildFrameworkAssembly)' == ''">$(GenBuildMSBuildArtifactsDirectory)bin/Microsoft.Build.Framework/$(Configuration)/netstandard2.0/Microsoft.Build.Framework.dll</GenBuildMSBuildFrameworkAssembly>
    <GenBuildMSBuildUtilitiesAssembly Condition="'$(GenBuildMSBuildUtilitiesAssembly)' == ''">$(GenBuildMSBuildArtifactsDirectory)bin/Microsoft.Build.Utilities/$(Configuration)/netstandard2.0/Microsoft.Build.Utilities.Core.dll</GenBuildMSBuildUtilitiesAssembly>
    <_ComponentBuildArguments>-p:GenBuildMSBuildFrameworkAssembly=&quot;$(GenBuildMSBuildFrameworkAssembly)&quot; -p:GenBuildMSBuildUtilitiesAssembly=&quot;$(GenBuildMSBuildUtilitiesAssembly)&quot;</_ComponentBuildArguments>
    <_AppBuildArguments Condition="'$(GenBuildAppArtifactsDirectory)' != ''">-p:GenBuildAppArtifactsDirectory=&quot;$([MSBuild]::NormalizeDirectory('$(GenBuildAppArtifactsDirectory)'))&quot; -p:ArtifactsDirectory=&quot;$([MSBuild]::NormalizeDirectory('$(GenBuildAppArtifactsDirectory)', 'nuget'))&quot;</_AppBuildArguments>
    <_MSBuildOutput>$(GenBuildMSBuildArtifactsDirectory)bin/MSBuild/$(Configuration)/net11.0/</_MSBuildOutput>
    <_RoslynOutput>$(GenBuildRoslynArtifactsDirectory)bin/</_RoslynOutput>
    <_Sdk>$(GenBuildToolsetDirectory)Sdks/Microsoft.NET.Sdk/</_Sdk>
    <_SdkSources>$(GenBuildRoot)src/sdk/src/Tasks/Microsoft.NET.Build.Tasks/</_SdkSources>
    <_SdkOutput>$(GenBuildSdkArtifactsDirectory)bin/$(Configuration)/Sdks/Microsoft.NET.Sdk/</_SdkOutput>
    <_NetAnalyzers>$(GenBuildSdkArtifactsDirectory)bin/Microsoft.CodeAnalysis.NetAnalyzers.Package/</_NetAnalyzers>
    <_SourceLinkOutput>$(GenBuildSourceLinkArtifactsDirectory)bin/</_SourceLinkOutput>
  </PropertyGroup>

  <ItemGroup>
    <Component Include="$(GenBuildRoot)src/msbuild/src/Utilities/Microsoft.Build.Utilities.csproj" Tfm="netstandard2.0" ArtifactsDirectory="$(GenBuildMSBuildArtifactsDirectory)" />
    <Component Include="$(GenBuildRoot)src/msbuild/src/MSBuild/MSBuild.csproj;$(GenBuildRoot)src/msbuild/src/MSBuild.ActionTaskHost/MSBuild.ActionTaskHost.csproj" Tfm="net11.0" ArtifactsDirectory="$(GenBuildMSBuildArtifactsDirectory)" />
    <Component Include="$(GenBuildRoot)src/sdk/src/Tasks/Microsoft.NET.Build.Tasks/Microsoft.NET.Build.Tasks.csproj" Tfm="net11.0" ArtifactsDirectory="$(GenBuildSdkArtifactsDirectory)" />
    <Component Include="$(MSBuildThisFileDirectory)arcade/TargetFramework.csproj" Tfm="net11.0" />
    <Component Include="$(MSBuildThisFileDirectory)arcade/sdk/ArcadeSdk.csproj" Tfm="net11.0" />
    <Component Include="$(MSBuildThisFileDirectory)arcade/xliff/XliffTasks.csproj" Tfm="net11.0" />
    <Component Include="$(MSBuildThisFileDirectory)arcade/templating/Templating.csproj" Tfm="net11.0" />
    <Component Include="$(GenBuildRoot)src/roslyn/src/Compilers/Core/MSBuildTask/MSBuild/Microsoft.Build.Tasks.CodeAnalysis.csproj;$(GenBuildRoot)src/roslyn/src/CodeStyle/Tools/CodeStyleConfigFileGenerator.csproj;$(GenBuildRoot)src/roslyn/src/RoslynAnalyzers/Tools/GenerateDocumentationAndConfigFiles/GenerateDocumentationAndConfigFiles.csproj" Tfm="net10.0" ArtifactsDirectory="$(GenBuildRoslynArtifactsDirectory)" />
    <Component Include="$(GenBuildRoot)src/roslyn/src/Compilers/CSharp/csc/AnyCpu/csc.csproj" Tfm="net10.0" ArtifactsDirectory="$(GenBuildRoslynArtifactsDirectory)" />
    <Component Include="$(GenBuildRoot)src/roslyn/src/Compilers/VisualBasic/vbc/AnyCpu/vbc.csproj" Tfm="net10.0" ArtifactsDirectory="$(GenBuildRoslynArtifactsDirectory)" />
    <Component Include="$(MSBuildThisFileDirectory)arcade/genfacades/GenFacades.csproj" Tfm="net11.0" />
    <Component Include="$(GenBuildRoot)src/roslyn/src/CodeStyle/CSharp/CodeFixes/Microsoft.CodeAnalysis.CSharp.CodeStyle.Fixes.csproj;$(GenBuildRoot)src/roslyn/src/CodeStyle/VisualBasic/CodeFixes/Microsoft.CodeAnalysis.VisualBasic.CodeStyle.Fixes.vbproj;$(GenBuildRoot)src/roslyn/src/RoslynAnalyzers/Microsoft.CodeAnalysis.Analyzers/Core/Microsoft.CodeAnalysis.Analyzers.csproj;$(GenBuildRoot)src/roslyn/src/RoslynAnalyzers/Microsoft.CodeAnalysis.BannedApiAnalyzers/CSharp/Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.csproj" Tfm="netstandard2.0" ArtifactsDirectory="$(GenBuildRoslynArtifactsDirectory)" />
    <Component Include="$(GenBuildRoot)src/sdk/src/Microsoft.CodeAnalysis.NetAnalyzers/src/Microsoft.CodeAnalysis.NetAnalyzers.Package.csproj" ArtifactsDirectory="$(GenBuildSdkArtifactsDirectory)" />
    <SourceLink Include="Microsoft.Build.Tasks.Git" Source="Microsoft.Build.Tasks.Git" />
    <SourceLink Include="Microsoft.SourceLink.Common" Source="SourceLink.Common" />
    <SourceLink Include="Microsoft.SourceLink.AzureRepos.Git" Source="SourceLink.AzureRepos.Git" />
    <SourceLink Include="Microsoft.SourceLink.Bitbucket.Git" Source="SourceLink.Bitbucket.Git" />
    <SourceLink Include="Microsoft.SourceLink.GitHub" Source="SourceLink.GitHub" />
    <SourceLink Include="Microsoft.SourceLink.GitLab" Source="SourceLink.GitLab" />
    <Component Include="@(SourceLink->'$(GenBuildRoot)src/sourcelink/src/%(Source)/%(Identity).csproj')" Tfm="net10.0" ArtifactsDirectory="$(GenBuildSourceLinkArtifactsDirectory)" />
    <Component Update="@(Component)">
      <FrameworkArgument Condition="'%(Component.Tfm)' != ''">-p:TargetFramework=%(Component.Tfm)</FrameworkArgument>
      <ArtifactsArgument Condition="'%(Component.ArtifactsDirectory)' != ''">-p:ArtifactsDir=&quot;%(Component.ArtifactsDirectory)&quot;</ArtifactsArgument>
      <ArtifactsArgument Condition="'%(Component.ArtifactsDirectory)' == ''">-p:GenBuildArcadeArtifactsDirectory=&quot;$(GenBuildArcadeArtifactsDirectory)&quot; -p:GenBuildArcadeNuGetArtifactsDirectory=&quot;$(GenBuildArcadeNuGetArtifactsDirectory)&quot; -p:ArtifactsDirectory=&quot;$(GenBuildArcadeNuGetArtifactsDirectory)&quot;</ArtifactsArgument>
    </Component>
  </ItemGroup>

  <Target Name="ValidateInputs">
    <Error Condition="!Exists('$(GenBuildDotNetHost)') or !Exists('$(GenBuildBootstrapSdk)MSBuild.dll')" Text="Build with a .NET 11 SDK. Set GenBuildDotNetHost and GenBuildBootstrapSdk to explicit build-time tool paths if needed." />
    <MakeDir Directories="$(GenBuildRoot)artifacts/log/genbuild/$(Configuration)" />
  </Target>

  <Target Name="BuildComponents" DependsOnTargets="ValidateInputs" Condition="'$(GenBuildSkipComponentBuild)' != 'true'">
    <Exec EnvironmentVariables="DOTNET_HOST_PATH=$(GenBuildDotNetHost)" Command="$(_MSBuild) &quot;%(Component.Identity)&quot; -t:Restore %(Component.ArtifactsArgument) $(_ComponentBuildArguments) $(_BuildArguments) -bl:&quot;$(GenBuildRoot)artifacts/log/genbuild/$(Configuration)/%(Component.Filename)-restore-{}.binlog&quot;" />
    <Exec EnvironmentVariables="DOTNET_HOST_PATH=$(GenBuildDotNetHost)" Command="$(_MSBuild) &quot;%(Component.Identity)&quot; -t:Build %(Component.FrameworkArgument) %(Component.ArtifactsArgument) -p:CreateBootstrap=false $(_ComponentBuildArguments) $(_BuildArguments) -bl:&quot;$(GenBuildRoot)artifacts/log/genbuild/$(Configuration)/%(Component.Filename)-build-{}.binlog&quot;" />
  </Target>

  <Target Name="BuildApp" DependsOnTargets="ValidateInputs">
    <XmlPeek XmlInputPath="$(GenBuildBootstrapSdk)Microsoft.NETCoreSdk.BundledVersions.props" Query="/Project/ItemGroup/KnownFrameworkReference[@Include='Microsoft.NETCore.App' and @TargetFramework='net11.0']/@TargetingPackVersion">
      <Output TaskParameter="Result" PropertyName="GenBuildTargetingPackVersion" />
    </XmlPeek>
    <Error Condition="'$(GenBuildTargetingPackVersion)' == ''" Text="The build-time SDK must declare the .NET 11 targeting-pack version." />
    <Exec EnvironmentVariables="DOTNET_HOST_PATH=$(GenBuildDotNetHost)" Command="$(_MSBuild) &quot;$(MSBuildThisFileDirectory)genbuild.csproj&quot; -t:Restore $(_AppBuildArguments) $(_BuildArguments) -bl:&quot;$(GenBuildRoot)artifacts/log/genbuild/$(Configuration)/app-restore-{}.binlog&quot;" />
    <Exec EnvironmentVariables="DOTNET_HOST_PATH=$(GenBuildDotNetHost)" Command="$(_MSBuild) &quot;$(MSBuildThisFileDirectory)genbuild.csproj&quot; -t:Build -p:OutputPath=&quot;$(GenBuildOutputDirectory)&quot; $(_AppBuildArguments) $(_BuildArguments) -bl:&quot;$(GenBuildRoot)artifacts/log/genbuild/$(Configuration)/app-build-{}.binlog&quot;" />
    <Exec EnvironmentVariables="DOTNET_HOST_PATH=$(GenBuildDotNetHost)" Command="$(_MSBuild) &quot;$(MSBuildThisFileDirectory)toolset/Toolset.csproj&quot; -t:Restore -p:GenBuildTargetingPackVersion=$(GenBuildTargetingPackVersion) $(_AppBuildArguments) $(_BuildArguments) -bl:&quot;$(GenBuildRoot)artifacts/log/genbuild/$(Configuration)/tools-restore-{}.binlog&quot;" />
    <Exec EnvironmentVariables="DOTNET_HOST_PATH=$(GenBuildDotNetHost)" Command="$(_MSBuild) &quot;$(MSBuildThisFileDirectory)toolset/Toolset.csproj&quot; -t:Build -p:GenBuildTargetingPackVersion=$(GenBuildTargetingPackVersion) -p:GenBuildToolsetDirectory=&quot;$(GenBuildToolsetDirectory)&quot; $(_AppBuildArguments) $(_BuildArguments) -bl:&quot;$(GenBuildRoot)artifacts/log/genbuild/$(Configuration)/tools-build-{}.binlog&quot;" />
  </Target>

  <Target Name="BuildNativeTaskHost" DependsOnTargets="Assemble" Condition="'$(GenBuildNativeTaskHost)' == 'true'">
    <Exec EnvironmentVariables="DOTNET_HOST_PATH=$(GenBuildDotNetHost)" Command="$(_MSBuild) &quot;$(MSBuildThisFileDirectory)native-host/NativeTaskHost.csproj&quot; -restore -t:Publish -p:GenBuildToolsetDirectory=&quot;$(GenBuildToolsetDirectory)&quot; -p:BaseIntermediateOutputPath=&quot;$(GenBuildNativeHostArtifactsDirectory)obj/&quot; -p:OutputPath=&quot;$(GenBuildNativeHostArtifactsDirectory)bin/$(Configuration)/&quot; -p:DefaultItemExcludes=**/obj/** -p:PublishDir=&quot;$(GenBuildToolsetDirectory)native-action-host/&quot; $(_BuildArguments) -bl:&quot;$(GenBuildRoot)artifacts/log/genbuild/$(Configuration)/native-host-{}.binlog&quot;" />
  </Target>

  <Target Name="BuildReadSandbox" DependsOnTargets="Assemble" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <MakeDir Directories="$(GenBuildToolsetDirectory)read-sandbox" />
    <Exec Command="&quot;$(GenBuildCCompiler)&quot; -std=c11 -O2 -Wall -Wextra -Werror -Wformat=2 -Wshadow -Wstrict-prototypes -Wmissing-prototypes -Wpedantic &quot;$(MSBuildThisFileDirectory)landlock-launcher/launcher.c&quot; -o &quot;$(GenBuildToolsetDirectory)read-sandbox/genbuild-landlock&quot;" />
  </Target>

  <Target Name="GenerateAnalyzerManifests" DependsOnTargets="BuildComponents">
    <Exec Command="&quot;$(GenBuildDotNetHost)&quot; --roll-forward Major &quot;$(_RoslynOutput)CodeStyleConfigFileGenerator/$(Configuration)/net10.0/CodeStyleConfigFileGenerator.dll&quot; CSharp &quot;$(_RoslynOutput)Microsoft.CodeAnalysis.CSharp.CodeStyle.Fixes/$(Configuration)/netstandard2.0&quot; Microsoft.CodeAnalysis.CSharp.CodeStyle.targets &quot;$(_RoslynOutput)Microsoft.CodeAnalysis.CodeStyle/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CodeStyle.dll;$(_RoslynOutput)Microsoft.CodeAnalysis.CSharp.CodeStyle/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.CodeStyle.dll&quot;" />
    <Exec Command="&quot;$(GenBuildDotNetHost)&quot; --roll-forward Major &quot;$(_RoslynOutput)CodeStyleConfigFileGenerator/$(Configuration)/net10.0/CodeStyleConfigFileGenerator.dll&quot; VisualBasic &quot;$(_RoslynOutput)Microsoft.CodeAnalysis.VisualBasic.CodeStyle.Fixes/$(Configuration)/netstandard2.0&quot; Microsoft.CodeAnalysis.VisualBasic.CodeStyle.targets &quot;$(_RoslynOutput)Microsoft.CodeAnalysis.CodeStyle/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CodeStyle.dll;$(_RoslynOutput)Microsoft.CodeAnalysis.VisualBasic.CodeStyle/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.VisualBasic.CodeStyle.dll&quot;" />
  </Target>

  <Target Name="Assemble" DependsOnTargets="BuildComponents;BuildApp;GenerateAnalyzerManifests">
    <Error Condition="!Exists('$(_MSBuildOutput)MSBuild.dll') or !Exists('$(_SdkOutput)tools/net11.0/Microsoft.NET.Build.Tasks.dll')" Text="The locally-built MSBuild or SDK tasks are missing. Run without GenBuildSkipComponentBuild." />
    <ItemGroup>
      <_Engine Include="$(_MSBuildOutput)**/*" Exclude="$(_MSBuildOutput)MSBuild;$(_MSBuildOutput)MSBuild.exe;$(_MSBuildOutput)Directory.*;$(_MSBuildOutput)**/*.runtimeconfig.dev.json;$(_MSBuildOutput)**/publish/**/*" />
      <_CommonEntry Include="$(_MSBuildOutput)Microsoft.Common.props;$(_MSBuildOutput)Microsoft.Common.targets;$(_MSBuildOutput)Microsoft.Common.CrossTargeting.targets" />
      <_Host Include="$(GenBuildMSBuildArtifactsDirectory)bin/MSBuild.ActionTaskHost/$(Configuration)/net11.0/**/*" Exclude="**/*.runtimeconfig.dev.json" />
      <_SdkEntry Include="$(_SdkSources)sdk/**/*" />
      <_SdkTarget Include="$(_SdkSources)targets/**/*;$(GenBuildRoot)src/sdk/src/Tasks/Common/targets/**/*" />
      <_SdkTask Include="$(_SdkOutput)tools/net11.0/**/*" />
      <_SdkTaskDependency Include="$(_MSBuildOutput)Microsoft.Build.Tasks.Core.dll;$(_MSBuildOutput)System.CodeDom.dll" />
      <_ApiCompatBuild Include="$(GenBuildRoot)src/sdk/src/Compatibility/ApiCompat/Microsoft.DotNet.ApiCompat.Task/build/**/*" />
      <_ApiCompatBuild Include="$(_SdkSources)targets/Microsoft.NET.ApiCompat.Common.targets;$(_SdkSources)targets/Microsoft.NET.ApiCompat.ValidatePackage.targets" />
      <_BootstrapData Include="$(GenBuildBootstrapSdk)Microsoft.NETCoreSdk.BundledVersions.props;$(GenBuildBootstrapSdk)RuntimeIdentifierGraph.json;$(GenBuildBootstrapSdk)PortableRuntimeIdentifierGraph.json" />
      <_PruneData Include="$(GenBuildBootstrapSdk)PrunePackageData/**/*" />
      <_RoslynTask Include="$(_RoslynOutput)Microsoft.Build.Tasks.CodeAnalysis/$(Configuration)/net10.0/Microsoft.Build.Tasks.CodeAnalysis.dll;$(GenBuildRoot)src/roslyn/src/Compilers/Core/MSBuildTask/*.targets" />
      <_CSharpCompiler Include="$(_RoslynOutput)csc/$(Configuration)/net10.0/**/*"
                       Exclude="$(_RoslynOutput)csc/$(Configuration)/net10.0/csc;$(_RoslynOutput)csc/$(Configuration)/net10.0/csc.exe;**/*.runtimeconfig.dev.json" />
      <_VisualBasicCompiler Include="$(_RoslynOutput)vbc/$(Configuration)/net10.0/**/*"
                            Exclude="$(_RoslynOutput)vbc/$(Configuration)/net10.0/vbc;$(_RoslynOutput)vbc/$(Configuration)/net10.0/vbc.exe;**/*.runtimeconfig.dev.json;@(_CSharpCompiler->'$(_RoslynOutput)vbc/$(Configuration)/net10.0/%(RecursiveDir)%(Filename)%(Extension)')" />
      <_SourceLinkBuild Include="$(GenBuildRoot)src/sourcelink/src/%(SourceLink.Source)/build/**/*">
        <Package>%(SourceLink.Identity)</Package>
      </_SourceLinkBuild>
      <_SourceLinkMultiTargetingBuild Include="$(GenBuildRoot)src/sourcelink/src/%(SourceLink.Source)/buildMultiTargeting/**/*">
        <Package>%(SourceLink.Identity)</Package>
      </_SourceLinkMultiTargetingBuild>
      <_SourceLinkTask Include="$(_SourceLinkOutput)%(SourceLink.Identity)/$(Configuration)/net10.0/**/*">
        <Package>%(SourceLink.Identity)</Package>
      </_SourceLinkTask>
      <_ArcadeTask Include="$(GenBuildArcadeArtifactsDirectory)bin/$(Configuration)/net11.0/**/*" />
      <_ArcadeBuild Include="$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.Build.Tasks.TargetFramework/src/build/**/*" />
      <_ArcadeMultiTargetingBuild Include="$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.Build.Tasks.TargetFramework/src/buildMultiTargeting/**/*" />
      <_ArcadeSdkTask Include="$(GenBuildArcadeArtifactsDirectory)sdk/bin/$(Configuration)/net11.0/**/*" />
      <_ArcadeSdkTools Include="$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.Arcade.Sdk/tools/BuildTasks.props;$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.Arcade.Sdk/tools/GenerateResxSource.targets;$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.Arcade.Sdk/tools/GenerateInternalsVisibleTo.targets;$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.Arcade.Sdk/tools/RepositoryInfo.targets" />
      <_XliffTask Include="$(GenBuildArcadeArtifactsDirectory)xliff/bin/$(Configuration)/net11.0/**/*" />
      <_GenFacadesTask Include="$(GenBuildArcadeArtifactsDirectory)genfacades/bin/$(Configuration)/net11.0/**/*" />
      <_GenFacadesBuild Include="$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.GenFacades/build/**/*" />
      <_TemplatingTask Include="$(GenBuildArcadeArtifactsDirectory)templating/bin/$(Configuration)/net11.0/**/*" />
      <_TemplatingBuild Include="$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.Build.Tasks.Templating/src/build/**/*" />
      <_XliffBuild Include="$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.XliffTasks/build/**/*" />
      <_XliffCrossTargetingBuild Include="$(GenBuildRoot)src/arcade/src/Microsoft.DotNet.XliffTasks/buildCrossTargeting/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_Engine)" DestinationFiles="@(_Engine->'$(GenBuildToolsetDirectory)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CommonEntry)" DestinationFolder="$(GenBuildToolsetDirectory)Current/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_Host)" DestinationFiles="@(_Host->'$(GenBuildToolsetDirectory)action-host/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SdkEntry)" DestinationFiles="@(_SdkEntry->'$(_Sdk)Sdk/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SdkTarget)" DestinationFiles="@(_SdkTarget->'$(_Sdk)targets/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SdkTask)" DestinationFiles="@(_SdkTask->'$(_Sdk)tools/net11.0/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SdkTaskDependency)" DestinationFolder="$(_Sdk)tools/net11.0/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ApiCompatBuild)" DestinationFiles="@(_ApiCompatBuild->'$(GenBuildToolsetDirectory)ApiCompat/build/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_BootstrapData)" DestinationFiles="@(_BootstrapData->'$(GenBuildToolsetDirectory)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PruneData)" DestinationFiles="@(_PruneData->'$(GenBuildToolsetDirectory)PrunePackageData/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RoslynTask)" DestinationFolder="$(GenBuildToolsetDirectory)Roslyn/" SkipUnchangedFiles="true" />
    <Error Condition="'@(_CSharpCompiler)' == ''" Text="The source-built C# compiler is missing. Run without GenBuildSkipComponentBuild." />
    <Error Condition="'@(_VisualBasicCompiler)' == ''" Text="The source-built VB compiler is missing. Run without GenBuildSkipComponentBuild." />
    <ItemGroup>
      <_ObsoleteCompiler Include="$(GenBuildToolsetDirectory)Roslyn/bincore/**/*"
                         Exclude="@(_CSharpCompiler->'$(GenBuildToolsetDirectory)Roslyn/bincore/%(RecursiveDir)%(Filename)%(Extension)');@(_VisualBasicCompiler->'$(GenBuildToolsetDirectory)Roslyn/bincore/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(_ObsoleteCompiler)" />
    <Copy SourceFiles="@(_CSharpCompiler)" DestinationFiles="@(_CSharpCompiler->'$(GenBuildToolsetDirectory)Roslyn/bincore/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_VisualBasicCompiler)" DestinationFiles="@(_VisualBasicCompiler->'$(GenBuildToolsetDirectory)Roslyn/bincore/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SourceLinkBuild)" DestinationFiles="@(_SourceLinkBuild->'$(GenBuildToolsetDirectory)Sdks/%(Package)/build/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SourceLinkMultiTargetingBuild)" DestinationFiles="@(_SourceLinkMultiTargetingBuild->'$(GenBuildToolsetDirectory)Sdks/%(Package)/buildMultiTargeting/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SourceLinkTask)" DestinationFiles="@(_SourceLinkTask->'$(GenBuildToolsetDirectory)Sdks/%(Package)/tools/net/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="'@(_ArcadeTask)' == ''" Text="The locally-built Arcade target-framework tasks are missing. Run without GenBuildSkipComponentBuild." />
    <Copy SourceFiles="@(_ArcadeTask)" DestinationFiles="@(_ArcadeTask->'$(GenBuildToolsetDirectory)Arcade/TargetFramework/tools/net/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ArcadeBuild)" DestinationFiles="@(_ArcadeBuild->'$(GenBuildToolsetDirectory)Arcade/TargetFramework/build/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ArcadeMultiTargetingBuild)" DestinationFiles="@(_ArcadeMultiTargetingBuild->'$(GenBuildToolsetDirectory)Arcade/TargetFramework/buildMultiTargeting/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(GenBuildArcadeArtifactsDirectory)sdk/bin/$(Configuration)/net11.0/Microsoft.DotNet.Arcade.Sdk.dll')" Text="The locally-built Arcade SDK tasks are missing. Run without GenBuildSkipComponentBuild." />
    <Copy SourceFiles="@(_ArcadeSdkTask)" DestinationFiles="@(_ArcadeSdkTask->'$(GenBuildToolsetDirectory)Arcade/Sdk/tools/net/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ArcadeSdkTools)" DestinationFolder="$(GenBuildToolsetDirectory)Arcade/Sdk/tools/" SkipUnchangedFiles="true" />
    <Error Condition="'@(_XliffTask)' == ''" Text="The locally-built XLIFF tasks are missing. Run without GenBuildSkipComponentBuild." />
    <Copy SourceFiles="@(_XliffTask)" DestinationFiles="@(_XliffTask->'$(GenBuildToolsetDirectory)Arcade/XliffTasks/tools/net/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="'@(_GenFacadesTask)' == ''" Text="The locally-built GenFacades tasks are missing. Run without GenBuildSkipComponentBuild." />
    <Copy SourceFiles="@(_GenFacadesTask)" DestinationFiles="@(_GenFacadesTask->'$(GenBuildToolsetDirectory)Arcade/GenFacades/tools/net/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GenFacadesBuild)" DestinationFiles="@(_GenFacadesBuild->'$(GenBuildToolsetDirectory)Arcade/GenFacades/build/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="'@(_TemplatingTask)' == ''" Text="The locally-built templating tasks are missing. Run without GenBuildSkipComponentBuild." />
    <Copy SourceFiles="@(_TemplatingTask)" DestinationFiles="@(_TemplatingTask->'$(GenBuildToolsetDirectory)Arcade/Templating/tools/net/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TemplatingBuild)" DestinationFiles="@(_TemplatingBuild->'$(GenBuildToolsetDirectory)Arcade/Templating/build/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_XliffBuild)" DestinationFiles="@(_XliffBuild->'$(GenBuildToolsetDirectory)Arcade/XliffTasks/build/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_XliffCrossTargetingBuild)" DestinationFiles="@(_XliffCrossTargetingBuild->'$(GenBuildToolsetDirectory)Arcade/XliffTasks/buildCrossTargeting/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_NetAnalyzerBuild Include="$(_NetAnalyzers)Build/**/*" />
      <_NetAnalyzerConfig Include="$(_NetAnalyzers)GlobalAnalyzerConfigs/**/*" />
      <_NetAnalyzerAssembly Include="$(GenBuildRoot)src/sdk/artifacts/bin/Microsoft.CodeAnalysis.NetAnalyzers/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.NetAnalyzers.dll;$(GenBuildRoot)src/sdk/artifacts/bin/Microsoft.CodeAnalysis.CSharp.NetAnalyzers/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll;$(GenBuildRoot)src/sdk/artifacts/bin/Microsoft.CodeAnalysis.VisualBasic.NetAnalyzers/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.VisualBasic.NetAnalyzers.dll" />
      <_CodeStyleCommon Include="$(_RoslynOutput)Microsoft.CodeAnalysis.CodeStyle/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CodeStyle.dll;$(_RoslynOutput)Microsoft.CodeAnalysis.CodeStyle.Fixes/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CodeStyle.Fixes.dll" />
      <_CSharpCodeStyle Include="$(_RoslynOutput)Microsoft.CodeAnalysis.CSharp.CodeStyle/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.CodeStyle.dll;$(_RoslynOutput)Microsoft.CodeAnalysis.CSharp.CodeStyle.Fixes/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.CodeStyle.Fixes.dll" />
      <_VisualBasicCodeStyle Include="$(_RoslynOutput)Microsoft.CodeAnalysis.VisualBasic.CodeStyle/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.VisualBasic.CodeStyle.dll;$(_RoslynOutput)Microsoft.CodeAnalysis.VisualBasic.CodeStyle.Fixes/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.VisualBasic.CodeStyle.Fixes.dll" />
      <_CSharpConfig Include="$(_RoslynOutput)Microsoft.CodeAnalysis.CSharp.CodeStyle.Fixes/$(Configuration)/netstandard2.0/config/**/*" />
      <_VisualBasicConfig Include="$(_RoslynOutput)Microsoft.CodeAnalysis.VisualBasic.CodeStyle.Fixes/$(Configuration)/netstandard2.0/config/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_NetAnalyzerBuild)" DestinationFiles="@(_NetAnalyzerBuild->'$(_Sdk)analyzers/build/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NetAnalyzerConfig)" DestinationFiles="@(_NetAnalyzerConfig->'$(_Sdk)analyzers/build/config/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NetAnalyzerAssembly)" DestinationFolder="$(_Sdk)analyzers/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CodeStyleCommon);@(_CSharpCodeStyle)" DestinationFolder="$(_Sdk)codestyle/cs/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CodeStyleCommon);@(_VisualBasicCodeStyle)" DestinationFolder="$(_Sdk)codestyle/vb/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_RoslynOutput)Microsoft.CodeAnalysis.CSharp.CodeStyle.Fixes/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.CodeStyle.targets" DestinationFolder="$(_Sdk)codestyle/cs/build/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_RoslynOutput)Microsoft.CodeAnalysis.VisualBasic.CodeStyle.Fixes/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.VisualBasic.CodeStyle.targets" DestinationFolder="$(_Sdk)codestyle/vb/build/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CSharpConfig)" DestinationFiles="@(_CSharpConfig->'$(_Sdk)codestyle/cs/build/config/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_VisualBasicConfig)" DestinationFiles="@(_VisualBasicConfig->'$(_Sdk)codestyle/vb/build/config/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_CompilerCatalogLine Include="@(_CSharpCompiler->'&lt;_CompilerToolInput Include=&quot;%24(MSBuildThisFileDirectory)bincore/%(RecursiveDir)%(Filename)%(Extension)&quot; /&gt;');@(_VisualBasicCompiler->'&lt;_CompilerToolInput Include=&quot;%24(MSBuildThisFileDirectory)bincore/%(RecursiveDir)%(Filename)%(Extension)&quot; /&gt;')" />
      <_CompilerCatalogLine Include="@(_NetAnalyzerAssembly->'&lt;_CompilerAnalyzerFile Include=&quot;%24(MSBuildThisFileDirectory)../Sdks/Microsoft.NET.Sdk/analyzers/%(Filename)%(Extension)&quot; /&gt;')" />
      <_CompilerCatalogLine Include="@(_CodeStyleCommon->'&lt;_CompilerAnalyzerFile Include=&quot;%24(MSBuildThisFileDirectory)../Sdks/Microsoft.NET.Sdk/codestyle/cs/%(Filename)%(Extension)&quot; /&gt;');@(_CSharpCodeStyle->'&lt;_CompilerAnalyzerFile Include=&quot;%24(MSBuildThisFileDirectory)../Sdks/Microsoft.NET.Sdk/codestyle/cs/%(Filename)%(Extension)&quot; /&gt;')" />
      <_CompilerCatalogLine Include="@(_CodeStyleCommon->'&lt;_CompilerAnalyzerFile Include=&quot;%24(MSBuildThisFileDirectory)../Sdks/Microsoft.NET.Sdk/codestyle/vb/%(Filename)%(Extension)&quot; /&gt;');@(_VisualBasicCodeStyle->'&lt;_CompilerAnalyzerFile Include=&quot;%24(MSBuildThisFileDirectory)../Sdks/Microsoft.NET.Sdk/codestyle/vb/%(Filename)%(Extension)&quot; /&gt;')" />
    </ItemGroup>
    <WriteLinesToFile File="$(GenBuildToolsetDirectory)Roslyn/CompilerInputs.props"
                      Lines="&lt;Project&gt;;&lt;ItemGroup&gt;;@(_CompilerCatalogLine);&lt;/ItemGroup&gt;;&lt;/Project&gt;"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(GenBuildOutputDirectory)component-inputs.txt" Lines="VMR=$(GenBuildRoot);BootstrapSdk=$(GenBuildBootstrapSdk);Configuration=$(Configuration);NuGet sources: src/nuget-client;C# compiler sources: src/roslyn" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Message Importance="high" Text="genbuild app: $(GenBuildOutputDirectory)genbuild.dll (external .NET runtime required; no SDK redist)" />
  </Target>

  <Target Name="Build" DependsOnTargets="Assemble;BuildNativeTaskHost;BuildReadSandbox" />
</Project>
