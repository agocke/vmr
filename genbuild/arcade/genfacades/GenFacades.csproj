<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Microsoft.DotNet.GenFacades</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.DotNet.GenFacades</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);GetTaskPackageFiles</TargetsForTfmSpecificContentInPackage>
    <_GenFacadesSource>$(MSBuildThisFileDirectory)../../../src/arcade/src/Microsoft.DotNet.GenFacades/</_GenFacadesSource>
    <_Engine>$(MSBuildThisFileDirectory)../../../src/msbuild/artifacts/bin/MSBuild/$(Configuration)/net11.0/</_Engine>
    <_Compiler>$(MSBuildThisFileDirectory)../../../src/roslyn/artifacts/bin/csc/$(Configuration)/net10.0/</_Compiler>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(_GenFacadesSource)*.cs" Exclude="$(_GenFacadesSource)MSBuildDeclaredIOTaskAttribute.cs" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(_Engine)Microsoft.Build.Framework.dll" Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(_Engine)Microsoft.Build.Utilities.Core.dll" Private="false" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(_Compiler)Microsoft.CodeAnalysis.dll" Private="false" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(_Compiler)Microsoft.CodeAnalysis.CSharp.dll" Private="false" />
    <None Include="$(_GenFacadesSource)build/**/*" Pack="true" PackagePath="build/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="GetTaskPackageFiles">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)**/*" PackagePath="tools/net/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
