<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net11.0</TargetFramework>
    <BaseOutputPath Condition="'$(GenBuildArcadeArtifactsDirectory)' != ''">$([MSBuild]::NormalizeDirectory('$(GenBuildArcadeArtifactsDirectory)', 'xliff', 'bin'))</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(GenBuildArcadeArtifactsDirectory)' != ''">$([MSBuild]::NormalizeDirectory('$(GenBuildArcadeArtifactsDirectory)', 'xliff', 'obj'))</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <AssemblyName>Microsoft.DotNet.XliffTasks</AssemblyName>
    <RootNamespace>XliffTasks</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.DotNet.XliffTasks</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);GetTaskPackageFiles</TargetsForTfmSpecificContentInPackage>
    <_XliffSource>$(MSBuildThisFileDirectory)../../../src/arcade/src/Microsoft.DotNet.XliffTasks/</_XliffSource>
    <_Engine>$([MSBuild]::NormalizeDirectory('$(GenBuildMSBuildArtifactsDirectory)', 'bin', 'MSBuild', '$(Configuration)', 'net11.0'))</_Engine>
    <_MSBuildUtilitiesAssembly Condition="'$(GenBuildMSBuildUtilitiesAssembly)' == ''">$(_Engine)Microsoft.Build.Utilities.Core.dll</_MSBuildUtilitiesAssembly>
    <_MSBuildUtilitiesAssembly Condition="'$(GenBuildMSBuildUtilitiesAssembly)' != ''">$(GenBuildMSBuildUtilitiesAssembly)</_MSBuildUtilitiesAssembly>
    <_MSBuildFrameworkAssembly Condition="'$(GenBuildMSBuildFrameworkAssembly)' != ''">$(GenBuildMSBuildFrameworkAssembly)</_MSBuildFrameworkAssembly>
    <_MSBuildFrameworkAssembly Condition="'$(GenBuildMSBuildFrameworkAssembly)' == ''">$([System.IO.Path]::GetDirectoryName('$(_MSBuildUtilitiesAssembly)'))/Microsoft.Build.Framework.dll</_MSBuildFrameworkAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(_XliffSource)**/*.cs" Exclude="$(_XliffSource)MSBuildDeclaredIOTaskAttribute.cs;$(_XliffSource)obj/**/*.cs;$(_XliffSource)bin/**/*.cs" />
    <Compile Include="$(_XliffSource)../Common/Internal/AbsolutePathExtensions.cs" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(_MSBuildFrameworkAssembly)" Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(_MSBuildUtilitiesAssembly)" Private="false" />
    <EmbeddedResource Include="$(_XliffSource)Model/*.xsd" LogicalName="XliffTasks.Model.%(Filename)%(Extension)" />
    <None Include="$(_XliffSource)build/**/*" Pack="true" PackagePath="build/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(_XliffSource)buildCrossTargeting/**/*" Pack="true" PackagePath="buildCrossTargeting/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="GetTaskPackageFiles">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)**/*" PackagePath="tools/net/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
